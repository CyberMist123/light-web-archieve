+package browser
+
+import (
+	"errors"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// 这些测试只动内存里的锁和假的关闭步骤，一个浏览器都不开。
+
+func stubKill(t *testing.T) *[]int {
+	t.Helper()
+	var mu sync.Mutex
+	killed := []int{}
+	old := killTreeFn
+	killTreeFn = func(pid int) { mu.Lock(); killed = append(killed, pid); mu.Unlock() }
+	t.Cleanup(func() { killTreeFn = old })
+	return &killed
+}
+
+func TestLockRecordsOwnerAndSince(t *testing.T) {
+	require.Nil(t, CurrentLock())
+	require.True(t, lockProfile("main.(*AppServer).favoritesHandler", -1))
+	setLockPID(4242)
+	l := CurrentLock()
+	require.NotNil(t, l)
+	assert.Equal(t, "main.(*AppServer).favoritesHandler", l.Owner)
+	assert.Equal(t, 4242, l.PID)
+	assert.WithinDuration(t, time.Now(), l.Since, 2*time.Second)
+	unlockProfile()
+	assert.Nil(t, CurrentLock())
+}
+
+// TestNewBrowserWaitGivesUpWhenBusy 登录窗口拿锁有上限：锁被占时限时返回 ErrProfileBusy，不开浏览器。
+func TestNewBrowserWaitGivesUpWhenBusy(t *testing.T) {
+	require.True(t, lockProfile("holder", -1))
+	defer unlockProfile()
+	start := time.Now()
+	b, err := NewBrowserWait(300*time.Millisecond, true)
+	assert.Nil(t, b)
+	assert.ErrorIs(t, err, ErrProfileBusy)
+	assert.Less(t, time.Since(start), 3*time.Second)
+	assert.Equal(t, "holder", CurrentLock().Owner, "拿锁失败不能改写占用信息")
+}
+
+// TestCloseKillsTreeAndReleasesLockWhenHung 0928/0929：关浏览器卡在 Cleanup 死等，锁永远不放。
+// 现在落盘和关闭各有上限，超时就杀进程树并强制放锁。
+func TestCloseKillsTreeAndReleasesLockWhenHung(t *testing.T) {
+	killed := stubKill(t)
+	oldP, oldC := persistMax, closeMax
+	persistMax, closeMax = 50*time.Millisecond, 100*time.Millisecond
+	t.Cleanup(func() { persistMax, closeMax = oldP, oldC })
+
+	require.True(t, lockProfile("hung", -1))
+	block := make(chan struct{})
+	defer close(block)
+	b := &Browser{profile: "test"}
+	start := time.Now()
+	b.closeWith(func() { <-block }, func() { <-block }, func() int { return 777 })
+	assert.Less(t, time.Since(start), 2*time.Second)
+	assert.Equal(t, []int{777}, *killed)
+	assert.Nil(t, CurrentLock())
+	require.True(t, profileMu.TryLock(), "锁必须已被释放")
+	profileMu.Unlock()
+}
+
+func TestCloseNormalDoesNotKill(t *testing.T) {
+	killed := stubKill(t)
+	require.True(t, lockProfile("ok", -1))
+	var persisted, closed atomic.Bool
+	b := &Browser{profile: "test"}
+	b.closeWith(func() { persisted.Store(true) }, func() { closed.Store(true) }, func() int { return 1 })
+	assert.True(t, persisted.Load())
+	assert.True(t, closed.Load())
+	assert.Empty(t, *killed)
+	assert.Nil(t, CurrentLock())
+}
+
+// TestClosePanicStillReleasesLock CDP 连接已断时关闭步骤会 panic，也必须放锁。
+func TestClosePanicStillReleasesLock(t *testing.T) {
+	stubKill(t)
+	require.True(t, lockProfile("panicky", -1))
+	b := &Browser{profile: "test"}
+	b.closeWith(func() { panic("closed network connection") }, func() { panic("boom") }, func() int { return 1 })
+	require.True(t, profileMu.TryLock())
+	profileMu.Unlock()
+}
+
+// TestLockWatchdogExitsWhenOverdue 占锁超过 XHS_LOCK_MAX_S：记日志、杀浏览器进程树、os.Exit(75)。
+func TestLockWatchdogExitsWhenOverdue(t *testing.T) {
+	killed := stubKill(t)
+	var code atomic.Int32
+	oldExit := exitProcess
+	exitProcess = func(c int) { code.Store(int32(c)) }
+	t.Cleanup(func() { exitProcess = oldExit })
+	t.Setenv("XHS_LOCK_MAX_S", "60")
+
+	require.True(t, lockProfile("stuck-owner", -1))
+	setLockPID(9001)
+	defer unlockProfile()
+
+	assert.False(t, checkLockWatchdog(time.Now().Add(59*time.Second)))
+	assert.Equal(t, int32(0), code.Load())
+	assert.True(t, checkLockWatchdog(time.Now().Add(61*time.Second)))
+	assert.Equal(t, int32(75), code.Load())
+	assert.Equal(t, []int{9001}, *killed)
+}
+
+func TestLockWatchdogIdleWhenUnlocked(t *testing.T) {
+	stubKill(t)
+	oldExit := exitProcess
+	exitProcess = func(int) { t.Fatal("没人占锁时看门狗不许退出") }
+	t.Cleanup(func() { exitProcess = oldExit })
+	assert.False(t, checkLockWatchdog(time.Now().Add(24*time.Hour)))
+}
+
+func TestLockMaxEnv(t *testing.T) {
+	t.Setenv("XHS_LOCK_MAX_S", "")
+	assert.Equal(t, 900*time.Second, LockMax())
+	t.Setenv("XHS_LOCK_MAX_S", "120")
+	assert.Equal(t, 120*time.Second, LockMax())
+	t.Setenv("XHS_LOCK_MAX_S", "abc")
+	assert.Equal(t, 900*time.Second, LockMax())
+	t.Setenv("XHS_LOCK_MAX_S", "-5")
+	assert.Equal(t, 900*time.Second, LockMax())
+}
+
+// TestCallerNameSkipsFactory owner 取浏览器工厂之外的第一个调用者（生产里是 main 的处理函数）；
+// 测试函数本身也在 browser 包里，所以这里拿到的是 testing 的调度函数。
+func TestCallerNameSkipsFactory(t *testing.T) {
+	name := callerName()
+	assert.False(t, strings.HasPrefix(name, "xiaohongshu-mcp/browser."), name)
+	assert.Equal(t, "testing.tRunner", name)
+}
+
+// stubLaunch 把「持锁后启动浏览器」换成计数桩（返回空壳 Browser，不拉起任何进程）。
+func stubLaunch(t *testing.T) *atomic.Int32 {
+	t.Helper()
+	var n atomic.Int32
+	old := launchFn
+	launchFn = func(bool, ...Option) *Browser { n.Add(1); return &Browser{profile: "stub"} }
+	t.Cleanup(func() { launchFn = old })
+	return &n
+}
+
+// TestNewBrowserGuardedRefusesAndReleases guard 报错：不启动、放锁、原样返回 guard 的错误。
+func TestNewBrowserGuardedRefusesAndReleases(t *testing.T) {
+	launched := stubLaunch(t)
+	sentinel := errors.New("[RISK_HOLD] test")
+	b, err := NewBrowserGuarded(func() error { return sentinel }, true)
+	assert.Nil(t, b)
+	assert.ErrorIs(t, err, sentinel)
+	assert.Equal(t, int32(0), launched.Load())
+	assert.Nil(t, CurrentLock())
+	require.True(t, profileMu.TryLock(), "guard 拒绝后锁必须已释放")
+	profileMu.Unlock()
+
+	b, err = NewBrowserGuarded(func() error { return nil }, true)
+	require.NoError(t, err)
+	require.NotNil(t, b)
+	assert.Equal(t, int32(1), launched.Load())
+	unlockProfile()
+}
+
+// TestNewBrowserGuardedChecksAfterQueueing 审查 should-fix：请求进来时没熔断、排在锁后面等，
+// 等的时候前一个请求撞了风控——拿到锁之后的 guard 必须看到新状态，不开浏览器。
+func TestNewBrowserGuardedChecksAfterQueueing(t *testing.T) {
+	launched := stubLaunch(t)
+	require.True(t, lockProfile("favorites-read", -1))
+	var held atomic.Bool
+	type res struct {
+		b   *Browser
+		err error
+	}
+	done := make(chan res, 1)
+	go func() {
+		b, err := NewBrowserGuarded(func() error {
+			if held.Load() {
+				return errors.New("[RISK_HOLD] tripped while queued")
+			}
+			return nil
+		}, true)
+		done <- res{b, err}
+	}()
+	time.Sleep(300 * time.Millisecond) // 让它排到锁后面
+	select {
+	case <-done:
+		t.Fatal("锁被占着时不应返回")
+	default:
+	}
+	held.Store(true) // 前一个请求撞了验证码，写了熔断
+	unlockProfile()
+	r := <-done
+	assert.Nil(t, r.b)
+	require.Error(t, r.err)
+	assert.Contains(t, r.err.Error(), "[RISK_HOLD]")
+	assert.Equal(t, int32(0), launched.Load(), "排队期间熔断了就不能再启动浏览器")
+	assert.Nil(t, CurrentLock())
+}
+
+// TestStubLaunchForTestNeverLaunches 给 main 包用的桩：调用 onLaunch、放锁、panic，绝不真启动。
+func TestStubLaunchForTestNeverLaunches(t *testing.T) {
+	var n atomic.Int32
+	restore := StubLaunchForTest(func() { n.Add(1) })
+	defer restore()
+	assert.Panics(t, func() { _, _ = NewBrowserGuarded(nil, true) })
+	assert.Equal(t, int32(1), n.Load())
+	require.True(t, profileMu.TryLock(), "桩 panic 之后锁必须已释放")
+	profileMu.Unlock()
+}
