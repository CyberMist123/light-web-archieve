+// 往回滚一截（约 1.2 屏）：有的懒加载靠哨兵元素「进入视口」触发，一直贴在底部它不会再触发一次。
+const favScrollBackJS = `() => {
+				const h = window.innerHeight || 800;
+				window.scrollBy(0, -Math.round(h * 1.2));
+				const sc = document.querySelector('.feeds-container, .feeds-page, #userPostedFeeds, .note-scroll-container');
+				if (sc) sc.scrollTop = Math.max(0, sc.scrollTop - Math.round(h * 1.2));
+			}`
+
+// 把最后一张卡片滚进视口底部（第 3 级兜底）。
+const favLastCardJS = `() => {
+				const cards = document.querySelectorAll('section.note-item, .note-item');
+				const last = cards.length ? cards[cards.length - 1] : null;
+				if (last && last.scrollIntoView) last.scrollIntoView({block: "end"});
+				return cards.length;
+			}`
+
+// favScroll 第 level 级滚法。0 = JS 滚到底；1 = 先往回一截、歇一下再滚到底；2 = 真实滚轮往下；3 = 滚轮 + 末卡入视。
+func (u *UserProfileAction) favScroll(ctx context.Context, level int) {
