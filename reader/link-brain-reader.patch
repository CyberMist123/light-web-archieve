+// fakeFloor 假楼：shown = 楼上显示的回复数，loaded = 已加载，perClick = 点一次加载几条（0 = 点了不涨）。
+type fakeFloor struct {
+	id       string
+	shown    int
+	loaded   int
+	perClick int
+	noButton bool // 页面说还有，但没有按钮
+	hasMore  int  // 覆盖 hasMore（0 = 按 loaded<shown 算）
+	failNext int  // 接下来这么多次点击「点不动」
+	failAll  bool // 一直点不动
+}
+
+// fakeComments 假评论区：floors 是全部楼，visible 是已加载楼数，scroll 一次多加载 pageSize 楼（canScroll=false 时滚不动）。
+type fakeComments struct {
+	floors    []*fakeFloor
+	visible   int
+	pageSize  int
+	canScroll bool
+	clicks    map[string]int
+	scrolls   int
+	noState   bool
+	order     []string // 点中的楼序列
+	blocked   bool     // 全局点不动（模拟限频），由测试切换
+}
+
+func newFake(visible int, floors ...*fakeFloor) *fakeComments {
+	return &fakeComments{floors: floors, visible: visible, pageSize: 10, canScroll: true, clicks: map[string]int{}}
+}
+
+func (fc *fakeComments) probe(limit int) floorSnapshot {
+	if fc.noState {
+		return floorSnapshot{}
+	}
+	s := floorSnapshot{OK: true, Loaded: fc.visible, Total: 999, HasMore: 0}
+	if fc.visible < len(fc.floors) {
+		s.HasMore = 1
+	}
+	for i := 0; i < fc.visible && i < limit; i++ {
+		f := fc.floors[i]
+		hm := 0
+		if f.loaded < f.shown {
+			hm = 1
+		}
+		if f.hasMore != 0 {
+			hm = f.hasMore
+		}
+		s.Floors = append(s.Floors, floorInfo{Index: i, ID: f.id, Shown: f.shown, Loaded: f.loaded, HasMore: hm,
+			Button: hm == 1 && !f.noButton})
+	}
+	return s
+}
+
+func (fc *fakeComments) expand(fl floorInfo) clickResult {
+	for _, f := range fc.floors {
+		if f.id == fl.ID {
+			if fc.blocked || f.failAll || f.failNext > 0 {
+				if f.failNext > 0 {
+					f.failNext--
+				}
+				return clickResult{Detail: "context deadline exceeded"}
+			}
+			fc.clicks[f.id]++
+			fc.order = append(fc.order, f.id)
+			f.loaded += f.perClick
+			if f.loaded > f.shown {
+				f.loaded = f.shown
+			}
+			return clickResult{OK: true}
+		}
+	}
+	return clickResult{Detail: "找不到这楼的 DOM"}
+}
+
+func (fc *fakeComments) scroll(int) {
+	fc.scrolls++
+	if fc.canScroll {
+		fc.visible += fc.pageSize
+		if fc.visible > len(fc.floors) {
+			fc.visible = len(fc.floors)
+		}
+	}
+}
+
+func (fc *fakeComments) ops(limit int) floorOps {
+	return floorOps{probe: func() floorSnapshot { return fc.probe(limit) }, expand: fc.expand, scroll: fc.scroll, risk: noRisk}
+}
+
+func fastFloorCfg(limit int, budget time.Duration) floorLoadCfg {
+	cfg := defaultFloorLoadCfg(limit, true, budget, 0)
+	cfg.GrowWait, cfg.Poll = 30*time.Millisecond, time.Millisecond
+	cfg.Backoff = []time.Duration{time.Millisecond, time.Millisecond, time.Millisecond}
+	cfg.ThrottlePause = func() time.Duration { return time.Millisecond }
+	cfg.ScrollSettle = []time.Duration{20 * time.Millisecond, 20 * time.Millisecond}
+	cfg.Tick = func(int) time.Duration { return time.Millisecond }
+	return cfg
+}
+
+func floors(n int, mk func(i int) *fakeFloor) []*fakeFloor {
+	out := make([]*fakeFloor, n)
+	for i := range out {
+		out[i] = mk(i)
+	}
+	return out
+}
