diff --git a/cmd/relatedfile/main.go b/cmd/relatedfile/main.go
new file mode 100644
index 0000000..633b35f
--- /dev/null
+++ b/cmd/relatedfile/main.go
@@ -0,0 +1,85 @@
+// relatedfile: guest-mode probe for a note's attachment metadata (relatedFile.docId).
+//
+// Why this exists: link_brain's fetch_related_file() uses a bare httpx GET, which
+// XHS anti-crawl answers with a placeholder page that has no note in
+// __INITIAL_STATE__ (so no docId). A *real* browser as GUEST renders the note and
+// exposes note.relatedFile (docId/name/pages) — the attachment metadata is
+// guest-visible but HIDDEN once logged in. So this must run with an EMPTY profile:
+// the caller points XHS_PROFILE_DIR at a fresh temp dir so there is no session.
+//
+// Reads window.__INITIAL_STATE__.note.noteDetailMap[<id>].note.relatedFile and
+// prints one JSON line on stdout: {"hasNote":bool,"guest":bool,"relatedFile":{...}|null}.
+// Exit 0 = probed (relatedFile may still be null if the note truly has no file);
+// 1 = browser/nav error; 2 = bad args.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/configs"
+)
+
+const extractJS = `(nid) => {
+  const st = window.__INITIAL_STATE__ || {};
+  const map = (st.note && st.note.noteDetailMap) || {};
+  const note = ((map[nid] || {}).note) || {};
+  const u = st.user && st.user.userInfo;
+  return JSON.stringify({
+    hasNote: !!note.noteId,
+    guest: !!(u && u.guest),
+    relatedFile: note.relatedFile || null
+  });
+}`
+
+func main() {
+	headless := flag.Bool("headless", true, "run headless")
+	note := flag.String("note", "", "note id")
+	token := flag.String("token", "", "xsec_token")
+	flag.Parse()
+	if *note == "" {
+		fmt.Fprintln(os.Stderr, "need -note <id>")
+		os.Exit(2)
+	}
+
+	b := browser.NewBrowser(*headless,
+		browser.WithFingerprintSeed(configs.FingerprintSeedFromEnv()),
+		browser.WithProxy(configs.ProxyFromEnv()))
+	defer b.Close()
+	page := b.NewPage()
+
+	url := "https://www.xiaohongshu.com/explore/" + *note
+	if *token != "" {
+		url += "?xsec_token=" + *token + "&xsec_source=pc_feed"
+	}
+
+	var outJSON string
+	err := rod.Try(func() {
+		pp := page.Context(context.Background()).Timeout(45 * time.Second)
+		pp.MustNavigate(url).MustWaitLoad()
+		// Hydration is async: poll until the note appears (or give up ~14s).
+		deadline := time.Now().Add(14 * time.Second)
+		for {
+			outJSON = pp.MustEval(extractJS, *note).Str()
+			var probe struct {
+				HasNote bool `json:"hasNote"`
+			}
+			_ = json.Unmarshal([]byte(outJSON), &probe)
+			if probe.HasNote || time.Now().After(deadline) {
+				break
+			}
+			time.Sleep(800 * time.Millisecond)
+		}
+	})
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "probe error: %v\n", err)
+		os.Exit(1)
+	}
+	fmt.Println(outJSON)
+}
