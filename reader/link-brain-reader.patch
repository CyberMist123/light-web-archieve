+// waitTabActive 等页面状态里的 activeTab 切到目标 tab，最多 10 秒，超时不算错。
+func (u *UserProfileAction) waitTabActive(ctx context.Context, tab ProfileTab) {
+	page := u.page.Context(ctx).Timeout(10 * time.Second)
+	js := fmt.Sprintf(`() => {
+		const u = window.__INITIAL_STATE__ && window.__INITIAL_STATE__.user;
+		const unwrap = (o) => o?.value ?? o?._value ?? o?._rawValue ?? o;
+		const active = u ? (unwrap(u.activeTab) || {}) : {};
+		return active.query === %q;
+	}`, string(tab))
+	_ = rod.Try(func() { page.MustWait(js) })
