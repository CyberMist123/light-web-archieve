@@ -0,0 +1,148 @@
+package xiaohongshu
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestClassifyRisk 固定风控判据：/website-login/* 一律 ACCOUNT_RISK（0930 就是被跳到 /website-login/error），
+// 验证浮层 = CAPTCHA_REQUIRED，普通页面不误判。
+func TestClassifyRisk(t *testing.T) {
+	cases := []struct {
+		path    string
+		captcha bool
+		want    string
+	}{
+		{"/website-login/error", false, RiskAccount},
+		{"/website-login/captcha", false, RiskAccount},
+		{"/website-login/captcha", true, RiskAccount},
+		{"/Website-Login/error", false, RiskAccount},
+		{"/explore", true, RiskCaptcha},
+		{"/user/profile/abc", true, RiskCaptcha},
+		{"/web/captcha", false, RiskCaptcha},
+		{"/explore", false, ""},
+		{"/explore/65f0abc", false, ""},
+		{"/file/123", false, ""},
+		{"/login", false, ""}, // 登录墙是游客态，不是风控跳转
+		{"", false, ""},
+	}
+	for _, c := range cases {
+		r := ClassifyRisk(c.path, c.captcha)
+		if c.want == "" {
+			assert.Nil(t, r, c.path)
+			continue
+		}
+		require.NotNil(t, r, c.path)
+		assert.Equal(t, c.want, r.Code, c.path)
+	}
+}
+
+// TestRiskErrorTextCarriesBracketCode MCP 报错文本里必须带 "[CODE]"，Python 的 looks_blocked 靠它认。
+func TestRiskErrorTextCarriesBracketCode(t *testing.T) {
+	r := ClassifyRisk("/website-login/error", false)
+	wrapped := fmt.Errorf("获取Feed详情失败: %w", r)
+	assert.True(t, strings.HasPrefix(r.Error(), "[ACCOUNT_RISK] "))
+	assert.Contains(t, wrapped.Error(), "[ACCOUNT_RISK]")
+	got := AsRisk(fmt.Errorf("outer: %w", wrapped))
+	require.NotNil(t, got)
+	assert.Equal(t, RiskAccount, got.Code)
+	assert.Nil(t, AsRisk(errors.New("feed x not found in noteDetailMap")))
+	assert.Nil(t, AsRisk(nil))
+}
+
+// TestAccessTextRisk 详情页错误容器写「请完成安全验证」时按验证码停车，而不是当成「这篇没了」。
+func TestAccessTextRisk(t *testing.T) {
+	r := accessTextRisk("请完成安全验证")
+	require.NotNil(t, r)
+	assert.Equal(t, RiskCaptcha, r.Code)
+	assert.Nil(t, accessTextRisk("该笔记已被删除"))
+	long := accessTextRisk("安全验证" + strings.Repeat("字", 500))
+	require.NotNil(t, long)
+	assert.Less(t, len([]rune(long.Detail)), 120)
+}
+
+// TestTabNotActiveIsDistinguishable 读收藏只在「页签没点中」时重试，这个错误必须能被 errors.Is 认出来。
+func TestTabNotActiveIsDistinguishable(t *testing.T) {
+	err := fmt.Errorf("%w: 当前 tab 为 %q，与请求的 %q 不符", ErrTabNotActive, "note", "fav")
+	assert.True(t, errors.Is(fmt.Errorf("wrap: %w", err), ErrTabNotActive))
+	assert.False(t, errors.Is(errors.New("favorites did not load"), ErrTabNotActive))
+}
+
+func TestRiskPageNilPage(t *testing.T) {
+	assert.Nil(t, RiskPage(nil))
+}
+
+// TestLoginStateJSFlagsRiskRedirect 登录判据先认安全跳转页，避免把风控页当「游客」等满 18 秒。
+func TestLoginStateJSFlagsRiskRedirect(t *testing.T) {
+	assert.Contains(t, loginStateJS, `location.pathname.startsWith("/website-login")) return "risk"`)
+}
+
+// TestScrollFavoritesStopsOnRisk 审查 should-fix：滚收藏（每次滚动都打一次收藏接口）途中要查风控，撞上立即停、不再滚。
+func TestScrollFavoritesStopsOnRisk(t *testing.T) {
+	checks, scrolls := 0, 0
+	count := 0
+	r := scrollUntilStable(context.Background(), time.Minute, time.Minute, time.Millisecond,
+		func() int { count += 10; return count }, // 一直在增长，不会自然停
+		func() { scrolls++ },
+		func() *RiskError {
+			checks++
+			if checks == 3 {
+				return ClassifyRisk("/website-login/error", false)
+			}
+			return nil
+		})
+	require.NotNil(t, r)
+	assert.Equal(t, RiskAccount, r.Code)
+	assert.Equal(t, 2*favScrollRiskEvery, scrolls, "第三次检查命中：之前滚了两组，命中后一次都不能再滚")
+}
+
+func TestScrollFavoritesSettlesWithoutRisk(t *testing.T) {
+	scrolls := 0
+	r := scrollUntilStable(context.Background(), time.Minute, 20*time.Millisecond, 5*time.Millisecond,
+		func() int { return 7 }, func() { scrolls++ }, func() *RiskError { return nil })
+	assert.Nil(t, r)
+	assert.Greater(t, scrolls, 0)
+}
+
+// TestCommentLoaderRiskLatch 滚评论：命中一次风控就锁存，之后不再调用探针，hitErr 带出码。
+func TestCommentLoaderRiskLatch(t *testing.T) {
+	calls := 0
+	cl := &commentLoader{risk: func() *RiskError {
+		calls++
+		if calls == 2 {
+			return &RiskError{Code: RiskCaptcha, Detail: "overlay"}
+		}
+		return nil
+	}}
+	assert.False(t, cl.riskHit())
+	assert.Nil(t, cl.hitErr(), "没命中时必须是真正的 nil error")
+	assert.True(t, cl.riskHit())
+	assert.True(t, cl.riskHit())
+	assert.Equal(t, 2, calls)
+	got := AsRisk(cl.hitErr())
+	require.NotNil(t, got)
+	assert.Equal(t, RiskCaptcha, got.Code)
+	assert.False(t, (&commentLoader{}).riskHit(), "没配探针时不拦")
+}
+
+// TestCommentBudgetLeavesRoomForExtraction 滚评论预算 = min(8 分钟, 离总时限剩余 − 抽取预留)。
+func TestCommentBudgetLeavesRoomForExtraction(t *testing.T) {
+	now := time.Now()
+	assert.Equal(t, commentLoadBudget, commentBudget(context.Background(), now))
+	ctx, cancel := context.WithDeadline(context.Background(), now.Add(12*time.Minute))
+	defer cancel()
+	assert.Equal(t, commentLoadBudget, commentBudget(ctx, now))
+	ctx2, cancel2 := context.WithDeadline(context.Background(), now.Add(5*time.Minute))
+	defer cancel2()
+	assert.Equal(t, 5*time.Minute-extractReserve, commentBudget(ctx2, now))
+	ctx3, cancel3 := context.WithDeadline(context.Background(), now.Add(time.Minute))
+	defer cancel3()
+	assert.Equal(t, time.Duration(0), commentBudget(ctx3, now))
+}
diff --git a/xiaohongshu/search.go b/xiaohongshu/search.go
