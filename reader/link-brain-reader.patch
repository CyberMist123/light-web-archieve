+	assert.True(t, strings.HasSuffix(noteVerifyURL(testNote, ""), "/explore/"+testNote))
+}
+
+func stubSearch(t *testing.T, fn func() ([]xiaohongshu.Feed, error)) *atomic.Int32 {
