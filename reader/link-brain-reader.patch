diff --git a/linkbrain_api.go b/linkbrain_api.go
new file mode 100644
index 0000000..540d4ea
--- /dev/null
+++ b/linkbrain_api.go
@@ -0,0 +1,520 @@
+package main
+
+// Link Brain 单账号接口（0925）：一个号、一个持久 profile，评论 / 私密收藏 / 附件
+// 都在这个进程里跑，由 browser.profileMu 串行——不再有第二套浏览器去顶号。
+//
+//   GET  /api/v1/login/session         扫码进度与最近一次已知登录态（不开浏览器，随便轮询）
+//   GET  /api/v1/favorites             当前账号的收藏列表
+//   POST /api/v1/attachments/download  点笔记附件页的「下载」按钮，把文件存到 dest_dir
+//
+// 扫码进行中，其它会开浏览器的接口一律立刻回 409 LOGIN_IN_PROGRESS：
+// 它们本来会排在 profile 锁后面干等最多 4 分钟，调用方超时后还会误判成服务坏了。
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/proto"
+	"github.com/sirupsen/logrus"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/configs"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+type loginState struct {
+	mu        sync.Mutex
+	seq       uint64
+	state     string // idle | waiting | success | timeout
+	user      *xiaohongshu.CurrentUser
+	started   time.Time
+	finished  time.Time
+	expires   time.Time
+	loggedIn  *bool // 最近一次浏览器实测结果
+	checkedAt time.Time
+	verifying bool      // 人工验证窗口开着
+	lastFav   time.Time // 上次读收藏（限频，防风控）
+	captcha   time.Time // 最近一次撞见验证码
+}
+
+func (l *loginState) begin(seq uint64, timeout time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.seq, l.state, l.user = seq, "waiting", nil
+	l.started, l.expires, l.finished = time.Now(), time.Now().Add(timeout), time.Time{}
+}
+
+func (l *loginState) finish(seq uint64, state string, user *xiaohongshu.CurrentUser, _ string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.seq != seq { // 已被新的二维码取代
+		return
+	}
+	l.state, l.user, l.finished = state, user, time.Now()
+	if state == "success" {
+		t := true
+		l.loggedIn, l.checkedAt = &t, time.Now()
+		l.lastFav, l.captcha = time.Time{}, time.Time{} // 刚扫完码允许马上同步
+	}
+}
+
+func (l *loginState) observe(loggedIn bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.loggedIn, l.checkedAt = &loggedIn, time.Now()
+}
+
+func (l *loginState) waiting() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.state == "waiting"
+}
+
+func (l *loginState) busy() string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.state == "waiting" {
+		return "LOGIN_IN_PROGRESS"
+	}
+	if l.verifying {
+		return "VERIFY_WINDOW_OPEN"
+	}
+	return ""
+}
+
+func (l *loginState) set(f func(l *loginState)) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	f(l)
+}
+
+func (l *loginState) snapshot() map[string]any {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	out := map[string]any{"state": l.state, "seq": l.seq}
+	if out["state"] == "" {
+		out["state"] = "idle"
+	}
+	if !l.started.IsZero() {
+		out["started_at"] = l.started.Format(time.RFC3339)
+		out["expires_at"] = l.expires.Format(time.RFC3339)
+	}
+	if !l.finished.IsZero() {
+		out["finished_at"] = l.finished.Format(time.RFC3339)
+	}
+	if l.user != nil {
+		out["nickname"], out["user_id"] = l.user.Nickname, l.user.UserID
+	}
+	if l.loggedIn != nil {
+		out["logged_in"], out["checked_at"] = *l.loggedIn, l.checkedAt.Format(time.RFC3339)
+	}
+	out["verifying"] = l.verifying
+	if !l.captcha.IsZero() {
+		out["captcha_at"] = l.captcha.Format(time.RFC3339)
+	}
+	return out
+}
+
+// busyGuard：扫码进行中，会开浏览器的接口立刻 409，别在 profile 锁后面干等。
+func (s *AppServer) busyGuard() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		p := c.Request.URL.Path
+		if strings.HasSuffix(p, "/login/session") || strings.HasSuffix(p, "/login/qrcode") || strings.HasSuffix(p, "/login/window") {
+			c.Next()
+			return
+		}
+		if code := s.xiaohongshuService.state.busy(); code != "" {
+			if strings.HasSuffix(p, "/login/status") {
+				respondSuccess(c, map[string]any{"is_logged_in": nil, "login_pending": true}, "正在等待扫码或人工验证")
+				c.Abort()
+				return
+			}
+			respondError(c, http.StatusConflict, code, "正在等待扫码登录或人工验证，完成后再试", nil)
+			c.Abort()
+			return
+		}
+		c.Next()
+	}
+}
+
+func (s *AppServer) loginSessionHandler(c *gin.Context) {
+	respondSuccess(c, s.xiaohongshuService.state.snapshot(), "ok")
+}
+
+// captchaJS：小红书的「安全验证」拼图/滑块浮层。组件只识别、停车，绝不尝试去解。
+const captchaJS = `() => { const t = document.body ? document.body.innerText : "";
+ return /安全验证/.test(t) && /拖动|拼图|滑块|验证/.test(t.replace(/安全验证/g, "")) }`
+
+func captchaPresent(page *rod.Page) bool {
+	hit := false
+	_ = rod.Try(func() { hit = page.Timeout(5 * time.Second).MustEval(captchaJS).Bool() })
+	return hit
+}
+
+var errCaptcha = fmt.Errorf("CAPTCHA_REQUIRED")
+
+func (s *AppServer) respondCaptcha(c *gin.Context) {
+	s.xiaohongshuService.state.set(func(l *loginState) { l.captcha = time.Now() })
+	respondError(c, http.StatusLocked, "CAPTCHA_REQUIRED",
+		"小红书要求安全验证（拼图滑块），已停止操作", "打开验证窗口手动完成，或等几小时后再试；期间不要反复重试")
+}
+
+// verifyWindowHandler 打开有界面的浏览器停在自己的主页，由人手动过验证；关窗即结束。
+func (s *AppServer) verifyWindowHandler(c *gin.Context) {
+	st := &s.xiaohongshuService.state
+	started := false
+	st.set(func(l *loginState) {
+		if !l.verifying && l.state != "waiting" {
+			l.verifying, started = true, true
+		}
+	})
+	if !started {
+		respondError(c, http.StatusConflict, "BUSY", "已有登录或验证窗口在进行", nil)
+		return
+	}
+	go func() {
+		defer st.set(func(l *loginState) { l.verifying = false })
+		b := browser.NewBrowser(false, browser.WithFingerprintSeed(configs.FingerprintSeed()), browser.WithProxy(configs.Proxy()))
+		defer b.Close()
+		page := b.NewPage()
+		_ = rod.Try(func() {
+			page.Timeout(30 * time.Second).MustNavigate(xiaohongshu.SiteHost() + "/explore")
+			time.Sleep(4 * time.Second)
+			_ = page.Timeout(15*time.Second).MustElement(`.user.side-bar-component a[href*="/user/profile/"]`).Click(proto.InputMouseButtonLeft, 1)
+		})
+		deadline := time.Now().Add(15 * time.Minute)
+		for time.Now().Before(deadline) {
+			time.Sleep(2 * time.Second)
+			if _, err := page.Timeout(3 * time.Second).Eval(`() => 1`); err != nil {
+				break // 用户关了窗口
+			}
+		}
+		if !captchaPresent(page) {
+			st.set(func(l *loginState) { l.captcha = time.Time{} })
+		}
+	}()
+	respondSuccess(c, map[string]any{"opened": true, "timeout": "15m"}, "验证窗口已打开，完成后关闭窗口即可")
+}
+
+type favItem struct {
+	NoteID    string `json:"note_id"`
+	XsecToken string `json:"xsec_token"`
+	Title     string `json:"title"`
+	Type      string `json:"type"`
+	Author    string `json:"author"`
+	AuthorID  string `json:"author_id"`
+	URL       string `json:"url"`
+}
+
+var errNotLoggedIn = fmt.Errorf("NOT_LOGGED_IN")
+
+const favMinInterval = 10 * time.Minute
+
+func (s *AppServer) favoritesHandler(c *gin.Context) {
+	var wait time.Duration
+	s.xiaohongshuService.state.set(func(l *loginState) {
+		if since := time.Since(l.lastFav); since < favMinInterval {
+			wait = favMinInterval - since
+		} else {
+			l.lastFav = time.Now()
+		}
+	})
+	if wait > 0 {
+		respondError(c, http.StatusTooManyRequests, "RATE_LIMITED", "收藏刚读过，为免触发风控请稍后再试",
+			map[string]any{"retry_after_s": int(wait.Seconds())})
+		return
+	}
+	// 与 favdump 一致用独立 context：挂在 HTTP 请求 context 上实测进主页必超时（0925）
+	ctx, cancel := context.WithTimeout(context.Background(), 6*time.Minute)
+	defer cancel()
+	b := newBrowser()
+	defer b.Close()
+	page := b.NewPage()
+	var out map[string]any
+	var fail error
+	err := rod.Try(func() {
+		login := xiaohongshu.NewLogin(page)
+		ok, err := login.CheckLoginStatus(ctx)
+		if err != nil {
+			fail = err
+			return
+		}
+		s.xiaohongshuService.state.observe(ok)
+		if !ok {
+			fail = errNotLoggedIn
+			return
+		}
+		var profile *xiaohongshu.UserProfileResponse
+		for attempt := 1; attempt <= 4; attempt++ {
+			// 收藏 tab 的客户端点击偶发不生效，每次从首页重新路由，重试几次基本能命中。
+			if attempt > 1 {
+				// 上一次失败的页面常处于点击挂住的坏状态，在它上面重试必然再超时（0925 实测）：换干净标签页。
+				_ = page.Close()
+				page = b.NewPage()
+			}
+			profile, err = xiaohongshu.NewUserProfileAction(page).GetMyProfileViaSidebar(ctx, xiaohongshu.TabFavorites)
+			if err == nil || ctx.Err() != nil {
+				break
+			}
+			logrus.Warnf("read favorites %d/4: %v", attempt, err)
+			if captchaPresent(page) {
+				fail = errCaptcha
+				return
+			}
+			time.Sleep(2 * time.Second)
+		}
+		if err != nil {
+			fail = err
+			return
+		}
+		if len(profile.Feeds) == 0 && captchaPresent(page) {
+			fail = errCaptcha
+			return
+		}
+		if len(profile.Feeds) == 0 {
+			if d := os.Getenv("LB_DEBUG_DIR"); d != "" {
+				if shot, err := page.Screenshot(true, nil); err == nil {
+					_ = os.WriteFile(filepath.Join(d, "fav-empty.png"), shot, 0o644)
+				}
+			}
+		}
+		host := xiaohongshu.SiteHost()
+		items := make([]favItem, 0, len(profile.Feeds))
+		for _, f := range profile.Feeds {
+			items = append(items, favItem{NoteID: f.ID, XsecToken: f.XsecToken, Title: f.NoteCard.DisplayTitle,
+				Type: f.NoteCard.Type, Author: f.NoteCard.User.Nickname, AuthorID: f.NoteCard.User.UserID,
+				URL: fmt.Sprintf("%s/explore/%s?xsec_token=%s&xsec_source=pc_feed", host, f.ID, f.XsecToken)})
+		}
+		out = map[string]any{"nickname": profile.UserBasicInfo.Nickname, "count": len(items), "items": items}
+	})
+	if err != nil && fail == nil {
+		fail = err
+	}
+	switch {
+	case fail == errCaptcha:
+		s.respondCaptcha(c)
+	case fail == errNotLoggedIn:
+		respondError(c, http.StatusUnauthorized, "NOT_LOGGED_IN", "小红书未登录或登录已失效", nil)
+	case fail != nil:
+		respondError(c, http.StatusInternalServerError, "FAVORITES_FAILED", "读取收藏失败", fail.Error())
+	default:
+		respondSuccess(c, out, "ok")
+	}
+}
+
+type attachmentRequest struct {
+	DocID     string `json:"doc_id" binding:"required"`
+	NoteID    string `json:"note_id" binding:"required"`
+	XsecToken string `json:"xsec_token"`
+	FileName  string `json:"file_name"`
+	DestDir   string `json:"dest_dir" binding:"required"`
+}
+
+func (s *AppServer) attachmentDownloadHandler(c *gin.Context) {
+	var req attachmentRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "请求参数错误", err.Error())
+		return
+	}
+	dest, err := filepath.Abs(req.DestDir)
+	if err == nil {
+		err = os.MkdirAll(dest, 0o755)
+	}
+	if err != nil {
+		respondError(c, http.StatusBadRequest, "BAD_DEST", "下载目录不可用", err.Error())
+		return
+	}
+	path, code, err := downloadAttachment(context.Background(), req, dest)
+	if code == "CAPTCHA_REQUIRED" {
+		s.respondCaptcha(c)
+		return
+	}
+	if err != nil {
+		status := map[string]int{"NOT_LOGGED_IN": http.StatusUnauthorized, "NO_DOWNLOAD_BUTTON": http.StatusBadGateway,
+			"DOWNLOAD_TIMEOUT": http.StatusGatewayTimeout}[code]
+		if status == 0 {
+			status, code = http.StatusInternalServerError, "DOWNLOAD_FAILED"
+		}
+		respondError(c, status, code, "附件下载失败", err.Error())
+		return
+	}
+	st, _ := os.Stat(path)
+	respondSuccess(c, map[string]any{"path": path, "bytes": st.Size()}, "ok")
+}
+
+// downloadAttachment 必须 headed：headless 下站点那个下载 POST 会挂住。
+// 实测要点（0925）：只认 xiaohongshu.com 的 /file 页；按钮刚渲染出来就点没反应，要等预览挂好。
+func downloadAttachment(parent context.Context, req attachmentRequest, dest string) (string, string, error) {
+	ctx, cancel := context.WithTimeout(parent, 3*time.Minute)
+	defer cancel()
+	before := map[string]bool{}
+	if es, err := os.ReadDir(dest); err == nil {
+		for _, e := range es {
+			before[e.Name()] = true
+		}
+	}
+	b := browser.NewBrowser(false, browser.WithFingerprintSeed(configs.FingerprintSeed()), browser.WithProxy(configs.Proxy()))
+	defer b.Close()
+	page := b.NewPage()
+	var path, code string
+	var fail error
+	err := rod.Try(func() {
+		_ = proto.BrowserSetDownloadBehavior{Behavior: proto.BrowserSetDownloadBehaviorBehaviorAllow,
+			DownloadPath: dest, EventsEnabled: true}.Call(page.Browser())
+		u := fmt.Sprintf("%s/file/%s?noteId=%s&fileName=%s&xsec_token=%s&xsec_source=note_detail_file",
+			xiaohongshu.SiteHost(), url.PathEscape(req.DocID), url.QueryEscape(req.NoteID),
+			url.QueryEscape(req.FileName), url.QueryEscape(req.XsecToken))
+		_ = page.Context(ctx).Timeout(30 * time.Second).Navigate(u)
+		btn, err := page.Context(ctx).Timeout(45*time.Second).ElementR("button", `下载`)
+		if err != nil && captchaPresent(page) {
+			code, fail = "CAPTCHA_REQUIRED", errCaptcha
+			return
+		}
+		if err != nil {
+			st, _ := page.Eval(`() => { const u=window.__INITIAL_STATE__?.user?.userInfo; const x=u?.value??u?._value??u?._rawValue??u; return x?.guest===true ? "guest" : "" }`)
+			if st != nil && st.Value.String() == "guest" {
+				code, fail = "NOT_LOGGED_IN", errNotLoggedIn
+				return
+			}
+			code, fail = "NO_DOWNLOAD_BUTTON", fmt.Errorf("附件页没有出现下载按钮（文件可能已删除或无下载权限）")
+			return
+		}
+		time.Sleep(8 * time.Second)
+		for i := 0; i < 90 && ctx.Err() == nil; i++ {
+			if i == 0 || i == 20 || i == 45 {
+				if b2, err := page.Timeout(10*time.Second).ElementR("button", `下载`); err == nil {
+					btn = b2
+				}
+				_ = btn.Timeout(10*time.Second).Click(proto.InputMouseButtonLeft, 1)
+			}
+			time.Sleep(time.Second)
+			es, _ := os.ReadDir(dest)
+			for _, e := range es {
+				n := e.Name()
+				if !before[n] && !e.IsDir() && !strings.HasSuffix(n, ".crdownload") && !strings.HasSuffix(n, ".tmp") {
+					if info, err := e.Info(); err == nil && info.Size() > 0 {
+						path = filepath.Join(dest, n)
+						return
+					}
+				}
+			}
+		}
+		if captchaPresent(page) {
+			code, fail = "CAPTCHA_REQUIRED", errCaptcha
+			return
+		}
+		code, fail = "DOWNLOAD_TIMEOUT", fmt.Errorf("点了下载但 90 秒内没有文件落地")
+	})
+	if err != nil && fail == nil {
+		fail = err
+	}
+	return path, code, fail
+}
+
+// loginWindowHandler 打开小红书官方登录窗口（有界面），由人在官方页面扫码——二维码、「扫码成功，
+// 请在手机上确认」等进度都是官方自己的。程序只在同一页面上等登录态出现（不导航），成功后
+// 在读取用的域名上复核一次，然后关窗落盘。用户手动关窗 = 取消。
+func (s *AppServer) loginWindowHandler(c *gin.Context) {
+	st := &s.xiaohongshuService.state
+	if code := st.busy(); code != "" {
+		respondError(c, http.StatusConflict, code, "已有登录或验证窗口在进行", nil)
+		return
+	}
+	timeout := 5 * time.Minute
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	seq := s.xiaohongshuService.logins.start(cancel)
+	st.begin(seq, timeout)
+	go func() {
+		defer cancel()
+		defer s.xiaohongshuService.logins.finish(seq)
+		b := browser.NewBrowser(false, browser.WithFingerprintSeed(configs.FingerprintSeed()), browser.WithProxy(configs.Proxy()))
+		defer b.Close()
+		page := b.NewPage()
+		host := xiaohongshu.LoginHost()
+		result, errText := "timeout", ""
+		var user *xiaohongshu.CurrentUser
+		err := rod.Try(func() {
+			_ = page.Timeout(30 * time.Second).Navigate(host + "/explore")
+			login := xiaohongshu.NewLogin(page)
+			// 已经登录：直接成功
+			if _, e := page.Timeout(8*time.Second).Element(".login-container"); e != nil {
+				if ok, _ := login.CheckLoginStatus(ctx); ok {
+					result = "success"
+					user, _ = login.CurrentUser(ctx)
+					return
+				}
+				_ = rod.Try(func() {
+					page.Timeout(10*time.Second).MustElementR("button, div, span", `^\s*登录\s*$`).MustClick()
+				})
+			}
+			done := make(chan bool, 1)
+			go func() { done <- login.WaitForLogin(ctx) }()
+			for {
+				select {
+				case ok := <-done:
+					if !ok {
+						return
+					}
+					user, _ = login.CurrentUser(ctx)
+					// 会话落在哪个域名因号而异：逐个复核并记住（之后读取都用它）
+					if login.RememberSiteHost(ctx) == "" {
+						result, errText = "failed", "扫码成功但两个域名都没有确认到登录，请重试一次"
+						return
+					}
+					result = "success"
+					return
+				case <-time.After(2 * time.Second):
+					if _, e := page.Timeout(3 * time.Second).Eval(`() => 1`); e != nil {
+						result = "cancelled"
+						cancel()
+						return
+					}
+				}
+			}
+		})
+		if err != nil && result == "timeout" && ctx.Err() == nil {
+			result, errText = "failed", err.Error()
+		}
+		b.Close() // 先落盘再报成功
+		if errText != "" {
+			logrus.Warnf("登录窗口 #%d: %s", seq, errText)
+		}
+		st.finish(seq, result, user, errText)
+		logrus.Infof("登录窗口 #%d 结束：%s", seq, result)
+	}()
+	respondSuccess(c, map[string]any{"opened": true, "timeout": timeout.String()}, "登录窗口已打开")
+}
+
+// logoutHandler 清掉本地浏览器目录里的小红书登录（只动这个 profile，不影响手机 App 和别的浏览器）。
+func (s *AppServer) logoutHandler(c *gin.Context) {
+	b := newBrowser()
+	defer b.Close()
+	page := b.NewPage()
+	err := rod.Try(func() {
+		res, err := proto.StorageGetCookies{}.Call(page.Browser())
+		if err != nil {
+			panic(err)
+		}
+		for _, ck := range res.Cookies {
+			d := strings.ToLower(ck.Domain)
+			if strings.Contains(d, "xiaohongshu.com") || strings.Contains(d, "rednote.com") {
+				_ = proto.NetworkDeleteCookies{Name: ck.Name, Domain: ck.Domain, Path: ck.Path}.Call(page)
+			}
+		}
+	})
+	if err != nil {
+		respondError(c, http.StatusInternalServerError, "LOGOUT_FAILED", "退出登录失败", err.Error())
+		return
+	}
+	s.xiaohongshuService.state.observe(false)
+	s.xiaohongshuService.state.set(func(l *loginState) { l.user = nil; l.state = "idle" })
+	respondSuccess(c, map[string]any{"logged_out": true}, "已退出登录")
+}
