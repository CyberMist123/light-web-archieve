+package main
+
+// Link Brain 单账号接口（0925）：一个号、一个持久 profile，评论 / 私密收藏 / 附件
+// 都在这个进程里跑，由 browser.profileMu 串行——不再有第二套浏览器去顶号。
+//
+//   GET  /api/v1/login/session         扫码进度与最近一次已知登录态（不开浏览器，随便轮询）
+//   GET  /api/v1/favorites             当前账号的收藏列表
+//   POST /api/v1/attachments/download  先看笔记、再点附件页的「下载」按钮，把文件存到 dest_dir
+//   POST /api/v1/notes/related-file    登录态看笔记页读附件元数据（游客被登录墙挡的笔记用）
+//
+// 扫码进行中，其它会开浏览器的接口一律立刻回 409 LOGIN_IN_PROGRESS：
+// 它们本来会排在 profile 锁后面干等最多 4 分钟，调用方超时后还会误判成服务坏了。
+//
+// 1001 护号：所有开页的路径导航后、关键步骤前都过 xiaohongshu.RiskPage；撞到验证码 / 安全跳转 /
+// 需要登录却是游客，立即停、不重试、写熔断（risk_hold.go），之后会开浏览器的请求一律 423 RISK_HOLD。
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/rand"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/proto"
+	"github.com/sirupsen/logrus"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/configs"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+type loginState struct {
+	mu        sync.Mutex
+	seq       uint64
+	state     string // idle | waiting | success | timeout
+	user      *xiaohongshu.CurrentUser
+	started   time.Time
+	finished  time.Time
+	expires   time.Time
+	loggedIn  *bool // 最近一次浏览器实测结果
+	checkedAt time.Time
+	verifying bool      // 人工验证窗口开着
+	lastFav   time.Time // 上次读收藏（限频，防风控）
+	captcha   time.Time // 最近一次撞见验证码
+}
+
+func (l *loginState) begin(seq uint64, timeout time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.seq, l.state, l.user = seq, "waiting", nil
+	l.started, l.expires, l.finished = time.Now(), time.Now().Add(timeout), time.Time{}
+}
+
+func (l *loginState) finish(seq uint64, state string, user *xiaohongshu.CurrentUser, _ string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.seq != seq { // 已被新的二维码取代
+		return
+	}
+	l.state, l.user, l.finished = state, user, time.Now()
+	if state == "success" {
+		t := true
+		l.loggedIn, l.checkedAt = &t, time.Now()
+		l.lastFav, l.captcha = time.Time{}, time.Time{} // 刚扫完码允许马上同步
+	}
+}
+
+// restartClock 登录窗口拿到浏览器锁后调用：expires_at 改为「现在 + 扫码时限」（仍是这一轮、仍在等才改）。
+func (l *loginState) restartClock(seq uint64, timeout time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.seq == seq && l.state == "waiting" {
+		l.expires = time.Now().Add(timeout)
+	}
+}
+
+func (l *loginState) observe(loggedIn bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.loggedIn, l.checkedAt = &loggedIn, time.Now()
+}
+
+func (l *loginState) waiting() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.state == "waiting"
+}
+
+// loginStuckGrace 等扫码状态过了 expires 这么久还没收尾，就当它已经结束（兜底，正常路径都会 finish）。
+const loginStuckGrace = 2 * time.Minute
+
+func (l *loginState) stuckLocked(now time.Time) bool {
+	return l.state == "waiting" && !l.expires.IsZero() && now.After(l.expires.Add(loginStuckGrace))
+}
+
+func (l *loginState) busy() string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.state == "waiting" && !l.stuckLocked(time.Now()) {
+		return "LOGIN_IN_PROGRESS"
+	}
+	if l.verifying {
+		return "VERIFY_WINDOW_OPEN"
+	}
+	return ""
+}
+
+func (l *loginState) set(f func(l *loginState)) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	f(l)
+}
+
+func (l *loginState) snapshot() map[string]any {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	out := map[string]any{"state": l.state, "seq": l.seq}
+	if out["state"] == "" {
+		out["state"] = "idle"
+	}
+	if l.stuckLocked(time.Now()) {
+		out["state"] = "timeout"
+	}
+	if !l.started.IsZero() {
+		out["started_at"] = l.started.Format(time.RFC3339)
+		out["expires_at"] = l.expires.Format(time.RFC3339)
+	}
+	if !l.finished.IsZero() {
+		out["finished_at"] = l.finished.Format(time.RFC3339)
+	}
+	if l.user != nil {
+		out["nickname"], out["user_id"] = l.user.Nickname, l.user.UserID
+	}
+	if l.loggedIn != nil {
+		out["logged_in"], out["checked_at"] = *l.loggedIn, l.checkedAt.Format(time.RFC3339)
+	}
+	out["verifying"] = l.verifying
+	if !l.captcha.IsZero() {
+		out["captcha_at"] = l.captcha.Format(time.RFC3339)
+	}
+	return out
+}
+
+// busyGuard：扫码进行中，会开浏览器的接口立刻 409，别在 profile 锁后面干等。
+func (s *AppServer) busyGuard() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		p := c.Request.URL.Path
+		if strings.HasSuffix(p, "/login/session") || strings.HasSuffix(p, "/login/qrcode") || strings.HasSuffix(p, "/login/window") ||
+			strings.HasSuffix(p, "/risk/clear") {
+			c.Next()
+			return
+		}
+		if code := s.xiaohongshuService.state.busy(); code != "" {
+			if strings.HasSuffix(p, "/login/status") {
+				respondSuccess(c, map[string]any{"is_logged_in": nil, "login_pending": true}, "正在等待扫码或人工验证")
+				c.Abort()
+				return
+			}
+			respondError(c, http.StatusConflict, code, "正在等待扫码登录或人工验证，完成后再试", nil)
+			c.Abort()
+			return
+		}
+		c.Next()
+	}
+}
+
+// loginSessionHandler 只读内存：不拿 profile 锁、不开浏览器（卡死时也能秒回，给 restart_reader 判锁占了多久）。
+func (s *AppServer) loginSessionHandler(c *gin.Context) {
+	out := s.xiaohongshuService.state.snapshot()
+	if h := s.xiaohongshuService.hold.get(); h != nil {
+		out["risk_hold"] = h
+	} else {
+		out["risk_hold"] = nil
+	}
+	out["lock"] = lockSnapshot(currentLock(), time.Now())
+	respondSuccess(c, out, "ok")
+}
+
+// windowLockWait 登录/验证窗口拿 profile 锁最多等这么久；拿不到就报失败，不让状态永远停在 waiting。
+const windowLockWait = 60 * time.Second
+
+// verifyWindowMax 验证窗口最长开多久（要短于锁看门狗的 XHS_LOCK_MAX_S=900s）。
+const verifyWindowMax = 12 * time.Minute
+
+// openWindowBrowser 登录/验证窗口用的有界面浏览器，拿锁最多等 windowLockWait（测试里替换成桩）。
+var openWindowBrowser = func() (*browser.Browser, error) {
+	return browser.NewBrowserWait(windowLockWait, false, browser.WithFingerprintSeed(configs.FingerprintSeed()), browser.WithProxy(configs.Proxy()))
+}
+
+func recoverLog(what string) {
+	if r := recover(); r != nil {
+		logrus.Errorf("%s 出错：%v", what, r)
+	}
+}
+
+// verifyWindowHandler 打开有界面的浏览器停在自己的主页，由人手动过验证；关窗即结束。
+func (s *AppServer) verifyWindowHandler(c *gin.Context) {
+	st := &s.xiaohongshuService.state
+	started := false
+	st.set(func(l *loginState) {
+		if !l.verifying && l.state != "waiting" {
+			l.verifying, started = true, true
+		}
+	})
+	if !started {
+		respondError(c, http.StatusConflict, "BUSY", "已有登录或验证窗口在进行", nil)
+		return
+	}
+	go func() {
+		defer st.set(func(l *loginState) { l.verifying = false })
+		defer recoverLog("验证窗口")
+		b, err := openWindowBrowser()
+		if err != nil {
+			logrus.Warnf("验证窗口没打开：%v（%s 内没等到浏览器空出来）", err, windowLockWait)
+			return
+		}
+		defer b.Close()
+		page := b.NewPage()
+		_ = rod.Try(func() {
+			page.Timeout(30 * time.Second).MustNavigate(xiaohongshu.SiteHost() + "/explore")
+			time.Sleep(4 * time.Second)
+			_ = page.Timeout(15*time.Second).MustElement(`.user.side-bar-component a[href*="/user/profile/"]`).Click(proto.InputMouseButtonLeft, 1)
+		})
+		// 1001：窗口活着的时候每 2 秒看一眼并记住最后一次读数；关窗后页面已死、什么都读不到，
+		// 不能拿「读不到」当「没风险」。只按关窗前最后一次有效读数决定解不解熔断。
+		last, seen := watchVerifyWindow(time.Now().Add(verifyWindowMax), 2*time.Second,
+			func() bool { _, err := page.Timeout(3 * time.Second).Eval(`() => 1`); return err == nil },
+			func() verifyReading { return verifyProbe(page) })
+		s.xiaohongshuService.finishVerify(last, seen)
+	}()
+	respondSuccess(c, map[string]any{"opened": true, "timeout": verifyWindowMax.String()}, "验证窗口已打开，完成后关闭窗口即可")
+}
+
+// verifyReading 验证窗口里读一次页面的结果。ok=false 表示这次没读到（页面在跳转或已关），不作数。
+type verifyReading struct {
+	ok       bool
+	risk     *xiaohongshu.RiskError // 页面上仍有的风控（验证浮层 / 安全跳转页）
+	loggedIn bool                   // 页面状态里是已登录用户
+}
+
+// verifyProbe 读一次验证窗口的页面：风控 + 登录态，不导航、不点（测试里替换）。
+var verifyProbe = func(page *rod.Page) verifyReading {
+	r, ok := xiaohongshu.RiskPageRead(page)
+	st := xiaohongshu.PageLoginState(page)
+	return verifyReading{ok: ok && st != "", risk: r, loggedIn: st == "user"}
+}
+
+// watchVerifyWindow 每 tick 看一眼：窗口还活着就采样，记住最后一次有效读数；窗口关了或到时就返回。
+func watchVerifyWindow(deadline time.Time, tick time.Duration, alive func() bool, sample func() verifyReading) (last verifyReading, seen bool) {
+	for time.Now().Before(deadline) {
+		time.Sleep(tick)
+		if !alive() {
+			break // 用户关了窗口
+		}
+		if r := sample(); r.ok {
+			last, seen = r, true
+		}
+	}
+	return last, seen
+}
+
+// verifyClears 验证窗口结束后能不能解熔断：要有有效读数、最后一次没有风控；
+// 不是验证码类的熔断（掉登录 / 安全跳转）还要最后看到的是已登录用户。
+func verifyClears(holdCode string, last verifyReading, seen bool) (bool, string) {
+	switch {
+	case !seen:
+		return false, "窗口里一次都没读到页面状态"
+	case last.risk != nil:
+		return false, "关窗前页面仍在风控（" + last.risk.Code + "）"
+	case holdCode != xiaohongshu.RiskCaptcha && !last.loggedIn:
+		return false, "关窗前没看到已登录（" + holdCode + " 要确认登录还在）"
+	}
+	return true, ""
+}
+
+// finishVerify 验证窗口收尾：按关窗前最后一次读数决定解除还是保持熔断。
+func (s *XiaohongshuService) finishVerify(last verifyReading, seen bool) {
+	h := s.hold.get()
+	if h == nil {
+		if seen && last.risk == nil {
+			s.state.set(func(l *loginState) { l.captcha = time.Time{} })
+		}
+		return
+	}
+	if ok, why := verifyClears(h.Code, last, seen); !ok {
+		logrus.Warnf("验证窗口结束，熔断保持（%s）：%s", h.Code, why)
+		return
+	}
+	s.clearRisk("人工验证窗口完成（关窗前页面无风控）")
+}
+
+type favItem struct {
+	NoteID    string `json:"note_id"`
+	XsecToken string `json:"xsec_token"`
+	Title     string `json:"title"`
+	Type      string `json:"type"`
+	Author    string `json:"author"`
+	AuthorID  string `json:"author_id"`
+	URL       string `json:"url"`
+}
+
+const favMinInterval = 10 * time.Minute
+
+// 读收藏一次请求内最多 2 次尝试；只有「子 tab 没点中」这种纯前端问题才重试，重试前歇 20–40 秒（0930 连读后被跳到登录错误页）。
+const favMaxAttempts = 2
+
+func favRetryWait() time.Duration { return time.Duration(20+rand.Intn(21)) * time.Second }
+
+// readFavoritesWithRetry 重试策略：风控类错误立即停；非 tab 问题不重试；重试前先查风控再等待。
+func readFavoritesWithRetry(ctx context.Context,
+	read func() (*xiaohongshu.UserProfileResponse, error),
+	riskCheck func() *xiaohongshu.RiskError,
+	wait func(context.Context, time.Duration) error,
+	freshPage func(),
+) (*xiaohongshu.UserProfileResponse, error) {
+	var err error
+	for attempt := 1; attempt <= favMaxAttempts; attempt++ {
+		if attempt > 1 {
+			if r := riskCheck(); r != nil {
+				return nil, r
+			}
+			d := favRetryWait()
+			logrus.Infof("read favorites: 页签没点中，歇 %s 再试最后一次", d)
+			if werr := wait(ctx, d); werr != nil {
+				return nil, err
+			}
+			freshPage()
+		}
+		var profile *xiaohongshu.UserProfileResponse
+		profile, err = read()
+		if err == nil {
+			return profile, nil
+		}
+		logrus.Warnf("read favorites %d/%d: %v", attempt, favMaxAttempts, err)
+		if r := xiaohongshu.AsRisk(err); r != nil {
+			return nil, r
+		}
+		if r := riskCheck(); r != nil {
+			return nil, r
+		}
+		if ctx.Err() != nil || !errors.Is(err, xiaohongshu.ErrTabNotActive) {
+			return nil, err
+		}
+	}
+	return nil, err
+}
+
+func sleepCtx(ctx context.Context, d time.Duration) error {
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-time.After(d):
+		return nil
+	}
+}
+
+func (s *AppServer) favoritesHandler(c *gin.Context) {
+	var wait time.Duration
+	s.xiaohongshuService.state.set(func(l *loginState) {
+		if since := time.Since(l.lastFav); since < favMinInterval {
+			wait = favMinInterval - since
+		} else {
+			l.lastFav = time.Now()
+		}
+	})
+	if wait > 0 {
+		respondError(c, http.StatusTooManyRequests, "RATE_LIMITED", "收藏刚读过，为免触发风控请稍后再试",
+			map[string]any{"retry_after_s": int(wait.Seconds())})
+		return
+	}
+	// 与 favdump 一致用独立 context：挂在 HTTP 请求 context 上实测进主页必超时（0925）
+	ctx, cancel := context.WithTimeout(context.Background(), 6*time.Minute)
+	defer cancel()
+	b, berr := s.xiaohongshuService.openBrowser()
+	if berr != nil { // 排队等锁期间别的请求撞了风控：不开浏览器
+		s.respondServiceError(c, berr, http.StatusInternalServerError, "FAVORITES_FAILED", "读取收藏失败")
+		return
+	}
+	defer b.Close()
+	page := b.NewPage()
+	var out map[string]any
+	var fail error
+	err := rod.Try(func() {
+		login := xiaohongshu.NewLogin(page)
+		ok, err := login.CheckLoginStatus(ctx)
+		if err != nil {
+			fail = err // 含 RiskError：登录检查时就被跳到风控页
+			return
+		}
+		s.xiaohongshuService.state.observe(ok)
+		if !ok {
+			fail = &xiaohongshu.RiskError{Code: xiaohongshu.RiskNotLoggedIn, Detail: "读收藏：读取服务的号是游客"}
+			return
+		}
+		profile, err := readFavoritesWithRetry(ctx,
+			func() (*xiaohongshu.UserProfileResponse, error) {
+				return xiaohongshu.NewUserProfileAction(page).GetMyProfileViaSidebar(ctx, xiaohongshu.TabFavorites)
+			},
+			func() *xiaohongshu.RiskError { return xiaohongshu.RiskPage(page) },
+			sleepCtx,
+			func() {
+				// 上一次失败的页面常处于点击挂住的坏状态，在它上面重试必然再超时（0925 实测）：换干净标签页。
+				_ = page.Close()
+				page = b.NewPage()
+			})
+		if err != nil {
+			fail = err
+			return
+		}
+		if r := xiaohongshu.RiskPage(page); r != nil {
+			fail = r
+			return
+		}
+		if len(profile.Feeds) == 0 {
+			if d := os.Getenv("LB_DEBUG_DIR"); d != "" {
+				if shot, err := page.Screenshot(true, nil); err == nil {
+					_ = os.WriteFile(filepath.Join(d, "fav-empty.png"), shot, 0o644)
+				}
+			}
+		}
+		host := xiaohongshu.SiteHost()
+		items := make([]favItem, 0, len(profile.Feeds))
+		for _, f := range profile.Feeds {
+			items = append(items, favItem{NoteID: f.ID, XsecToken: f.XsecToken, Title: f.NoteCard.DisplayTitle,
+				Type: f.NoteCard.Type, Author: f.NoteCard.User.Nickname, AuthorID: f.NoteCard.User.UserID,
+				URL: fmt.Sprintf("%s/explore/%s?xsec_token=%s&xsec_source=pc_feed", host, f.ID, f.XsecToken)})
+		}
+		out = map[string]any{"nickname": profile.UserBasicInfo.Nickname, "count": len(items), "items": items}
+	})
+	if err != nil && fail == nil {
+		fail = err
+		if r := xiaohongshu.RiskPage(page); r != nil { // panic 多半是页面被跳走了
+			fail = r
+		}
+	}
+	if r := xiaohongshu.AsRisk(fail); r != nil {
+		s.respondRisk(c, r)
+		return
+	}
+	if fail != nil {
+		respondError(c, http.StatusInternalServerError, "FAVORITES_FAILED", "读取收藏失败", fail.Error())
+		return
+	}
+	respondSuccess(c, out, "ok")
+}
+
+type attachmentRequest struct {
+	DocID     string `json:"doc_id" binding:"required"`
+	NoteID    string `json:"note_id" binding:"required"`
+	XsecToken string `json:"xsec_token"`
+	FileName  string `json:"file_name"`
+	DestDir   string `json:"dest_dir" binding:"required"`
+}
+
+func (s *AppServer) attachmentDownloadHandler(c *gin.Context) {
+	var req attachmentRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "请求参数错误", err.Error())
+		return
+	}
+	dest, err := filepath.Abs(req.DestDir)
+	if err == nil {
+		err = os.MkdirAll(dest, 0o755)
+	}
+	if err != nil {
+		respondError(c, http.StatusBadRequest, "BAD_DEST", "下载目录不可用", err.Error())
+		return
+	}
+	path, code, err := downloadAttachment(context.Background(), req, dest, s.xiaohongshuService.openHeadedBrowser)
+	if h := asHold(err); h != nil {
+		respondHold(c, h)
+		return
+	}
+	if r := xiaohongshu.AsRisk(err); r != nil {
+		s.respondRisk(c, r)
+		return
+	}
+	if err != nil {
+		status := map[string]int{"NO_DOWNLOAD_BUTTON": http.StatusBadGateway, "DOWNLOAD_TIMEOUT": http.StatusGatewayTimeout}[code]
+		if status == 0 {
+			status, code = http.StatusInternalServerError, "DOWNLOAD_FAILED"
+		}
+		respondError(c, status, code, "附件下载失败", err.Error())
+		return
+	}
+	st, _ := os.Stat(path)
+	respondSuccess(c, map[string]any{"path": path, "bytes": st.Size()}, "ok")
+}
+
+// humanDwell 在页面上停 lo–hi 秒，中间慢慢滚几下，像人在看。
+func humanDwell(page *rod.Page, lo, hi int) {
+	total := time.Duration(lo+rand.Intn(hi-lo+1)) * time.Second
+	end := time.Now().Add(total)
+	for time.Now().Before(end) {
+		time.Sleep(time.Duration(1200+rand.Intn(2500)) * time.Millisecond)
+		_ = page.Mouse.Scroll(0, float64(120+rand.Intn(380)), 3+rand.Intn(5))
+	}
+}
+
+type noteFileRequest struct {
+	NoteID    string `json:"note_id" binding:"required"`
+	XsecToken string `json:"xsec_token"`
+}
+
+// relatedFileJS：登录态下 __INITIAL_STATE__ 里的对象是 Vue ref，要拆 value/_value 才看得到内容
+// （0917 以为『登录会藏掉附件』，多半就是没拆 ref）。state 读不到时再看页面上有没有附件卡片。
+const relatedFileJS = `(nid) => {
+  const un = (x) => { for (let i = 0; i < 4 && x && typeof x === "object" && ("_value" in x || "value" in x) && !("noteId" in x); i++) x = x._value ?? x.value; return x; };
+  const st = window.__INITIAL_STATE__ || {};
+  const map = un(un(st.note)?.noteDetailMap) || {};
+  const note = un(un(map[nid])?.note) || {};
+  const u = un(un(st.user)?.userInfo);
+  const rf = un(note.relatedFile) || null;
+  const card = Array.from(document.querySelectorAll("[class*=file], [class*=attach], [class*=doc]"))
+    .map(e => (e.innerText || "").trim()).find(t => /\.(pdf|docx?|xlsx?|pptx?|zip)\b/i.test(t)) || "";
+  const wall = location.pathname.startsWith("/login") || location.pathname.startsWith("/404");
+  return JSON.stringify({ hasNote: !!note.noteId, guest: !!(u && u.guest), wall, path: location.pathname,
+    relatedFile: rf ? { docId: String(rf.docId ?? ""), name: rf.name || "", bizExtra: rf.bizExtra || "" } : null,
+    cardText: card.slice(0, 200),
+    loginBtn: !!Array.from(document.querySelectorAll("button, div")).find(e => (e.innerText || "").trim() === "登录") });
+}`
+
+// noteRelatedFileHandler 用登录的号打开笔记页（像人一样看一会儿），读附件元数据。
+// 给游客被登录墙挡住的笔记用；一次只看一篇，由调用方控制节奏。
+func (s *AppServer) noteRelatedFileHandler(c *gin.Context) {
+	var req noteFileRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "请求参数错误", err.Error())
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	b, berr := s.xiaohongshuService.openHeadedBrowser()
+	if berr != nil {
+		s.respondServiceError(c, berr, http.StatusBadGateway, "NOTE_OPEN_FAILED", "笔记页打不开")
+		return
+	}
+	defer b.Close()
+	page := b.NewPage()
+	var out string
+	var risk *xiaohongshu.RiskError
+	err := rod.Try(func() {
+		u := fmt.Sprintf("%s/explore/%s?xsec_token=%s&xsec_source=pc_feed", xiaohongshu.SiteHost(),
+			url.PathEscape(req.NoteID), url.QueryEscape(req.XsecToken))
+		page.Context(ctx).Timeout(40 * time.Second).MustNavigate(u).MustWaitLoad()
+		if risk = xiaohongshu.RiskPage(page); risk != nil {
+			return
+		}
+		humanDwell(page, 5, 12)
+		if risk = xiaohongshu.RiskPage(page); risk != nil {
+			return
+		}
+		out = page.Context(ctx).MustEval(relatedFileJS, req.NoteID).Str()
+	})
+	if err != nil && risk == nil {
+		risk = xiaohongshu.RiskPage(page)
+	}
+	if risk != nil {
+		s.respondRisk(c, risk)
+		return
+	}
+	if err != nil {
+		respondError(c, http.StatusBadGateway, "NOTE_OPEN_FAILED", "笔记页打不开", err.Error())
+		return
+	}
+	// 登录号看笔记却是游客：调用方（attachments.py）照旧按 data.guest 停车，这里同时写熔断，后面的开页一律拦下
+	var probe struct {
+		Guest    bool `json:"guest"`
+		LoginBtn bool `json:"loginBtn"`
+	}
+	if json.Unmarshal([]byte(out), &probe) == nil && (probe.Guest || probe.LoginBtn) {
+		s.xiaohongshuService.tripRisk(xiaohongshu.RiskNotLoggedIn, "登录号补看：打开笔记是游客")
+	}
+	c.Data(http.StatusOK, "application/json; charset=utf-8", []byte(`{"success":true,"data":`+out+`}`))
+}
+
+// downloadAttachment 必须 headed：headless 下站点那个下载 POST 会挂住。
+// 实测要点（0925）：只认 xiaohongshu.com 的 /file 页；按钮刚渲染出来就点没反应，要等预览挂好。
+// 1001：每次导航后、点下载前都查风控；撞到就返回 *xiaohongshu.RiskError（code 为风控码），不再往下点。
+func downloadAttachment(parent context.Context, req attachmentRequest, dest string,
+	open func() (*browser.Browser, error)) (string, string, error) {
+	ctx, cancel := context.WithTimeout(parent, 3*time.Minute)
+	defer cancel()
+	before := map[string]bool{}
+	if es, err := os.ReadDir(dest); err == nil {
+		for _, e := range es {
+			before[e.Name()] = true
+		}
+	}
+	b, berr := open() // 拿到锁后再查一次熔断（*holdError）
+	if berr != nil {
+		return "", codeRiskHold, berr
+	}
+	defer b.Close()
+	page := b.NewPage()
+	var path, code string
+	var fail error
+	stopIfRisk := func() bool {
+		if r := xiaohongshu.RiskPage(page); r != nil {
+			code, fail = r.Code, r
+			return true
+		}
+		return false
+	}
+	err := rod.Try(func() {
+		_ = proto.BrowserSetDownloadBehavior{Behavior: proto.BrowserSetDownloadBehaviorBehaviorAllow,
+			DownloadPath: dest, EventsEnabled: true}.Call(page.Browser())
+		// 0927 像人：先打开笔记看一会儿、往下翻一翻，再去附件页（人是从笔记里点进附件的）
+		if req.NoteID != "" {
+			nu := fmt.Sprintf("%s/explore/%s?xsec_token=%s&xsec_source=pc_feed", xiaohongshu.SiteHost(),
+				url.PathEscape(req.NoteID), url.QueryEscape(req.XsecToken))
+			if page.Context(ctx).Timeout(30*time.Second).Navigate(nu) == nil {
+				if stopIfRisk() {
+					return
+				}
+				humanDwell(page, 6, 14)
+				if stopIfRisk() {
+					return
+				}
+			}
+		}
+		u := fmt.Sprintf("%s/file/%s?noteId=%s&fileName=%s&xsec_token=%s&xsec_source=note_detail_file",
+			xiaohongshu.SiteHost(), url.PathEscape(req.DocID), url.QueryEscape(req.NoteID),
+			url.QueryEscape(req.FileName), url.QueryEscape(req.XsecToken))
+		_ = page.Context(ctx).Timeout(30 * time.Second).Navigate(u)
+		if stopIfRisk() {
+			return
+		}
+		btn, err := page.Context(ctx).Timeout(45*time.Second).ElementR("button", `下载`)
+		if err != nil {
+			if stopIfRisk() {
+				return
+			}
+			st, _ := page.Eval(`() => { const u=window.__INITIAL_STATE__?.user?.userInfo; const x=u?.value??u?._value??u?._rawValue??u; return x?.guest===true ? "guest" : "" }`)
+			if st != nil && st.Value.String() == "guest" {
+				code, fail = xiaohongshu.RiskNotLoggedIn, &xiaohongshu.RiskError{Code: xiaohongshu.RiskNotLoggedIn, Detail: "附件页：读取服务的号是游客"}
+				return
+			}
+			code, fail = "NO_DOWNLOAD_BUTTON", fmt.Errorf("附件页没有出现下载按钮（文件可能已删除或无下载权限）")
+			return
+		}
+		time.Sleep(8 * time.Second)
+		var stopped bool
+		path, stopped = waitDownload(ctx, time.Second, stopIfRisk,
+			func() {
+				if b2, err := page.Timeout(10*time.Second).ElementR("button", `下载`); err == nil {
+					btn = b2
+				}
+				_ = btn.Timeout(10*time.Second).Click(proto.InputMouseButtonLeft, 1)
+			},
+			func() string {
+				es, _ := os.ReadDir(dest)
+				for _, e := range es {
+					n := e.Name()
+					if !before[n] && !e.IsDir() && !strings.HasSuffix(n, ".crdownload") && !strings.HasSuffix(n, ".tmp") {
+						if info, err := e.Info(); err == nil && info.Size() > 0 {
+							return filepath.Join(dest, n)
+						}
+					}
+				}
+				return ""
+			})
+		if stopped || path != "" {
+			return
+		}
+		if stopIfRisk() {
+			return
+		}
+		code, fail = "DOWNLOAD_TIMEOUT", fmt.Errorf("点了下载但 90 秒内没有文件落地")
+	})
+	if err != nil && fail == nil {
+		fail = err
+		stopIfRisk()
+	}
+	return path, code, fail
+}
+
+// downloadClickAt 第几个 tick 点（重点）一次「下载」：刚渲染出来的按钮常点了没反应（0925）。
+var downloadClickAt = map[int]bool{0: true, 20: true, 45: true}
+
+// waitDownload 点「下载」并等文件落地，最多 90 个 tick。1001：每次（重）点之前都先查风控，
+// 撞上就不点、返回 stopped=true。landed 返回落地文件路径（没有返回空串）。
+func waitDownload(ctx context.Context, tick time.Duration, risk func() bool, click func(), landed func() string) (path string, stopped bool) {
+	for i := 0; i < 90 && ctx.Err() == nil; i++ {
+		if downloadClickAt[i] {
+			if risk() {
+				return "", true
+			}
+			click()
+		}
+		if sleepCtx(ctx, tick) != nil {
+			break
+		}
+		if p := landed(); p != "" {
+			return p, false
+		}
+	}
+	return "", false
+}
+
+// loginWindowHandler 打开小红书官方登录窗口（有界面），由人在官方页面扫码——二维码、「扫码成功，
+// 请在手机上确认」等进度都是官方自己的。程序只在同一页面上等登录态出现（不导航），成功后
+// 在读取用的域名上复核一次，然后关窗落盘。用户手动关窗 = 取消。
+//
+// 1001：拿浏览器锁最多等 windowLockWait，拿不到就 finish 为 failed；窗口里出错（panic）也 finish，
+// 状态不会永远停在 waiting。5 分钟扫码时限从拿到锁之后才开始算。成功 = 解除风控熔断。
+func (s *AppServer) loginWindowHandler(c *gin.Context) {
+	st := &s.xiaohongshuService.state
+	if code := st.busy(); code != "" {
+		respondError(c, http.StatusConflict, code, "已有登录或验证窗口在进行", nil)
+		return
+	}
+	timeout := 5 * time.Minute
+	parent, cancel := context.WithCancel(context.Background())
+	seq := s.xiaohongshuService.logins.start(cancel)
+	st.begin(seq, windowLockWait+timeout)
+	go func() {
+		defer cancel()
+		defer s.xiaohongshuService.logins.finish(seq)
+		result, user, errText := runLoginWindowFn(s, parent, seq, timeout)
+		if errText != "" {
+			logrus.Warnf("登录窗口 #%d: %s", seq, errText)
+		}
+		if result == "success" {
+			s.xiaohongshuService.clearRisk(fmt.Sprintf("登录窗口 #%d 登录成功", seq))
+		}
+		st.finish(seq, result, user, errText)
+		logrus.Infof("登录窗口 #%d 结束：%s", seq, result)
+	}()
+	respondSuccess(c, map[string]any{"opened": true, "timeout": timeout.String()}, "登录窗口已打开")
+}
+
+// runLoginWindowFn 测试里替换成桩（真窗口要人扫码）。
+var runLoginWindowFn = (*AppServer).runLoginWindow
+
+func (s *AppServer) runLoginWindow(parent context.Context, seq uint64, timeout time.Duration) (result string, user *xiaohongshu.CurrentUser, errText string) {
+	result = "timeout"
+	defer func() {
+		if r := recover(); r != nil {
+			result, user, errText = "failed", nil, fmt.Sprintf("登录窗口出错：%v", r)
+		}
+	}()
+	b, err := openWindowBrowser()
+	if err != nil {
+		return "failed", nil, fmt.Sprintf("读取服务正忙（别的操作占着浏览器超过 %s），稍后再点登录", windowLockWait)
+	}
+	defer b.Close()
+	// 扫码时限从拿到锁这一刻起算：expires_at 同步改成真实的截止时间，调用方按它等（别按固定秒数）
+	s.xiaohongshuService.state.restartClock(seq, timeout)
+	ctx, cancelT := context.WithTimeout(parent, timeout)
+	defer cancelT()
+	page := b.NewPage()
+	host := xiaohongshu.LoginHost()
+	err = rod.Try(func() {
+		_ = page.Timeout(30 * time.Second).Navigate(host + "/explore")
+		login := xiaohongshu.NewLogin(page)
+		// 已经登录：直接成功
+		if _, e := page.Timeout(8 * time.Second).Element(".login-container"); e != nil {
+			if ok, _ := login.CheckLoginStatus(ctx); ok {
+				result = "success"
+				user, _ = login.CurrentUser(ctx)
+				return
+			}
+			_ = rod.Try(func() {
+				page.Timeout(10*time.Second).MustElementR("button, div, span", `^\s*登录\s*$`).MustClick()
+			})
+		}
+		done := make(chan bool, 1)
+		go func() { done <- login.WaitForLogin(ctx) }()
+		for {
+			select {
+			case ok := <-done:
+				if !ok {
+					return
+				}
+				user, _ = login.CurrentUser(ctx)
+				// 会话落在哪个域名因号而异：逐个复核并记住（之后读取都用它）
+				if login.RememberSiteHost(ctx) == "" {
+					result, errText = "failed", "扫码成功但两个域名都没有确认到登录，请重试一次"
+					return
+				}
+				result = "success"
+				return
+			case <-time.After(2 * time.Second):
+				if _, e := page.Timeout(3 * time.Second).Eval(`() => 1`); e != nil {
+					result = "cancelled"
+					cancelT()
+					return
+				}
+			}
+		}
+	})
+	if err != nil && result == "timeout" && ctx.Err() == nil {
+		result, errText = "failed", err.Error()
+	}
+	b.Close() // 先落盘再报成功
+	return result, user, errText
+}
+
+// logoutHandler 清掉本地浏览器目录里的小红书登录（只动这个 profile，不影响手机 App 和别的浏览器）。
+func (s *AppServer) logoutHandler(c *gin.Context) {
+	b := newBrowser()
+	defer b.Close()
+	page := b.NewPage()
+	err := rod.Try(func() {
+		res, err := proto.StorageGetCookies{}.Call(page.Browser())
+		if err != nil {
+			panic(err)
+		}
+		for _, ck := range res.Cookies {
+			d := strings.ToLower(ck.Domain)
+			if strings.Contains(d, "xiaohongshu.com") || strings.Contains(d, "rednote.com") {
+				_ = proto.NetworkDeleteCookies{Name: ck.Name, Domain: ck.Domain, Path: ck.Path}.Call(page)
+			}
+		}
+	})
+	if err != nil {
+		respondError(c, http.StatusInternalServerError, "LOGOUT_FAILED", "退出登录失败", err.Error())
+		return
+	}
+	s.xiaohongshuService.state.observe(false)
+	s.xiaohongshuService.state.set(func(l *loginState) { l.user = nil; l.state = "idle" })
+	respondSuccess(c, map[string]any{"logged_out": true}, "已退出登录")
+}
