+// TestLoadFloorsExpandsEveryFrontFloor 前 10 楼每楼的回复都点到底，包括「展开 120 条回复」（旧逻辑按阈值 100 跳过）
+// 和要连点多次的楼（旧逻辑只点一次）；首屏已有 10 楼时不滚动。
+func TestLoadFloorsExpandsEveryFrontFloor(t *testing.T) {
+	shown := []int{0, 3, 25, 120, 1, 0, 49, 10, 2, 11, 500, 7}
+	fc := newFake(10, floors(len(shown), func(i int) *fakeFloor {
+		return &fakeFloor{id: id(i), shown: shown[i], loaded: min(1, shown[i]), perClick: 10}
+	})...)
+	res, r := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), fc.ops(10))
+	require.Nil(t, r)
+	assert.Equal(t, CommentStopFloorLimit, res.Reason)
+	assert.False(t, res.Partial)
+	assert.Empty(t, res.RepliesPartial)
+	assert.Equal(t, 10, res.FloorsExpanded)
+	assert.Equal(t, 10, res.FloorsLoaded)
+	assert.Equal(t, 0, fc.scrolls, "首屏已够 10 楼就不再滚（不多打接口）")
+	for i := 0; i < 10; i++ {
+		assert.Equal(t, shown[i], fc.floors[i].loaded, "第 %d 楼", i+1)
+	}
+	assert.Equal(t, 12, fc.clicks[id(3)], "120 条回复的楼要连点 12 次")
+	assert.Equal(t, 0, fc.clicks[id(10)], "上限外的楼不点")
+	require.NotNil(t, res.TotalShown)
+	assert.Equal(t, 999, *res.TotalShown)
+}
