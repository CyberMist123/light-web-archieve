@@ -0,0 +1,119 @@
+package xiaohongshu
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// r03 问题 1：真机「shown=9 loaded=9 has_more=true reason=no_button」——状态里 subCommentHasMore 陈旧为 true，
+// 但回复已全部加载、楼里也没有按钮：算展开到底，不进 replies_partial、不算 partial、不空等按钮。
+func TestLoadFloorsStaleHasMoreCountsAsExpanded(t *testing.T) {
+	fc := newFake(2, &fakeFloor{id: "a", shown: 9, loaded: 9, hasMore: 1, noButton: true},
+		&fakeFloor{id: "b", shown: 3, loaded: 1, perClick: 10})
+	diag := 0
+	ops := fc.ops(10)
+	ops.diagnose = func(floorInfo) string { diag++; return "楼里没有展开按钮" }
+	res, r := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), ops)
+	require.Nil(t, r)
+	assert.Equal(t, CommentStopEnd, res.Reason)
+	assert.False(t, res.Partial)
+	assert.Empty(t, res.RepliesPartial)
+	assert.Equal(t, 0, res.RepliesMissing)
+	assert.Equal(t, 2, res.FloorsExpanded, "陈旧 hasMore 的楼也算展开到底")
+	assert.Equal(t, 0, diag, "不该当成 no_button 去诊断")
+	assert.Equal(t, 3, fc.floors[1].loaded)
+}
+
+// 缺口为 0 的楼永远不作为 gap 出现：预算 0 时有按钮但已加载 ≥ 显示的楼不列；真缺口照报。
+func TestLoadFloorsZeroMissingNeverAGap(t *testing.T) {
+	fc := newFake(3, &fakeFloor{id: "a", shown: 4, loaded: 4, hasMore: 1},
+		&fakeFloor{id: "b", shown: 6, loaded: 1, perClick: 10}, &fakeFloor{id: "c", shown: 0})
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, 0), fc.ops(10))
+	assert.Equal(t, CommentStopBudget, res.Reason)
+	assert.True(t, res.Partial)
+	require.Len(t, res.RepliesPartial, 1)
+	assert.Equal(t, "b", res.RepliesPartial[0].CommentID)
+	assert.Equal(t, ReplyGapNotReached, res.RepliesPartial[0].Reason)
+	assert.Equal(t, 5, res.RepliesMissing)
+	assert.Equal(t, 1, res.FloorsExpanded)
+}
+
+// r03 问题 2：expand_floors 只展开指定楼；滚到要的楼都出来（这里有一个不存在 → 滚到底），
+// 其它楼不点不列；找不到的进 floors_not_found；到底时 partial 只看要的楼。
+func TestLoadFloorsExpandFloorsOnlyTargets(t *testing.T) {
+	fc := newFake(10, floors(30, func(i int) *fakeFloor { return &fakeFloor{id: id(i), shown: 5, loaded: 1, perClick: 10} })...)
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.ExpandFloors = []string{id(3), id(25), "nope"}
+	res, r := loadFloors(context.Background(), cfg, fc.ops(1000))
+	require.Nil(t, r)
+	assert.Equal(t, CommentStopEnd, res.Reason)
+	assert.Equal(t, []string{"nope"}, res.FloorsNotFound)
+	assert.False(t, res.Partial)
+	assert.Empty(t, res.RepliesPartial, "其它楼不列（不算缺口）")
+	assert.Equal(t, 0, res.RepliesMissing)
+	assert.Equal(t, 2, res.FloorsExpanded)
+	assert.Equal(t, 30, res.FloorsLoaded)
+	assert.Equal(t, 5, fc.floors[3].loaded)
+	assert.Equal(t, 5, fc.floors[25].loaded, "楼层上限外的目标楼也展开")
+	assert.Equal(t, 1, fc.floors[0].loaded, "非目标楼不点")
+	assert.Len(t, fc.clicks, 2)
+}
+
+// 要的楼都找到就收工（不看楼层上限、不滚到底）。
+func TestLoadFloorsExpandFloorsStopsWhenAllFound(t *testing.T) {
+	fc := newFake(10, floors(50, func(i int) *fakeFloor { return &fakeFloor{id: id(i), shown: 5, loaded: 1, perClick: 10} })...)
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.ExpandFloors = []string{id(15)}
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(1000))
+	assert.Equal(t, CommentStopFloorLimit, res.Reason)
+	assert.Equal(t, 1, fc.scrolls)
+	assert.Nil(t, res.FloorsNotFound)
+	assert.False(t, res.Partial)
+	assert.Equal(t, 1, res.FloorsExpanded)
+	assert.Equal(t, 5, fc.floors[15].loaded)
+}
+
+// 超长楼续读预算用完：只报要的楼（not_reached，缺多少如实），其它有缺口的楼不进 replies_partial / replies_missing。
+func TestLoadFloorsExpandFloorsBudgetPartial(t *testing.T) {
+	fc := newFake(3, &fakeFloor{id: "a", shown: 50, loaded: 1, perClick: 10},
+		&fakeFloor{id: "big", shown: 1153, loaded: 30, perClick: 1}, &fakeFloor{id: "c", shown: 40, loaded: 1, perClick: 10})
+	cfg := fastFloorCfg(10, 60*time.Millisecond)
+	cfg.ExpandFloors = []string{"big"}
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(10))
+	assert.Equal(t, CommentStopBudget, res.Reason)
+	assert.True(t, res.Partial)
+	require.Len(t, res.RepliesPartial, 1)
+	g := res.RepliesPartial[0]
+	assert.Equal(t, "big", g.CommentID)
+	assert.Equal(t, 2, g.Floor)
+	assert.Equal(t, ReplyGapNotReached, g.Reason)
+	assert.Equal(t, 1153-g.Loaded, res.RepliesMissing)
+	assert.Greater(t, g.Loaded, 30)
+	assert.Equal(t, 0, fc.clicks["a"])
+	assert.Equal(t, 0, fc.clicks["c"])
+}
+
+// expand_floors 归一化：去空白、去空串、去重；全空 = nil（现行为）。
+func TestNormalizeExpandFloors(t *testing.T) {
+	c := CommentLoadConfig{ExpandFloors: []string{" x ", "", "y", "x"}}.normalize()
+	assert.Equal(t, []string{"x", "y"}, c.ExpandFloors)
+	assert.Nil(t, CommentLoadConfig{ExpandFloors: []string{" ", ""}}.normalize().ExpandFloors)
+}
+
+// floors_not_found 只在传了 expand_floors 且有没找到的时出现；老调用方的响应不多这个键。
+func TestCommentLoadFloorsNotFoundJSON(t *testing.T) {
+	fc := newFake(2, &fakeFloor{id: "a"}, &fakeFloor{id: "b"})
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), fc.ops(10))
+	raw, _ := json.Marshal(res)
+	assert.NotContains(t, string(raw), "floors_not_found")
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.ExpandFloors = []string{"zz"}
+	res, _ = loadFloors(context.Background(), cfg, fc.ops(10))
+	raw, _ = json.Marshal(res)
+	assert.Contains(t, string(raw), `"floors_not_found":["zz"]`)
+}
diff --git a/xiaohongshu/comment_floors_test.go b/xiaohongshu/comment_floors_test.go
new file mode 100644
index 0000000..05b938d
--- /dev/null
+++ b/xiaohongshu/comment_floors_test.go
@@ -0,0 +1,423 @@
+package xiaohongshu
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// fakeFloor 假楼：shown = 楼上显示的回复数，loaded = 已加载，perClick = 点一次加载几条（0 = 点了不涨）。
+type fakeFloor struct {
+	id       string
+	shown    int
+	loaded   int
+	perClick int
+	noButton bool // 页面说还有，但没有按钮
+	hasMore  int  // 覆盖 hasMore（0 = 按 loaded<shown 算）
+	failNext int  // 接下来这么多次点击「点不动」
+	failAll  bool // 一直点不动
+}
+
+// fakeComments 假评论区：floors 是全部楼，visible 是已加载楼数，scroll 一次多加载 pageSize 楼（canScroll=false 时滚不动）。
+type fakeComments struct {
+	floors    []*fakeFloor
+	visible   int
+	pageSize  int
+	canScroll bool
+	clicks    map[string]int
+	scrolls   int
+	noState   bool
+	order     []string // 点中的楼序列
+	blocked   bool     // 全局点不动（模拟限频），由测试切换
+}
+
+func newFake(visible int, floors ...*fakeFloor) *fakeComments {
+	return &fakeComments{floors: floors, visible: visible, pageSize: 10, canScroll: true, clicks: map[string]int{}}
+}
+
+func (fc *fakeComments) probe(limit int) floorSnapshot {
+	if fc.noState {
+		return floorSnapshot{}
+	}
+	s := floorSnapshot{OK: true, Loaded: fc.visible, Total: 999, HasMore: 0}
+	if fc.visible < len(fc.floors) {
+		s.HasMore = 1
+	}
+	for i := 0; i < fc.visible && i < limit; i++ {
+		f := fc.floors[i]
+		hm := 0
+		if f.loaded < f.shown {
+			hm = 1
+		}
+		if f.hasMore != 0 {
+			hm = f.hasMore
+		}
+		s.Floors = append(s.Floors, floorInfo{Index: i, ID: f.id, Shown: f.shown, Loaded: f.loaded, HasMore: hm,
+			Button: hm == 1 && !f.noButton})
+	}
+	return s
+}
+
+func (fc *fakeComments) expand(fl floorInfo) clickResult {
+	for _, f := range fc.floors {
+		if f.id == fl.ID {
+			if fc.blocked || f.failAll || f.failNext > 0 {
+				if f.failNext > 0 {
+					f.failNext--
+				}
+				return clickResult{Detail: "context deadline exceeded"}
+			}
+			fc.clicks[f.id]++
+			fc.order = append(fc.order, f.id)
+			f.loaded += f.perClick
+			if f.loaded > f.shown {
+				f.loaded = f.shown
+			}
+			return clickResult{OK: true}
+		}
+	}
+	return clickResult{Detail: "找不到这楼的 DOM"}
+}
+
+func (fc *fakeComments) scroll(int) {
+	fc.scrolls++
+	if fc.canScroll {
+		fc.visible += fc.pageSize
+		if fc.visible > len(fc.floors) {
+			fc.visible = len(fc.floors)
+		}
+	}
+}
+
+func (fc *fakeComments) ops(limit int) floorOps {
+	return floorOps{probe: func() floorSnapshot { return fc.probe(limit) }, expand: fc.expand, scroll: fc.scroll, risk: noRisk}
+}
+
+func fastFloorCfg(limit int, budget time.Duration) floorLoadCfg {
+	cfg := defaultFloorLoadCfg(limit, true, budget, 0)
+	cfg.GrowWait, cfg.Poll = 30*time.Millisecond, time.Millisecond
+	cfg.Backoff = []time.Duration{time.Millisecond, time.Millisecond, time.Millisecond}
+	cfg.ThrottlePause = func() time.Duration { return time.Millisecond }
+	cfg.ScrollSettle = []time.Duration{20 * time.Millisecond, 20 * time.Millisecond}
+	cfg.Tick = func(int) time.Duration { return time.Millisecond }
+	return cfg
+}
+
+func floors(n int, mk func(i int) *fakeFloor) []*fakeFloor {
+	out := make([]*fakeFloor, n)
+	for i := range out {
+		out[i] = mk(i)
+	}
+	return out
+}
+
+func id(i int) string { return string(rune('a'+i/26)) + string(rune('a'+i%26)) }
