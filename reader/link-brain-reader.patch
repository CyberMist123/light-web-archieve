+// TestCommentLoadJSONContract 响应字段名是给 Python 的契约：data.comment_load 下这些键一个都不能改名。
+func TestCommentLoadJSONContract(t *testing.T) {
+	fc := newFake(2, &fakeFloor{id: "a", shown: 9, loaded: 6, hasMore: -1}, &fakeFloor{id: "b"})
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), fc.ops(10))
+	raw, err := json.Marshal(FeedDetailResponse{CommentLoad: &res})
+	require.NoError(t, err)
+	var got map[string]map[string]any
+	require.NoError(t, json.Unmarshal(raw, &got))
+	cl := got["comment_load"]
+	for _, k := range []string{"floor_limit", "floors_loaded", "floors_expanded", "comments_total_shown", "comments_has_more",
+		"replies_partial", "replies_missing", "partial", "stop_reason", "clicks", "scrolls", "seconds", "budget_seconds",
+		"replies_per_floor_cap", "click_fails", "dom_clicks", "throttle_pauses"} {
+		assert.Contains(t, cl, k)
+	}
+	gap := cl["replies_partial"].([]any)[0].(map[string]any)
+	for _, k := range []string{"floor", "comment_id", "shown", "loaded", "missing", "has_more", "clicks", "reason", "detail"} {
+		assert.Contains(t, gap, k)
+	}
+	raw, _ = json.Marshal(FeedDetailResponse{})
+	assert.NotContains(t, string(raw), "comment_load", "没加载评论时不带这个键")
+}
