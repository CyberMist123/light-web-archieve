+// TestPruneEvidenceKeeps14Days 只删超过 14 天、且是本模块起名的目录；别的文件 / 目录一概不碰。
+func TestPruneEvidenceKeeps14Days(t *testing.T) {
+	root := t.TempDir()
+	now := time.Date(2026, 10, 8, 12, 0, 0, 0, time.Local)
+	mk := func(name string) {
+		require.NoError(t, os.MkdirAll(filepath.Join(root, name), 0o700))
+		require.NoError(t, os.WriteFile(filepath.Join(root, name, "meta.json"), []byte("{}"), 0o600))
+	}
+	mk("20260920-040145")   // 18 天前：删
+	mk("20260923-235959-2") // 14 天多一点：删
+	mk("20260925-040145")   // 13 天前：留
+	mk("20261008-051957")   // 今天：留
+	mk("my-notes")          // 不是本模块的：不碰
+	require.NoError(t, os.WriteFile(filepath.Join(root, "20200101-000000.txt"), nil, 0o600))
+
+	assert.Equal(t, 2, PruneEvidence(root, EvidenceKeep, now))
+	left, _ := os.ReadDir(root)
+	var names []string
+	for _, e := range left {
+		names = append(names, e.Name())
+	}
+	assert.ElementsMatch(t, []string{"20260925-040145", "20261008-051957", "my-notes", "20200101-000000.txt"}, names)
