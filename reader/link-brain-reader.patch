+const (
+	// favScrollRiskEvery 滚收藏时每隔几轮查一次风控（每次滚动都会触发一次收藏接口）。
+	favScrollRiskEvery = 4
+	// favScrollBudget 一次全量滚动最多这么久。10-02 读满 1159 条约 3 分钟（1.3 秒一滚）；放慢到平均 ~2.5 秒一滚后
+	// 10-04 真号实测 1120 条用满 300 秒（每滚约 10 条、平均 2.7 秒一滚）还差 40 条，所以放到 420 秒；估计 5–6 分钟，再加几级换滚法的等待。上层：linkbrain_api.go 读收藏 ctx = favRequestTimeout（10 分钟），
+	// Python 客户端超时 780 秒（启动 ≤90 + 10 分钟 + 关浏览器 ≤30），都比它长。
+	favScrollBudget = 420 * time.Second
+	// favExtractReserve 滚动必须在 ctx 截止前这么久收手，给提取 + 风控复查 + 关页留时间。
+	favExtractReserve = 45 * time.Second
+	favExpectRatio    = 0.95
