+// TestVerifyTargetOpensIncidentPage 1008（B3）：验证窗口开出事的那一页，但去掉 tab / subTab（不让页面自己去读收藏）；
+// 安全跳转页、外站、没记 url 的走老路（首页 → 侧栏「我」）。tab=fav 才提示她自己点「收藏」。
+func TestVerifyTargetOpensIncidentPage(t *testing.T) {
+	t.Setenv("XHS_HOST", "")
+	cases := []struct {
+		hold     riskHold
+		want     string
+		wantHint bool
+	}{
+		{riskHold{URL: "https://www.xiaohongshu.com/user/profile/u1?tab=fav&subTab=note&xsec_token=t", Tab: "fav"},
+			"https://www.xiaohongshu.com/user/profile/u1?xsec_token=t", true},
+		{riskHold{URL: "https://www.rednote.com/user/profile/u1", Tab: "note"}, "https://www.rednote.com/user/profile/u1", false},
+		{riskHold{URL: "https://www.xiaohongshu.com/explore/n1?xsec_token=t#c"}, "https://www.xiaohongshu.com/explore/n1?xsec_token=t", false},
+		{riskHold{URL: "https://www.xiaohongshu.com/website-login/captcha?redirectPath=x", Tab: "fav"}, "", true},
+		{riskHold{URL: "https://evil.example.com/user/profile/u1", Tab: "fav"}, "", true},
+		{riskHold{URL: "javascript:alert(1)"}, "", false},
+		{riskHold{}, "", false},
+		// 审查：页签没点动接着弹验证——activeTab 还是 note，但程序要去收藏（want_tab=fav）：照样提示她点「收藏」
+		{riskHold{URL: "https://www.xiaohongshu.com/user/profile/u1?xsec_token=t", Tab: "note", WantTab: "fav"},
+			"https://www.xiaohongshu.com/user/profile/u1?xsec_token=t", true},
+		// 要提示点收藏、出事页面却不是主页（还在 /explore）：走老路落到她的主页，她才有「收藏」可点
+		{riskHold{URL: "https://www.xiaohongshu.com/explore?channel_id=x", WantTab: "fav"}, "", true},
+	}
+	for _, c := range cases {
