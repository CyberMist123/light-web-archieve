@@ -0,0 +1,259 @@
+package main
+
+import (
+	"context"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+// 1001 审查修复的测试。仍然一个浏览器都不开：browser.StubLaunchForTest 把「持锁后启动」换成计数桩
+// （计数、放锁、panic），拦截失效时测试看到的是 500 + 计数 1，而不是真的拉起浏览器。
+
+// queuedApp 起服务但不占锁；返回释放函数可控的占锁、启动计数。
+func queuedApp(t *testing.T) (*AppServer, string, *atomic.Int32) {
+	t.Helper()
+	dir := t.TempDir()
+	t.Setenv("XHS_PROFILE_DIR", dir)
+	var launched atomic.Int32
+	restore := browser.StubLaunchForTest(func() { launched.Add(1) })
+	t.Cleanup(restore)
+	return NewAppServer(NewXiaohongshuService()), dir, &launched
+}
+
+type httpResult struct {
+	code int
+	out  map[string]any
+}
+
+// TestQueuedRequestRechecksHoldAfterLock 审查 should-fix：请求过了入口的熔断检查、排在浏览器锁后面时，
+// 前一个请求撞了风控。拿到锁后必须再查：回 423 RISK_HOLD，不开浏览器。
+func TestQueuedRequestRechecksHoldAfterLock(t *testing.T) {
+	for _, ep := range []struct{ method, path, body string }{
+		{"GET", "/api/v1/favorites", ""},
+		{"GET", "/api/v1/login/status", ""},
+		{"POST", "/api/v1/attachments/download", `{"doc_id":"d","note_id":"n","dest_dir":"DEST"}`},
+		{"POST", "/api/v1/notes/related-file", `{"note_id":"n"}`},
+		{"POST", "/api/v1/feeds/detail", `{"feed_id":"f","xsec_token":"t"}`},
+	} {
+		t.Run(ep.path, func(t *testing.T) {
+			app, dir, launched := queuedApp(t)
+			router := setupRoutes(app)
+			body := ep.body
+			if body != "" {
+				body = strings.ReplaceAll(body, "DEST", filepath.ToSlash(filepath.Join(dir, "dl")))
+			}
+			release, ok := browser.Occupy("previous-request", 5*time.Second)
+			require.True(t, ok)
+			done := make(chan httpResult, 1)
+			go func() {
+				code, out := doJSON(t, router, ep.method, ep.path, body)
+				done <- httpResult{code, out}
+			}()
+			time.Sleep(300 * time.Millisecond)
+			select {
+			case r := <-done:
+				t.Fatalf("锁被占着时请求不应返回：%d %v", r.code, r.out)
+			default:
+			}
+			// 占着锁的那个请求撞了验证码
+			app.xiaohongshuService.tripRisk(xiaohongshu.RiskCaptcha, "前一个请求撞了验证码")
+			release()
+			var r httpResult
+			select {
+			case r = <-done:
+			case <-time.After(10 * time.Second):
+				t.Fatal("放锁后请求没有返回")
+			}
+			assert.Equal(t, http.StatusLocked, r.code, "%v", r.out)
+			assert.Equal(t, "RISK_HOLD", r.out["code"])
+			hold, _ := r.out["hold"].(map[string]any)
+			require.NotNil(t, hold)
+			assert.Equal(t, "CAPTCHA_REQUIRED", hold["code"])
+			assert.Equal(t, int32(0), launched.Load(), "排队期间熔断了就不能再开浏览器")
+			assert.Nil(t, browser.CurrentLock(), "拒绝后锁要放掉")
+		})
+	}
+}
+
+// TestQueuedRequestLaunchesWhenNoHold 对照组：同样排队、但没熔断时确实会走到启动（桩计数 1、回 500），
+// 证明上面那个测试看到的 423 来自拿锁后的复查，而不是请求根本没走到开浏览器。
+func TestQueuedRequestLaunchesWhenNoHold(t *testing.T) {
+	app, _, launched := queuedApp(t)
+	router := setupRoutes(app)
+	release, ok := browser.Occupy("previous-request", 5*time.Second)
+	require.True(t, ok)
+	done := make(chan int, 1)
+	go func() { code, _ := doJSON(t, router, "GET", "/api/v1/favorites", ""); done <- code }()
+	time.Sleep(200 * time.Millisecond)
+	release()
+	assert.Equal(t, http.StatusInternalServerError, <-done)
+	assert.Equal(t, int32(1), launched.Load())
+	assert.Nil(t, browser.CurrentLock())
+}
+
+// TestMCPFeedDetailRechecksHoldAfterLock 入库主路（MCP get_feed_detail → service）同样在拿锁后复查，
+// 报错文本带 "[RISK_HOLD]"（Python looks_blocked 靠它认）。
+func TestMCPFeedDetailRechecksHoldAfterLock(t *testing.T) {
+	app, _, launched := queuedApp(t)
+	release, ok := browser.Occupy("previous-request", 5*time.Second)
+	require.True(t, ok)
+	done := make(chan *MCPToolResult, 1)
+	go func() {
+		done <- app.handleGetFeedDetail(context.Background(), map[string]any{"feed_id": "f", "xsec_token": "t"})
+	}()
+	time.Sleep(300 * time.Millisecond)
+	app.xiaohongshuService.tripRisk(xiaohongshu.RiskAccount, "跳到 /website-login/error")
+	release()
+	res := <-done
+	require.True(t, res.IsError)
+	assert.Contains(t, res.Content[0].Text, "[RISK_HOLD]")
+	assert.Equal(t, int32(0), launched.Load())
+}
+
+// ---- 验证窗口：只按关窗前最后一次有效读数解熔断（审查 should-fix） ----
+
+func verifyRun(alive []bool, readings []verifyReading) (verifyReading, bool) {
+	i, j := 0, 0
+	return watchVerifyWindow(time.Now().Add(time.Minute), time.Millisecond,
+		func() bool {
+			if i >= len(alive) {
+				return false
+			}
+			i++
+			return alive[i-1]
+		},
+		func() verifyReading {
+			if j >= len(readings) {
+				return verifyReading{}
+			}
+			j++
+			return readings[j-1]
+		})
+}
+
+func TestVerifyWindowDecision(t *testing.T) {
+	captcha := &xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}
+	clean := verifyReading{ok: true, loggedIn: true}
+	stillCaptcha := verifyReading{ok: true, risk: captcha, loggedIn: true}
+	guest := verifyReading{ok: true}
+	unread := verifyReading{ok: false}
+
+	cases := []struct {
+		name     string
+		hold     string
+		alive    []bool
+		readings []verifyReading
+		wantHeld bool
+	}{
+		{"关窗时验证码还在", xiaohongshu.RiskCaptcha, []bool{true, true, false}, []verifyReading{clean, stillCaptcha}, true},
+		{"一打开就关（一次都没读到）", xiaohongshu.RiskCaptcha, []bool{false}, nil, true},
+		{"验证过了再关", xiaohongshu.RiskCaptcha, []bool{true, true, false}, []verifyReading{stillCaptcha, clean}, false},
+		{"最后一次没读到不作数，按上一次有效读数", xiaohongshu.RiskCaptcha, []bool{true, true, false}, []verifyReading{clean, unread}, false},
+		{"掉登录的熔断：开关验证窗口但没登录", xiaohongshu.RiskNotLoggedIn, []bool{true, false}, []verifyReading{guest}, true},
+		{"安全跳转的熔断：页面干净但不是登录用户", xiaohongshu.RiskAccount, []bool{true, false}, []verifyReading{guest}, true},
+		{"安全跳转的熔断：已登录且干净", xiaohongshu.RiskAccount, []bool{true, false}, []verifyReading{clean}, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			t.Setenv("XHS_PROFILE_DIR", t.TempDir())
+			svc := NewXiaohongshuService()
+			svc.tripRisk(c.hold, "test")
+			last, seen := verifyRun(c.alive, c.readings)
+			svc.finishVerify(last, seen)
+			assert.Equal(t, c.wantHeld, svc.hold.get() != nil)
+		})
+	}
+}
+
+// TestQrcodeShortcutClearsOnlyNotLoggedIn 扫码入口发现「已是登录态」只能解掉登录类熔断（审查 nit）。
+func TestQrcodeShortcutClearsOnlyNotLoggedIn(t *testing.T) {
+	for code, wantHeld := range map[string]bool{
+		xiaohongshu.RiskNotLoggedIn: false,
+		xiaohongshu.RiskCaptcha:     true,
+		xiaohongshu.RiskAccount:     true,
+	} {
+		t.Setenv("XHS_PROFILE_DIR", t.TempDir())
+		svc := NewXiaohongshuService()
+		svc.tripRisk(code, "test")
+		svc.clearRiskIf(xiaohongshu.RiskNotLoggedIn, "扫码入口复核：已是登录态")
+		assert.Equal(t, wantHeld, svc.hold.get() != nil, code)
+	}
+}
+
+// TestLoginWindowClockStartsAfterLock 扫码 5 分钟从拿到锁起算，expires_at 跟着改（审查 nit）。
+func TestLoginWindowClockStartsAfterLock(t *testing.T) {
+	var l loginState
+	l.begin(7, windowLockWait+5*time.Minute)
+	l.set(func(l *loginState) { l.expires = time.Now().Add(10 * time.Second) }) // 假装等锁用掉了大半
+	l.restartClock(7, 5*time.Minute)
+	l.mu.Lock()
+	exp := l.expires
+	l.mu.Unlock()
+	assert.WithinDuration(t, time.Now().Add(5*time.Minute), exp, 2*time.Second)
+	l.restartClock(6, time.Hour) // 旧一轮不许改
+	l.mu.Lock()
+	assert.WithinDuration(t, time.Now().Add(5*time.Minute), l.expires, 2*time.Second)
+	l.mu.Unlock()
+}
+
+// ---- 附件下载：每次（重）点「下载」之前都查风控（审查 should-fix） ----
+
+func TestWaitDownloadChecksRiskBeforeEveryClick(t *testing.T) {
+	old := downloadClickAt
+	downloadClickAt = map[int]bool{0: true, 2: true, 4: true}
+	t.Cleanup(func() { downloadClickAt = old })
+
+	var clicks, checks int
+	path, stopped := waitDownload(context.Background(), time.Millisecond,
+		func() bool { checks++; return checks == 2 }, // 第二次点之前页面弹了验证
+		func() { clicks++ },
+		func() string { return "" })
+	assert.True(t, stopped)
+	assert.Equal(t, "", path)
+	assert.Equal(t, 1, clicks, "撞到风控后不能再点")
+
+	clicks, checks = 0, 0
+	n := 0
+	path, stopped = waitDownload(context.Background(), time.Millisecond,
+		func() bool { checks++; return false },
+		func() { clicks++ },
+		func() string {
+			n++
+			if n == 3 {
+				return "f.pdf"
+			}
+			return ""
+		})
+	assert.False(t, stopped)
+	assert.Equal(t, "f.pdf", path)
+	assert.Equal(t, 2, clicks)
+	assert.Equal(t, 2, checks)
+}
+
+// TestFeedDetailDeadlineUnderWatchdog 详情总时限要短于锁看门狗（留出启动和关闭）。
+func TestFeedDetailDeadlineUnderWatchdog(t *testing.T) {
+	assert.Equal(t, 12*time.Minute, feedDetailDeadline(900*time.Second))
+	assert.Equal(t, 3*time.Minute, feedDetailDeadline(60*time.Second))
+	for _, max := range []time.Duration{600 * time.Second, 900 * time.Second, 1800 * time.Second} {
+		assert.Less(t, feedDetailDeadline(max)+90*time.Second+30*time.Second, max)
+	}
+}
+
+func TestMain(m *testing.M) {
+	// 保险：任何测试都不许读写真 profile。
+	if os.Getenv("XHS_PROFILE_DIR") == "" {
+		d, _ := os.MkdirTemp("", "lbr-test-profile-")
+		os.Setenv("XHS_PROFILE_DIR", d)
+	}
+	os.Exit(m.Run())
+}
diff --git a/risk_hold.go b/risk_hold.go
new file mode 100644
index 0000000..ea84ad1
--- /dev/null
+++ b/risk_hold.go
@@ -0,0 +1,276 @@
+package main
+
+// 风控熔断（1001）：撞到验证码 / 安全跳转页 / 需要登录却是游客之后，拒绝一切会开浏览器的请求，
+// 直到有人处理。状态落在 <XHS_PROFILE_DIR>/risk-hold.json，重启服务后仍生效。
+//
+// 解除只有三条路：登录窗口成功（已验证登录）、人工验证窗口完成（关窗前最后一次读数没有风控；
+// 掉登录 / 安全跳转类还要看到已登录）、POST /api/v1/risk/clear（外加远程扫码 /login/qrcode 扫码成功，
+// 它也是一次已验证的登录；取码时发现「已是登录态」只解 NOT_LOGGED_IN）。
+// 登录窗口、验证窗口、扫码、/login/session、/login/logout、/risk/clear 不受熔断拦截。
+//
+// 两道闸：请求进来时（riskGuard / mcpRiskMiddleware），以及拿到浏览器锁之后、启动之前
+// （XiaohongshuService.openBrowser → holdGuard）。后一道挡住「排在锁后面时前一个请求撞了风控」。
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+	"github.com/sirupsen/logrus"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+const codeRiskHold = "RISK_HOLD"
+
+type riskHold struct {
+	Code   string `json:"code"`
+	Since  string `json:"since"` // RFC3339
+	Detail string `json:"detail"`
+}
+
+type holdStore struct {
+	mu   sync.Mutex
+	path string
+	cur  *riskHold
+}
+
+func holdPath() string { return filepath.Join(browser.ProfileDir(), "risk-hold.json") }
+
+// loadHoldStore 读熔断文件。文件在但读不懂：按熔断处理（宁可停，也不在不明状态下开页）。
+func loadHoldStore(path string) *holdStore {
+	h := &holdStore{path: path}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return h
+	}
+	var r riskHold
+	if json.Unmarshal(data, &r) != nil || r.Code == "" {
+		r = riskHold{Code: xiaohongshu.RiskAccount, Since: time.Now().Format(time.RFC3339),
+			Detail: "risk-hold.json 读不懂，按熔断处理；确认账号没事后 POST /api/v1/risk/clear"}
+	}
+	h.cur = &r
+	logrus.Warnf("风控熔断仍在生效（自 %s）：%s %s", r.Since, r.Code, r.Detail)
+	return h
+}
+
+func (h *holdStore) get() *riskHold {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.cur == nil {
+		return nil
+	}
+	c := *h.cur
+	return &c
+}
+
+// trip 写熔断；已在熔断中则保留最早那次（since 不刷新）。
+func (h *holdStore) trip(code, detail string) *riskHold {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.cur != nil {
+		c := *h.cur
+		return &c
+	}
+	r := riskHold{Code: code, Since: time.Now().Format(time.RFC3339), Detail: detail}
+	h.cur = &r
+	if err := writeFileAtomic(h.path, r); err != nil {
+		logrus.Errorf("风控熔断写盘失败（内存里仍生效）：%v", err)
+	}
+	logrus.Errorf("风控熔断：%s %s —— 之后所有会开浏览器的请求一律拒绝，直到扫码登录/验证窗口/risk/clear", code, detail)
+	c := r
+	return &c
+}
+
+// clear 解除熔断；原来就没有返回 false。
+func (h *holdStore) clear(reason string) bool {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	had := h.cur != nil
+	h.cur = nil
+	if err := os.Remove(h.path); err != nil && !os.IsNotExist(err) {
+		logrus.Errorf("删除熔断文件失败（重启后会再次生效）：%v", err)
+	}
+	if had {
+		logrus.Infof("风控熔断已解除：%s", reason)
+	}
+	return had
+}
+
+func writeFileAtomic(path string, v any) error {
+	data, err := json.MarshalIndent(v, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, data, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, path)
+}
+
+// tripRisk 写熔断（验证码另记 captcha_at，兼容旧字段）。
+func (s *XiaohongshuService) tripRisk(code, detail string) *riskHold {
+	if code == xiaohongshu.RiskCaptcha {
+		s.state.set(func(l *loginState) { l.captcha = time.Now() })
+	}
+	return s.hold.trip(code, detail)
+}
+
+// noteRisk 错误若是风控类就写熔断，返回它；否则返回 nil。
+func (s *XiaohongshuService) noteRisk(err error) *xiaohongshu.RiskError {
+	r := xiaohongshu.AsRisk(err)
+	if r != nil {
+		s.tripRisk(r.Code, r.Detail)
+	}
+	return r
+}
+
+// clearRisk 解除熔断和验证码时间戳。
+func (s *XiaohongshuService) clearRisk(reason string) {
+	s.hold.clear(reason)
+	s.state.set(func(l *loginState) { l.captcha = time.Time{} })
+}
+
+// clearRiskIf 只在当前熔断码是 code 时解除（例如「已是登录态」只能解 NOT_LOGGED_IN）。
+func (s *XiaohongshuService) clearRiskIf(code, reason string) bool {
+	h := s.hold.get()
+	if h == nil || h.Code != code {
+		if h != nil {
+			logrus.Infof("%s，但熔断码是 %s，不由这里解除", reason, h.Code)
+		}
+		return false
+	}
+	s.clearRisk(reason)
+	return true
+}
+
+// holdError 拿到浏览器锁后发现已在熔断中（排队期间别的请求撞了风控）。Error() 以 "[RISK_HOLD]" 开头。
+type holdError struct{ hold *riskHold }
+
+func (e *holdError) Error() string { return holdText(e.hold) }
+
+// asHold 错误链里若是 holdError，返回熔断内容。
+func asHold(err error) *riskHold {
+	var h *holdError
+	if errors.As(err, &h) {
+		return h.hold
+	}
+	return nil
+}
+
+// holdGuard 给 browser.NewBrowserGuarded：拿到 profile 锁之后、启动浏览器之前再查一次熔断。
+func (s *XiaohongshuService) holdGuard() error {
+	if h := s.hold.get(); h != nil {
+		logrus.Warnf("拿到浏览器锁时已在风控熔断中（%s），不开浏览器", h.Code)
+		return &holdError{hold: h}
+	}
+	return nil
+}
+
+// respondServiceError 服务层报错统一出口：熔断 → 423 RISK_HOLD；风控 → respondRisk；其他按调用方给的码。
+func (s *AppServer) respondServiceError(c *gin.Context, err error, status int, code, msg string) {
+	if h := asHold(err); h != nil {
+		respondHold(c, h)
+		return
+	}
+	if r := xiaohongshu.AsRisk(err); r != nil {
+		s.respondRisk(c, r)
+		return
+	}
+	respondError(c, status, code, msg, err.Error())
+}
+
+// respondRisk 风控停车：写熔断，按码回 423 / 401。
+func (s *AppServer) respondRisk(c *gin.Context, r *xiaohongshu.RiskError) {
+	hold := s.xiaohongshuService.tripRisk(r.Code, r.Detail)
+	status, msg, hint := http.StatusLocked, "小红书把账号跳到了登录异常/安全页，已停止操作", "先在手机 App 看看账号状态，再扫码登录；期间不要反复重试"
+	switch r.Code {
+	case xiaohongshu.RiskCaptcha:
+		msg, hint = "小红书要求安全验证（拼图滑块），已停止操作", "打开验证窗口手动完成，或等几小时后再试；期间不要反复重试"
+	case xiaohongshu.RiskNotLoggedIn:
+		status, msg, hint = http.StatusUnauthorized, "小红书未登录或登录已失效", "扫码登录后再试"
+	}
+	logrus.Errorf("%s %s %d %s", c.Request.Method, c.Request.URL.Path, status, r.Code)
+	c.JSON(status, gin.H{"error": msg, "code": r.Code, "details": r.Detail + "；" + hint, "hold": hold})
+}
+
+func respondHold(c *gin.Context, h *riskHold) {
+	logrus.Warnf("%s %s 423 RISK_HOLD（%s）", c.Request.Method, c.Request.URL.Path, h.Code)
+	c.AbortWithStatusJSON(http.StatusLocked, gin.H{"error": "读取服务处于风控熔断中，已拒绝开浏览器", "code": codeRiskHold,
+		"details": "扫码登录、打开验证窗口完成，或确认没事后 POST /api/v1/risk/clear", "hold": h})
+}
+
+// holdExempt 熔断中仍放行的接口：它们要么不开浏览器，要么就是用来解除熔断的。
+var holdExempt = []string{"/login/session", "/login/window", "/verify/window", "/login/logout", "/risk/clear",
+	"/login/qrcode", "/login/cookies"}
+
+func (s *AppServer) riskGuard() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		p := c.Request.URL.Path
+		for _, e := range holdExempt {
+			if strings.HasSuffix(p, e) {
+				c.Next()
+				return
+			}
+		}
+		if h := s.xiaohongshuService.hold.get(); h != nil {
+			respondHold(c, h)
+			return
+		}
+		c.Next()
+	}
+}
+
+// mcpHoldExempt 熔断中仍放行的 MCP 工具（不开浏览器，或是登录本身）。
+var mcpHoldExempt = map[string]bool{"delete_cookies": true, "get_login_qrcode": true}
+
+func holdText(h *riskHold) string {
+	return fmt.Sprintf("[RISK_HOLD] 读取服务处于风控熔断中（%s，自 %s）：%s。已拒绝开浏览器；扫码登录、验证窗口完成或 POST /api/v1/risk/clear 之后再试",
+		h.Code, h.Since, h.Detail)
+}
+
+// mcpRiskMiddleware 熔断中拒绝 /mcp 的工具调用（入库主路 get_feed_detail 也走这里）。
+func (s *AppServer) mcpRiskMiddleware(next mcp.MethodHandler) mcp.MethodHandler {
+	return func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {
+		if method == "tools/call" {
+			if r, ok := req.(*mcp.CallToolRequest); ok && r.Params != nil && !mcpHoldExempt[r.Params.Name] {
+				if h := s.xiaohongshuService.hold.get(); h != nil {
+					logrus.Warnf("MCP %s 被熔断拒绝（%s）", r.Params.Name, h.Code)
+					return &mcp.CallToolResult{IsError: true, Content: []mcp.Content{&mcp.TextContent{Text: holdText(h)}}}, nil
+				}
+			}
+		}
+		return next(ctx, method, req)
+	}
+}
+
+// riskClearHandler POST /api/v1/risk/clear：人工确认没事后解除熔断。
+func (s *AppServer) riskClearHandler(c *gin.Context) {
+	cleared := s.xiaohongshuService.hold.get() != nil
+	s.xiaohongshuService.clearRisk("POST /api/v1/risk/clear")
+	respondSuccess(c, map[string]any{"cleared": cleared, "risk_hold": nil}, "熔断已解除")
+}
+
+// currentLock 读 profile 锁占用（只读内存，不碰锁本身；测试里可替换）。
+var currentLock = browser.CurrentLock
+
+// lockSnapshot /login/session 里的 lock 字段：{"owner","since","held_s"} 或 nil。
+func lockSnapshot(l *browser.LockInfo, now time.Time) any {
+	if l == nil {
+		return nil
+	}
+	return map[string]any{"owner": l.Owner, "since": l.Since.Format(time.RFC3339), "held_s": int(now.Sub(l.Since).Seconds())}
+}
diff --git a/risk_hold_test.go b/risk_hold_test.go
new file mode 100644
index 0000000..b56028d
--- /dev/null
+++ b/risk_hold_test.go
@@ -0,0 +1,431 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+// 这些测试全部不开浏览器：熔断拦截发生在处理函数之前；XHS_PROFILE_DIR 指到临时目录，
+// 真 profile 里的 risk-hold.json 一个字节都不碰。testApp 还先占住浏览器锁（guardOwner）：
+// 万一拦截失效，处理函数也只会排队卡住（测试超时失败），绝不会真拉起浏览器去开小红书。
+
+const guardOwner = "test-guard"
+
+func testApp(t *testing.T) (*AppServer, string) {
+	t.Helper()
+	dir := t.TempDir()
+	t.Setenv("XHS_PROFILE_DIR", dir)
+	release, ok := browser.Occupy(guardOwner, 5*time.Second)
+	require.True(t, ok)
+	t.Cleanup(release)
+	return NewAppServer(NewXiaohongshuService()), dir
+}
+
+func doJSON(t *testing.T, h http.Handler, method, path, body string) (int, map[string]any) {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	if body != "" {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, req)
+	out := map[string]any{}
+	_ = json.Unmarshal(w.Body.Bytes(), &out)
+	return w.Code, out
+}
+
+func TestHoldStorePersistsAcrossRestart(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "risk-hold.json")
+	h := loadHoldStore(path)
+	require.Nil(t, h.get())
+
+	first := h.trip(xiaohongshu.RiskAccount, "跳到 /website-login/error")
+	_, err := time.Parse(time.RFC3339, first.Since)
+	require.NoError(t, err, "since 必须是 RFC3339")
+	again := h.trip(xiaohongshu.RiskCaptcha, "later")
+	assert.Equal(t, first, again, "已在熔断中：保留最早那次")
+
+	var onDisk riskHold
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.NoError(t, json.Unmarshal(data, &onDisk))
+	assert.Equal(t, *first, onDisk)
+
+	reloaded := loadHoldStore(path) // 模拟重启服务
+	require.NotNil(t, reloaded.get())
+	assert.Equal(t, xiaohongshu.RiskAccount, reloaded.get().Code)
+
+	assert.True(t, reloaded.clear("test"))
+	assert.Nil(t, reloaded.get())
+	_, err = os.Stat(path)
+	assert.True(t, os.IsNotExist(err))
+	assert.False(t, reloaded.clear("again"))
+}
+
+func TestHoldStoreUnreadableFileFailsClosed(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "risk-hold.json")
+	require.NoError(t, os.WriteFile(path, []byte("{not json"), 0o600))
+	h := loadHoldStore(path)
+	require.NotNil(t, h.get(), "读不懂的熔断文件按熔断处理")
+}
+
+// TestRiskHoldBlocksBrowserEndpoints 熔断中所有会开浏览器的接口一律 423 RISK_HOLD，且不碰浏览器锁。
+func TestRiskHoldBlocksBrowserEndpoints(t *testing.T) {
+	app, _ := testApp(t)
+	router := setupRoutes(app)
+	app.xiaohongshuService.tripRisk(xiaohongshu.RiskCaptcha, "test")
+
+	for _, ep := range []struct{ method, path, body string }{
+		{"GET", "/api/v1/favorites", ""},
+		{"GET", "/api/v1/login/status", ""},
+		{"POST", "/api/v1/attachments/download", `{"doc_id":"d","note_id":"n","dest_dir":"x"}`},
+		{"POST", "/api/v1/notes/related-file", `{"note_id":"n"}`},
+		{"POST", "/api/v1/feeds/detail", `{"feed_id":"f","xsec_token":"t"}`},
+		{"GET", "/api/v1/user/me", ""},
+	} {
+		code, out := doJSON(t, router, ep.method, ep.path, ep.body)
+		assert.Equal(t, http.StatusLocked, code, ep.path)
+		assert.Equal(t, "RISK_HOLD", out["code"], ep.path)
+		hold, _ := out["hold"].(map[string]any)
+		require.NotNil(t, hold, ep.path)
+		assert.Equal(t, "CAPTCHA_REQUIRED", hold["code"])
+		assert.NotEmpty(t, hold["since"])
+		assert.Equal(t, "test", hold["detail"])
+	}
+	assert.Equal(t, guardOwner, browser.CurrentLock().Owner, "被熔断拦下的请求不能去拿浏览器锁")
+}
+
+// TestSessionReportsHoldAndLockWithoutBrowser /login/session 带出 risk_hold 与 lock，且熔断中照样放行。
+func TestSessionReportsHoldAndLockWithoutBrowser(t *testing.T) {
+	app, dir := testApp(t)
+	router := setupRoutes(app)
+
+	code, out := doJSON(t, router, "GET", "/api/v1/login/session", "")
+	require.Equal(t, http.StatusOK, code)
+	data := out["data"].(map[string]any)
+	assert.Contains(t, data, "risk_hold")
+	assert.Nil(t, data["risk_hold"])
+	// 锁正被占着（guard），session 照样秒回并报出占用者：它不拿锁、不开浏览器
+	lock0 := data["lock"].(map[string]any)
+	assert.Equal(t, guardOwner, lock0["owner"])
+
+	old := currentLock
+	since := time.Now().Add(-125 * time.Second)
+	currentLock = func() *browser.LockInfo {
