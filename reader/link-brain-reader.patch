+// 现象（真号日志）：「详情页关键容器未在 8s 内出现」→ 评论 0 楼 → 抽取时 `feed <id> not found in noteDetailMap`；
+// 页面上没有看得见的验证浮层（否则 RiskPage 早就按 CAPTCHA_REQUIRED 停车写熔断了），也不是错误容器（那是「笔记不可访问」）。
+// 这种笔记同时不在网页版的收藏列表里（fav-tokens.json 里没有它）。
+//
+// 判法（保守）：
+//   - 先照旧过 RiskPage：看得见的验证 / 安全跳转 → 风控（写熔断），看不见的验证组件 → HIDDEN_WIDGET（不熔断）。不放宽一点。
+//   - 再照旧过 checkPageAccessible（删除 / 仅作者可见等错误容器 → 「笔记不可访问」）。
+//   - 都不是、页面状态里又找不到这篇（noteDetailMap 没有这个 id）：
+//       · 页面上有登录框（PageLoginState=guest）→ NOT_LOGGED_IN（号的事，写熔断——和附件页 / 登录号补看同一口径）；
+//       · 落在 /login 一类的页面 → 不判（原样报「找不到」，交给原来的处理），宁可不认，也不把号的事说成这篇的事；
+//       · 其余 → NOTE_RESTRICTED：只是这一篇，不写熔断。落一份证据（截图 + 页面片段，只在本机）方便真机看这页到底长什么样。
+//
+// 报错文本以 "[NOTE_RESTRICTED]" 开头，故意不带「安全验证 / 验证码 / 滑块 / 登录」这些字：Python 的 looks_blocked 按这些字
+// 把报错当成「号出事」（整批停车、要人处理）。
+
+import (
+	"context"
+	"encoding/json"
+	stderrors "errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/sirupsen/logrus"
+)
+
+// NoteRestrictedCode 只是这一篇打不开（网页版要人工验证才给看），不是号出事。
+const NoteRestrictedCode = "NOTE_RESTRICTED"
+
+// NoteRestrictedText 给她看的话（HTTP 响应的 error 字段）。
+const NoteRestrictedText = "这篇在小红书网页版要验证才能看"
+
+// EvidenceRestricted 证据触发名：详情页没渲染出这篇笔记（不是风控，只为真机核对页面长什么样）。
+const EvidenceRestricted = "note_restricted"
+
+// ErrNoteNotInState 页面状态（__INITIAL_STATE__.note.noteDetailMap）里没有这篇。extractFeedDetail 的报错包着它。
+var ErrNoteNotInState = stderrors.New("页面状态里没有这篇笔记")
+
+// NoteRestrictedError 这一篇在网页版被限制（停本次，不写熔断）。
+type NoteRestrictedError struct {
+	NoteID   string
+	Path     string // 页面停在哪（location.pathname）
+	Evidence string // 证据目录（只在本机）
+}
+
+func (e *NoteRestrictedError) Error() string {
+	path := e.Path
+	if path == "" {
+		path = "?"
+	}
+	return fmt.Sprintf("[%s] 详情页没渲染出这篇笔记（页面状态里找不到 %s，页面停在 %s）：网页版限制了这篇，要人工打开看一眼",
+		NoteRestrictedCode, e.NoteID, path)
+}
+
+// AsNoteRestricted 从错误链里取出 NoteRestrictedError；不是返回 nil。
+func AsNoteRestricted(err error) *NoteRestrictedError {
+	var r *NoteRestrictedError
+	if stderrors.As(err, &r) {
+		return r
+	}
+	return nil
+}
+
+// noteStateJS 读一次页面：这篇在不在页面状态里、页面停在哪、是不是游客。只读，不点、不滚。
+// 登录态下 __INITIAL_STATE__ 里的对象可能是 Vue ref，要拆 value/_value（同 relatedFileJS）。
+const noteStateJS = `(id) => {
+  const un = (x) => { for (let i = 0; i < 4 && x && typeof x === "object" && ("_value" in x || "value" in x) && !("noteId" in x); i++) x = x._value ?? x.value; return x; };
+  const st = window.__INITIAL_STATE__ || {};
+  const map = un(un(st.note)?.noteDetailMap) || {};
+  const entry = un(map[id]);
+  const note = un(entry?.note) || {};
+  return JSON.stringify({has: !!entry && typeof entry === "object", noteId: String(note.noteId || ""),
+    path: location.pathname, hasState: !!window.__INITIAL_STATE__,
+    title: String(document.title || "").slice(0, 40)});
+}`
+
+// NoteState 详情页的一次读数。
+type NoteState struct {
+	Has    bool   `json:"has"`
+	NoteID string `json:"noteId"`
+	Path   string `json:"path"`
+	// Login 页面登录态（PageLoginState：user / guest / guestflag / risk / pending）。只认 guest（页面上有登录框）为游客：
+	// SSR 首帧对已登录会话也写 guest:true（guestflag），不能凭它判掉登录。
+	Login    string `json:"-"`
+	HasState bool   `json:"hasState"`
+	Title    string `json:"title"`
+}
+
+// ReadNoteState 读一次页面（换一份干净的 context，只给 5 秒）。读不到返回 ok=false。
+var ReadNoteState = func(page *rod.Page, id string) (NoteState, bool) {
+	var st NoteState
+	if page == nil {
+		return st, false
+	}
+	var raw string
+	if err := rod.Try(func() {
+		raw = page.Context(context.Background()).Timeout(5*time.Second).MustEval(noteStateJS, id).Str()
+	}); err != nil {
+		logrus.Warnf("读不到详情页状态：%v", err)
+		return st, false
+	}
+	if json.Unmarshal([]byte(raw), &st) != nil {
+		return st, false
+	}
+	st.Login = PageLoginState(page)
+	return st, true
+}
+
+// ClassifyMissingNote 页面上没有这篇时怎么判（纯函数）：nil = 不判（照原样报错）；
+// RiskError(NOT_LOGGED_IN) = 号是游客；NoteRestrictedError = 只是这一篇。
+func ClassifyMissingNote(id string, st NoteState) error {
+	if st.Has {
+		return nil
+	}
+	if st.Login == "guest" {
+		return &RiskError{Code: RiskNotLoggedIn, Detail: "打开笔记：读取服务的号是游客"}
+	}
+	p := strings.ToLower(st.Path)
+	if st.Login == "risk" || strings.Contains(p, "login") {
+		// 落在登录类页面：可能是号的事，不在这里判（/website-login/* 早已被 RiskPage 认成风控）
+		return nil
+	}
+	return &NoteRestrictedError{NoteID: id, Path: st.Path}
+}
+
+// noteWaitExtra 关键容器没等到时，再等这么久看这篇会不会出现在页面状态里（慢夜里别把慢当成限制）。
+var noteWaitExtra = 6 * time.Second
+
+// restrictedCheck 详情页的关键容器没出现、或抽取时找不到这篇：再看一眼（最多 noteWaitExtra）。
+// 返回 nil = 这篇在（或判不了，照原样走）；否则是 RiskError（游客）或 NoteRestrictedError。
+func restrictedCheck(page *rod.Page, id string, wait time.Duration) error {
+	deadline := time.Now().Add(wait)
+	var st NoteState
+	var ok bool
+	for {
+		st, ok = ReadNoteState(page, id)
+		if ok && st.Has {
+			return nil
+		}
+		if time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(500 * time.Millisecond)
+	}
+	if !ok {
+		return nil // 读不到页面：判不了，照原样走（宁可报原来的错，也不乱判）
+	}
+	err := ClassifyMissingNote(id, st)
+	if r := AsNoteRestricted(err); r != nil {
+		logrus.Warnf("笔记 %s 的详情页没渲染出来（path=%s login=%s title=%q）：按网页版限制处理，不写熔断", id, st.Path, st.Login, st.Title)
+		if ev := CaptureEvidence(page, EvidenceRestricted, nil, ""); ev != nil {
+			r.Evidence = ev.Dir
+		}
+	}
+	return err
+}
diff --git a/xiaohongshu/note_restricted_localbrowser_test.go b/xiaohongshu/note_restricted_localbrowser_test.go
new file mode 100644
index 0000000..16279fd
--- /dev/null
+++ b/xiaohongshu/note_restricted_localbrowser_test.go
@@ -0,0 +1,74 @@
+//go:build localbrowser
+
+package xiaohongshu
+
+// 1011 本地浏览器测试（默认不编译）：真实 DOM 上，入库主路（GetFeedDetailWithConfig）对「页面上没有这篇」怎么判。
+// 不碰小红书、不碰真 profile（见 risk_localbrowser_test.go 文件头）。
+// 跑法：go test -tags localbrowser -count=1 -timeout 600s -run LocalBrowserRestricted ./xiaohongshu
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const emptyState = `<script>window.__INITIAL_STATE__ = {note:{noteDetailMap:{}}, user:{userInfo:{guest:false,userId:"u1"}}};</script>`
+
+func TestLocalBrowserRestrictedNote(t *testing.T) {
+	old := noteWaitExtra
+	noteWaitExtra = time.Second
+	t.Cleanup(func() { noteWaitExtra = old })
+	srv := fixtureServer(t, map[string]string{
+		// 网页版限制的笔记：没有详情容器、没有错误容器、页面状态里没有这篇、也没有看得见的验证
+		"/explore/aaaa000000000001": `<div class="interstitial">页面加载中</div>` + emptyState,
+		// 对照 ①：页面上有看得见的验证浮层 → 照旧按风控停（写熔断），不当成「只是这一篇」
+		"/explore/aaaa000000000002": captchaOverlay + emptyState,
+		// 对照 ②：页面上有登录框 → 号的事（NOT_LOGGED_IN）
+		"/explore/aaaa000000000003": `<div class="login-container" style="width:300px;height:300px">扫码</div>` +
+			`<script>window.__INITIAL_STATE__ = {note:{noteDetailMap:{}}, user:{userInfo:{guest:true}}};</script>`,
+		// 对照 ③：正常笔记照常成功
+		"/explore/calm02": detailFixture("calm02", false),
+	})
+	t.Setenv("XHS_HOST", srv.URL)
+	page := localPage(t)
+	cfg := CommentLoadConfig{MaxCommentItems: 10}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+
+	start := time.Now()
+	res, err := NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "aaaa000000000001", "tok", true, cfg)
+	assert.Nil(t, res)
+	r := AsNoteRestricted(err)
+	require.NotNil(t, r, "页面上没有这篇、也没有验证 → NOTE_RESTRICTED，err=%v", err)
+	assert.Nil(t, AsRisk(err), "不写熔断")
+	assert.Equal(t, "/explore/aaaa000000000001", r.Path)
+	assert.NotEmpty(t, r.Evidence, "落一份证据（临时目录）")
+	assert.Less(t, time.Since(start), 90*time.Second, "关键容器没出现就停，不在空页面上滚评论")
+
+	_, err = NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "aaaa000000000002", "tok", true, cfg)
+	rk := AsRisk(err)
+	require.NotNil(t, rk, "看得见的验证照旧是风控，err=%v", err)
+	assert.Equal(t, RiskCaptcha, rk.Code)
+	assert.Nil(t, AsNoteRestricted(err))
+
+	_, err = NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "aaaa000000000003", "tok", true, cfg)
+	rk = AsRisk(err)
+	require.NotNil(t, rk, "页面上有登录框 → 号的事，err=%v", err)
+	assert.Equal(t, RiskNotLoggedIn, rk.Code)
+
+	got, err := NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "calm02", "tok", true, cfg)
+	require.NoError(t, err)
+	assert.Equal(t, "calm02", got.Note.NoteID)
+
+	// 读数接口本身：这篇在 / 不在
+	page.Timeout(20 * time.Second).MustNavigate(srv.URL + "/explore/calm02").MustWaitLoad()
+	st, ok := ReadNoteState(page, "calm02")
+	require.True(t, ok)
+	assert.True(t, st.Has)
+	st, ok = ReadNoteState(page, "nothere")
+	require.True(t, ok)
+	assert.False(t, st.Has)
+}
