+//go:build localbrowser
+
+package main
+
+// 1008（B1 / B3 / B4）端到端：真实入口（/api/v1/favorites、/api/v1/verify/window）→ 内置浏览器（无界面、临时 profile、
+// 挂死代理只通本机）→ 本机假站点。不碰小红书、不碰真 profile、不碰真 ~/.link-brain/risk-evidence。
+// 跑法：go test -tags localbrowser -count=1 -timeout 900s -run LocalBrowser .
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+// fakeSite 假小红书：首页（已登录 + 侧栏「我」）→ 自己的主页（笔记 / 收藏两个页签）→ 收藏接口。
+// mode：收藏页签点了以后——"dead" 没反应；"captcha" 先打收藏接口（回 461 / code 300011），回来后切到收藏、地址栏带上
+// tab=fav、弹出验证组件。记下每个路径被请求了几次、主页请求带的 query、页签被点的情况、验证窗口提示有没有出现。
+type fakeSite struct {
+	mu       sync.Mutex
+	mode     string
+	hits     map[string]int
+	queries  []string
+	clicks   []string
+	sawHint  int
+	noteMode string
+}
+
+func (f *fakeSite) count(p string) int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.hits[p]
+}
+
+func (f *fakeSite) handler(w http.ResponseWriter, r *http.Request) {
+	f.mu.Lock()
+	f.hits[r.URL.Path]++
+	mode := f.mode
+	switch r.URL.Path {
+	case "/user/profile/me":
+		f.queries = append(f.queries, r.URL.RawQuery)
+	case "/clicked":
+		f.clicks = append(f.clicks, r.URL.Query().Get("trusted")+":"+r.URL.Query().Get("text"))
+	case "/saw-hint":
+		f.sawHint++
+	}
+	f.mu.Unlock()
+	switch r.URL.Path {
+	case "/api/sns/web/v2/note/collect/page":
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(461)
+		fmt.Fprint(w, `{"code":300011,"success":false,"msg":"当前账号存在异常"}`)
+	case "/clicked", "/saw-hint":
+		w.WriteHeader(http.StatusNoContent)
+	case "/explore":
+		html(w, `<div id="app"><ul class="side-bar"><li class="user side-bar-component"><a href="/user/profile/me">我</a></li></ul></div>
+<script>window.__INITIAL_STATE__ = {user: {userInfo: {value: {guest: false, userId: "me", nickname: "测试号"}}}};</script>`)
+	case "/user/profile/me":
+		html(w, fmt.Sprintf(`<div class="reds-tab-list" style="padding:40px 20px">
+<div class="reds-tab-item sub-tab-list" style="display:inline-block;width:90px;height:40px;line-height:40px">笔记</div>
+<div class="reds-tab-item sub-tab-list" id="fav-tab" style="display:inline-block;width:90px;height:40px;line-height:40px">收藏</div></div>
+<div class="feeds-container" style="height:300px"></div>
+<script>
+const MODE = %q;
+window.__INITIAL_STATE__ = {user: {userInfo: {value: {guest: false, userId: "me"}}, activeTab: {value: {index: 0, query: "note"}},
+  notes: {value: [[{id: "own"}], []]}, userPageData: {value: {basicInfo: {nickname: "测试号"}}}}};
+document.getElementById("fav-tab").addEventListener("click", e => {
+  fetch("/clicked?trusted=" + e.isTrusted + "&text=" + encodeURIComponent(e.target.innerText.trim()), {keepalive: true});
+  if (MODE === "hidden") {
+    // 页签切过去了，但页面里多了一个看不见的验证组件（在屏幕外，里面有滑块画布）
+    window.__INITIAL_STATE__.user.activeTab.value = {index: 1, query: "fav"};
+    const h = document.createElement("div");
+    h.className = "red-captcha-container";
+    h.style.cssText = "position:fixed;left:-10000px;top:100px;width:320px;height:240px";
+    h.innerHTML = '<canvas width="300" height="150"></canvas><div>拖动滑块完成拼图</div>';
+    document.body.appendChild(h);
+    return;
+  }
+  if (MODE === "dead-captcha") {
+    // 页签点了没反应，紧接着弹出看得见的验证组件（B4 最常见的出事路径：那一刻 activeTab 还是 note）
+    if (document.querySelector(".red-captcha-container")) return;
+    const d = document.createElement("div");
+    d.className = "red-captcha-container";
+    d.style.cssText = "position:fixed;top:120px;left:40px;width:320px;height:240px;background:#eee;z-index:99";
+    document.body.appendChild(d);
+    return;
+  }
+  if (MODE !== "captcha") return;
+  fetch("/api/sns/web/v2/note/collect/page?num=30&cursor=").then(r => r.text()).then(() => {
+    history.replaceState(null, "", location.pathname + "?xsec_token=t&tab=fav&subTab=note");
+    window.__INITIAL_STATE__.user.activeTab.value = {index: 1, query: "fav"};
+    const d = document.createElement("div");
+    d.className = "red-captcha-container";
+    d.style.cssText = "position:fixed;top:120px;left:40px;width:320px;height:240px;background:#eee;z-index:99";
+    document.body.appendChild(d);
+  });
+}, true);
+const hintPoll = setInterval(() => {
+  if (document.getElementById("lb-verify-hint")) { clearInterval(hintPoll); fetch("/saw-hint", {keepalive: true}); }
+}, 200);
+</script>`, mode))
+	case "/explore/n1":
+		// 验证窗口用：已登录的笔记页，验证组件出现 1.5 秒后消失（她拖过了）
+		html(w, `<div class="note-container" style="height:300px">一篇笔记</div>
+<div id="cap" class="red-captcha-container" style="position:fixed;top:100px;left:40px;width:320px;height:240px;background:#eee;z-index:99"></div>
+<script>window.__INITIAL_STATE__ = {user: {userInfo: {value: {guest: false, userId: "me"}}}};
+setTimeout(() => document.getElementById("cap").remove(), 1500);</script>`)
+	default:
+		http.NotFound(w, r)
+	}
