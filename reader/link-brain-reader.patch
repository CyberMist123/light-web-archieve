+			snap := app.xiaohongshuService.state.snapshot()
+			assert.Equal(t, "success", snap["state"], "对外照旧报 success")
+			assert.Equal(t, true, snap["logged_in"])
+			app.xiaohongshuService.state.mu.Lock()
+			lastFavKept := !app.xiaohongshuService.state.lastFav.IsZero()
+			app.xiaohongshuService.state.mu.Unlock()
+			assert.Equal(t, c.result == loginAlready, lastFavKept, "没扫码不清读收藏限频")
