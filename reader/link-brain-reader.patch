+	require.NoError(t, err, "对照组：没有验证浮层时照常成功")
+	assert.Equal(t, "calm01", res.Note.NoteID)
+
+	start := time.Now()
+	res, err = NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "trap01", "tok", true, cfg)
+	assert.Nil(t, res)
+	r := AsRisk(err)
+	require.NotNil(t, r, "滚评论途中弹了验证必须按风控失败，err=%v", err)
+	assert.Equal(t, RiskCaptcha, r.Code)
+	assert.Less(t, time.Since(start), 2*time.Minute, "命中后立即停，不许滚满 8 分钟")
+}
+
+// favLazyFixture 假收藏页：__INITIAL_STATE__ 结构照小红书 web（user.notes[activeTab.index] + noteQueries[i].hasMore，
+// 外面包一层 {value}），滚到底附近 300ms 后追加一页（30 条），读满 total 条后 hasMore=false。
+// trigger = "scroll"：window 滚动就加载；"wheel"：只认真实滚轮（模拟 scrollTo 触发不了加载的布局）。
+// withQueries=false：页面状态里没有 noteQueries（hasMore 读不到，判停只能靠换滚法 + 基准）。
+func favLazyFixture(total int, trigger string, withQueries bool) string {
+	return fmt.Sprintf(`<div id="feeds" class="feeds-container"></div>
+<script>
+const TOTAL = %d, TRIGGER = %q, WITH_Q = %v;
+const fav = [];
+const st = {user: {notes: {value: [[{id: "own"}], fav]}, activeTab: {value: {index: 1, query: "fav"}}}};
+if (WITH_Q) st.user.noteQueries = {value: [{num: 30, cursor: "", hasMore: false}, {num: 30, cursor: "", hasMore: true}]};
+window.__INITIAL_STATE__ = st;
+let loading = false;
+function addPage() {
+  const box = document.getElementById("feeds");
+  for (let i = 0; i < 30 && fav.length < TOTAL; i++) {
+    fav.push({id: "n" + fav.length});
+    const s = document.createElement("section");
+    s.className = "note-item";
+    s.style.cssText = "height:120px;margin:4px;background:#eee";
+    s.textContent = "card " + fav.length;
+    box.appendChild(s);
+  }
+  if (WITH_Q && fav.length >= TOTAL) st.user.noteQueries.value[1].hasMore = false;
+}
+function maybeLoad() {
+  if (loading || fav.length >= TOTAL) return;
+  if (window.innerHeight + window.scrollY < document.body.scrollHeight - 400) return;
+  loading = true;
+  setTimeout(() => { addPage(); loading = false; }, 300);
+}
+addPage();
+if (TRIGGER === "wheel") window.addEventListener("wheel", () => setTimeout(maybeLoad, 50), {passive: true});
+else window.addEventListener("scroll", maybeLoad, {passive: true});
+</script>`, total, trigger, withQueries)
+}
+
+// TestLocalBrowserFavoritesScrollReadsAll F1：真实 DOM 上的判停接线——
+// ① 页面给 hasMore：读满后按 has_more_false 收工；② 只有真实滚轮才触发加载、页面不给 hasMore、调用方给了基准：
+// 普通滚法停住后要升级到滚轮把剩下的读出来，而不是把第一页当全量。
+func TestLocalBrowserFavoritesScrollReadsAll(t *testing.T) {
+	srv := fixtureServer(t, map[string]string{
+		"/fav/scroll": favLazyFixture(95, "scroll", true),
+		"/fav/wheel":  favLazyFixture(95, "wheel", false),
+	})
+	page := localPage(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+
+	page.MustNavigate(srv.URL + "/fav/scroll").MustWaitLoad()
+	res, r := (&UserProfileAction{page: page}).scrollLoadAllFavorites(ctx)
+	require.Nil(t, r)
+	assert.Equal(t, 95, res.Count)
+	assert.Equal(t, FavStopEnd, res.Reason)
+	assert.False(t, res.Partial)
+	require.NotNil(t, res.HasMore)
+	assert.False(t, *res.HasMore)
+
+	page.MustNavigate(srv.URL + "/fav/wheel").MustWaitLoad()
+	res, r = (&UserProfileAction{page: page, FavExpect: 95}).scrollLoadAllFavorites(ctx)
+	require.Nil(t, r)
+	assert.Equal(t, 95, res.Count, "只认滚轮的页面：升级到真实滚轮后要读满")
+	assert.GreaterOrEqual(t, res.Level, 2)
+	assert.Nil(t, res.HasMore, "页面没给 noteQueries：hasMore 读不到，不许崩")
+	assert.False(t, res.Partial)
+}
