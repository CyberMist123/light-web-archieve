+type favScrollCfg struct {
+	Budget      time.Duration
+	Settle      []time.Duration // 每一级滚法「条数不动多久」算这一级没招了；级数 = len(Settle)
+	ConfirmEnd  time.Duration   // hasMore=false 之后条数再稳这么久就收工（等最后一页渲染进状态）
+	Expect      int
+	ExpectRatio float64 // 条数 < Expect*ExpectRatio 算「明显低于基准」
+	WantTab     string  // 期望的 activeTab.query；空 = 不核
+	Tick        func(i int) time.Duration
+	// OnStall 列表卡住且 hasMore=true 的那一刻调一次（落证据），返回证据目录；nil = 不落。
+	OnStall func(count int) string
+	// Refused 收藏接口最近一次是不是回了拒绝（说明；空串 = 没有），每轮滚之前看一眼（读内存，不发请求）；nil = 不看。
+	Refused func() string
+	// OnRefused 看到拒绝那一刻调一次（落证据），返回证据目录；nil = 不落。
+	OnRefused func(why string) string
