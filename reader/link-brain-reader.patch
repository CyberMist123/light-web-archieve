+++ b/xiaohongshu/comment_floors_localbrowser_test.go
@@ -0,0 +1,120 @@
+//go:build localbrowser
+
+package xiaohongshu
+
+// 1004d：楼层探针 JS + 按楼找「展开」按钮 + 拟人点击，在真实 DOM 上走一遍（不碰小红书，见 risk_localbrowser_test.go 的说明）。
+// 跑法：go test -tags localbrowser -count=1 -timeout 600s -run LocalBrowserCommentFloors ./xiaohongshu
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// floorsFixture 12 楼（第 13 楼起靠滚动加载，hasMore=true）；每楼 subCommentCount 见 shown，首屏每楼带 1 条回复，
+// 「展开 N 条回复」点一次 300ms 后补 10 条（state 和 DOM 一起），还有就变成「展开更多回复」，没有就移除按钮。
+// 第 4 楼 120 条（旧逻辑按阈值 100 跳过），第 7 楼 49 条（要连点 5 次）。
+func floorsFixture(id string) string { return floorsFixtureBar(id, false) }
+
+// floorsFixtureBar bar=true 时视口底部有一条 140px 的固定输入栏（像详情页底部的互动栏），贴底的按钮会被它盖住。
+func floorsFixtureBar(id string, bar bool) string {
+	barHTML := ""
+	if bar {
+		barHTML = `<div class="engage-bar" style="position:fixed;left:0;right:0;bottom:0;height:140px;z-index:50;background:#fafafa">说点什么</div>`
+	}
+	return barHTML + fmt.Sprintf(`<div id="noteContainer" class="note-container">
+<div id="detail-title">楼层测试</div><div id="detail-desc">正文</div>
+<div class="note-scroller" style="height:600px;overflow:auto"><div class="interact-container">赞</div>
+<div class="comments-el"><div class="comments-container"><div class="total">共 400 条评论</div><div id="list"></div></div></div></div></div>
+<script>
+const SHOWN = [0, 3, 25, 120, 1, 0, 49, 10, 2, 11, 500, 7];
+const list = SHOWN.map((n, i) => ({id: "c" + i, content: "楼 " + (i + 1), subCommentCount: String(n),
+  subComments: n ? [{id: "c" + i + "-0", content: "回复 0"}] : [], subCommentHasMore: n > 1}));
+window.__INITIAL_STATE__ = {note: {noteDetailMap: {%q: {note: {noteId: %q, title: "楼层测试", desc: "正文",
+  interactInfo: {commentCount: "400"}}, comments: {list, cursor: "x", hasMore: true}}}}};
+const box = document.getElementById("list");
+function render(i) {
+  const c = list[i];
+  let p = document.getElementById("floor-" + i);
+  if (!p) { p = document.createElement("div"); p.className = "parent-comment"; p.id = "floor-" + i; box.appendChild(p); }
+  const left = Number(c.subCommentCount) - c.subComments.length;
+  p.innerHTML = '<div class="comment-item" id="comment-' + c.id + '" style="height:60px">' + c.content + '</div>' +
+    '<div class="reply-container"><div class="list-container">' +
+    c.subComments.map(s => '<div class="comment-item comment-item-sub" style="height:20px">' + s.content + '</div>').join("") +
+    '</div>' + (left > 0 ? '<div class="show-more" style="display:inline-block;width:140px;height:24px;cursor:pointer">' +
+    (c.subComments.length <= 1 ? "展开 " + left + " 条回复" : "展开更多回复") + '</div>' : "") + '</div>';
+  const btn = p.querySelector(".show-more");
+  if (btn) btn.addEventListener("click", () => setTimeout(() => {
+    for (let k = 0; k < 10 && c.subComments.length < Number(c.subCommentCount); k++)
+      c.subComments.push({id: c.id + "-" + c.subComments.length, content: "回复 " + c.subComments.length});
+    c.subCommentHasMore = c.subComments.length < Number(c.subCommentCount);
+    render(i);
+  }, 300));
+}
+list.forEach((_, i) => render(i));
+</script>`, id, id)
+}
+
+// TestLocalBrowserCommentFloorsExpandAll 前 10 楼每楼回复都点到底（含 120 条、要连点的楼），上限外的楼不点；
+// comment_load 如实报：floor_limit、前 10 楼全展开、无缺口、读到 12 楼、页面显示 400 条。
+func TestLocalBrowserCommentFloorsExpandAll(t *testing.T) {
+	srv := fixtureServer(t, map[string]string{"/explore/floors01": floorsFixture("floors01")})
+	t.Setenv("XHS_HOST", srv.URL)
+	page := localPage(t)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Minute)
+	defer cancel()
+	cfg := CommentLoadConfig{ClickMoreReplies: true, MaxCommentItems: 10}
+	res, err := NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "floors01", "tok", true, cfg)
+	require.NoError(t, err)
+	require.NotNil(t, res.CommentLoad)
+	cl := res.CommentLoad
+	t.Logf("comment_load = %+v", *cl)
+	assert.Equal(t, CommentStopFloorLimit, cl.Reason)
+	assert.False(t, cl.Partial)
+	assert.Empty(t, cl.RepliesPartial)
+	assert.Equal(t, 10, cl.FloorsExpanded)
+	assert.Equal(t, 12, cl.FloorsLoaded)
+	require.NotNil(t, cl.TotalShown)
+	assert.Equal(t, 400, *cl.TotalShown)
+	require.NotNil(t, cl.HasMore)
+	assert.True(t, *cl.HasMore)
+
+	shown := []int{0, 3, 25, 120, 1, 0, 49, 10, 2, 11, 500, 7}
+	require.Len(t, res.Comments.List, 12)
+	for i := 0; i < 10; i++ {
+		assert.Len(t, res.Comments.List[i].SubComments, shown[i], "第 %d 楼回复要全", i+1)
+	}
+	assert.Len(t, res.Comments.List[10].SubComments, 1, "上限外的第 11 楼不点")
+}
+
+// TestLocalBrowserCommentFloorsSlowClickAndBar 19:54 真号失败的复现：点前拟人停顿 2.5 秒（> 查按钮时的 2 秒超时）、
+// 视口底部有固定输入栏。第一版里按钮句柄带着 2 秒超时，点击必然 context deadline；第二版要照样全部点开。
+func TestLocalBrowserCommentFloorsSlowClickAndBar(t *testing.T) {
+	srv := fixtureServer(t, map[string]string{"/explore/floors02": floorsFixtureBar("floors02", true)})
+	t.Setenv("XHS_HOST", srv.URL)
+	page := localPage(t)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 9*time.Minute)
+	defer cancel()
+	action := NewFeedDetailAction(page)
+	action.preClick = func(ctx context.Context) { time.Sleep(2500 * time.Millisecond) }
+	cfg := CommentLoadConfig{ClickMoreReplies: true, MaxCommentItems: 4, RequestBudget: 10 * time.Minute}
+	res, err := action.GetFeedDetailWithConfig(ctx, "floors02", "tok", true, cfg)
+	require.NoError(t, err)
+	require.NotNil(t, res.CommentLoad)
+	cl := res.CommentLoad
+	t.Logf("comment_load = %+v gaps=%+v", *cl, cl.RepliesPartial)
+	assert.Equal(t, CommentStopFloorLimit, cl.Reason)
+	assert.False(t, cl.Partial)
+	assert.Equal(t, 0, cl.ClickFails)
+	assert.Equal(t, 4, cl.FloorsExpanded)
+	shown := []int{0, 3, 25, 120}
+	for i := 0; i < 4; i++ {
+		assert.Len(t, res.Comments.List[i].SubComments, shown[i], "第 %d 楼回复要全", i+1)
+	}
+}
