+// activeTabQuery 读页面状态里当前子 tab 的 query；读不到返回空串。
+func (u *UserProfileAction) activeTabQuery(ctx context.Context) string {
+	q := ""
+	_ = rod.Try(func() {
+		q = u.page.Context(ctx).Timeout(10 * time.Second).MustEval(`() => {
+			const unwrap = (o) => o?.value ?? o?._value ?? o?._rawValue ?? o;
+			const a = unwrap(window.__INITIAL_STATE__?.user?.activeTab) || {};
+			return a.query || "";
+		}`).Str()
+	})
+	return q
+}
+
+// scrollLoadAllFavorites 把收藏子 tab 滚到底，加载全量收藏。
+// 反复滚到页面底 → 等懒加载把新 feed 追加进 __INITIAL_STATE__.user.notes[activeTab.index]，
+// 直到条数连续几次不再增长（到底）或耗尽预算（最多 ~150s）。只读不写。
+// favScrollRiskEvery 滚收藏时每隔几轮（每轮约 1.3 秒，每次滚动都会触发一次收藏接口）查一次风控。
+const favScrollRiskEvery = 4
+
+// scrollLoadAllFavorites 1001：途中每 favScrollRiskEvery 轮查一次风控，撞上立即停、返回它。
+func (u *UserProfileAction) scrollLoadAllFavorites(ctx context.Context) *RiskError {
+	return scrollUntilStable(ctx, 240*time.Second, 12*time.Second, 1300*time.Millisecond,
+		func() int {
+			cnt := 0
+			_ = rod.Try(func() {
+				cnt = u.page.Context(ctx).Timeout(15 * time.Second).MustEval(favCountJS).Int()
+			})
+			return cnt
+		},
+		func() {
+			_ = rod.Try(func() {
+				u.page.Context(ctx).Timeout(15 * time.Second).MustEval(favScrollJS)
+			})
+		},
+		func() *RiskError { return RiskPage(u.page) })
+}
+
+const favCountJS = `() => {
+		const unwrap = x => x?.value ?? x?._value ?? x?._rawValue ?? x;
+		const u = window.__INITIAL_STATE__?.user;
+		const notes = unwrap(u?.notes);
+		const active = unwrap(u?.activeTab);
+		return (notes && active && notes[active.index] && notes[active.index].length) || 0;
+	}`
+
+// 滚到底触发下一页懒加载（window 和常见滚动容器都滚一下，兜不同布局）
+const favScrollJS = `() => {
+				window.scrollTo(0, document.body.scrollHeight);
+				const sc = document.querySelector('.feeds-container, .feeds-page, #userPostedFeeds, .note-scroll-container');
+				if (sc) sc.scrollTop = sc.scrollHeight;
+			}`
+
+// scrollUntilStable 反复「数一下 → 滚一下 → 歇 tick」，settle 内条数没增长算到底，budget 用完也停；
+// 每 favScrollRiskEvery 轮（含第 0 轮）滚之前查一次风控，命中返回它、不再滚。
+func scrollUntilStable(ctx context.Context, budget, settle, tick time.Duration,
+	count func() int, scroll func(), risk func() *RiskError) *RiskError {
+	deadline := time.Now().Add(budget)
+	last := -1
+	lastGrow := time.Now()
+	for i := 0; time.Now().Before(deadline); i++ {
+		cnt := count()
+		if cnt == last {
+			if time.Since(lastGrow) >= settle {
+				logrus.Infof("XHS favorites 全量加载完成，共 %d 条", cnt)
+				return nil
+			}
+		} else {
+			last = cnt
+			lastGrow = time.Now()
+		}
+		if i%favScrollRiskEvery == 0 {
+			if r := risk(); r != nil {
+				logrus.Warnf("滚收藏途中撞到风控，停止滚动: %s", r.Error())
+				return r
+			}
+		}
+		scroll()
+		select {
+		case <-ctx.Done():
+			return nil
+		case <-time.After(tick):
+		}
+	}
+	logrus.Infof("XHS favorites 全量加载到预算上限，取已加载的 %d 条", last)
+	return nil
+}
