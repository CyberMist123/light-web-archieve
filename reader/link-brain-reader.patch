+func localSite(t *testing.T, handler http.HandlerFunc) (*AppServer, string) {
+	t.Helper()
+	dir := t.TempDir()
+	require.True(t, strings.HasPrefix(filepath.Clean(dir), filepath.Clean(os.TempDir())))
+	t.Setenv("XHS_PROFILE_DIR", dir)
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "Local State"), []byte("{}"), 0o600))
+	srv := httptest.NewServer(handler)
+	t.Cleanup(srv.Close)
+	require.True(t, strings.HasPrefix(srv.URL, "http://127.0.0.1:"))
+	t.Setenv("XHS_HOST", srv.URL)
+	configs.InitHeadless(true)
+	configs.SetProxy("http://127.0.0.1:9")
+	t.Cleanup(func() { configs.SetProxy("") })
+	return NewAppServer(NewXiaohongshuService()), dir
+}
+
+func html(w http.ResponseWriter, body string) {
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	fmt.Fprint(w, "<!doctype html><html><head><meta charset=utf-8></head><body>"+body+"</body></html>")
+}
+
+func holdOnDisk(t *testing.T, dir string) string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(dir, "risk-hold.json"))
+	if err != nil {
+		return ""
+	}
+	var h riskHold
+	require.NoError(t, json.Unmarshal(data, &h))
+	return h.Code
+}
+
+// TestLocalBrowserFavoritesRedirectTripsHold 读收藏时被跳到 /website-login/error：
+// 423 ACCOUNT_RISK、熔断落盘；下一次请求直接 423 RISK_HOLD。
+func TestLocalBrowserFavoritesRedirectTripsHold(t *testing.T) {
+	app, dir := localSite(t, func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasPrefix(r.URL.Path, "/website-login/") {
+			html(w, "<div>登录异常</div>")
+			return
+		}
+		http.Redirect(w, r, "/website-login/error?redirectPath=x", http.StatusFound)
+	})
+	router := setupRoutes(app)
+	code, out := doJSON(t, router, "GET", "/api/v1/favorites", "")
+	assert.Equal(t, http.StatusLocked, code, "%v", out)
+	assert.Equal(t, xiaohongshu.RiskAccount, out["code"])
+	assert.Equal(t, xiaohongshu.RiskAccount, holdOnDisk(t, dir))
+
+	app.xiaohongshuService.state.set(func(l *loginState) { l.lastFav = time.Time{} })
+	code, out = doJSON(t, router, "GET", "/api/v1/login/status", "")
+	assert.Equal(t, http.StatusLocked, code)
+	assert.Equal(t, "RISK_HOLD", out["code"])
+}
+
+// TestLocalBrowserLoginStatusGuestTripsNotLoggedIn /login/status 确认是游客：照旧 200 is_logged_in=false，
+// 同时写 NOT_LOGGED_IN 熔断。
+func TestLocalBrowserLoginStatusGuestTripsNotLoggedIn(t *testing.T) {
+	app, dir := localSite(t, func(w http.ResponseWriter, r *http.Request) {
+		html(w, `<div class="login-container" style="width:300px;height:300px">登录</div>`)
+	})
+	router := setupRoutes(app)
+	code, out := doJSON(t, router, "GET", "/api/v1/login/status", "")
+	require.Equal(t, http.StatusOK, code, "%v", out)
+	assert.Equal(t, false, out["data"].(map[string]any)["is_logged_in"])
+	assert.Equal(t, xiaohongshu.RiskNotLoggedIn, holdOnDisk(t, dir))
+}
+
+// TestLocalBrowserMCPFeedDetailCaptchaMidLoad 入库主路（MCP get_feed_detail）：滚评论途中弹验证 →
+// isError 且文本带 [CAPTCHA_REQUIRED]、熔断落盘；之后 /mcp 的请求被 [RISK_HOLD] 拦下。
+func TestLocalBrowserMCPFeedDetailCaptchaMidLoad(t *testing.T) {
+	var comments strings.Builder
+	for i := 0; i < 30; i++ {
+		fmt.Fprintf(&comments, `<div class="parent-comment" style="height:80px">评论 %d</div>`, i)
+	}
+	app, dir := localSite(t, func(w http.ResponseWriter, r *http.Request) {
+		html(w, fmt.Sprintf(`<div id="noteContainer" class="note-container"><div id="detail-title">t</div>
+<div class="note-scroller" style="height:400px;overflow:auto"><div class="comments-container">%s</div></div></div>
+<script>
+window.__INITIAL_STATE__ = {note:{noteDetailMap:{"trap02":{note:{noteId:"trap02",interactInfo:{commentCount:"30"}},comments:{list:[{id:"c"}]}}}}};
+function trip() {
+  if (document.getElementById("cap")) return;
+  const d = document.createElement("div");
+  d.id = "cap";
+  d.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.4)";
+  d.innerHTML = '<div style="width:320px;height:240px;margin:80px auto;background:#fff">安全验证<p>请拖动下方滑块完成拼图</p></div>';
+  document.body.appendChild(d);
+}
+document.addEventListener("wheel", trip, true);
+</script>`, comments.String()))
+	})
+	res := app.handleGetFeedDetail(context.Background(), map[string]any{
+		"feed_id": "trap02", "xsec_token": "tok", "load_all_comments": true, "max_comment_items": float64(20),
+	})
+	require.True(t, res.IsError, "%v", res.Content)
+	assert.Contains(t, res.Content[0].Text, "[CAPTCHA_REQUIRED]")
+	assert.Equal(t, xiaohongshu.RiskCaptcha, holdOnDisk(t, dir))
+
+	again := app.handleGetFeedDetail(context.Background(), map[string]any{"feed_id": "trap02", "xsec_token": "tok"})
+	require.True(t, again.IsError)
+	assert.Contains(t, again.Content[0].Text, "[RISK_HOLD]", "熔断后拿锁复查即拒绝，不再开浏览器")
+}
