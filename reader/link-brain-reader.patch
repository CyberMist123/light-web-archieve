+// scrollLoadAllFavorites 把收藏子 tab 滚到底，加载全量收藏。
+// 反复滚到页面底 → 等懒加载把新 feed 追加进 __INITIAL_STATE__.user.notes[activeTab.index]，
+// 直到条数连续几次不再增长（到底）或耗尽预算（最多 ~150s）。只读不写。
+func (u *UserProfileAction) scrollLoadAllFavorites(ctx context.Context) {
+	countJS := `() => {
+		const unwrap = x => x?.value ?? x?._value ?? x?._rawValue ?? x;
+		const u = window.__INITIAL_STATE__?.user;
+		const notes = unwrap(u?.notes);
+		const active = unwrap(u?.activeTab);
+		return (notes && active && notes[active.index] && notes[active.index].length) || 0;
+	}`
+	// 负载高时懒加载一页要好几秒：「连续 3 次×1.3s 没新增」会把中途误判成到底（0921/0925 实测停在 20、47 条）。
+	// 改成按时间：12 秒没有任何新增才算到底；总预算 240s。
+	deadline := time.Now().Add(240 * time.Second)
+	last := -1
+	lastGrow := time.Now()
+	for time.Now().Before(deadline) {
+		cnt := 0
+		_ = rod.Try(func() {
+			p := u.page.Context(ctx).Timeout(15 * time.Second)
+			cnt = p.MustEval(countJS).Int()
+		})
+		if cnt == last {
+			if time.Since(lastGrow) >= 12*time.Second {
+				logrus.Infof("XHS favorites 全量加载完成，共 %d 条", cnt)
+				return
+			}
+		} else {
+			last = cnt
+			lastGrow = time.Now()
+		}
+		// 滚到底触发下一页懒加载（window 和常见滚动容器都滚一下，兜不同布局）
+		_ = rod.Try(func() {
+			p := u.page.Context(ctx).Timeout(15 * time.Second)
+			p.MustEval(`() => {
+				window.scrollTo(0, document.body.scrollHeight);
+				const sc = document.querySelector('.feeds-container, .feeds-page, #userPostedFeeds, .note-scroll-container');
+				if (sc) sc.scrollTop = sc.scrollHeight;
+			}`)
+		})
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(1300 * time.Millisecond):
+		}
+	}
+	logrus.Infof("XHS favorites 全量加载到预算上限，取已加载的 %d 条", last)
+}
