+// TestScrollFavoritesStopsOnAPIRefused 1008（审查）：收藏接口已经回了拒绝——再滚只是接着打被拒的接口，立即停（api_refused，partial），
+// 当场落证据；不返回风控（页面同时弹了验证由上层的风控复查写熔断）。
+func TestScrollFavoritesStopsOnAPIRefused(t *testing.T) {
+	scrolls, count, refusedCalls := 0, 0, 0
+	cfg := fastFavCfg(0)
+	cfg.Budget = time.Minute
+	cfg.Refused = func() string {
+		if count >= 30 {
+			return "收藏接口回 HTTP 461（code=300011）"
+		}
+		return ""
+	}
+	cfg.OnRefused = func(string) string { refusedCalls++; return "EV" }
+	res, r := scrollFavorites(context.Background(), cfg,
+		func() favProbe { count += 10; return favProbe{Count: count, HasMore: 1, Tab: "fav"} },
+		func(int) { scrolls++ }, noRisk)
+	assert.Nil(t, r)
+	assert.Equal(t, FavStopRefused, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Equal(t, 30, res.Count)
+	assert.Equal(t, 2, scrolls, "第 3 次读数时已被拒：之后不再滚")
+	assert.Equal(t, 1, refusedCalls)
+	assert.Equal(t, "EV", res.Evidence)
+}
+
+// TestHiddenWidgetTextAvoidsBlockedHints HIDDEN_WIDGET 的报错文本会进 MCP 报错：不能带 Python looks_blocked 认的字，
+// 否则会被当成「号出事」整批停车。给她看的 HTTP 文案照施工单。
+func TestHiddenWidgetTextAvoidsBlockedHints(t *testing.T) {
+	text := strings.ToLower((&RiskError{Code: RiskHiddenWidget, Detail: HiddenWidgetDetail}).Error())
+	for _, hint := range []string{"captcha", "验证码", "滑块", "安全验证", "风控", "登录", "账号异常", "行为异常", "频繁"} {
+		assert.NotContains(t, text, hint)
+	}
+	assert.Equal(t, "页面里有验证组件但没显示滑块，这次先停，下次照常读", HiddenWidgetText)
+	assert.True(t, (&RiskError{Code: RiskHiddenWidget}).Hidden())
+	assert.False(t, (&RiskError{Code: RiskCaptcha}).Hidden())
+	assert.False(t, (*RiskError)(nil).Hidden())
+}
+
+// TestScrollFavoritesEndsOnHasMoreFalse 页面明确说没有更多：条数稳一小会儿就收工，算读全，不必把几级滚法都试一遍。
+func TestScrollFavoritesEndsOnHasMoreFalse(t *testing.T) {
+	n := 0
+	res, r := scrollFavorites(context.Background(), fastFavCfg(0),
+		func() favProbe {
+			n++
+			if n < 5 {
+				return favProbe{Count: n * 30, HasMore: 1, Tab: "fav"}
+			}
+			return favProbe{Count: 120, HasMore: 0, Tab: "fav"}
+		}, func(int) {}, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopEnd, res.Reason)
+	assert.False(t, res.Partial)
+	assert.Equal(t, 120, res.Count)
+	require.NotNil(t, res.HasMore)
+	assert.False(t, *res.HasMore)
+	assert.Equal(t, 0, res.Level)
+}
+
+// TestScrollFavoritesSlowLoadNotMistakenForEnd 慢懒加载：第 0 级「不动」超过 settle 后不收工，换滚法继续，
+// 后面又长出来的条数要读进来（10-03 读回 50、10-04 读回 540 都是这种被误判到底）。
+func TestScrollFavoritesSlowLoadNotMistakenForEnd(t *testing.T) {
+	count := 50
+	levelsSeen := map[int]bool{}
+	res, r := scrollFavorites(context.Background(), fastFavCfg(0),
+		func() favProbe { return favProbe{Count: count, HasMore: -1, Tab: "fav"} },
+		func(level int) {
+			levelsSeen[level] = true
+			if level >= 2 && count < 200 { // 只有真实滚轮那一级才触发得了加载
+				count += 50
+			}
+		}, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, 200, res.Count, "停在 50 时不能当成全量")
+	assert.True(t, levelsSeen[1] && levelsSeen[2])
+	assert.Equal(t, FavStopStable, res.Reason, "hasMore 读不到、没给基准：几级都试过不再长才按读全处理")
+	assert.False(t, res.Partial)
+	assert.Nil(t, res.HasMore)
+}
+
+// TestScrollStalledStopsAfterLevel1 1008（B4 前兆即停）：页面说还有更多（hasMore=true）但条数卡住（10-08 05:18 卡在 1150）——
+// 最多换第 1 级滚法（往回滚一截），还不动就停：stop_reason=stalled、partial；不再升到真实滚轮那两级；
+// 卡住那一刻落一次证据；卡住期间每轮都查风控。
+func TestScrollStalledStopsAfterLevel1(t *testing.T) {
+	rounds, risks, scrolls, stalls := 0, 0, 0, 0
+	maxLevel := -1
+	res, r := scrollFavorites(context.Background(), func() favScrollCfg {
+		cfg := fastFavCfg(1216)
+		cfg.OnStall = func(count int) string { stalls++; assert.Equal(t, 1150, count); return "EVIDENCE-DIR" }
+		return cfg
+	}(),
+		func() favProbe { rounds++; return favProbe{Count: 1150, HasMore: 1, Tab: "fav"} },
+		func(level int) {
+			scrolls++
+			if level > maxLevel {
+				maxLevel = level
+			}
+		},
+		func() *RiskError { risks++; return nil })
+	require.Nil(t, r)
+	assert.Equal(t, FavStopStalled, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Equal(t, 1150, res.Count)
+	assert.Equal(t, 1, res.Level, "最多到第 1 级")
+	assert.Equal(t, 1, maxLevel, "不许用到第 2/3 级（真实滚轮）")
+	require.NotNil(t, res.HasMore)
+	assert.True(t, *res.HasMore)
+	assert.Equal(t, 1, stalls, "卡住那一刻只落一次证据")
+	assert.Equal(t, "EVIDENCE-DIR", res.Evidence)
+	assert.Greater(t, scrolls, 0)
+	// 第 0 轮照例查一次；之后每一轮（条数一直没长）都查：查的次数 = 走到滚动那一步的轮数
+	assert.Equal(t, scrolls, risks, "卡住期间每轮都查风控")
+
+	// 卡住途中弹了验证：下一轮就停，返回风控
+	n := 0
+	_, r = scrollFavorites(context.Background(), fastFavCfg(0),
+		func() favProbe { return favProbe{Count: 540, HasMore: 1, Tab: "fav"} }, func(int) {},
+		func() *RiskError {
+			if n++; n == 3 {
+				return ClassifyRisk("/explore", true)
+			}
+			return nil
+		})
+	require.NotNil(t, r)
+	assert.Equal(t, RiskCaptcha, r.Code)
+	assert.Equal(t, 3, n, "第 0 轮查过之后，每轮都查（不是每 4 轮）")
+}
+
+// TestScrollGrowingHasMoreChecksRiskEvery4 对照：一直在长（正常翻页）时仍是每 4 轮查一次风控，不额外加检查。
+func TestScrollGrowingHasMoreChecksRiskEvery4(t *testing.T) {
+	count, risks, scrolls := 0, 0, 0
+	cfg := fastFavCfg(0)
+	cfg.Budget = 200 * time.Millisecond
+	_, r := scrollFavorites(context.Background(), cfg,
+		func() favProbe { count += 10; return favProbe{Count: count, HasMore: 1, Tab: "fav"} },
+		func(int) { scrolls++ }, func() *RiskError { risks++; return nil })
+	require.Nil(t, r)
+	require.Greater(t, scrolls, 8)
+	assert.Equal(t, (scrolls+favScrollRiskEvery-1)/favScrollRiskEvery, risks)
+}
+
+// TestScrollFavoritesBelowExpectKeepsScrolling 条数停住但远低于基准（页面没给 hasMore）：继续换滚法；
+// 后来长到基准附近就按读全收工；始终长不上去就报 below_expect（partial）。
+func TestScrollFavoritesBelowExpectKeepsScrolling(t *testing.T) {
+	count := 540
+	res, r := scrollFavorites(context.Background(), fastFavCfg(1159),
+		func() favProbe { return favProbe{Count: count, HasMore: -1, Tab: "fav"} },
+		func(level int) {
+			if level >= 1 && count < 1160 {
+				count += 62
+			}
+		}, noRisk)
+	require.Nil(t, r)
+	assert.GreaterOrEqual(t, res.Count, 1159)
+	assert.Equal(t, FavStopStable, res.Reason)
+	assert.False(t, res.Partial)
+
+	res, r = scrollFavorites(context.Background(), fastFavCfg(1159),
+		func() favProbe { return favProbe{Count: 540, HasMore: -1, Tab: "fav"} }, func(int) {}, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopBelowExpect, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Equal(t, 1159, res.Expect)
+}
+
+// TestScrollFavoritesHasMoreFalseBelowExpectTriesOnceMore hasMore=false 但远低于基准：先换一级滚法再信它（防字段一时没更新）。
+func TestScrollFavoritesHasMoreFalseBelowExpectTriesOnceMore(t *testing.T) {
+	res, r := scrollFavorites(context.Background(), fastFavCfg(1159),
+		func() favProbe { return favProbe{Count: 600, HasMore: 0, Tab: "fav"} }, func(int) {}, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopEnd, res.Reason)
+	assert.False(t, res.Partial, "页面明确说到底了：她真删了一批，照实算读全")
+	assert.GreaterOrEqual(t, res.Level, 1)
+}
+
+// TestScrollFavoritesBudgetIsPartial 预算用完还在长：报 budget（partial）。
+func TestScrollFavoritesBudgetIsPartial(t *testing.T) {
+	count := 0
+	cfg := fastFavCfg(0)
+	cfg.Budget = 60 * time.Millisecond
+	res, r := scrollFavorites(context.Background(), cfg,
+		func() favProbe { count += 5; return favProbe{Count: count, HasMore: -1, Tab: "fav"} }, func(int) {}, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopBudget, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Greater(t, res.Count, 0)
+}
+
+// TestScrollFavoritesTabLost 滚动途中页签跳回「笔记」：立即停（10-04 读回的 49 条其实是别的 tab），不滚满 12 秒再报。
+func TestScrollFavoritesTabLost(t *testing.T) {
+	n, scrolls := 0, 0
+	res, r := scrollFavorites(context.Background(), fastFavCfg(0),
+		func() favProbe {
+			n++
+			if n >= 3 {
+				return favProbe{Count: 49, HasMore: -1, Tab: "note"}
+			}
+			return favProbe{Count: 49, HasMore: -1, Tab: "fav"}
+		}, func(int) { scrolls++ }, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopTabLost, res.Reason)
+	assert.Equal(t, "note", res.Tab)
+	assert.True(t, res.Partial)
+	assert.Equal(t, 2, scrolls)
+}
+
+// TestScrollFavoritesProbeFailureIsNotGrowth 读数失败（-1）不算增长也不算变化；读不到 tab（空串）不算跳走。
+func TestScrollFavoritesProbeFailureIsNotGrowth(t *testing.T) {
+	n := 0
+	res, r := scrollFavorites(context.Background(), fastFavCfg(0),
+		func() favProbe {
+			n++
+			if n%2 == 0 {
+				return favProbe{Count: -1, HasMore: -1}
+			}
+			return favProbe{Count: 80, HasMore: -1, Tab: ""}
+		}, func(int) {}, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, 80, res.Count)
+	assert.Equal(t, FavStopStable, res.Reason)
+}
+
+// TestScrollFavoritesCancelled ctx 结束：如实报 cancelled（partial），不卡住。
+func TestScrollFavoritesCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	n := 0
+	res, r := scrollFavorites(ctx, fastFavCfg(0),
+		func() favProbe {
+			n++
+			if n == 3 {
+				cancel()
+			}
+			return favProbe{Count: n, HasMore: 1, Tab: "fav"}
+		}, func(int) {}, noRisk)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopCancelled, res.Reason)
+	assert.True(t, res.Partial)
+}
+
+// TestFavBudgetRespectsCtxDeadline 滚动预算不超过 ctx 截止前留给提取的那段。
+func TestFavBudgetRespectsCtxDeadline(t *testing.T) {
+	now := time.Now()
+	assert.Equal(t, favScrollBudget, favBudget(context.Background(), now))
+	ctx, cancel := context.WithDeadline(context.Background(), now.Add(2*time.Minute))
+	defer cancel()
+	assert.Equal(t, 2*time.Minute-favExtractReserve, favBudget(ctx, now))
+	ctx2, cancel2 := context.WithDeadline(context.Background(), now.Add(10*time.Second))
+	defer cancel2()
+	assert.Equal(t, time.Duration(0), favBudget(ctx2, now))
+}
+
+// TestFavTickIsJittered 滚动间隔带抖动，不是固定的机枪节奏，且在 1.7 秒以上。
+func TestFavTickIsJittered(t *testing.T) {
+	seen := map[time.Duration]bool{}
+	for i := 0; i < 50; i++ {
+		d := favTick(i)
+		assert.GreaterOrEqual(t, d, 1700*time.Millisecond)
+		assert.Less(t, d, 9200*time.Millisecond)
+		seen[d] = true
+	}
+	assert.Greater(t, len(seen), 10)
+}
+
+// TestCommentBudgetLeavesRoomForExtraction 滚评论预算 = min(8 分钟, 离总时限剩余 − 抽取预留)。
+func TestCommentBudgetLeavesRoomForExtraction(t *testing.T) {
+	now := time.Now()
+	assert.Equal(t, commentLoadBudget, commentBudget(context.Background(), now))
+	ctx, cancel := context.WithDeadline(context.Background(), now.Add(12*time.Minute))
+	defer cancel()
+	assert.Equal(t, commentLoadBudget, commentBudget(ctx, now))
+	ctx2, cancel2 := context.WithDeadline(context.Background(), now.Add(5*time.Minute))
+	defer cancel2()
+	assert.Equal(t, 5*time.Minute-extractReserve, commentBudget(ctx2, now))
+	ctx3, cancel3 := context.WithDeadline(context.Background(), now.Add(time.Minute))
+	defer cancel3()
+	assert.Equal(t, time.Duration(0), commentBudget(ctx3, now))
+}
+
+// TestScrollFavoritesReachedExpectStopsEarly 页面不给 hasMore，但已不少于基准且不再长：当前级就收工，不再升级滚法多打接口。
+func TestScrollFavoritesReachedExpectStopsEarly(t *testing.T) {
