@@ -0,0 +1,342 @@
+package main
+
+// 风控熔断（1001）：撞到验证码 / 安全跳转页 / 需要登录却是游客之后，拒绝一切会开浏览器的请求，
+// 直到有人处理。状态落在 <XHS_PROFILE_DIR>/risk-hold.json，重启服务后仍生效。
+//
+// 解除只有三条路：登录窗口成功（已验证登录）、人工验证窗口完成、POST /api/v1/risk/clear（外加远程扫码
+// /login/qrcode 扫码成功，它也是一次已验证的登录；取码时发现「已是登录态」只解 NOT_LOGGED_IN）。
+// 1008（审查）：登录窗口同理——真扫了码才全解；一打开就发现「已是登录态」（没扫码）只解 NOT_LOGGED_IN，
+// 验证码 / 安全跳转类保留（那类验证只在读收藏那一下出，/explore 页面干净不说明没事）。
+// 1008 第二轮：看不见的验证组件（HIDDEN_WIDGET）不写熔断：停本次、回 503，下次照常。
+// 1008（B3）验证窗口：验证码 / 安全跳转类要求窗口里**出现过**风控、关窗前最后一次读数又干净（她真拖过了）才解除；
+// 从头到尾没出现过 → 不自动解除，/login/session 给 verify_result="no_captcha_seen"，交给她亲手确认（risk/clear）。
+// 掉登录类仍按「关窗前看到已登录、页面干净」解除。
+// 登录窗口、验证窗口、扫码、/login/session、/login/logout、/risk/clear 不受熔断拦截。
+//
+// 两道闸：请求进来时（riskGuard / mcpRiskMiddleware），以及拿到浏览器锁之后、启动之前
+// （XiaohongshuService.openBrowser → holdGuard）。后一道挡住「排在锁后面时前一个请求撞了风控」。
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+	"github.com/sirupsen/logrus"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+const codeRiskHold = "RISK_HOLD"
+
+type riskHold struct {
+	Code   string `json:"code"`
+	Since  string `json:"since"` // RFC3339
+	Detail string `json:"detail"`
+	// 1008（B1）：出事那一刻程序在哪一页（location.href）、哪个子页签（activeTab.query，如 fav）、程序要去的子页签
+	// （want_tab：读收藏 = fav；页签没点动接着弹验证时 tab 还是 note）、证据目录（<risk-evidence>/<时间>，里面
+	// shot.png / hit.html / meta.json，见 xiaohongshu/evidence.go）。只有经页面探针撞上的风控才有；掉登录（NOT_LOGGED_IN）等没有。
+	// url 含本号主页 id 和 xsec_token：只落在 risk-hold.json、只给验证窗口用，HTTP 一律不回（见 view）。
+	URL      string `json:"url,omitempty"`
+	Tab      string `json:"tab,omitempty"`
+	WantTab  string `json:"want_tab,omitempty"`
+	Evidence string `json:"evidence,omitempty"`
+}
+
+// riskHoldView 熔断的对外样子（HTTP）：不带 url（本号主页 id + xsec_token）；证据目录（本机绝对路径）只给 /login/session
+// （Python 的「查看截图」要用），423 响应里不带——423 的 hold 会被 Python 原样转进状态行、问题记录、stdout。
+type riskHoldView struct {
+	Code         string `json:"code"`
+	Since        string `json:"since"`
+	Detail       string `json:"detail"`
+	Tab          string `json:"tab,omitempty"`
+	WantTab      string `json:"want_tab,omitempty"`
+	IncidentPage bool   `json:"incident_page,omitempty"` // 记下了出事页面（验证窗口会直接开它）
+	Evidence     string `json:"evidence,omitempty"`
+}
+
+func (h *riskHold) view(withEvidence bool) *riskHoldView {
+	if h == nil {
+		return nil
+	}
+	v := &riskHoldView{Code: h.Code, Since: h.Since, Detail: h.Detail, Tab: h.Tab, WantTab: h.WantTab, IncidentPage: h.URL != ""}
+	if withEvidence {
+		v.Evidence = h.Evidence
+	}
+	return v
+}
+
+type holdStore struct {
+	mu   sync.Mutex
+	path string
+	cur  *riskHold
+}
+
+func holdPath() string { return filepath.Join(browser.ProfileDir(), "risk-hold.json") }
+
+// loadHoldStore 读熔断文件。文件在但读不懂：按熔断处理（宁可停，也不在不明状态下开页）。
+func loadHoldStore(path string) *holdStore {
+	h := &holdStore{path: path}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return h
+	}
+	var r riskHold
+	if json.Unmarshal(data, &r) != nil || r.Code == "" {
+		r = riskHold{Code: xiaohongshu.RiskAccount, Since: time.Now().Format(time.RFC3339),
+			Detail: "risk-hold.json 读不懂，按熔断处理；确认账号没事后 POST /api/v1/risk/clear"}
+	}
+	h.cur = &r
+	logrus.Warnf("风控熔断仍在生效（自 %s）：%s %s", r.Since, r.Code, r.Detail)
+	return h
+}
+
+func (h *holdStore) get() *riskHold {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.cur == nil {
+		return nil
+	}
+	c := *h.cur
+	return &c
+}
+
+// trip 写熔断；已在熔断中则保留最早那次（since 不刷新）。ev 为这次出事的证据（可为 nil）。
+func (h *holdStore) trip(code, detail string, ev *xiaohongshu.Evidence) *riskHold {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.cur != nil {
+		c := *h.cur
+		return &c
+	}
+	r := riskHold{Code: code, Since: time.Now().Format(time.RFC3339), Detail: detail}
+	if ev != nil {
+		r.URL, r.Tab, r.WantTab, r.Evidence = ev.URL, ev.Tab, ev.WantTab, ev.Dir
+	}
+	h.cur = &r
+	if err := writeFileAtomic(h.path, r); err != nil {
+		logrus.Errorf("风控熔断写盘失败（内存里仍生效）：%v", err)
+	}
+	logrus.Errorf("风控熔断：%s %s —— 之后所有会开浏览器的请求一律拒绝，直到扫码登录/验证窗口/risk/clear", code, detail)
+	c := r
+	return &c
+}
+
+// clear 解除熔断；原来就没有返回 false。
+func (h *holdStore) clear(reason string) bool {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	had := h.cur != nil
+	h.cur = nil
+	if err := os.Remove(h.path); err != nil && !os.IsNotExist(err) {
+		logrus.Errorf("删除熔断文件失败（重启后会再次生效）：%v", err)
+	}
+	if had {
+		logrus.Infof("风控熔断已解除：%s", reason)
+	}
+	return had
+}
+
+func writeFileAtomic(path string, v any) error {
+	data, err := json.MarshalIndent(v, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, data, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, path)
+}
+
+// riskEvidenceMaxAge 写熔断时只认这么久以内落的风控证据（同一请求里撞上就写熔断，远小于这个数）。
+const riskEvidenceMaxAge = 2 * time.Minute
+
+// tripRisk 写熔断（验证码另记 captcha_at，兼容旧字段）。1008：把这次撞风控时页面探针落的证据挂上（url / tab / evidence）；
+// 这是一次新的熔断时，上一轮验证窗口的结论（verify_result）作废。
+func (s *XiaohongshuService) tripRisk(code, detail string) *riskHold {
+	if code == xiaohongshu.RiskHiddenWidget { // 看不见的验证组件只停本次、不写熔断（调用方本该先分流，这里兜底）
+		logrus.Warnf("看不见的验证组件不写熔断：%s", detail)
+		return s.hold.get()
+	}
+	if code == xiaohongshu.RiskCaptcha {
+		s.state.set(func(l *loginState) { l.captcha = time.Now() })
+	}
+	fresh := s.hold.get() == nil
+	h := s.hold.trip(code, detail, xiaohongshu.TakeRiskEvidence(code, riskEvidenceMaxAge))
+	if fresh {
+		s.state.set(func(l *loginState) { l.resetVerify() })
+	}
+	return h
+}
+
+// noteRisk 错误若是风控类就写熔断，返回它；否则返回 nil。看不见的验证组件（HIDDEN_WIDGET）返回它但不写熔断。
+func (s *XiaohongshuService) noteRisk(err error) *xiaohongshu.RiskError {
+	r := xiaohongshu.AsRisk(err)
+	if r != nil && !r.Hidden() {
+		s.tripRisk(r.Code, r.Detail)
+	}
+	return r
+}
+
+// clearRisk 解除熔断和验证码时间戳。
+func (s *XiaohongshuService) clearRisk(reason string) {
+	s.hold.clear(reason)
+	s.state.set(func(l *loginState) { l.captcha = time.Time{} })
+}
+
+// clearRiskIf 只在当前熔断码是 code 时解除（例如「已是登录态」只能解 NOT_LOGGED_IN）。
+func (s *XiaohongshuService) clearRiskIf(code, reason string) bool {
+	h := s.hold.get()
+	if h == nil || h.Code != code {
+		if h != nil {
+			logrus.Infof("%s，但熔断码是 %s，不由这里解除", reason, h.Code)
+		}
+		return false
+	}
+	s.clearRisk(reason)
+	return true
+}
+
+// holdError 拿到浏览器锁后发现已在熔断中（排队期间别的请求撞了风控）。Error() 以 "[RISK_HOLD]" 开头。
+type holdError struct{ hold *riskHold }
+
+func (e *holdError) Error() string { return holdText(e.hold) }
+
+// asHold 错误链里若是 holdError，返回熔断内容。
+func asHold(err error) *riskHold {
+	var h *holdError
+	if errors.As(err, &h) {
+		return h.hold
+	}
+	return nil
+}
+
+// holdGuard 给 browser.NewBrowserGuarded：拿到 profile 锁之后、启动浏览器之前再查一次熔断。
+func (s *XiaohongshuService) holdGuard() error {
+	if h := s.hold.get(); h != nil {
+		logrus.Warnf("拿到浏览器锁时已在风控熔断中（%s），不开浏览器", h.Code)
+		return &holdError{hold: h}
+	}
+	return nil
+}
+
+// respondServiceError 服务层报错统一出口：熔断 → 423 RISK_HOLD；风控 → respondRisk；其他按调用方给的码。
+func (s *AppServer) respondServiceError(c *gin.Context, err error, status int, code, msg string) {
+	if h := asHold(err); h != nil {
+		respondHold(c, h)
+		return
+	}
+	if r := xiaohongshu.AsRisk(err); r != nil {
+		s.respondRisk(c, r)
+		return
+	}
+	if r := xiaohongshu.AsNoteRestricted(err); r != nil { // 1011：只是这一篇（网页版要验证），不写熔断
+		respondNoteRestricted(c, r)
+		return
+	}
+	respondError(c, status, code, msg, err.Error())
+}
+
+// respondRisk 风控停车：写熔断，按码回 423 / 401。
+// 1008 第二轮：看不见的验证组件（HIDDEN_WIDGET）不写熔断，回 503（TRANSIENT：这次先停，下次照常），带证据目录（只在本机）。
+func (s *AppServer) respondRisk(c *gin.Context, r *xiaohongshu.RiskError) {
+	if r.Hidden() {
+		body := gin.H{"error": xiaohongshu.HiddenWidgetText, "code": r.Code, "details": r.Detail}
+		if r.Evidence != "" {
+			body["evidence"] = r.Evidence
+		}
+		logrus.Warnf("%s %s %d %s（%s）", c.Request.Method, c.Request.URL.Path, http.StatusServiceUnavailable, r.Code, r.Why)
+		c.JSON(http.StatusServiceUnavailable, body)
+		return
+	}
+	hold := s.xiaohongshuService.tripRisk(r.Code, r.Detail).view(false)
+	status, msg, hint := http.StatusLocked, "小红书把账号跳到了登录异常/安全页，已停止操作", "先在手机 App 看看账号状态，再扫码登录；期间不要反复重试"
+	switch r.Code {
+	case xiaohongshu.RiskCaptcha:
+		msg, hint = "小红书要求安全验证（拼图滑块），已停止操作", "打开验证窗口手动完成，或等几小时后再试；期间不要反复重试"
+	case xiaohongshu.RiskNotLoggedIn:
+		status, msg, hint = http.StatusUnauthorized, "小红书未登录或登录已失效", "扫码登录后再试"
+	}
+	logrus.Errorf("%s %s %d %s", c.Request.Method, c.Request.URL.Path, status, r.Code)
+	c.JSON(status, gin.H{"error": msg, "code": r.Code, "details": r.Detail + "；" + hint, "hold": hold})
+}
+
+func respondHold(c *gin.Context, h *riskHold) {
+	logrus.Warnf("%s %s 423 RISK_HOLD（%s）", c.Request.Method, c.Request.URL.Path, h.Code)
+	c.AbortWithStatusJSON(http.StatusLocked, gin.H{"error": "读取服务处于风控熔断中，已拒绝开浏览器", "code": codeRiskHold,
+		"details": "扫码登录、打开验证窗口完成，或确认没事后 POST /api/v1/risk/clear", "hold": h.view(false)})
+}
+
+// holdExempt 熔断中仍放行的接口：它们要么不开浏览器，要么就是用来解除熔断的。
+var holdExempt = []string{"/login/session", "/login/window", "/verify/window", "/login/logout", "/risk/clear",
+	"/login/qrcode", "/login/cookies"}
+
+func (s *AppServer) riskGuard() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		p := c.Request.URL.Path
+		for _, e := range holdExempt {
+			if strings.HasSuffix(p, e) {
+				c.Next()
+				return
+			}
+		}
+		if h := s.xiaohongshuService.hold.get(); h != nil {
+			respondHold(c, h)
+			return
+		}
+		c.Next()
+	}
+}
+
+// mcpHoldExempt 熔断中仍放行的 MCP 工具（不开浏览器，或是登录本身）。
+var mcpHoldExempt = map[string]bool{"delete_cookies": true, "get_login_qrcode": true}
+
+func holdText(h *riskHold) string {
+	return fmt.Sprintf("[RISK_HOLD] 读取服务处于风控熔断中（%s，自 %s）：%s。已拒绝开浏览器；扫码登录、验证窗口完成或 POST /api/v1/risk/clear 之后再试",
+		h.Code, h.Since, h.Detail)
+}
+
+// mcpRiskMiddleware 熔断中拒绝 /mcp 的工具调用（入库主路 get_feed_detail 也走这里）。
+func (s *AppServer) mcpRiskMiddleware(next mcp.MethodHandler) mcp.MethodHandler {
+	return func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {
+		if method == "tools/call" {
+			if r, ok := req.(*mcp.CallToolRequest); ok && r.Params != nil && !mcpHoldExempt[r.Params.Name] {
+				if h := s.xiaohongshuService.hold.get(); h != nil {
+					logrus.Warnf("MCP %s 被熔断拒绝（%s）", r.Params.Name, h.Code)
+					return &mcp.CallToolResult{IsError: true, Content: []mcp.Content{&mcp.TextContent{Text: holdText(h)}}}, nil
+				}
+			}
+		}
+		return next(ctx, method, req)
+	}
+}
+
+// riskClearHandler POST /api/v1/risk/clear：人工确认没事后解除熔断。
+func (s *AppServer) riskClearHandler(c *gin.Context) {
+	cleared := s.xiaohongshuService.hold.get() != nil
+	s.xiaohongshuService.clearRisk("POST /api/v1/risk/clear")
+	respondSuccess(c, map[string]any{"cleared": cleared, "risk_hold": nil}, "熔断已解除")
+}
+
+// currentLock 读 profile 锁占用（只读内存，不碰锁本身；测试里可替换）。
+var currentLock = browser.CurrentLock
+
+// lockSnapshot /login/session 里的 lock 字段：{"owner","since","held_s"} 或 nil。
+func lockSnapshot(l *browser.LockInfo, now time.Time) any {
+	if l == nil {
+		return nil
+	}
+	return map[string]any{"owner": l.Owner, "since": l.Since.Format(time.RFC3339), "held_s": int(now.Sub(l.Since).Seconds())}
+}
