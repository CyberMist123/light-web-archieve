+// TestScrollFavoritesStopsOnHiddenWidget 1008 第二轮：滚动途中页面里有看不见的验证组件（或出现一下又没了）——立即停、
+// 一次都不再滚，不返回风控（不写熔断），已读到的按 partial 交回（hidden_widget），带证据目录。
+func TestScrollFavoritesStopsOnHiddenWidget(t *testing.T) {
+	scrolls, count := 0, 0
+	cfg := fastFavCfg(0)
+	cfg.Budget = time.Minute
+	res, r := scrollFavorites(context.Background(), cfg,
+		func() favProbe { count += 10; return favProbe{Count: count, HasMore: 1, Tab: "fav"} },
+		func(int) { scrolls++ },
+		func() *RiskError {
+			if count >= 50 {
+				return &RiskError{Code: RiskHiddenWidget, Detail: HiddenWidgetDetail, Why: "hidden-widget:offscreen", Evidence: "EV"}
+			}
+			return nil
+		})
+	assert.Nil(t, r, "看不见的验证组件不是风控：不写熔断")
+	assert.Equal(t, FavStopHidden, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Equal(t, "EV", res.Evidence)
+	n := scrolls
+	assert.Equal(t, res.Count, count, "命中那轮的读数照样算进去")
+	assert.Equal(t, n, res.Scrolls, "命中后一次都不再滚")
+	assert.Equal(t, favScrollRiskEvery, scrolls, "第 2 次检查（第 4 轮）命中：之前滚了一组")
