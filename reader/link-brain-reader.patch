+// TestLoadFloorsBigLimitStopsOnBudget 楼层上限放宽（统计「一次最多几楼」）：预算到了收手，如实报读到几楼、没轮到的楼。
+func TestLoadFloorsBigLimitStopsOnBudget(t *testing.T) {
+	fc := newFake(10, floors(5000, func(i int) *fakeFloor { return &fakeFloor{id: id(i % 676), shown: 0} })...)
+	for i, f := range fc.floors {
+		f.id = id(i/676) + id(i%676)
+	}
+	cfg := fastFloorCfg(2000, 60*time.Millisecond)
+	cfg.Tick = func(int) time.Duration { return 5 * time.Millisecond }
+	res, r := loadFloors(context.Background(), cfg, fc.ops(2000))
+	require.Nil(t, r)
+	assert.Equal(t, CommentStopBudget, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Greater(t, res.FloorsLoaded, 10)
+	assert.Less(t, res.FloorsLoaded, 2000)
+	assert.Equal(t, res.FloorsLoaded, res.FloorsExpanded)
+	assert.InDelta(t, 0.06, res.BudgetSeconds, 0.5)
+}
