+		"/v/display-none":   `<div class="red-captcha-container" style="display:none;width:320px;height:240px">` + slider + `</div>`,
+		"/v/ancestor-alpha": `<div style="opacity:0"><div class="red-captcha-container" style="width:320px;height:240px;background:#eee"></div></div>`,
