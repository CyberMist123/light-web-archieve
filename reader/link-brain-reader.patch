+	app.respondServiceError(c2, &xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}, 500, "X", "x")
+	assert.Equal(t, http.StatusLocked, w2.Code)
+	assert.NotNil(t, app.xiaohongshuService.hold.get())
+}
+
+func TestPickTokenAndKeyword(t *testing.T) {
+	feeds := []xiaohongshu.Feed{{ID: "aaa", XsecToken: "t1"}, {ID: strings.ToUpper(testNote), XsecToken: "t2"}, {ID: "bbb"}}
+	assert.Equal(t, "t2", pickToken(feeds, testNote))
+	assert.Equal(t, "", pickToken(feeds, "bbb"), "没口令的不算")
+	assert.Equal(t, "", pickToken(nil, testNote))
