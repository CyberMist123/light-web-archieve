+// TestCollectWatchRefused 收藏接口最近一次回包是拒绝（HTTP ≥400 / success=false）才算；之后又正常回了一页就不算；
+// 请求没回来（换页时被取消）不算。
+func TestCollectWatchRefused(t *testing.T) {
+	w := &CollectWatch{pending: map[proto.NetworkRequestID]int{}}
+	assert.Equal(t, "", w.Refused())
+	w.add("a", CollectCall{Status: 200})
+	w.fill("a", `{"code":0,"success":true,"data":{"has_more":true,"notes":[]}}`, nil)
+	assert.Equal(t, "", w.Refused())
+	w.add("b", CollectCall{Status: 461})
+	assert.Contains(t, w.Refused(), "461", "状态码先到：回包还没取也算")
+	w.fill("b", `{"code":300011,"success":false,"msg":"当前账号存在异常"}`, nil)
+	assert.Contains(t, w.Refused(), "300011")
+	w.add("c", CollectCall{Status: 200})
+	w.fail("c", "net::ERR_ABORTED")
+	assert.Contains(t, w.Refused(), "461", "没回来的请求跳过，看它前面那次")
+	w.add("d", CollectCall{Status: 200})
+	w.fill("d", `{"code":-1,"success":false,"msg":"x"}`, nil)
+	assert.Contains(t, w.Refused(), "code=-1")
+	w.add("e", CollectCall{Status: 200})
+	w.fill("e", `{"code":0,"success":true}`, nil)
+	assert.Equal(t, "", w.Refused(), "之后又正常回了一页：不算")
+	var nilWatch *CollectWatch
+	assert.Equal(t, "", nilWatch.Refused())
+	assert.Equal(t, "", CollectRefused(nil))
+}
