+// TestCommentLoadWindowRespectsRequestBudget 评论预算 = min(commentBudget, 请求预算剩余 − 尾巴)。
+func TestCommentLoadWindowRespectsRequestBudget(t *testing.T) {
+	now := time.Now()
+	cfg := CommentLoadConfig{RequestBudget: 540 * time.Second, RequestStart: now}
+	assert.Equal(t, commentLoadBudget, commentLoadWindow(context.Background(), cfg, now), "刚进来：8 分钟上限说了算")
+	cfg.RequestStart = now.Add(-200 * time.Second) // 排队 + 开浏览器用了 200 秒
+	assert.Equal(t, 540*time.Second-200*time.Second-requestTailReserve, commentLoadWindow(context.Background(), cfg, now))
+	cfg.RequestStart = now.Add(-600 * time.Second)
+	assert.Equal(t, time.Duration(0), commentLoadWindow(context.Background(), cfg, now))
+	ctx, cancel := context.WithDeadline(context.Background(), now.Add(4*time.Minute))
+	defer cancel()
+	cfg.RequestStart = now
+	assert.Equal(t, 4*time.Minute-extractReserve, commentLoadWindow(ctx, cfg, now), "总时限更紧时听总时限")
+}
