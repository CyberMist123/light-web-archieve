+// favTick 滚动间隔：1.7–3.1 秒均匀抖动，大约每 12 次多停 3–6 秒（像人停下来看一眼）。
+func favTick(int) time.Duration {
+	d := 1700*time.Millisecond + time.Duration(rand.Int63n(int64(1400*time.Millisecond)))
+	if rand.Intn(12) == 0 {
+		d += 3*time.Second + time.Duration(rand.Int63n(int64(3*time.Second)))
+	}
+	return d
