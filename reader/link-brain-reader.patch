+package xiaohongshu
+
+// 1004d 第二版（19:54 真号试跑之后）：公平分档、每楼回复上限、退避重试、疑似限频、诊断。
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestLoadFloorsFairRounds 公平分档：先让每楼都到 30 条，再轮回来继续，不让前几楼吃光预算。
+func TestLoadFloorsFairRounds(t *testing.T) {
+	fc := newFake(3, &fakeFloor{id: "a", shown: 100, loaded: 1, perClick: 10},
+		&fakeFloor{id: "b", shown: 100, loaded: 1, perClick: 10}, &fakeFloor{id: "c", shown: 100, loaded: 1, perClick: 10})
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), fc.ops(10))
+	require.GreaterOrEqual(t, len(fc.order), 18)
+	assert.Equal(t, []string{"a", "a", "a", "b", "b", "b", "c", "c", "c"}, fc.order[:9], "第一档：每楼先到 30 条")
+	assert.Equal(t, []string{"a", "a", "a", "b", "b", "b", "c", "c", "c"}, fc.order[9:18], "第二档：再各到 60 条")
+	assert.Equal(t, CommentStopEnd, res.Reason)
+	assert.False(t, res.Partial)
+}
+
+// TestLoadFloorsFairUnderBudget 预算只够点一部分：每楼都分到一批，缺口如实报。
+func TestLoadFloorsFairUnderBudget(t *testing.T) {
+	fc := newFake(10, floors(10, func(i int) *fakeFloor { return &fakeFloor{id: id(i), shown: 200, loaded: 1, perClick: 5} })...)
+	ops := fc.ops(10)
+	inner := ops.expand
+	ops.expand = func(f floorInfo) clickResult { time.Sleep(2 * time.Millisecond); return inner(f) }
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, 250*time.Millisecond), ops)
+	assert.Equal(t, CommentStopBudget, res.Reason)
+	assert.True(t, res.Partial)
+	for i, f := range fc.floors {
+		assert.Greater(t, f.loaded, 1, "第 %d 楼也要分到一批", i+1)
+	}
+	assert.Len(t, res.RepliesPartial, 10)
+	assert.Greater(t, res.RepliesMissing, 0)
+}
+
+// TestLoadFloorsReplyCap 每楼回复上限：到了就不再点，列 reply_cap 但不算 partial。
+func TestLoadFloorsReplyCap(t *testing.T) {
+	fc := newFake(2, &fakeFloor{id: "a", shown: 100, loaded: 1, perClick: 10}, &fakeFloor{id: "b", shown: 5, loaded: 1, perClick: 10})
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.ReplyCap = 20
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(10))
+	assert.Equal(t, 21, fc.floors[0].loaded)
+	assert.Equal(t, 2, fc.clicks["a"])
+	require.Len(t, res.RepliesPartial, 1)
+	assert.Equal(t, ReplyGapReplyCap, res.RepliesPartial[0].Reason)
+	assert.Equal(t, 79, res.RepliesPartial[0].Missing)
+	assert.False(t, res.Partial)
+	assert.Equal(t, 20, res.ReplyCap)
+}
+
+// TestLoadFloorsClickFailBackoffThenRecovers 点不动两次后能点了：按退避重试，不放弃，最后展开到底。
+func TestLoadFloorsClickFailBackoffThenRecovers(t *testing.T) {
+	fc := newFake(1, &fakeFloor{id: "a", shown: 30, loaded: 1, perClick: 10, failNext: 2})
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.Backoff = []time.Duration{20 * time.Millisecond, 50 * time.Millisecond, time.Second}
+	start := time.Now()
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(10))
+	assert.GreaterOrEqual(t, time.Since(start), 70*time.Millisecond, "两次失败后分别退避 20ms、50ms")
+	assert.Equal(t, 30, fc.floors[0].loaded)
+	assert.Equal(t, 2, res.ClickFails)
+	assert.Empty(t, res.RepliesPartial)
+	assert.False(t, res.Partial)
+}
+
+// TestLoadFloorsBackoffServesOtherFloors 一楼在退避时先去点别的楼，不干等。
+func TestLoadFloorsBackoffServesOtherFloors(t *testing.T) {
+	fc := newFake(2, &fakeFloor{id: "a", shown: 11, loaded: 1, perClick: 10, failNext: 1}, &fakeFloor{id: "b", shown: 11, loaded: 1, perClick: 10})
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.Backoff = []time.Duration{100 * time.Millisecond, time.Second, time.Second}
+	loadFloors(context.Background(), cfg, fc.ops(10))
+	assert.Equal(t, []string{"b", "a"}, fc.order)
+}
+
+// TestLoadFloorsClickFailedGivesUpWithDetail 一直点不动：退避用完放弃，detail 带点击报错和离上次成功多久。
+func TestLoadFloorsClickFailedGivesUpWithDetail(t *testing.T) {
+	fc := newFake(2, &fakeFloor{id: "a", shown: 30, loaded: 1, perClick: 10, failAll: true}, &fakeFloor{id: "b"})
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), fc.ops(10))
+	require.Len(t, res.RepliesPartial, 1)
+	g := res.RepliesPartial[0]
+	assert.Equal(t, ReplyGapClickFailed, g.Reason)
+	assert.Contains(t, g.Detail, "点不动")
+	assert.Contains(t, g.Detail, "context deadline exceeded")
+	assert.Contains(t, g.Detail, "距上次成功")
+	assert.Equal(t, 4, res.ClickFails)
+	assert.True(t, res.Partial)
+}
+
+// TestLoadFloorsNoGrowthDetailHasDiagnosis 点了不涨：detail 带诊断（按钮状态 / 条数）。
+func TestLoadFloorsNoGrowthDetailHasDiagnosis(t *testing.T) {
+	fc := newFake(1, &fakeFloor{id: "a", shown: 8, loaded: 1, perClick: 0})
+	ops := fc.ops(10)
+	ops.diagnose = func(floorInfo) string { return "按钮「展开更多回复」遮挡=engage-bar" }
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), ops)
+	require.Len(t, res.RepliesPartial, 1)
+	assert.Equal(t, ReplyGapNoGrowth, res.RepliesPartial[0].Reason)
+	assert.Contains(t, res.RepliesPartial[0].Detail, "遮挡=engage-bar")
+	assert.Contains(t, res.RepliesPartial[0].Detail, "回复数没变")
+}
+
+// TestLoadFloorsThrottledStops 连续多楼都点不动：歇两次仍不行就判停 throttled。
+func TestLoadFloorsThrottledStops(t *testing.T) {
+	fc := newFake(3, floors(3, func(i int) *fakeFloor { return &fakeFloor{id: id(i), shown: 30, loaded: 1, perClick: 10} })...)
+	fc.blocked = true
+	cfg := fastFloorCfg(10, time.Minute)
+	pauses := 0
+	cfg.ThrottlePause = func() time.Duration { pauses++; return time.Millisecond }
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(10))
+	assert.Equal(t, CommentStopThrottled, res.Reason)
+	assert.Equal(t, 2, res.ThrottlePauses)
+	assert.Equal(t, 2, pauses)
+	assert.True(t, res.Partial)
+	assert.Empty(t, fc.clicks)
+}
+
+// TestLoadFloorsThrottlePauseRecovers 疑似限频歇一次后恢复：继续展开到底，放弃过的楼也重新给机会。
+func TestLoadFloorsThrottlePauseRecovers(t *testing.T) {
+	fc := newFake(3, floors(3, func(i int) *fakeFloor { return &fakeFloor{id: id(i), shown: 30, loaded: 1, perClick: 10} })...)
+	fc.blocked = true
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.ThrottlePause = func() time.Duration { fc.blocked = false; return 20 * time.Millisecond }
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(10))
+	assert.Equal(t, CommentStopEnd, res.Reason)
+	assert.Equal(t, 1, res.ThrottlePauses)
+	assert.False(t, res.Partial)
+	for _, f := range fc.floors {
+		assert.Equal(t, 30, f.loaded)
+	}
+}
+
+// TestLoadFloorsButtonTextChangeCountsAsResponse 点完回复数没涨但按钮文本变了（「展开 N 条」→「展开更多」）：算有反应，不记失败。
+func TestLoadFloorsButtonTextChangeCountsAsResponse(t *testing.T) {
+	clicks := 0
+	snap := func() floorSnapshot {
+		text, loaded, hasMore := "展开 9 条回复", 1, 1
+		if clicks >= 1 {
+			text = "展开更多回复"
+		}
+		if clicks >= 2 {
+			loaded, hasMore = 10, 0
+		}
+		f := floorInfo{ID: "a", Shown: 10, Loaded: loaded, HasMore: hasMore, Button: hasMore == 1, BtnText: text}
+		return floorSnapshot{OK: true, Floors: []floorInfo{f}, Loaded: 1, Total: 10, HasMore: 0}
+	}
+	ops := floorOps{probe: snap, expand: func(floorInfo) clickResult { clicks++; return clickResult{OK: true} },
+		scroll: func(int) {}, risk: noRisk}
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), ops)
+	assert.Equal(t, 2, clicks)
+	assert.Equal(t, 0, res.ClickFails)
+	assert.False(t, res.Partial)
+}
+
+// TestFormatFloorDiag 诊断压成一句：按钮文本、位置、视口、遮挡、disabled、DOM / 状态条数。
+func TestFormatFloorDiag(t *testing.T) {
+	got := formatFloorDiag(`{"root":true,"domSubs":96,"stateSubs":96,"hasMore":true,"shown":"224","cands":1,"text":"展开更多回复",` +
+		`"rect":[300,860,120,24],"vh":900,"inView":true,"covered":"engage-bar","disabled":false,"loading":false,"visible":true}`)
+	for _, want := range []string{"展开更多回复", "(300,860 120×24)", "视口内=是", "遮挡=engage-bar", "disabled=否", "DOM 96", "状态 96", "224"} {
+		assert.Contains(t, got, want)
+	}
+	assert.Contains(t, formatFloorDiag(`{"root":false}`), "找不到这楼")
+	assert.Contains(t, formatFloorDiag(`{"root":true,"cands":0}`), "没有展开按钮")
+	assert.Contains(t, formatFloorDiag(`oops`), "诊断读不出")
+}
diff --git a/xiaohongshu/evidence.go b/xiaohongshu/evidence.go
new file mode 100644
index 0000000..5f0bc8d
--- /dev/null
+++ b/xiaohongshu/evidence.go
@@ -0,0 +1,731 @@
+package xiaohongshu
+
+// 出事证据（1008，B1）：撞风控、「切换到收藏第 1 轮未生效」、「列表卡住且 hasMore=true」这三个时刻，
+// 当场把程序看见的页面落盘，事后谁都能核对「到底有没有滑块、是谁挡住了点击、收藏接口回了什么」。
+//
+//	~/.link-brain/risk-evidence/<YYYYMMDD-HHMMSS>/
+//	  shot.png   视口截图（CDP Page.captureScreenshot，只截当前视口：不改视口尺寸、不滚动，不会触发懒加载请求）
+//	  hit.html   开头一行 CSP（default-src 'none'：双击打开也不去拉小红书的资源）+ 命中元素 outerHTML，共 ≤2KB
+//	             （没有命中元素时：页签中心那个元素；再没有：body）
+//	  meta.json  url / path / tab（activeTab.query）/ want_tab（程序要去的子页签）/ why · kind · hidden_why / verdict（复读后的结论）/
+//	             命中元素 tag·class·id·rect / 祖先链样式 / 中心点 elementFromPoint 是不是它自己 /
+//	             「收藏」页签中心 elementFromPoint 的元素 / 收藏接口回包摘要 / probe_error（最近读页失败）
+//
+// 时刻另有：看不见的验证组件（hidden_widget，1008 第二轮）、收藏接口回拒绝（fav_api_refused）。
+// 只读页面，不点、不导航、不发任何网络请求。截图里有私密收藏：只存本机，保留 14 天自动删（每次落证据、服务启动、
+// /login/session 被轮询时最多每小时一次）；不进「复制报错」、不进 WebDAV（Python 侧负责排除）。
+// 根目录：LINK_BRAIN_EVIDENCE_DIR → $LINK_BRAIN_HOME/risk-evidence → ~/.link-brain/risk-evidence（与 Python 的 home() 一致）。
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/proto"
+	"github.com/sirupsen/logrus"
+)
+
+// 落证据的时刻（meta.json 的 trigger）。
+const (
+	EvidenceRisk     = "risk"             // 命中风控（RiskPage / 详情页错误容器写着安全验证）
+	EvidenceHidden   = "hidden_widget"    // 看不见的验证组件（停本次、不写熔断；1008 第二轮）
+	EvidenceTabClick = "fav_tab_click"    // 切换到收藏第 1 轮拟人点击没生效
+	EvidenceStalled  = "fav_list_stalled" // 收藏列表卡住、页面还说有更多（hasMore=true）
+	EvidenceRefused  = "fav_api_refused"  // 收藏接口回了拒绝（HTTP ≥400 / success=false）
+)
+
+// EvidenceKeep 证据保留多久。
+const EvidenceKeep = 14 * 24 * time.Hour
+
+const (
+	evidenceHitMax    = 2048 // hit.html 上限（字节，含开头那行 CSP）
+	evidenceSnippet   = 1024 // meta.json 里中心点元素 outerHTML 上限（字节）
+	evidenceDedupe    = 30 * time.Second
+	evidenceDirLayout = "20060102-150405"
+	// hitCSP hit.html 开头加一行 CSP：她双击打开时浏览器不去拉小红书的图片 / iframe / 脚本（那会带着她日常浏览器的登录态）。
+	hitCSP = `<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">` + "\n"
+	// evidencePruneEvery 服务常驻、几周不出事时也要清旧证据：/login/session 被轮询时顺手清，最多每小时一次。
+	evidencePruneEvery = time.Hour
+	// probeErrorKeep 读页失败记录多久内算「这次的」（进下一份证据的 probe_error）。
+	probeErrorKeep = 10 * time.Minute
+)
+
+var evidenceDirRe = regexp.MustCompile(`^(\d{8}-\d{6})(-\d+)?$`)
+
+// evidenceFiles 证据目录里只会有这几个文件；清旧证据时目录里有别的东西就不删（不是本模块建的）。
+var evidenceFiles = map[string]bool{"shot.png": true, "hit.html": true, "meta.json": true}
+
+// Evidence 一次落盘的证据（服务层只用 Dir / URL / Tab / WantTab / Code）。
+type Evidence struct {
+	Dir     string
+	Trigger string
+	Code    string
+	URL     string
+	Tab     string
+	// WantTab 出事时程序要去的子页签（读收藏 = fav），见 SetPageIntent。页签没点动接着弹验证时 Tab 还是 note，靠它知道是读收藏出的事。
+	WantTab string
+	At      time.Time
+}
+
+// ---- 页面意图：这一页是在为哪个子页签干活（读收藏 = fav），落证据时一并记下 ----
+
+var pageIntents sync.Map // proto.TargetTargetID → string
+
+// SetPageIntent 记下这一页正在为哪个子页签干活；返回撤销函数（defer 调）。
+func SetPageIntent(page *rod.Page, tab string) func() {
+	if page == nil || tab == "" {
+		return func() {}
+	}
+	id := page.TargetID
+	prev, had := pageIntents.Load(id)
+	pageIntents.Store(id, tab)
+	return func() {
+		if had {
+			pageIntents.Store(id, prev)
+		} else {
+			pageIntents.Delete(id)
+		}
+	}
+}
+
+func pageIntent(page *rod.Page) string {
+	if page == nil {
+		return ""
+	}
+	if v, ok := pageIntents.Load(page.TargetID); ok {
+		return v.(string)
+	}
+	return ""
+}
+
+// ---- 风控探针读页失败：写日志（readRiskProbe），并记进下一份证据的 probe_error ----
+
+var probeErr struct {
+	mu     sync.Mutex
+	target proto.TargetTargetID
+	at     time.Time
+	msg    string
+	count  int
+}
+
+func noteProbeError(page *rod.Page, err error) {
+	if page == nil || err == nil {
+		return
+	}
+	probeErr.mu.Lock()
+	defer probeErr.mu.Unlock()
+	if probeErr.target != page.TargetID || time.Since(probeErr.at) > probeErrorKeep {
+		probeErr.count = 0
+	}
+	probeErr.target, probeErr.at, probeErr.msg = page.TargetID, time.Now(), truncBytes(err.Error(), 300)
+	probeErr.count++
+}
+
+// lastProbeError 这一页最近 probeErrorKeep 内的读页失败（没有返回 nil）。
+func lastProbeError(page *rod.Page) map[string]any {
+	probeErr.mu.Lock()
+	defer probeErr.mu.Unlock()
+	if page == nil || probeErr.target != page.TargetID || probeErr.at.IsZero() || time.Since(probeErr.at) > probeErrorKeep {
+		return nil
+	}
+	return map[string]any{"at": probeErr.at.Format(time.RFC3339), "error": probeErr.msg, "count": probeErr.count}
+}
+
+// EvidenceRoot 证据根目录。
+func EvidenceRoot() string {
+	if d := strings.TrimSpace(os.Getenv("LINK_BRAIN_EVIDENCE_DIR")); d != "" {
+		return d
+	}
+	if h := strings.TrimSpace(os.Getenv("LINK_BRAIN_HOME")); h != "" {
+		return filepath.Join(h, "risk-evidence")
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return filepath.Join(os.TempDir(), "link-brain-risk-evidence")
+	}
+	return filepath.Join(home, ".link-brain", "risk-evidence")
+}
+
+// PruneEvidence 删掉 root 下早于 now-keep 的证据目录；只认本模块起的目录名（YYYYMMDD-HHMMSS[-n]），
+// 而且目录里只能有本模块写的文件（shot.png / hit.html / meta.json，没有子目录）——LINK_BRAIN_EVIDENCE_DIR 配错、
+// 指到一个按时间命名的备份目录时，别人的东西一概不碰。
+func PruneEvidence(root string, keep time.Duration, now time.Time) int {
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return 0
+	}
+	removed := 0
+	for _, e := range entries {
+		m := evidenceDirRe.FindStringSubmatch(e.Name())
+		if !e.IsDir() || m == nil {
+			continue
+		}
+		at, err := time.ParseInLocation(evidenceDirLayout, m[1], time.Local)
+		if err != nil || now.Sub(at) <= keep {
+			continue
+		}
+		dir := filepath.Join(root, e.Name())
+		if !onlyEvidenceFiles(dir) {
+			logrus.Warnf("出事证据：%s 里有不是本模块写的东西，不删", dir)
+			continue
+		}
+		if os.RemoveAll(dir) == nil {
+			removed++
+		}
+	}
+	if removed > 0 {
+		logrus.Infof("出事证据：删掉 %d 份超过 %s 的旧证据（%s）", removed, keep, root)
+	}
+	return removed
+}
+
+func onlyEvidenceFiles(dir string) bool {
+	es, err := os.ReadDir(dir)
+	if err != nil {
+		return false
+	}
+	for _, f := range es {
+		if f.IsDir() || !evidenceFiles[f.Name()] {
+			return false
+		}
+	}
+	return true
+}
+
+var lastPrune struct {
+	mu sync.Mutex
+	at time.Time
+}
+
+// MaybePruneEvidence 节流清旧证据（最多每 evidencePruneEvery 一次）：服务常驻、几周不出事也照样清。
+// /login/session 被轮询时在后台调，不拖慢它。
+func MaybePruneEvidence(now time.Time) bool {
+	lastPrune.mu.Lock()
+	if !lastPrune.at.IsZero() && now.Sub(lastPrune.at) < evidencePruneEvery {
+		lastPrune.mu.Unlock()
+		return false
+	}
+	lastPrune.at = now
+	lastPrune.mu.Unlock()
+	PruneEvidence(EvidenceRoot(), EvidenceKeep, now)
+	return true
+}
+
+// newEvidenceDir 在 root 下按时刻建目录；同一秒已有就加 -2、-3…
+func newEvidenceDir(root string, at time.Time) (string, error) {
+	if err := os.MkdirAll(root, 0o700); err != nil {
+		return "", err
+	}
+	base := at.Format(evidenceDirLayout)
+	for i := 1; i < 100; i++ {
+		name := base
+		if i > 1 {
+			name = fmt.Sprintf("%s-%d", base, i)
+		}
+		dir := filepath.Join(root, name)
+		if err := os.Mkdir(dir, 0o700); err == nil {
+			return dir, nil
+		} else if !os.IsExist(err) {
+			return "", err
+		}
+	}
+	return "", fmt.Errorf("证据目录重名太多：%s", base)
+}
+
+// evidenceJS 读一次页面要落进 meta.json 的东西（只读）。label = 要看的子页签文字（如「收藏」），空串不看。
+const evidenceJS = `(label) => {
+ const hit = (` + riskFindJS + `)();
+ const unwrap = x => x?.value ?? x?._value ?? x?._rawValue ?? x;
+ const vw = window.innerWidth || 0, vh = window.innerHeight || 0;
+ const cls = (e) => { const c = e.className; return String((c && typeof c === "object" && "baseVal" in c) ? c.baseVal : (c || "")).slice(0, 300); };
+ const rectOf = (e) => { const r = e.getBoundingClientRect(); return {x: Math.round(r.left), y: Math.round(r.top), w: Math.round(r.width), h: Math.round(r.height)}; };
+ const style = (e) => { const cs = getComputedStyle(e); return {display: cs.display, visibility: cs.visibility, opacity: cs.opacity,
+   position: cs.position, z_index: cs.zIndex, pointer_events: cs.pointerEvents}; };
+ const brief = (e, n) => e ? {tag: e.tagName.toLowerCase(), id: e.id || "", class: cls(e), rect: rectOf(e), html: (e.outerHTML || "").slice(0, n)} : null;
+ const centerOf = (e) => { const r = e.getBoundingClientRect(); return {x: r.left + r.width / 2, y: r.top + r.height / 2}; };
+ const inView = (r) => r.w > 0 && r.h > 0 && r.x < vw && r.y < vh && r.x + r.w > 0 && r.y + r.h > 0;
+ const at = (p) => (p.x >= 0 && p.y >= 0 && p.x < vw && p.y < vh) ? document.elementFromPoint(p.x, p.y) : null;
+ const out = {url: location.href, path: location.pathname, title: (document.title || "").slice(0, 200), tab: "", tab_index: null,
+   viewport: {w: vw, h: vh, scroll_x: Math.round(window.scrollX || 0), scroll_y: Math.round(window.scrollY || 0)},
+   why: hit.why, kind: hit.kind || "", hidden_why: hit.hidden_why || "", hit: null, tab_probe: null, body_html: ""};
+ try {
+  const a = unwrap(window.__INITIAL_STATE__?.user?.activeTab) || {};
+  if (typeof a.query === "string") out.tab = a.query;
+  if (typeof a.index === "number") out.tab_index = a.index;
+ } catch (e) {}
+ if (hit.el) {
+  const e = hit.el, r = rectOf(e), c = centerOf(e), ce = at(c);
+  const anc = [];
+  for (let a = e.parentElement; a && anc.length < 40; a = a.parentElement) {
+   anc.push(Object.assign({tag: a.tagName.toLowerCase(), id: a.id || "", class: cls(a).slice(0, 120)}, style(a)));
+  }
+  out.hit = Object.assign(brief(e, 4096), {style: style(e), in_viewport: inView(r), center: {x: Math.round(c.x), y: Math.round(c.y)},
+   center_hit_self: !!(ce && (ce === e || e.contains(ce))), center_el: brief(ce, 2048), ancestors: anc});
+ }
+ if (label) {
+  const t = Array.from(document.querySelectorAll(".reds-tab-item.sub-tab-list")).find(x => (x.innerText || x.textContent || "").trim() === label);
+  if (t) {
+   const r = rectOf(t), c = centerOf(t), ce = at(c);
+   out.tab_probe = Object.assign(brief(t, 2048), {label, found: true, style: style(t), in_viewport: inView(r),
+    center: {x: Math.round(c.x), y: Math.round(c.y)}, center_is_tab: !!(ce && (ce === t || t.contains(ce))), center_el: brief(ce, 2048)});
+  } else {
+   out.tab_probe = {label, found: false};
+  }
+ }
+ if (!hit.el) out.body_html = ((document.body || document.documentElement).outerHTML || "").slice(0, 4096);
+ return JSON.stringify(out);
+}`
+
+// truncBytes 截到最多 n 字节，不切坏 UTF-8。
+func truncBytes(s string, n int) string {
+	if len(s) <= n {
+		return s
+	}
+	cut := n
+	for cut > 0 && !utf8.RuneStart(s[cut]) {
+		cut--
+	}
+	return s[:cut]
+}
+
+// trimHTMLField 把 m[key]（一个 brief 对象）里的 html 截到 n 字节。
+func trimHTMLField(m map[string]any, key string, n int) {
+	if sub, ok := m[key].(map[string]any); ok {
+		if h, ok := sub["html"].(string); ok {
+			sub["html"] = truncBytes(h, n)
+		}
+	}
+}
+
+// CaptureEvidence 当场落一份证据，返回它（失败返回 nil，从不 panic、不影响调用方）。
+// risk 可为 nil（非风控时刻）；tabLabel 为要看的子页签文字（「收藏」），空串不看。
+func CaptureEvidence(page *rod.Page, trigger string, risk *RiskError, tabLabel string) (ev *Evidence) {
+	if page == nil {
+		return nil
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			logrus.Warnf("落出事证据出错（不影响本次操作）：%v", r)
+			ev = nil
+		}
+	}()
+	root := EvidenceRoot()
+	now := time.Now()
+	PruneEvidence(root, EvidenceKeep, now)
+	dir, err := newEvidenceDir(root, now)
+	if err != nil {
+		logrus.Warnf("落出事证据失败（建目录）：%v", err)
+		return nil
+	}
+	// 调用方的 page 常带着已经用完的 ctx / deadline：换一份干净的，只给几秒
+	pg := page.Context(context.Background())
+	var errs []string
+	meta := map[string]any{}
+	var raw string
+	if err := rod.Try(func() { raw = pg.Timeout(8*time.Second).MustEval(evidenceJS, tabLabel).Str() }); err != nil {
+		errs = append(errs, "读页面失败："+err.Error())
+	} else if err := json.Unmarshal([]byte(raw), &meta); err != nil {
+		errs = append(errs, "页面读数解不开："+err.Error())
+		meta = map[string]any{}
+	}
+	files := map[string]any{"shot": "", "hit": ""}
+	var shot []byte
+	if err := rod.Try(func() {
+		var e error
+		shot, e = pg.Timeout(10*time.Second).Screenshot(false, &proto.PageCaptureScreenshot{Format: proto.PageCaptureScreenshotFormatPng})
+		if e != nil {
+			panic(e)
+		}
+	}); err != nil {
+		errs = append(errs, "截图失败："+err.Error())
+	} else if err := os.WriteFile(filepath.Join(dir, "shot.png"), shot, 0o600); err != nil {
+		errs = append(errs, "截图写盘失败："+err.Error())
+	} else {
+		files["shot"] = "shot.png"
+	}
+
+	// hit.html：命中元素 → 页签中心那个元素 → body
+	hitHTML, hitSource := "", ""
+	if h, ok := meta["hit"].(map[string]any); ok {
+		if s, _ := h["html"].(string); s != "" {
+			hitHTML, hitSource = s, "hit"
+		}
+		h["html_bytes"] = len(truncBytes(hitHTML, evidenceHitMax))
+		delete(h, "html")
+		trimHTMLField(h, "center_el", evidenceSnippet)
+	}
+	if tp, ok := meta["tab_probe"].(map[string]any); ok {
+		if hitHTML == "" {
+			if ce, ok := tp["center_el"].(map[string]any); ok {
+				if s, _ := ce["html"].(string); s != "" {
+					hitHTML, hitSource = s, "tab_center"
+				}
+			}
+		}
+		if s, ok := tp["html"].(string); ok {
+			tp["html"] = truncBytes(s, evidenceSnippet)
+		}
+		trimHTMLField(tp, "center_el", evidenceSnippet)
+	}
+	if body, _ := meta["body_html"].(string); hitHTML == "" && body != "" {
+		hitHTML, hitSource = body, "body"
+	}
+	delete(meta, "body_html")
+	if hitHTML != "" {
+		data := hitCSP + truncBytes(hitHTML, evidenceHitMax-len(hitCSP))
+		if err := os.WriteFile(filepath.Join(dir, "hit.html"), []byte(data), 0o600); err != nil {
+			errs = append(errs, "hit.html 写盘失败："+err.Error())
+		} else {
+			files["hit"] = "hit.html"
+		}
+	}
+
+	meta["trigger"] = trigger
+	meta["at"] = now.Format(time.RFC3339)
+	meta["hit_source"] = hitSource
+	meta["files"] = files
+	wantTab := pageIntent(page)
+	meta["want_tab"] = wantTab
+	if risk != nil {
+		meta["code"], meta["detail"] = risk.Code, risk.Detail
+		// 探针（复读后）的结论：why 是落证据这一刻重读的，可能已经变了（出现一下又没了），以这个为准
+		meta["verdict"] = risk.Why
+	}
+	if pe := lastProbeError(page); pe != nil {
+		meta["probe_error"] = pe
+	}
+	if w := collectWatchFor(page); w != nil {
+		w.waitBodies(1500 * time.Millisecond) // 刚回来的那一包回包还在取（读浏览器内存），等一小会儿
+		meta["collect_api"] = w.Summary()
+	} else {
+		meta["collect_api"] = nil
+	}
+	if len(errs) > 0 {
+		meta["errors"] = errs
+	}
+	data, _ := json.MarshalIndent(meta, "", "  ")
+	if err := os.WriteFile(filepath.Join(dir, "meta.json"), data, 0o600); err != nil {
+		logrus.Warnf("落出事证据失败（meta.json）：%v", err)
+	}
+	ev = &Evidence{Dir: dir, Trigger: trigger, At: now, WantTab: wantTab}
+	ev.URL, _ = meta["url"].(string)
+	ev.Tab, _ = meta["tab"].(string)
+	if risk != nil {
+		ev.Code = risk.Code
+	}
+	logrus.Warnf("出事证据已落盘（%s%s）：%s", trigger, map[bool]string{true: " " + ev.Code, false: ""}[ev.Code != ""], dir)
+	return ev
+}
+
+// ---- 撞风控时的证据：RiskPage 命中就落一份，服务层写熔断时取走挂进 risk-hold.json ----
+
+var riskEv struct {
+	mu     sync.Mutex
+	last   *Evidence
+	target proto.TargetTargetID
+	taken  bool
+}
+
+// noteRiskEvidence RiskPage 命中时调用：同一页面、同一码 30 秒内只落一份（同一件事常被连查两次）；
+// 证据目录记进 r.Evidence（没落新的就用 30 秒内那份）。看不见的验证组件也落（trigger=hidden_widget）。
+func noteRiskEvidence(page *rod.Page, r *RiskError) {
+	if page == nil || r == nil {
+		return
+	}
+	riskEv.mu.Lock()
+	if l := riskEv.last; l != nil && riskEv.target == page.TargetID && l.Code == r.Code && time.Since(l.At) < evidenceDedupe {
+		r.Evidence = l.Dir
+		riskEv.mu.Unlock()
+		return
+	}
+	riskEv.mu.Unlock()
+	trigger := EvidenceRisk
+	if r.Hidden() {
+		trigger = EvidenceHidden
+	}
+	ev := CaptureEvidence(page, trigger, r, tabLabel[TabFavorites])
+	if ev == nil {
+		return
+	}
+	r.Evidence = ev.Dir
+	riskEv.mu.Lock()
+	riskEv.last, riskEv.target, riskEv.taken = ev, page.TargetID, false
+	riskEv.mu.Unlock()
+}
+
+// TakeRiskEvidence 写熔断时取走最近一份同码、maxAge 内、还没被取走的风控证据；没有返回 nil。
+// 浏览器操作在进程内串行（profile 锁），所以「最近一份」就是这次出事的那份。
+func TakeRiskEvidence(code string, maxAge time.Duration) *Evidence {
+	riskEv.mu.Lock()
+	defer riskEv.mu.Unlock()
+	l := riskEv.last
+	if l == nil || riskEv.taken || l.Code != code || time.Since(l.At) > maxAge {
+		return nil
+	}
+	riskEv.taken = true
+	c := *l
+	return &c
+}
+
+// ---- 收藏接口回包：/api/sns/web/v2/note/collect/page 的 HTTP 状态和 JSON code / msg ----
+
+const collectAPIPath = "/api/sns/web/v2/note/collect/page"
+
+// CollectCall 一次收藏接口调用的摘要（不留数据本身：只留状态码、code、msg、has_more、这一页几条）。
+type CollectCall struct {
+	At      string `json:"at"`
+	Status  int    `json:"status"`
+	Code    any    `json:"code,omitempty"`
+	Success *bool  `json:"success,omitempty"`
+	Msg     string `json:"msg,omitempty"`
+	HasMore *bool  `json:"has_more,omitempty"`
+	Notes   *int   `json:"notes,omitempty"`
+	Failed  string `json:"failed,omitempty"` // 请求没回来（loadingFailed 的 errorText）
+	Body    string `json:"body_error,omitempty"`
+}
+
+// CollectWatch 监听一个页面上的收藏接口回包（CDP Network 事件 + getResponseBody：都是读浏览器内存，不发请求）。
+type CollectWatch struct {
+	mu      sync.Mutex
+	calls   []CollectCall
+	total   int
+	pending map[proto.NetworkRequestID]int // requestId → 在 calls 里的位置（-1 = 已被挤出窗口）
+	stop    context.CancelFunc
+	target  proto.TargetTargetID
+}
+
+const collectKeep = 20
+
+var collectWatches sync.Map // proto.TargetTargetID → *CollectWatch
+
+func collectWatchFor(page *rod.Page) *CollectWatch {
+	if page == nil {
+		return nil
+	}
+	if w, ok := collectWatches.Load(page.TargetID); ok {
+		return w.(*CollectWatch)
+	}
+	return nil
+}
+
+// WatchCollectAPI 开始监听；用完调 Stop。监听本身不发任何网络请求。
+func WatchCollectAPI(page *rod.Page) *CollectWatch {
+	ctx, cancel := context.WithCancel(context.Background())
+	w := &CollectWatch{pending: map[proto.NetworkRequestID]int{}, stop: cancel}
+	if page == nil {
+		return w
+	}
+	w.target = page.TargetID
+	// 先限时开 Network 域：EachEvent 自己开域时用的是不带截止的 ctx，浏览器这时卡住的话，读收藏请求会拿着
+	// profile 锁一直挂着。开成功后 rod 记下「已启用」，EachEvent 就不再自己开；开不了就不监听（不影响读收藏）。
+	if err := (proto.NetworkEnable{}).Call(page.Context(context.Background()).Timeout(5 * time.Second)); err != nil {
+		logrus.Warnf("收藏接口监听没挂上（Network.enable 5 秒内没回，不影响读收藏）：%v", err)
+		return w
+	}
+	p := page.Context(ctx)
+	err := rod.Try(func() {
+		wait := p.EachEvent(
+			func(e *proto.NetworkResponseReceived) {
+				if e.Response == nil || !strings.Contains(e.Response.URL, collectAPIPath) {
+					return
+				}
+				w.add(e.RequestID, CollectCall{At: time.Now().Format(time.RFC3339), Status: e.Response.Status})
+			},
+			func(e *proto.NetworkLoadingFinished) {
+				if !w.tracked(e.RequestID) {
+					return
+				}
+				id := e.RequestID
+				go func() {
+					var body string
+					err := rod.Try(func() {
+						res, err := proto.NetworkGetResponseBody{RequestID: id}.Call(p.Timeout(5 * time.Second))
+						if err != nil {
+							panic(err)
+						}
+						body = res.Body
+					})
+					w.fill(id, body, err)
+				}()
+			},
+			func(e *proto.NetworkLoadingFailed) {
+				if w.tracked(e.RequestID) {
+					w.fail(e.RequestID, e.ErrorText)
+				}
+			},
+		)
+		go wait()
+	})
+	if err != nil {
+		logrus.Warnf("收藏接口监听没挂上（不影响读收藏）：%v", err)
+		return w
+	}
+	collectWatches.Store(page.TargetID, w)
+	return w
+}
+
+// Stop 停止监听。
+func (w *CollectWatch) Stop() {
+	if w == nil {
+		return
+	}
+	w.stop()
+	if w.target != "" {
+		collectWatches.CompareAndDelete(w.target, w)
+	}
+}
+
+func (w *CollectWatch) add(id proto.NetworkRequestID, c CollectCall) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.total++
+	w.calls = append(w.calls, c)
+	if len(w.calls) > collectKeep {
+		drop := len(w.calls) - collectKeep
+		w.calls = w.calls[drop:]
+		for k, v := range w.pending {
+			if v -= drop; v < 0 {
+				v = -1
+			}
+			w.pending[k] = v
+		}
+	}
+	w.pending[id] = len(w.calls) - 1
+}
+
+func (w *CollectWatch) tracked(id proto.NetworkRequestID) bool {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	_, ok := w.pending[id]
+	return ok
+}
+
+func (w *CollectWatch) slot(id proto.NetworkRequestID) *CollectCall {
+	i, ok := w.pending[id]
+	if !ok || i < 0 || i >= len(w.calls) {
+		return nil
+	}
+	return &w.calls[i]
+}
+
+func (w *CollectWatch) fill(id proto.NetworkRequestID, body string, err error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	c := w.slot(id)
+	delete(w.pending, id)
+	if c == nil {
+		return
+	}
+	if err != nil {
+		c.Body = "取不到回包：" + err.Error()
+		return
+	}
+	var resp struct {
+		Code    any    `json:"code"`
+		Success *bool  `json:"success"`
+		Msg     string `json:"msg"`
+		Data    *struct {
+			HasMore *bool             `json:"has_more"`
+			Notes   []json.RawMessage `json:"notes"`
+		} `json:"data"`
+	}
+	if json.Unmarshal([]byte(body), &resp) != nil {
+		c.Body = "回包不是 JSON：" + truncBytes(strings.TrimSpace(body), 120)
+		return
+	}
+	c.Code, c.Success, c.Msg = resp.Code, resp.Success, truncBytes(resp.Msg, 200)
+	if resp.Data != nil {
+		c.HasMore = resp.Data.HasMore
+		if resp.Data.Notes != nil {
+			n := len(resp.Data.Notes)
+			c.Notes = &n
+		}
+	}
+}
+
+func (w *CollectWatch) fail(id proto.NetworkRequestID, text string) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if c := w.slot(id); c != nil {
+		c.Failed = text
+	}
+	delete(w.pending, id)
+}
+
+// waitBodies 等还在取的回包最多 max（落证据前调；平时不等）。
+func (w *CollectWatch) waitBodies(max time.Duration) {
+	deadline := time.Now().Add(max)
+	for {
+		w.mu.Lock()
+		n := len(w.pending)
+		w.mu.Unlock()
+		if n == 0 || time.Now().After(deadline) {
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+}
+
+// Calls 最近的调用（最多 20 次，旧的在前）。
+func (w *CollectWatch) Calls() []CollectCall {
+	if w == nil {
+		return nil
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return append([]CollectCall(nil), w.calls...)
+}
+
+// Refused 最近一次收藏接口回包是不是拒绝（HTTP ≥400，或 JSON success=false）；是就返回一句说明，否则空串。
+// 只看最近一次：被拒之后又正常回了一页就不算。请求没回来（loadingFailed，如换页时被取消）不算拒绝。
+func (w *CollectWatch) Refused() string {
+	if w == nil {
+		return ""
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	for i := len(w.calls) - 1; i >= 0; i-- {
+		c := w.calls[i]
+		if c.Failed != "" {
+			continue
+		}
+		if c.Status >= 400 || (c.Success != nil && !*c.Success) {
+			s := fmt.Sprintf("收藏接口回 HTTP %d", c.Status)
+			if c.Code != nil {
+				s += fmt.Sprintf(" code=%v", c.Code)
+			}
+			if c.Msg != "" {
+				s += " msg=" + c.Msg
+			}
+			return s
+		}
+		return ""
+	}
+	return ""
+}
+
+// CollectRefused 这一页上挂着的收藏接口监听看到的拒绝（没挂监听 / 没被拒返回空串）。
+func CollectRefused(page *rod.Page) string { return collectWatchFor(page).Refused() }
+
+// Summary 落进 meta.json 的摘要：总次数 + 最近 10 次。
+func (w *CollectWatch) Summary() map[string]any {
+	if w == nil {
+		return nil
+	}
+	calls := w.Calls()
+	w.mu.Lock()
+	total := w.total
+	w.mu.Unlock()
+	if len(calls) > 10 {
+		calls = calls[len(calls)-10:]
+	}
+	return map[string]any{"total": total, "recent": calls}
+}
