+
+func TestProfileSeedSurvivesReopen(t *testing.T) {
+	dir := t.TempDir()
+	first := profileSeed(dir, 12345)
+	if reopened := profileSeed(dir, 99999); reopened != first {
+		t.Fatalf("profile identity changed on reopen: %d -> %d", first, reopened)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "cookies.json")); !os.IsNotExist(err) {
+		t.Fatal("profile seed must not use cookies.json")
+	}
+}
+
+func TestDefaultProfileIndependentOfWorkingDirectory(t *testing.T) {
+	t.Setenv("XHS_PROFILE_DIR", "")
+	before := ProfileDir()
+	t.Chdir(t.TempDir())
+	if ProfileDir() != before || !filepath.IsAbs(before) {
+		t.Fatal("CLI and MCP must resolve the same absolute profile")
+	}
+}
