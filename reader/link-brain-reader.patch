+// TestScrollFavoritesStopsOnRisk 审查 should-fix：滚收藏（每次滚动都打一次收藏接口）途中要查风控，撞上立即停、不再滚。
+func TestScrollFavoritesStopsOnRisk(t *testing.T) {
+	checks, scrolls := 0, 0
+	count := 0
+	cfg := fastFavCfg(0)
+	cfg.Budget = time.Minute
+	res, r := scrollFavorites(context.Background(), cfg,
+		func() favProbe { count += 10; return favProbe{Count: count, HasMore: 1, Tab: "fav"} }, // 一直在增长，不会自然停
+		func(int) { scrolls++ },
+		func() *RiskError {
+			checks++
+			if checks == 3 {
+				return ClassifyRisk("/website-login/error", false)
+			}
+			return nil
+		})
+	require.NotNil(t, r)
+	assert.Equal(t, RiskAccount, r.Code)
+	assert.Equal(t, 2*favScrollRiskEvery, scrolls, "第三次检查命中：之前滚了两组，命中后一次都不能再滚")
+	assert.True(t, res.Partial)
+	assert.Equal(t, FavStopRisk, res.Reason)
+}
