+// ---- 验证窗口：只按关窗前最后一次有效读数解熔断（审查 should-fix） ----
+
+func verifyRun(alive []bool, readings []verifyReading) (verifyReading, bool) {
+	i, j := 0, 0
+	return watchVerifyWindow(time.Now().Add(time.Minute), time.Millisecond,
+		func() bool {
+			if i >= len(alive) {
+				return false
+			}
+			i++
+			return alive[i-1]
+		},
+		func() verifyReading {
+			if j >= len(readings) {
+				return verifyReading{}
+			}
+			j++
+			return readings[j-1]
+		})
+}
+
+func TestVerifyWindowDecision(t *testing.T) {
+	captcha := &xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}
+	clean := verifyReading{ok: true, loggedIn: true}
+	stillCaptcha := verifyReading{ok: true, risk: captcha, loggedIn: true}
+	guest := verifyReading{ok: true}
+	unread := verifyReading{ok: false}
+
+	cases := []struct {
+		name     string
+		hold     string
+		alive    []bool
+		readings []verifyReading
+		wantHeld bool
+	}{
+		{"关窗时验证码还在", xiaohongshu.RiskCaptcha, []bool{true, true, false}, []verifyReading{clean, stillCaptcha}, true},
+		{"一打开就关（一次都没读到）", xiaohongshu.RiskCaptcha, []bool{false}, nil, true},
+		{"验证过了再关", xiaohongshu.RiskCaptcha, []bool{true, true, false}, []verifyReading{stillCaptcha, clean}, false},
+		{"最后一次没读到不作数，按上一次有效读数", xiaohongshu.RiskCaptcha, []bool{true, true, false}, []verifyReading{clean, unread}, false},
+		{"掉登录的熔断：开关验证窗口但没登录", xiaohongshu.RiskNotLoggedIn, []bool{true, false}, []verifyReading{guest}, true},
+		{"安全跳转的熔断：页面干净但不是登录用户", xiaohongshu.RiskAccount, []bool{true, false}, []verifyReading{guest}, true},
+		{"安全跳转的熔断：已登录且干净", xiaohongshu.RiskAccount, []bool{true, false}, []verifyReading{clean}, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			t.Setenv("XHS_PROFILE_DIR", t.TempDir())
+			svc := NewXiaohongshuService()
+			svc.tripRisk(c.hold, "test")
+			last, seen := verifyRun(c.alive, c.readings)
+			svc.finishVerify(last, seen)
+			assert.Equal(t, c.wantHeld, svc.hold.get() != nil)
+		})
+	}
+}
+
+// TestQrcodeShortcutClearsOnlyNotLoggedIn 扫码入口发现「已是登录态」只能解掉登录类熔断（审查 nit）。
