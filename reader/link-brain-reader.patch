+
+func TestNoteWindowResult(t *testing.T) {
+	captcha := &xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}
+	clean := noteWindowReading{verifyReading: verifyReading{ok: true, loggedIn: true}}
+	risky := noteWindowReading{verifyReading: verifyReading{ok: true, risk: captcha, loggedIn: true}}
+	guest := noteWindowReading{verifyReading: verifyReading{ok: true}, guest: true}
+	cases := []struct {
+		name           string
+		last           noteWindowReading
+		seen, noteSeen bool
+		result, trip   string
+	}{
+		{"一次都没读到", noteWindowReading{}, false, false, verifyNotRead, ""},
+		{"关窗时还要验证：按风控写熔断（不放宽）", risky, true, true, verifyStillRisk, xiaohongshu.RiskCaptcha},
+		{"关窗时是游客", guest, true, false, verifyNotLoggedIn, xiaohongshu.RiskNotLoggedIn},
+		{"看到过这篇、关窗时干净", clean, true, true, verifyNoteOK, ""},
+		{"没看到这篇", clean, true, false, verifyNoteNotSeen, ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			result, trip := noteWindowResult(c.last, c.seen, c.noteSeen)
+			assert.Equal(t, c.result, result)
+			assert.Equal(t, c.trip, trip)
+
+			t.Setenv("XHS_PROFILE_DIR", t.TempDir())
+			svc := NewXiaohongshuService()
+			assert.Equal(t, c.result, svc.finishNoteVerify(testNote, c.last, c.seen, c.noteSeen, "tok"))
+			assert.Equal(t, c.trip != "", svc.hold.get() != nil)
+			snap := svc.state.snapshot()
+			assert.Equal(t, c.result, snap["verify_result"])
+			vn := snap["verify_note"].(map[string]any)
+			assert.Equal(t, testNote, vn["note_id"])
+			assert.Equal(t, c.result == verifyNoteOK, vn["ok"])
+			if c.result == verifyNoteOK {
+				assert.Equal(t, "tok", vn["token"])
+			} else {
+				assert.Equal(t, "", vn["token"], "没看到这篇就不交口令")
+			}
+		})
+	}
+}
+
+// TestNoteVerifyWindowRequest 没有熔断 + 带笔记 → 开笔记验证窗口（mode=note）；有熔断 → 先处理熔断（mode=hold）；
+// 不带笔记 → 照旧 no_hold 不开窗；笔记 id 不对 → 400 不开窗。
+func TestNoteVerifyWindowRequest(t *testing.T) {
+	app, _ := testApp(t)
+	var opened atomic.Int32
+	old := openWindowBrowser
+	openWindowBrowser = func() (*browser.Browser, error) { opened.Add(1); return nil, browser.ErrProfileBusy }
+	t.Cleanup(func() { openWindowBrowser = old })
+	router := setupRoutes(app)
+
+	code, out := doJSON(t, router, "POST", "/api/v1/verify/window", `{"note_id":"../../x"}`)
+	assert.Equal(t, http.StatusBadRequest, code, "%v", out)
+	code, out = doJSON(t, router, "POST", "/api/v1/verify/window", "")
+	require.Equal(t, http.StatusOK, code)
+	assert.Equal(t, "no_hold", out["data"].(map[string]any)["result"])
+	time.Sleep(50 * time.Millisecond)
+	assert.Equal(t, int32(0), opened.Load())
+
+	code, out = doJSON(t, router, "POST", "/api/v1/verify/window", `{"note_id":"`+testNote+`","xsec_token":"t"}`)
+	require.Equal(t, http.StatusOK, code, "%v", out)
+	data := out["data"].(map[string]any)
+	assert.Equal(t, "note", data["mode"])
+	assert.Equal(t, true, data["opened"])
+	waitNotVerifying(app)
+	assert.Equal(t, int32(1), opened.Load())
+	snap := app.xiaohongshuService.state.snapshot()
+	assert.Equal(t, verifyWindowFailed, snap["verify_result"])
+	assert.Equal(t, testNote, snap["verify_note"].(map[string]any)["note_id"])
+	assert.Nil(t, app.xiaohongshuService.hold.get(), "窗口没打开不写熔断")
+
+	// 有熔断：一律先处理熔断（号的事），mode=hold
+	app.xiaohongshuService.tripRisk(xiaohongshu.RiskCaptcha, "test")
+	code, out = doJSON(t, router, "POST", "/api/v1/verify/window", `{"note_id":"`+testNote+`"}`)
+	require.Equal(t, http.StatusOK, code)
+	assert.Equal(t, "hold", out["data"].(map[string]any)["mode"])
+	waitNotVerifying(app)
+	assert.NotNil(t, app.xiaohongshuService.hold.get())
+}
+
+// TestNoteVerifyWindowWatchesNote 窗口里的读数：先是验证 → 她过完 → 这篇渲染出来 → 关窗：note_ok，交新口令，不写熔断。
+func TestNoteVerifyWindowWatchesNote(t *testing.T) {
+	captcha := &xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}
+	readings := []noteWindowReading{
+		{verifyReading: verifyReading{ok: true, riskRead: true, risk: captcha, loggedIn: true}},
+		{verifyReading: verifyReading{ok: true, riskRead: true, loggedIn: true}, rendered: true, token: "new"},
+	}
+	var last noteWindowReading
+	var seen, noteSeen bool
+	token := ""
+	i, j := 0, 0
+	alive := []bool{true, true}
+	_, _, _ = watchVerifyWindow(time.Now().Add(time.Minute), time.Millisecond,
+		func() bool { i++; return i <= len(alive) },
+		func() verifyReading {
+			r := readings[j]
+			j++
+			if r.ok {
+				last, seen = r, true
+			}
+			if r.rendered && r.risk == nil {
+				noteSeen = true
+				token = r.token
+			}
+			return r.verifyReading
+		})
+	t.Setenv("XHS_PROFILE_DIR", t.TempDir())
+	svc := NewXiaohongshuService()
+	assert.Equal(t, verifyNoteOK, svc.finishNoteVerify(testNote, last, seen, noteSeen, token))
+	assert.Nil(t, svc.hold.get())
+	assert.Equal(t, "new", svc.state.snapshot()["verify_note"].(map[string]any)["token"])
+}
