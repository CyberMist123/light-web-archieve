+// scrollFavorites 判停核心（纯逻辑，单测用桩驱动）：反复「读数 → 查风控（每 favScrollRiskEvery 轮）→ 滚 → 歇 Tick」。
+//   - 读数里页签不是 WantTab → tab_lost，立即停；
+//   - hasMore=false 且条数稳了 ConfirmEnd → has_more_false（读全）。条数还明显低于基准时，至少先换过一级滚法再信它；
+//   - 条数在当前级的 Settle 内没增长 → 页面没给 hasMore 但已不少于基准就收工（stable）；
+//     页面说还有更多（hasMore=true）：第一次卡住时 OnStall 落证据，已用到第 favStalledMaxLevel 级就停（stalled，partial）；
+//     否则升一级滚法（等待随之放宽）；最高级也没招了 → 按 hasMore / 基准给结论；
+//   - 风控：每 favScrollRiskEvery 轮查一次；hasMore=true 而这一轮没长（或已在换滚法）时每轮都查；
+//     看不见的验证组件（RiskError.Hidden）→ hidden_widget（partial，不返回风控、不写熔断）；
+//   - 收藏接口回了拒绝（cfg.Refused）→ api_refused（partial），当场落证据；
+//   - 预算用完 → budget（partial，除非页面已说没有更多）；ctx 结束 → cancelled（partial）。
+func scrollFavorites(ctx context.Context, cfg favScrollCfg, probe func() favProbe, scroll func(level int),
+	risk func() *RiskError) (FavScrollResult, *RiskError) {
+	start := time.Now()
+	deadline := start.Add(cfg.Budget)
+	levels := len(cfg.Settle)
+	if levels == 0 {
+		levels, cfg.Settle = 1, []time.Duration{12 * time.Second}
+	}
+	if cfg.Tick == nil {
+		cfg.Tick = favTick
+	}
+	res := FavScrollResult{Expect: cfg.Expect}
+	best, hasMore := 0, -1
+	stallNoted := false
+	lastGrow := time.Now()
+	below := func() bool { return cfg.Expect > 0 && float64(best) < float64(cfg.Expect)*cfg.ExpectRatio }
+	finish := func(reason string) (FavScrollResult, *RiskError) {
+		res.Count, res.Reason, res.Seconds = best, reason, time.Since(start).Round(100*time.Millisecond).Seconds()
+		if hasMore >= 0 {
+			v := hasMore == 1
+			res.HasMore = &v
+		}
+		switch reason {
+		case FavStopEnd, FavStopStable:
+			res.Partial = false
+		default:
+			res.Partial = true
+		}
+		hm := "读不到"
+		if res.HasMore != nil {
+			hm = fmt.Sprint(*res.HasMore)
+		}
+		if res.Partial {
+			logrus.Warnf("XHS favorites 只读到一截，共 %d 条（判停 %s · hasMore=%s · 基准 %d · 滚 %d 次 · 用到第 %d 级滚法 · %.0f 秒）",
+				best, reason, hm, cfg.Expect, res.Scrolls, res.Level, res.Seconds)
+		} else {
+			logrus.Infof("XHS favorites 全量加载完成，共 %d 条（判停 %s · hasMore=%s · 基准 %d · 滚 %d 次 · 用到第 %d 级滚法 · %.0f 秒）",
+				best, reason, hm, cfg.Expect, res.Scrolls, res.Level, res.Seconds)
+		}
+		return res, nil
+	}
+	for i := 0; ; i++ {
+		if ctx.Err() != nil {
+			return finish(FavStopCancelled)
+		}
+		if !time.Now().Before(deadline) {
+			if hasMore == 0 {
+				return finish(FavStopEnd)
+			}
+			return finish(FavStopBudget)
+		}
+		p := probe()
+		if cfg.WantTab != "" && p.Tab != "" && p.Tab != cfg.WantTab {
+			res.Tab = p.Tab
+			return finish(FavStopTabLost)
+		}
+		if p.HasMore >= 0 {
+			hasMore = p.HasMore
+		}
+		grew := p.Count > best
+		if grew {
+			best = p.Count
+			lastGrow = time.Now()
+		}
+		still := time.Since(lastGrow)
+		if p.Count >= 0 && best > 0 && hasMore == 0 && still >= cfg.ConfirmEnd && (!below() || res.Level >= 1) {
+			return finish(FavStopEnd)
+		}
+		if still >= cfg.Settle[res.Level] {
+			if hasMore == -1 && cfg.Expect > 0 && best >= cfg.Expect {
+				// 页面不给 hasMore，但已经读到不少于基准、当前滚法下又不再长：按读全收工，不必再升级滚法多打接口
+				return finish(FavStopStable)
+			}
+			if hasMore == 1 {
+				// 1008（B4）：页面说还有更多却加载不出来——收藏接口多半在拒绝。第一次卡住落证据；换过第 1 级还不动就停
+				if !stallNoted {
+					stallNoted = true
+					logrus.Warnf("XHS favorites 列表卡住：条数停在 %d 条 %s 没动，页面说还有更多（基准 %d），落证据",
+						best, still.Round(time.Second), cfg.Expect)
+					if cfg.OnStall != nil {
+						res.Evidence = cfg.OnStall(best)
+					}
+				}
+				if res.Level >= favStalledMaxLevel || res.Level+1 >= levels {
+					logrus.Warnf("XHS favorites 换过第 %d 级滚法仍卡在 %d 条：为免被拦先停（不上真实滚轮）", res.Level, best)
+					return finish(FavStopStalled)
+				}
+			}
+			if res.Level+1 < levels {
+				res.Level++
+				lastGrow = time.Now() // 新一级滚法重新计时
+				logrus.Infof("XHS favorites 条数停在 %d 条 %s 没动（hasMore=%d，基准 %d）：换第 %d 级滚法再试",
+					best, still.Round(time.Second), hasMore, cfg.Expect, res.Level)
+			} else {
+				switch {
+				case hasMore == 0:
+					return finish(FavStopEnd)
+				case below():
+					return finish(FavStopBelowExpect)
+				default:
+					return finish(FavStopStable)
+				}
+			}
+		}
+		// 卡住期间（hasMore=true 却没长，或已在换滚法）每轮都查风控；平时每 favScrollRiskEvery 轮查一次
+		stuck := i > 0 && hasMore == 1 && (!grew || res.Level >= 1)
+		if i%favScrollRiskEvery == 0 || stuck {
+			if r := risk(); r != nil {
+				if r.Hidden() {
+					// 1008 第二轮：看不见的验证组件 / 出现一下又没了——立即停（不再滚、不再点），不写熔断，已读到的按 partial 交回
+					logrus.Warnf("滚收藏途中页面里有看不见的验证组件，停止滚动（不写熔断）：%s", r.Why)
+					if res.Evidence == "" {
+						res.Evidence = r.Evidence
+					}
+					return finish(FavStopHidden)
+				}
+				logrus.Warnf("滚收藏途中撞到风控，停止滚动: %s", r.Error())
+				res.Count, res.Reason, res.Partial = best, FavStopRisk, true
+				res.Seconds = time.Since(start).Round(100 * time.Millisecond).Seconds()
+				return res, r
+			}
+		}
+		// 1008（审查）：收藏接口已经回了拒绝（461 / 300011 之类）——再滚只是接着打被拒的接口，立即停
+		if cfg.Refused != nil {
+			if why := cfg.Refused(); why != "" {
+				logrus.Warnf("XHS favorites 收藏接口回了拒绝，停止滚动（读到 %d 条）：%s", best, why)
+				if cfg.OnRefused != nil {
+					if ev := cfg.OnRefused(why); ev != "" {
+						res.Evidence = ev
+					}
+				}
+				return finish(FavStopRefused)
+			}
+		}
+		scroll(res.Level)
+		res.Scrolls++
+		select {
+		case <-ctx.Done():
+			return finish(FavStopCancelled)
+		case <-time.After(cfg.Tick(i)):
+		}
+	}
+}
+
+// FavTabRetryPause 页签第 1 轮拟人点击没生效之后，在原页面歇多久再拟人点第 2 次（20–40 秒；测试里替换）。
+var FavTabRetryPause = func() time.Duration { return time.Duration(20+rand.Intn(21)) * time.Second }
+
+// findSubTab 找文字为 label 的主页子 tab（每次现找：页面重渲染后旧元素会失效）。
+func (u *UserProfileAction) findSubTab(ctx context.Context, label string) (*rod.Element, error) {
+	elems, err := u.page.Context(ctx).Timeout(10 * time.Second).Elements(`.reds-tab-item.sub-tab-list`)
+	if err != nil {
+		return nil, fmt.Errorf("未找到主页子 tab: %w", err)
+	}
+	for _, elem := range elems {
+		if text, err := elem.Text(); err == nil && strings.TrimSpace(text) == label {
+			return elem, nil
+		}
+	}
+	return nil, fmt.Errorf("未找到子 tab %q", label)
 }
 
