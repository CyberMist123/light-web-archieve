+// TestReadFavoritesRetryPolicy 读收藏最多 2 次；只有「页签没点中」才重试；重试前先查风控再歇 20–40 秒。
+func TestReadFavoritesRetryPolicy(t *testing.T) {
+	tabErr := fmt.Errorf("%w: 当前 tab 为 %q", xiaohongshu.ErrTabNotActive, "note")
+	ok := &xiaohongshu.UserProfileResponse{}
+
+	type run struct {
+		reads, waits, fresh, risks int
+		waited                     time.Duration
+	}
+	exec := func(results []error, riskAfter int) (run, *xiaohongshu.UserProfileResponse, error) {
+		var r run
+		p, err := readFavoritesWithRetry(context.Background(),
+			func() (*xiaohongshu.UserProfileResponse, error) {
+				e := results[r.reads]
+				r.reads++
+				if e == nil {
+					return ok, nil
+				}
+				return nil, e
+			},
+			func() *xiaohongshu.RiskError {
+				r.risks++
+				if riskAfter > 0 && r.risks >= riskAfter {
+					return &xiaohongshu.RiskError{Code: xiaohongshu.RiskAccount, Detail: "x"}
+				}
+				return nil
+			},
+			func(_ context.Context, d time.Duration) error { r.waits++; r.waited = d; return nil },
+			func() { r.fresh++ })
+		return r, p, err
+	}
+
+	// 页签没点中 → 歇 20–40 秒换页再试一次 → 成功
+	r, p, err := exec([]error{tabErr, nil}, 0)
+	require.NoError(t, err)
+	assert.Same(t, ok, p)
+	assert.Equal(t, 2, r.reads)
+	assert.Equal(t, 1, r.waits)
+	assert.Equal(t, 1, r.fresh)
+	assert.GreaterOrEqual(t, r.waited, 20*time.Second)
+	assert.LessOrEqual(t, r.waited, 40*time.Second)
+
+	// 两次都没点中 → 就此放弃（不许第 3 次）
+	r, _, err = exec([]error{tabErr, tabErr, tabErr}, 0)
+	assert.ErrorIs(t, err, xiaohongshu.ErrTabNotActive)
+	assert.Equal(t, 2, r.reads)
+
+	// 其他失败（没加载出来）→ 不重试
+	r, _, err = exec([]error{errors.New("favorites did not load"), nil}, 0)
+	assert.Error(t, err)
+	assert.Equal(t, 1, r.reads)
+	assert.Equal(t, 0, r.waits)
+
+	// 读的时候就撞风控 → 立即停，不重试
+	r, _, err = exec([]error{&xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}, nil}, 0)
+	assert.Equal(t, xiaohongshu.RiskCaptcha, xiaohongshu.AsRisk(err).Code)
+	assert.Equal(t, 1, r.reads)
+	assert.Equal(t, 0, r.risks)
+
+	// 页签没点中但页面已是风控页 → 不等、不重试
+	r, _, err = exec([]error{tabErr, nil}, 1)
+	assert.Equal(t, xiaohongshu.RiskAccount, xiaohongshu.AsRisk(err).Code)
+	assert.Equal(t, 1, r.reads)
+	assert.Equal(t, 0, r.waits)
+}
+
+// TestLoginWindowFinishesWhenLockBusy 登录窗口 60 秒内拿不到浏览器 → finish 为 failed，状态不许停在 waiting。
+func TestLoginWindowFinishesWhenLockBusy(t *testing.T) {
+	for name, stub := range map[string]func() (*browser.Browser, error){
+		"busy":  func() (*browser.Browser, error) { return nil, browser.ErrProfileBusy },
+		"panic": func() (*browser.Browser, error) { panic("NewPage failed") },
+	} {
+		t.Run(name, func(t *testing.T) {
+			app, _ := testApp(t)
+			old := openWindowBrowser
+			openWindowBrowser = stub
+			t.Cleanup(func() { openWindowBrowser = old })
+			router := setupRoutes(app)
+
+			code, _ := doJSON(t, router, "POST", "/api/v1/login/window", "")
+			require.Equal(t, http.StatusOK, code)
+			var state string
+			for i := 0; i < 50; i++ {
+				_, out := doJSON(t, router, "GET", "/api/v1/login/session", "")
+				state = out["data"].(map[string]any)["state"].(string)
+				if state != "waiting" {
+					break
+				}
+				time.Sleep(20 * time.Millisecond)
+			}
+			assert.Equal(t, "failed", state)
+			assert.Equal(t, "", app.xiaohongshuService.state.busy(), "失败后不能再挡着别的接口")
+		})
+	}
+}
+
+// TestLoginWindowSuccessClearsHold 登录窗口成功（已验证登录）= 解除熔断；失败不解除。只验收尾逻辑，不开窗。
+func TestLoginWindowSuccessClearsHold(t *testing.T) {
+	for result, wantHeld := range map[string]bool{"success": false, "failed": true, "cancelled": true} {
+		t.Run(result, func(t *testing.T) { loginWindowOutcome(t, result, wantHeld) })
+	}
+}
+
+func loginWindowOutcome(t *testing.T, result string, wantHeld bool) {
+	{
+		app, _ := testApp(t)
+		old := runLoginWindowFn
+		runLoginWindowFn = func(*AppServer, context.Context, uint64, time.Duration) (string, *xiaohongshu.CurrentUser, string) {
+			return result, nil, ""
+		}
+		app.xiaohongshuService.tripRisk(xiaohongshu.RiskNotLoggedIn, "游客")
+		router := setupRoutes(app)
+		code, _ := doJSON(t, router, "POST", "/api/v1/login/window", "")
+		require.Equal(t, http.StatusOK, code, "登录窗口不受熔断拦截")
+		for i := 0; i < 50 && app.xiaohongshuService.state.waiting(); i++ {
+			time.Sleep(20 * time.Millisecond)
+		}
+		runLoginWindowFn = old
+		assert.Equal(t, wantHeld, app.xiaohongshuService.hold.get() != nil, result)
+	}
+}
+
+// TestStuckWaitingIsNotBusyForever 兜底：waiting 过了期限还没收尾，不再挡别的接口。
+func TestStuckWaitingIsNotBusyForever(t *testing.T) {
+	var l loginState
+	l.begin(1, time.Minute)
+	assert.Equal(t, "LOGIN_IN_PROGRESS", l.busy())
+	l.set(func(l *loginState) { l.expires = time.Now().Add(-loginStuckGrace - time.Second) })
+	assert.Equal(t, "", l.busy())
+	assert.Equal(t, "timeout", l.snapshot()["state"])
+}
