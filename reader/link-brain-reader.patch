+		{loginAlready, xiaohongshu.RiskCaptcha, true},
+		{loginAlready, xiaohongshu.RiskAccount, true},
+		{"success", xiaohongshu.RiskCaptcha, false},
+		{"success", xiaohongshu.RiskAccount, false},
+	} {
+		t.Run(c.result+"/"+c.hold, func(t *testing.T) {
