+// detailFixture 一篇有 30 条评论的笔记；armed=true 时，第一次滚动（滚评论区）就弹出固定定位的验证浮层。
+func detailFixture(id string, armed bool) string {
+	var comments strings.Builder
+	for i := 0; i < 30; i++ {
+		fmt.Fprintf(&comments, `<div class="parent-comment" style="height:80px">评论 %d：要验证吗</div>`, i)
+	}
+	return fmt.Sprintf(`<div id="noteContainer" class="note-container">
+<div id="detail-title">安全验证怎么过</div><div id="detail-desc">拖动滑块教程</div>
+<div class="note-scroller" style="height:400px;overflow:auto"><div class="interact-container">赞</div>
+<div class="comments-container">%s</div></div></div>
+<script>
+window.__INITIAL_STATE__ = {note:{noteDetailMap:{%q:{note:{noteId:%q,title:"安全验证怎么过",desc:"拖动滑块教程",
+  interactInfo:{commentCount:"30"}},comments:{list:[{id:"c1",content:"要验证吗"}],hasMore:true}}}}};
+const armed = %v;
+function trip() {
+  if (!armed || document.getElementById("cap")) return;
+  const d = document.createElement("div");
+  d.id = "cap";
+  d.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.4)";
+  d.innerHTML = '<div style="width:320px;height:240px;margin:80px auto;background:#fff">安全验证<p>请拖动下方滑块完成拼图</p></div>';
+  document.body.appendChild(d);
+}
+document.addEventListener("wheel", trip, true);
+window.addEventListener("scroll", trip, true);
+</script>`, comments.String(), id, id, armed)
+}
