+// tabFixture 假主页：点「收藏」后怎么反应由 mode 定——
+//
+//	"ok"：页签切过去；"dead"：点了没反应（前端不响应）；"mask"：页签被一层透明遮罩盖住；
+//	"captcha"：点了没反应，紧接着弹出验证浮层。
+//
+// 每次 click 事件（含 DOM 合成点击）都记进 window.__clicks（isTrusted / 点在谁身上）。
+func tabFixture(mode string) string {
+	return fmt.Sprintf(`<!doctype html><html><head><meta charset=utf-8></head><body>%s
+<div class="feeds-container" style="height:400px"></div>
+<script>
+const MODE = %q;
+window.__INITIAL_STATE__ = {user: {activeTab: {value: {index: 0, query: "note"}}, notes: {value: [[{id: "own"}], []]}}};
+window.__clicks = [];
+document.addEventListener("click", e => {
+  window.__clicks.push({trusted: e.isTrusted, text: (e.target.innerText || "").trim(), cls: String(e.target.className || "")});
+}, true);
+const fav = document.getElementById("fav-tab");
+fav.addEventListener("click", () => {
+  if (MODE === "ok") window.__INITIAL_STATE__.user.activeTab.value = {index: 1, query: "fav"};
+  if (MODE === "captcha" && !document.getElementById("cap")) {
+    const d = document.createElement("div");
+    d.id = "cap";
+    d.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.4)";
+    d.innerHTML = '<div style="width:320px;height:240px;margin:80px auto;background:#fff">安全验证<p>请拖动下方滑块完成拼图</p></div>';
+    document.body.appendChild(d);
+  }
+});
+if (MODE === "mask") {
+  const m = document.createElement("div");
+  m.className = "reds-mask";
+  m.style.cssText = "position:fixed;inset:0;z-index:50;background:transparent";
+  document.body.appendChild(m);
+}
+</script></body></html>`, profileTabs, mode)
+}
+
+type clickRec struct {
+	Trusted bool   `json:"trusted"`
+	Text    string `json:"text"`
+	Cls     string `json:"cls"`
+}
+
+func clicksOn(t *testing.T, page *rod.Page) []clickRec {
+	t.Helper()
+	var out []clickRec
+	raw := page.Timeout(5 * time.Second).MustEval(`() => JSON.stringify(window.__clicks || [])`).Str()
+	require.NoError(t, json.Unmarshal([]byte(raw), &out))
+	return out
+}
+
+// TestLocalBrowserSelectTabNoSyntheticClick B4：第 1 轮拟人点击没生效 → 查风控、落证据、原页面歇一会儿 → 第 2 轮拟人点击 →
+// 还不生效返回 ErrTabStuck。全程只有 2 次真实点击（isTrusted），没有 DOM this.click() 合成点击；被遮罩盖住时一次都点不到页签，
+// 证据里写清是谁盖住了页签中心。一点就中：不落证据、不歇。中途弹验证：第 2 轮之前就停。
+func TestLocalBrowserSelectTabNoSyntheticClick(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("LINK_BRAIN_EVIDENCE_DIR", root)
+	pauses := 0
+	old := FavTabRetryPause
+	FavTabRetryPause = func() time.Duration { pauses++; return 300 * time.Millisecond }
+	t.Cleanup(func() { FavTabRetryPause = old })
+	var mu sync.Mutex
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		fmt.Fprint(w, tabFixture(strings.TrimPrefix(r.URL.Path, "/p/")))
+	}))
+	t.Cleanup(srv.Close)
+	page := localPage(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+	open := func(mode string) *UserProfileAction {
+		page.Timeout(20 * time.Second).MustNavigate(srv.URL + "/p/" + mode).MustWaitLoad()
+		return &UserProfileAction{page: page}
+	}
+
+	// 一点就中
+	u := open("ok")
+	require.NoError(t, u.selectTab(ctx, page, TabFavorites))
+	assert.Len(t, clicksOn(t, page), 1)
+	assert.Equal(t, 0, pauses)
+	assert.Empty(t, u.Evidence)
+	assert.Empty(t, evidenceDirs(t, root))
+
+	// 点了没反应：只拟人点 2 次，不合成点击
+	u = open("dead")
+	err := u.selectTab(ctx, page, TabFavorites)
+	require.ErrorIs(t, err, ErrTabStuck)
+	assert.ErrorIs(t, err, ErrTabNotActive)
+	assert.Nil(t, AsRisk(err), "点不动不是风控，不写熔断")
+	cl := clicksOn(t, page)
+	require.Len(t, cl, 2, "第 1 轮 + 歇过之后第 2 轮，各一次")
+	for _, c := range cl {
+		assert.True(t, c.Trusted, "不许 DOM this.click() 合成点击：%+v", c)
+		assert.Equal(t, "收藏", c.Text)
+	}
+	assert.Equal(t, 1, pauses)
+	require.NotEmpty(t, u.Evidence)
+	m := readMeta(t, u.Evidence)
+	assert.Equal(t, "fav_tab_click", m["trigger"])
+	assert.Equal(t, "note", m["tab"])
+	assert.Equal(t, true, m["tab_probe"].(map[string]any)["center_is_tab"])
+	_, err = os.Stat(filepath.Join(u.Evidence, "shot.png"))
+	assert.NoError(t, err)
+
+	// 页签被透明遮罩盖住：拟人点击点不到它；以前第 2/3 轮的 DOM 合成点击会穿过遮罩直接点中——现在一次都没有
+	pauses = 0
+	u = open("mask")
+	err = u.selectTab(ctx, page, TabFavorites)
+	require.ErrorIs(t, err, ErrTabStuck)
+	for _, c := range clicksOn(t, page) {
+		assert.True(t, c.Trusted, "%+v", c)
+		assert.NotEqual(t, "收藏", c.Text, "遮罩下的页签不该被点到（只有合成点击才点得到）")
+	}
+	assert.Equal(t, 1, pauses)
+	m = readMeta(t, u.Evidence)
+	tp := m["tab_probe"].(map[string]any)
+	assert.Equal(t, false, tp["center_is_tab"], "证据要写清页签中心被谁盖住")
+	assert.Contains(t, tp["center_el"].(map[string]any)["class"], "reds-mask")
+	hit, _ := os.ReadFile(filepath.Join(u.Evidence, "hit.html"))
+	assert.Contains(t, string(hit), "reds-mask", "没有风控命中元素时，hit.html 记页签中心那个元素")
+
+	// 第 1 轮之后弹了验证：第 2 轮之前就返回风控，不再点、不歇
+	pauses = 0
+	u = open("captcha")
+	err = u.selectTab(ctx, page, TabFavorites)
+	r := AsRisk(err)
+	require.NotNil(t, r, "err=%v", err)
+	assert.Equal(t, RiskCaptcha, r.Code)
+	assert.Len(t, clicksOn(t, page), 1)
+	assert.Equal(t, 0, pauses)
+}
+
+// favStallFixture 假收藏页：每次滚到底附近追加 30 条，但到 stallAt 条就再也加载不出来，页面状态仍说 hasMore=true
+// （10-08 05:18 卡在 1150 条那种）。记录真实滚轮事件次数。
+func favStallFixture(stallAt int) string {
+	return fmt.Sprintf(`<div id="feeds" class="feeds-container"></div>
+<script>
+const STALL = %d;
+const fav = [];
+const st = {user: {notes: {value: [[{id: "own"}], fav]}, activeTab: {value: {index: 1, query: "fav"}},
+  noteQueries: {value: [{hasMore: false}, {hasMore: true}]}}};
+window.__INITIAL_STATE__ = st;
+window.__wheels = 0;
+window.addEventListener("wheel", () => { window.__wheels++; }, {passive: true});
+let loading = false;
+function addPage() {
+  const box = document.getElementById("feeds");
+  for (let i = 0; i < 30 && fav.length < STALL; i++) {
+    fav.push({id: "n" + fav.length});
+    const s = document.createElement("section");
+    s.className = "note-item";
+    s.style.cssText = "height:120px;margin:4px;background:#eee";
+    s.textContent = "card " + fav.length;
+    box.appendChild(s);
+  }
+}
+function maybeLoad() {
+  if (loading || fav.length >= STALL) return;
+  if (window.innerHeight + window.scrollY < document.body.scrollHeight - 400) return;
+  loading = true;
+  setTimeout(() => { addPage(); loading = false; }, 300);
+}
+addPage();
+window.addEventListener("scroll", maybeLoad, {passive: true});
+</script>`, stallAt)
+}
+
+// TestLocalBrowserFavoritesStallStopsAtLevel1 B4：真实 DOM 上列表卡住、页面说还有更多——换过第 1 级就停（stalled、partial），
+// 没有一次真实滚轮；卡住那一刻落了证据（trigger=fav_list_stalled）。
+func TestLocalBrowserFavoritesStallStopsAtLevel1(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("LINK_BRAIN_EVIDENCE_DIR", root)
+	srv := fixtureServer(t, map[string]string{"/fav/stall": favStallFixture(60)})
+	page := localPage(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+	page.MustNavigate(srv.URL + "/fav/stall").MustWaitLoad()
+	u := &UserProfileAction{page: page, FavExpect: 95}
+	start := time.Now()
+	res, r := u.scrollLoadAllFavorites(ctx)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopStalled, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Equal(t, 60, res.Count)
+	assert.Equal(t, 1, res.Level)
+	require.NotNil(t, res.HasMore)
+	assert.True(t, *res.HasMore)
+	assert.Less(t, time.Since(start), 90*time.Second, "12s + 16s 两级就停，不走满四级")
+	wheels := page.MustEval(`() => window.__wheels`).Int()
+	assert.Equal(t, 0, wheels, "hasMore=true 卡住时不上真实滚轮")
+	require.NotEmpty(t, res.Evidence)
+	assert.Equal(t, res.Evidence, u.Evidence)
+	m := readMeta(t, res.Evidence)
+	assert.Equal(t, "fav_list_stalled", m["trigger"])
+	assert.Equal(t, "fav", m["tab"])
+}
