new file mode 100644
index 0000000..0a302ef
--- /dev/null
+++ b/linkbrain_api.go
@@ -0,0 +1,1100 @@
+package main
+
+// Link Brain 单账号接口（0925）：一个号、一个持久 profile，评论 / 私密收藏 / 附件
+// 都在这个进程里跑，由 browser.profileMu 串行——不再有第二套浏览器去顶号。
+//
+//   GET  /api/v1/login/session         扫码进度与最近一次已知登录态（不开浏览器，随便轮询）
+//   GET  /api/v1/favorites[?expect=N]  当前账号的收藏列表；N = 上次正常读到的条数（期望基准），响应带 partial / stop_reason
+//   POST /api/v1/attachments/download  先看笔记、再点附件页的「下载」按钮，把文件存到 dest_dir
+//   POST /api/v1/notes/related-file    登录态看笔记页读附件元数据（游客被登录墙挡的笔记用）
+//
+// 扫码进行中，其它会开浏览器的接口一律立刻回 409 LOGIN_IN_PROGRESS：
+// 它们本来会排在 profile 锁后面干等最多 4 分钟，调用方超时后还会误判成服务坏了。
+//
+// 1001 护号：所有开页的路径导航后、关键步骤前都过 xiaohongshu.RiskPage；撞到验证码 / 安全跳转 /
+// 需要登录却是游客，立即停、不重试、写熔断（risk_hold.go），之后会开浏览器的请求一律 423 RISK_HOLD。
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/rand"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/proto"
+	"github.com/sirupsen/logrus"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+	"github.com/xpzouying/xiaohongshu-mcp/configs"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+type loginState struct {
+	mu        sync.Mutex
+	seq       uint64
+	state     string // idle | waiting | success | timeout
+	user      *xiaohongshu.CurrentUser
+	started   time.Time
+	finished  time.Time
+	expires   time.Time
+	loggedIn  *bool // 最近一次浏览器实测结果
+	checkedAt time.Time
+	verifying bool      // 人工验证窗口开着
+	lastFav   time.Time // 上次读收藏（限频，防风控）
+	captcha   time.Time // 最近一次撞见验证码
+
+	// 1008（B3）最近一次验证窗口的结论（见 verifyClears）：verify_result / verify_finished_at / verify_hold_since。
+	// verifyHoldSince = 窗口针对的那次熔断的 since，调用方拿它和当前 risk_hold.since 对上才算数。
+	verifyResult    string
+	verifyFinished  time.Time
+	verifyHoldSince string
+
+	// 1011 笔记验证窗口（note_verify.go）：针对哪一篇、窗口里看没看到它正常渲染、当时地址里的口令（/login/session 的 verify_note）
+	verifyNoteID    string
+	verifyNoteOK    bool
+	verifyNoteToken string
+}
+
+// resetVerify 清掉上一轮验证窗口的结论（开新窗口 / 写了新的熔断时）。调用方持锁。
+func (l *loginState) resetVerify() {
+	l.verifyResult, l.verifyFinished, l.verifyHoldSince = "", time.Time{}, ""
+	l.verifyNoteID, l.verifyNoteOK, l.verifyNoteToken = "", false, ""
+}
+
+func (l *loginState) begin(seq uint64, timeout time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.seq, l.state, l.user = seq, "waiting", nil
+	l.started, l.expires, l.finished = time.Now(), time.Now().Add(timeout), time.Time{}
+}
+
+func (l *loginState) finish(seq uint64, state string, user *xiaohongshu.CurrentUser, _ string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.seq != seq { // 已被新的二维码取代
+		return
+	}
+	already := state == loginAlready
+	if already {
+		state = "success" // 对外照旧：登录窗口成功（调用方按 success 等）
+	}
+	l.state, l.user, l.finished = state, user, time.Now()
+	if state == "success" {
+		t := true
+		l.loggedIn, l.checkedAt = &t, time.Now()
+		if !already { // 没扫码就不清限频 / 验证码时间（熔断也没全解）
+			l.lastFav, l.captcha = time.Time{}, time.Time{} // 刚扫完码允许马上同步
+		}
+	}
+}
+
+// restartClock 登录窗口拿到浏览器锁后调用：expires_at 改为「现在 + 扫码时限」（仍是这一轮、仍在等才改）。
+func (l *loginState) restartClock(seq uint64, timeout time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.seq == seq && l.state == "waiting" {
+		l.expires = time.Now().Add(timeout)
+	}
+}
+
+func (l *loginState) observe(loggedIn bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.loggedIn, l.checkedAt = &loggedIn, time.Now()
+}
+
+func (l *loginState) waiting() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.state == "waiting"
+}
+
+// loginStuckGrace 等扫码状态过了 expires 这么久还没收尾，就当它已经结束（兜底，正常路径都会 finish）。
+const loginStuckGrace = 2 * time.Minute
+
+func (l *loginState) stuckLocked(now time.Time) bool {
+	return l.state == "waiting" && !l.expires.IsZero() && now.After(l.expires.Add(loginStuckGrace))
+}
+
+func (l *loginState) busy() string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.state == "waiting" && !l.stuckLocked(time.Now()) {
+		return "LOGIN_IN_PROGRESS"
+	}
+	if l.verifying {
+		return "VERIFY_WINDOW_OPEN"
+	}
+	return ""
+}
+
+func (l *loginState) set(f func(l *loginState)) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	f(l)
+}
+
+func (l *loginState) snapshot() map[string]any {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	out := map[string]any{"state": l.state, "seq": l.seq}
+	if out["state"] == "" {
+		out["state"] = "idle"
+	}
+	if l.stuckLocked(time.Now()) {
+		out["state"] = "timeout"
+	}
+	if !l.started.IsZero() {
+		out["started_at"] = l.started.Format(time.RFC3339)
+		out["expires_at"] = l.expires.Format(time.RFC3339)
+	}
+	if !l.finished.IsZero() {
+		out["finished_at"] = l.finished.Format(time.RFC3339)
+	}
+	if l.user != nil {
+		out["nickname"], out["user_id"] = l.user.Nickname, l.user.UserID
+	}
+	if l.loggedIn != nil {
+		out["logged_in"], out["checked_at"] = *l.loggedIn, l.checkedAt.Format(time.RFC3339)
+	}
+	out["verifying"] = l.verifying
+	if !l.captcha.IsZero() {
+		out["captcha_at"] = l.captcha.Format(time.RFC3339)
+	}
+	if l.verifyResult != "" {
+		out["verify_result"] = l.verifyResult
+		out["verify_hold_since"] = l.verifyHoldSince
+		if !l.verifyFinished.IsZero() {
+			out["verify_finished_at"] = l.verifyFinished.Format(time.RFC3339)
+		}
+	}
+	if l.verifyNoteID != "" {
+		out["verify_note"] = map[string]any{"note_id": l.verifyNoteID, "ok": l.verifyNoteOK, "token": l.verifyNoteToken}
+	}
+	return out
+}
+
+// busyGuard：扫码进行中，会开浏览器的接口立刻 409，别在 profile 锁后面干等。
+func (s *AppServer) busyGuard() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		p := c.Request.URL.Path
+		if strings.HasSuffix(p, "/login/session") || strings.HasSuffix(p, "/login/qrcode") || strings.HasSuffix(p, "/login/window") ||
+			strings.HasSuffix(p, "/risk/clear") {
+			c.Next()
+			return
+		}
+		if code := s.xiaohongshuService.state.busy(); code != "" {
+			if strings.HasSuffix(p, "/login/status") {
+				respondSuccess(c, map[string]any{"is_logged_in": nil, "login_pending": true}, "正在等待扫码或人工验证")
+				c.Abort()
+				return
+			}
+			respondError(c, http.StatusConflict, code, "正在等待扫码登录或人工验证，完成后再试", nil)
+			c.Abort()
+			return
+		}
+		c.Next()
+	}
+}
+
+// loginSessionHandler 只读内存：不拿 profile 锁、不开浏览器（卡死时也能秒回，给 restart_reader 判锁占了多久）。
+func (s *AppServer) loginSessionHandler(c *gin.Context) {
+	out := s.xiaohongshuService.state.snapshot()
+	if h := s.xiaohongshuService.hold.get(); h != nil {
+		out["risk_hold"] = h.view(true) // 带证据目录（查看截图），不带 url（本号主页 + xsec_token）
+	} else {
+		out["risk_hold"] = nil
+	}
+	out["lock"] = lockSnapshot(currentLock(), time.Now())
+	respondSuccess(c, out, "ok")
+	// 服务常驻、几周不出事时也要清掉 14 天前的证据：顺手在后台清，最多每小时一次（不拖慢这个只读接口）
+	go func() {
+		defer recoverLog("清旧证据")
+		xiaohongshu.MaybePruneEvidence(time.Now())
+	}()
+}
+
+// windowLockWait 登录/验证窗口拿 profile 锁最多等这么久；拿不到就报失败，不让状态永远停在 waiting。
+const windowLockWait = 60 * time.Second
+
+// verifyWindowMax 验证窗口最长开多久（要短于锁看门狗的 XHS_LOCK_MAX_S=900s）；verifyTick 多久看一眼（测试里改小）。
+var (
+	verifyWindowMax = 12 * time.Minute
+	verifyTick      = 2 * time.Second
+)
+
+// verifyAliveFails alive() 连续这么多次失败才算她关了窗口（页面跳转时会偶尔读不到一次）。
+const verifyAliveFails = 2
+
+// 验证窗口的结论（/login/session 的 verify_result）。
+const (
+	verifyCleared      = "cleared"         // 窗口里出现过风控、关窗前已消失（掉登录类：看到已登录）→ 已解除
+	verifyNoCaptcha    = "no_captcha_seen" // 窗口里从头到尾没出现过验证 / 风控页 → 不自动解除，交给她确认（risk/clear）
+	verifyStillRisk    = "still_risk"      // 关窗前页面仍在风控 → 保持
+	verifyNotRead      = "not_read"        // 窗口里一次都没读到页面 → 保持
+	verifyNotLoggedIn  = "not_logged_in"   // 掉登录 / 安全跳转类：关窗前没看到已登录 → 保持
+	verifyNoHold       = "no_hold"         // 没有熔断（开窗前就没有，或窗口期间被别的路解除了）
+	verifyWindowFailed = "window_failed"   // 窗口没打开（浏览器被别的操作占着）
+)
+
+// verifyHintText 出事在读收藏时（tab=fav 或 want_tab=fav）注入在验证窗口页面顶部的一行提示。窗口不替她点「收藏」：
+// 熔断期间程序替她发收藏请求是自动化动作，要她明确同意（本批不做）。提示里不带「安全验证」字样、id 不带 captcha，
+// 不会被风控探针当成浮层。「等两三秒再关窗」：窗口 1 秒看一眼，拖完立刻关可能没来得及看到滑块消失。
+const verifyHintText = "请点一下『收藏』页签看看有没有滑块：出现滑块就拖完，等两三秒再关窗；没出现就直接关窗"
+
+// verifyHintTick 有提示（她要去点收藏、可能拖滑块）时看得勤一点，免得 2 秒一次漏看一闪而过的滑块。
+const verifyHintTick = time.Second
+
+const verifyHintJS = `(text) => {
+ if (document.getElementById("lb-verify-hint")) return false;
+ const d = document.createElement("div");
+ d.id = "lb-verify-hint";
+ d.textContent = text;
+ d.style.cssText = "position:fixed;top:0;left:0;right:0;z-index:2147483647;padding:6px 12px;background:#fff3cd;color:#664d03;" +
+  "font:14px/1.5 system-ui,sans-serif;text-align:center;pointer-events:none;border-bottom:1px solid #ffe69c";
+ (document.body || document.documentElement).appendChild(d);
+ return true;
+}`
+
+// openWindowBrowser 登录/验证窗口用的有界面浏览器，拿锁最多等 windowLockWait（测试里替换成桩）。
+var openWindowBrowser = func() (*browser.Browser, error) {
+	return browser.NewBrowserWait(windowLockWait, false, browser.WithFingerprintSeed(configs.FingerprintSeed()), browser.WithProxy(configs.Proxy()))
+}
+
+func recoverLog(what string) {
+	if r := recover(); r != nil {
+		logrus.Errorf("%s 出错：%v", what, r)
+	}
+}
+
+// siteHostOK 熔断记下的出事页面能不能拿来开验证窗口：只认小红书 / rednote 的域名和当前读取域名。
+func siteHostOK(host string) bool {
+	host = strings.ToLower(host)
+	for _, base := range []string{xiaohongshu.SiteHost(), xiaohongshu.LoginHost()} {
+		if u, err := url.Parse(base); err == nil && strings.EqualFold(u.Host, host) {
+			return true
+		}
+	}
+	for _, d := range []string{"xiaohongshu.com", "rednote.com"} {
+		if host == d || strings.HasSuffix(host, "."+d) {
+			return true
+		}
+	}
+	return false
+}
+
+// verifyTarget 验证窗口打开哪一页（1008 B3）：熔断记下的出事页面；返回空串 = 走老路（首页 → 侧栏「我」）。
+//   - 去掉 tab / subTab 参数：带着 tab=fav 直开主页，页面会自己去读收藏——那等于程序替她点了「收藏」；
+//   - /website-login/* 安全跳转页不直开（那是跳转的结果，不是出事的页面），走老路，被拦的话站点会自己再跳过去。
+//
+// hint = 要不要在页面顶部提示她自己点「收藏」：出事时停在收藏页签（tab=fav），或者程序正要去收藏页签（want_tab=fav：
+// 页签没点动接着弹验证——B4 最常见的出事路径——那一刻 activeTab 还是 note）。要提示时出事页面不是主页（如还在 /explore），
+// 走老路落到她的主页，她才有「收藏」可点。
+func verifyTarget(h *riskHold) (target string, hint bool) {
+	if h == nil {
+		return "", false
+	}
+	fav := string(xiaohongshu.TabFavorites)
+	hint = h.Tab == fav || h.WantTab == fav
+	u, err := url.Parse(strings.TrimSpace(h.URL))
+	if err != nil || h.URL == "" || (u.Scheme != "http" && u.Scheme != "https") || !siteHostOK(u.Host) ||
+		strings.HasPrefix(strings.ToLower(u.Path), "/website-login") {
+		return "", hint
+	}
+	if hint && !strings.HasPrefix(strings.ToLower(u.Path), "/user/profile/") {
+		return "", hint
+	}
+	q := u.Query()
+	for k := range q {
+		if strings.EqualFold(k, "tab") || strings.EqualFold(k, "subTab") {
+			q.Del(k)
+		}
+	}
+	u.RawQuery = q.Encode()
+	u.Fragment = ""
+	return u.String(), hint
+}
+
+// verifyWindowHandler 打开有界面的浏览器，由人手动过验证；关窗即结束。
+// 1008（B3）：没有熔断直接回 result=no_hold、不开窗；有熔断就开出事的那一页（verifyTarget），
+// 出事时在收藏页签的，页面顶部提示她自己点「收藏」（窗口不替她点）。
+func (s *AppServer) verifyWindowHandler(c *gin.Context) {
+	st := &s.xiaohongshuService.state
+	// 1011：body 可选 {note_id, xsec_token}——没有熔断时开这篇的笔记验证窗口（note_verify.go）；有熔断一律先处理熔断
+	var note noteVerifyRequest
+	_ = c.ShouldBindJSON(&note)
+	h := s.xiaohongshuService.hold.get()
+	if h == nil {
+		if strings.TrimSpace(note.NoteID) != "" {
+			s.noteVerifyWindow(c, note)
+			return
+		}
+		respondSuccess(c, map[string]any{"opened": false, "result": verifyNoHold, "risk_hold": nil}, "当前没有风控熔断，不用验证")
+		return
+	}
+	started := false
+	st.set(func(l *loginState) {
+		if !l.verifying && l.state != "waiting" {
+			l.verifying, started = true, true
+			l.resetVerify()
+			l.verifyHoldSince = h.Since
+		}
+	})
+	if !started {
+		respondError(c, http.StatusConflict, "BUSY", "已有登录或验证窗口在进行", nil)
+		return
+	}
+	target, hint := verifyTarget(h)
+	go func() {
+		defer st.set(func(l *loginState) { l.verifying = false })
+		defer recoverLog("验证窗口")
+		b, err := openWindowBrowser()
+		if err != nil {
+			logrus.Warnf("验证窗口没打开：%v（%s 内没等到浏览器空出来）", err, windowLockWait)
+			s.xiaohongshuService.noteVerify(verifyWindowFailed)
+			return
+		}
+		defer b.Close()
+		page := b.NewPage()
+		_ = rod.Try(func() {
+			if target != "" {
+				logrus.Infof("验证窗口打开出事的页面（tab=%s want_tab=%s，提示点收藏=%v）", h.Tab, h.WantTab, hint)
+				page.Timeout(30 * time.Second).MustNavigate(target)
+				return
+			}
+			page.Timeout(30 * time.Second).MustNavigate(xiaohongshu.SiteHost() + "/explore")
+			time.Sleep(4 * time.Second)
+			_ = page.Timeout(15*time.Second).MustElement(`.user.side-bar-component a[href*="/user/profile/"]`).Click(proto.InputMouseButtonLeft, 1)
+		})
+		// 1001：窗口活着的时候每 2 秒看一眼并记住最后一次读数；关窗后页面已死、什么都读不到，
+		// 不能拿「读不到」当「没风险」。1008：另记窗口里有没有出现过风控（seenRisk）；有提示时 1 秒看一眼。
+		tick := verifyTick
+		if hint && tick > verifyHintTick {
+			tick = verifyHintTick
+		}
+		last, seen, seenRisk := watchVerifyWindow(time.Now().Add(verifyWindowMax), tick,
+			func() bool { _, err := page.Timeout(3 * time.Second).Eval(`() => 1`); return err == nil },
+			func() verifyReading {
+				if hint {
+					_ = rod.Try(func() { page.Timeout(2*time.Second).MustEval(verifyHintJS, verifyHintText) })
+				}
+				return verifyProbe(page)
+			})
+		s.xiaohongshuService.finishVerify(last, seen, seenRisk)
+	}()
+	respondSuccess(c, map[string]any{"opened": true, "mode": "hold", "timeout": verifyWindowMax.String(), "incident_page": target != "", "tab_hint": hint},
+		"验证窗口已打开，完成后关闭窗口即可")
+}
+
+// verifyReading 验证窗口里读一次页面的结果。ok=false 表示这次没读到完整读数（页面在跳转或已关），不作「最后一次读数」。
+type verifyReading struct {
+	ok       bool
+	riskRead bool                   // 风控探针这次读到了页面（登录态没读到也算）：看到的风控照样算「出现过」
+	risk     *xiaohongshu.RiskError // 页面上仍有的风控（看得见的验证浮层 / 安全跳转页）
+	loggedIn bool                   // 页面状态里是已登录用户
+}
+
+// verifyProbe 读一次验证窗口的页面：风控 + 登录态，不导航、不点、不落证据（测试里替换）。
+var verifyProbe = func(page *rod.Page) verifyReading {
+	r, ok := xiaohongshu.RiskPageRead(page)
+	st := xiaohongshu.PageLoginState(page)
+	return verifyReading{ok: ok && st != "", riskRead: ok, risk: r, loggedIn: st == "user"}
+}
+
+// watchVerifyWindow 每 tick 看一眼：窗口还活着就采样，记住最后一次有效读数、有没有出现过风控；
+// alive() 连续 verifyAliveFails 次失败（她关了窗口）或到时就返回。只失败一次（页面跳转）不算关窗。
+// seenRisk 只要风控探针读到并命中就置位，不要求同一次也读到登录态（审查：一闪而过的滑块别因为登录态没读到而漏掉）。
+func watchVerifyWindow(deadline time.Time, tick time.Duration, alive func() bool, sample func() verifyReading) (last verifyReading, seen, seenRisk bool) {
+	fails := 0
+	for time.Now().Before(deadline) {
+		time.Sleep(tick)
+		if !alive() {
+			if fails++; fails >= verifyAliveFails {
+				break // 用户关了窗口
+			}
+			continue
+		}
+		fails = 0
+		r := sample()
+		if (r.ok || r.riskRead) && r.risk != nil {
+			seenRisk = true
+		}
+		if r.ok {
+			last, seen = r, true
+		}
+	}
+	return last, seen, seenRisk
+}
+
+// verifyClears 验证窗口结束后能不能解熔断，返回（解不解、verify_result、原因）。
+//   - 要有有效读数、关窗前最后一次没有风控、而且看到已登录（审查：验证码类也要——被踢到登录页、回到首页是游客、关窗，
+//     不能当成验证过了）；
+//   - 掉登录（NOT_LOGGED_IN）：看到已登录就解（登录是状态，看到了就是证据）；
+//   - 验证码 / 安全跳转：1008（B3）要求窗口里**出现过**风控、最后又干净（她真拖过了）；从头到尾没出现过 →
+//     不自动解除（no_captcha_seen）——验证只在读收藏那一下出，窗口里看不到不等于没事（10-08 04:02 就是这么被
+//     误解除、05:11 手动同步又撞上的）。
+func verifyClears(holdCode string, last verifyReading, seen, seenRisk bool) (bool, string, string) {
+	switch {
+	case !seen:
+		return false, verifyNotRead, "窗口里一次都没读到页面状态"
+	case last.risk != nil:
+		return false, verifyStillRisk, "关窗前页面仍在风控（" + last.risk.Code + "）"
+	case !last.loggedIn:
+		return false, verifyNotLoggedIn, "关窗前没看到已登录（" + holdCode + " 要确认登录还在）"
+	case holdCode == xiaohongshu.RiskNotLoggedIn:
+		return true, verifyCleared, ""
+	case !seenRisk:
+		return false, verifyNoCaptcha, "窗口里从头到尾没出现过验证 / 风控页，不自动解除（要她确认没事再恢复）"
+	}
+	return true, verifyCleared, ""
+}
+
+// noteVerify 记下这一轮验证窗口的结论（/login/session 的 verify_result）。
+func (s *XiaohongshuService) noteVerify(result string) {
+	s.state.set(func(l *loginState) { l.verifyResult, l.verifyFinished = result, time.Now() })
+}
+
+// finishVerify 验证窗口收尾：按窗口里的读数决定解除还是保持熔断，结论记进 verify_result。
+func (s *XiaohongshuService) finishVerify(last verifyReading, seen, seenRisk bool) string {
+	h := s.hold.get()
+	if h == nil {
+		if seen && last.risk == nil {
+			s.state.set(func(l *loginState) { l.captcha = time.Time{} })
+		}
+		s.noteVerify(verifyNoHold)
+		return verifyNoHold
+	}
+	ok, result, why := verifyClears(h.Code, last, seen, seenRisk)
+	if !ok {
+		logrus.Warnf("验证窗口结束，熔断保持（%s，%s）：%s", h.Code, result, why)
+	} else if h.Code == xiaohongshu.RiskNotLoggedIn {
+		s.clearRisk("人工验证窗口完成（关窗前看到已登录、页面无风控）")
+	} else {
+		s.clearRisk("人工验证窗口完成（窗口里出现过验证，关窗前已消失）")
+	}
+	s.noteVerify(result)
+	return result
+}
+
+type favItem struct {
+	NoteID    string `json:"note_id"`
+	XsecToken string `json:"xsec_token"`
+	Title     string `json:"title"`
+	Type      string `json:"type"`
+	Author    string `json:"author"`
+	AuthorID  string `json:"author_id"`
+	URL       string `json:"url"`
+}
+
+const favMinInterval = 10 * time.Minute
+
+// 读收藏一次请求只进 1 次收藏页签（1008 B4 前兆即停）：
+//
+//   - 以前「子 tab 没点中」会歇 20–40 秒、换干净标签页、再做一次登录检查、再点 3 轮。过去 10 次读收藏里，
+//     第 1 轮点不动的 6 次有 4 次接着撞验证——点不动多半是收藏接口在拒绝，换页重来只会加码。现在：页签第 1 轮没点中，
+//     在原页面歇 20–40 秒再拟人点 1 次（见 xiaohongshu.selectTab）；还不生效就结束本次读收藏，回 503 FAV_TAB_STUCK
+//     （TRANSIENT「页签点不动，疑似小红书在限流，今晚先不读收藏」），**不写熔断**、不换新页、不做第二次登录检查。
+//   - F1（10-04）：一次请求**最多滚到底 1 次**；已经滚完一遍才发现页签不对，报不可重试的错（见 GetMyProfileViaSidebar）。
+//   - 一次同步只发 1 次本请求（Python favorites.fetch_favorites）；读到一截 / 可疑时当晚不再重读（Python 侧
+//     sync_state 的重读冷却 + nightly 不对它重试）。服务端另有 favMinInterval 限频。
+//
+// 所以一晚上对收藏列表的全量滚动 ≤ 1 次，进收藏页 ≤ 1 次。
+const codeFavTabStuck = "FAV_TAB_STUCK"
+
+// favRequestTimeout 读收藏整个请求（登录检查 + 进主页 + 点页签 + 等首屏 + 滚动 ≤favScrollBudget + 提取）的上限。
+// Python 客户端超时（favorites.fetch_favorites 780 秒）= 启动 ≤90 + 本值 + 关浏览器 ≤30 + 余量，必须比本值长。
+const favRequestTimeout = 10 * time.Minute
+
+// favExpectParam 解析 ?expect=N（上次正常读到的收藏条数）。乱填 / 负数 / 离谱大数一律当 0（不知道）。
+func favExpectParam(raw string) int {
+	n, err := strconv.Atoi(strings.TrimSpace(raw))
+	if err != nil || n <= 0 || n > 200000 {
+		return 0
+	}
+	return n
+}
+
+// readFavorites 读一次收藏（不重试）：风控类错误原样返回；别的失败先查一次风控（只读页面），
+// 页面已是风控页就按风控报，否则原样返回（页签没点中 / 没停住由调用方报 FAV_TAB_STUCK）。
+func readFavorites(read func() (*xiaohongshu.UserProfileResponse, error),
+	riskCheck func() *xiaohongshu.RiskError) (*xiaohongshu.UserProfileResponse, error) {
+	profile, err := read()
+	if err == nil {
+		return profile, nil
+	}
+	logrus.Warnf("read favorites: %v", err)
+	if r := xiaohongshu.AsRisk(err); r != nil {
+		return nil, r
+	}
+	// 看不见的验证组件不盖掉原来的错（页签点不动 FAV_TAB_STUCK 更说明问题）；它的证据已经落了
+	if r := riskCheck(); r != nil && !r.Hidden() {
+		return nil, r
+	}
+	return nil, err
+}
+
+// favTabStuckText 页签没点中 / 没停住时给她看的话。
+func favTabStuckText(err error) string {
+	if errors.Is(err, xiaohongshu.ErrTabStuck) {
+		return "页签点不动，疑似小红书在限流，今晚先不读收藏"
+	}
+	return "收藏页签没停住，疑似小红书在限流，今晚先不读收藏"
+}
+
+// favReadSummary 响应里如实带上这次读收藏的结论：partial（只读到一截）、stop_reason（判停原因）、has_more
+// （页面状态里的「还有更多」，读不到为 null）、expect（调用方给的基准）、scroll（滚了几次 / 用到第几级滚法 / 秒数）。
+// 列表卡住时另带 evidence（证据目录，只在本机）。
+// 没有滚动结论（不该发生）按 partial 报，宁可让上层当一截处理，也不把来历不明的条数当全量。
+func favReadSummary(r *xiaohongshu.FavScrollResult, expect int) map[string]any {
+	if r == nil {
+		return map[string]any{"partial": true, "stop_reason": "not_scrolled", "has_more": nil, "expect": expect}
+	}
+	var hasMore any
+	if r.HasMore != nil {
+		hasMore = *r.HasMore
+	}
+	out := map[string]any{
+		"partial": r.Partial, "stop_reason": r.Reason, "has_more": hasMore, "expect": expect,
+		"scroll": map[string]any{"loaded": r.Count, "scrolls": r.Scrolls, "level": r.Level, "seconds": r.Seconds},
+	}
+	if r.Evidence != "" {
+		out["evidence"] = r.Evidence
+	}
+	return out
+}
+
+func sleepCtx(ctx context.Context, d time.Duration) error {
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-time.After(d):
+		return nil
+	}
+}
+
+func (s *AppServer) favoritesHandler(c *gin.Context) {
+	var wait time.Duration
+	s.xiaohongshuService.state.set(func(l *loginState) {
+		if since := time.Since(l.lastFav); since < favMinInterval {
+			wait = favMinInterval - since
+		} else {
+			l.lastFav = time.Now()
+		}
+	})
+	if wait > 0 {
+		respondError(c, http.StatusTooManyRequests, "RATE_LIMITED", "收藏刚读过，为免触发风控请稍后再试",
+			map[string]any{"retry_after_s": int(wait.Seconds())})
+		return
+	}
+	expect := favExpectParam(c.Query("expect"))
+	// 与 favdump 一致用独立 context：挂在 HTTP 请求 context 上实测进主页必超时（0925）
+	ctx, cancel := context.WithTimeout(context.Background(), favRequestTimeout)
+	defer cancel()
+	b, berr := s.xiaohongshuService.openBrowser()
+	if berr != nil { // 排队等锁期间别的请求撞了风控：不开浏览器
+		s.respondServiceError(c, berr, http.StatusInternalServerError, "FAVORITES_FAILED", "读取收藏失败")
+		return
+	}
+	defer b.Close()
+	page := b.NewPage()
+	// 1008（B1）：从第一次导航起就记收藏接口的回包（HTTP 状态 + code/msg），出事时写进证据。只读浏览器内存，不发请求。
+	watch := xiaohongshu.WatchCollectAPI(page)
+	defer watch.Stop()
+	var out map[string]any
+	var fail error
+	var evidence string
+	err := rod.Try(func() {
+		login := xiaohongshu.NewLogin(page)
+		ok, err := login.CheckLoginStatus(ctx)
+		if err != nil {
+			fail = err // 含 RiskError：登录检查时就被跳到风控页
+			return
+		}
+		s.xiaohongshuService.state.observe(ok)
+		if !ok {
+			fail = &xiaohongshu.RiskError{Code: xiaohongshu.RiskNotLoggedIn, Detail: "读收藏：读取服务的号是游客"}
+			return
+		}
+		var scroll *xiaohongshu.FavScrollResult
+		profile, err := readFavorites(
+			func() (*xiaohongshu.UserProfileResponse, error) {
+				action := xiaohongshu.NewUserProfileAction(page)
+				action.FavExpect = expect
+				p, err := action.GetMyProfileViaSidebar(ctx, xiaohongshu.TabFavorites)
+				scroll, evidence = action.FavScroll, action.Evidence
+				return p, err
+			},
+			func() *xiaohongshu.RiskError { return xiaohongshu.RiskPage(page) })
+		if err != nil {
+			fail = err
+			return
+		}
+		if r := xiaohongshu.RiskPage(page); r != nil {
+			if !r.Hidden() {
+				fail = r
+				return
+			}
+			// 看不见的验证组件：列表已经读完（不再滚、不再点），按滚动结论交回；证据已落
+			logrus.Warnf("读完收藏后页面里有看不见的验证组件（%s）：不写熔断，按滚动结论交回", r.Why)
+		}
+		if len(profile.Feeds) == 0 {
+			if d := os.Getenv("LB_DEBUG_DIR"); d != "" {
+				if shot, err := page.Screenshot(true, nil); err == nil {
+					_ = os.WriteFile(filepath.Join(d, "fav-empty.png"), shot, 0o644)
+				}
+			}
+		}
+		host := xiaohongshu.SiteHost()
+		items := make([]favItem, 0, len(profile.Feeds))
+		for _, f := range profile.Feeds {
+			items = append(items, favItem{NoteID: f.ID, XsecToken: f.XsecToken, Title: f.NoteCard.DisplayTitle,
+				Type: f.NoteCard.Type, Author: f.NoteCard.User.Nickname, AuthorID: f.NoteCard.User.UserID,
+				URL: fmt.Sprintf("%s/explore/%s?xsec_token=%s&xsec_source=pc_feed", host, f.ID, f.XsecToken)})
+		}
+		out = map[string]any{"nickname": profile.UserBasicInfo.Nickname, "count": len(items), "items": items}
+		for k, v := range favReadSummary(scroll, expect) {
+			out[k] = v
+		}
+	})
+	if err != nil && fail == nil {
+		fail = err
+		if r := xiaohongshu.RiskPage(page); r != nil { // panic 多半是页面被跳走了
+			fail = r
+		}
+	}
+	if r := xiaohongshu.AsRisk(fail); r != nil {
+		s.respondRisk(c, r)
+		return
+	}
+	if fail != nil && ctx.Err() == nil && errors.Is(fail, xiaohongshu.ErrTabNotActive) {
+		// 1008（B4）：页签点不动 / 没停住 = 前兆，本次不读了；不写熔断（不是撞了验证），不换新页重来
+		body := gin.H{"error": favTabStuckText(fail), "code": codeFavTabStuck, "details": fail.Error()}
+		if evidence != "" {
+			body["evidence"] = evidence
+		}
+		logrus.Warnf("%s %s %d %s：%v", c.Request.Method, c.Request.URL.Path, http.StatusServiceUnavailable, codeFavTabStuck, fail)
+		c.JSON(http.StatusServiceUnavailable, body)
+		return
+	}
+	if fail != nil {
+		respondError(c, http.StatusInternalServerError, "FAVORITES_FAILED", "读取收藏失败", fail.Error())
+		return
+	}
+	respondSuccess(c, out, "ok")
+}
+
+type attachmentRequest struct {
+	DocID     string `json:"doc_id" binding:"required"`
+	NoteID    string `json:"note_id" binding:"required"`
+	XsecToken string `json:"xsec_token"`
+	FileName  string `json:"file_name"`
+	DestDir   string `json:"dest_dir" binding:"required"`
+}
+
+func (s *AppServer) attachmentDownloadHandler(c *gin.Context) {
+	var req attachmentRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "请求参数错误", err.Error())
+		return
+	}
+	dest, err := filepath.Abs(req.DestDir)
+	if err == nil {
+		err = os.MkdirAll(dest, 0o755)
+	}
+	if err != nil {
+		respondError(c, http.StatusBadRequest, "BAD_DEST", "下载目录不可用", err.Error())
+		return
+	}
+	path, code, err := downloadAttachment(context.Background(), req, dest, s.xiaohongshuService.openHeadedBrowser)
+	if h := asHold(err); h != nil {
+		respondHold(c, h)
+		return
+	}
+	if r := xiaohongshu.AsRisk(err); r != nil {
+		s.respondRisk(c, r)
+		return
+	}
+	if r := xiaohongshu.AsNoteRestricted(err); r != nil {
+		respondNoteRestricted(c, r)
+		return
+	}
+	if err != nil {
+		status := map[string]int{"NO_DOWNLOAD_BUTTON": http.StatusBadGateway, "DOWNLOAD_TIMEOUT": http.StatusGatewayTimeout}[code]
+		if status == 0 {
+			status, code = http.StatusInternalServerError, "DOWNLOAD_FAILED"
+		}
+		respondError(c, status, code, "附件下载失败", err.Error())
+		return
+	}
+	st, _ := os.Stat(path)
+	respondSuccess(c, map[string]any{"path": path, "bytes": st.Size()}, "ok")
+}
