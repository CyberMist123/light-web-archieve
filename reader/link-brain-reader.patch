+// TestLocalBrowserRiskProbe 审查 must-fix：探针按结构认验证浮层，笔记标题/正文/评论/收藏卡片里的
+// 「安全验证…验证」不算；真的浮层 / 验证组件 / 安全跳转页照样认出来。
+func TestLocalBrowserRiskProbe(t *testing.T) {
+	srv := fixtureServer(t, map[string]string{
+		"/user/profile/me":        favCards,
+		"/explore/abc":            detailModal,
+		"/explore/overlay":        detailModal + captchaOverlay,
+		"/user/profile/overlay":   favCards + captchaOverlay,
+		"/explore/widget":         captchaWidget,
+		"/explore/hidden":         favCards + hiddenWidget,
+		"/website-login/error":    `<div>登录异常</div>`,
+		"/explore/plain":          `<div>普通页面</div>`,
+		"/explore/text-in-header": `<div style="position:fixed;top:0;height:60px;width:100%">安全验证中心 · 帮助</div>`,
+	})
+	page := localPage(t)
+	cases := []struct{ path, want string }{
+		{"/user/profile/me", ""},
+		{"/explore/abc", ""},
+		{"/explore/plain", ""},
+		{"/explore/hidden", ""},
+		{"/explore/text-in-header", ""}, // 固定头部里只有「安全验证」没有操作提示（剔掉「安全验证」后无 拖动/拼图/滑块/点击/验证）
+		{"/explore/overlay", RiskCaptcha},
+		{"/user/profile/overlay", RiskCaptcha},
+		{"/explore/widget", RiskCaptcha},
+		{"/website-login/error", RiskAccount},
+	}
+	for _, c := range cases {
+		page.Timeout(20 * time.Second).MustNavigate(srv.URL + c.path).MustWaitLoad()
+		r, ok := RiskPageRead(page)
+		require.True(t, ok, c.path)
+		if c.want == "" {
+			assert.Nil(t, r, c.path)
+		} else if assert.NotNil(t, r, c.path) {
+			assert.Equal(t, c.want, r.Code, c.path)
+		}
+	}
+}
