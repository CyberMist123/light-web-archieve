+	assert.NotContains(t, verifyHintText, "安全验证", "提示语不能被风控探针当成验证浮层")
+	assert.NotContains(t, strings.ToLower(verifyHintJS), "captcha")
+	assert.Contains(t, verifyHintText, "等两三秒再关窗")
+}
