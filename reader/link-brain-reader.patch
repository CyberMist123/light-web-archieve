+// TestMaybePruneEvidenceThrottled 服务常驻不出事也要清：/login/session 轮询时顺手清，最多每小时一次。
+func TestMaybePruneEvidenceThrottled(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("LINK_BRAIN_EVIDENCE_DIR", root)
+	lastPrune.mu.Lock()
+	lastPrune.at = time.Time{}
+	lastPrune.mu.Unlock()
+	now := time.Now()
+	old := now.Add(-20 * 24 * time.Hour).Format(evidenceDirLayout)
+	require.NoError(t, os.MkdirAll(filepath.Join(root, old), 0o700))
+	assert.True(t, MaybePruneEvidence(now))
+	_, err := os.Stat(filepath.Join(root, old))
+	assert.True(t, os.IsNotExist(err), "超过 14 天的清掉")
+	require.NoError(t, os.MkdirAll(filepath.Join(root, old), 0o700))
+	assert.False(t, MaybePruneEvidence(now.Add(30*time.Minute)), "一小时内不再清")
+	assert.True(t, MaybePruneEvidence(now.Add(61*time.Minute)))
+}
