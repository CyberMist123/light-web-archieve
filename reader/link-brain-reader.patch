+package xiaohongshu
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// r03 问题 1：真机「shown=9 loaded=9 has_more=true reason=no_button」——状态里 subCommentHasMore 陈旧为 true，
+// 但回复已全部加载、楼里也没有按钮：算展开到底，不进 replies_partial、不算 partial、不空等按钮。
+func TestLoadFloorsStaleHasMoreCountsAsExpanded(t *testing.T) {
+	fc := newFake(2, &fakeFloor{id: "a", shown: 9, loaded: 9, hasMore: 1, noButton: true},
+		&fakeFloor{id: "b", shown: 3, loaded: 1, perClick: 10})
+	diag := 0
+	ops := fc.ops(10)
+	ops.diagnose = func(floorInfo) string { diag++; return "楼里没有展开按钮" }
+	res, r := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), ops)
+	require.Nil(t, r)
+	assert.Equal(t, CommentStopEnd, res.Reason)
+	assert.False(t, res.Partial)
+	assert.Empty(t, res.RepliesPartial)
+	assert.Equal(t, 0, res.RepliesMissing)
+	assert.Equal(t, 2, res.FloorsExpanded, "陈旧 hasMore 的楼也算展开到底")
+	assert.Equal(t, 0, diag, "不该当成 no_button 去诊断")
+	assert.Equal(t, 3, fc.floors[1].loaded)
+}
+
+// 缺口为 0 的楼永远不作为 gap 出现：预算 0 时有按钮但已加载 ≥ 显示的楼不列；真缺口照报。
+func TestLoadFloorsZeroMissingNeverAGap(t *testing.T) {
+	fc := newFake(3, &fakeFloor{id: "a", shown: 4, loaded: 4, hasMore: 1},
+		&fakeFloor{id: "b", shown: 6, loaded: 1, perClick: 10}, &fakeFloor{id: "c", shown: 0})
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, 0), fc.ops(10))
+	assert.Equal(t, CommentStopBudget, res.Reason)
+	assert.True(t, res.Partial)
+	require.Len(t, res.RepliesPartial, 1)
+	assert.Equal(t, "b", res.RepliesPartial[0].CommentID)
+	assert.Equal(t, ReplyGapNotReached, res.RepliesPartial[0].Reason)
+	assert.Equal(t, 5, res.RepliesMissing)
+	assert.Equal(t, 1, res.FloorsExpanded)
+}
+
+// r03 问题 2：expand_floors 只展开指定楼；滚到要的楼都出来（这里有一个不存在 → 滚到底），
+// 其它楼不点不列；找不到的进 floors_not_found；到底时 partial 只看要的楼。
+func TestLoadFloorsExpandFloorsOnlyTargets(t *testing.T) {
+	fc := newFake(10, floors(30, func(i int) *fakeFloor { return &fakeFloor{id: id(i), shown: 5, loaded: 1, perClick: 10} })...)
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.ExpandFloors = []string{id(3), id(25), "nope"}
+	res, r := loadFloors(context.Background(), cfg, fc.ops(1000))
+	require.Nil(t, r)
+	assert.Equal(t, CommentStopEnd, res.Reason)
+	assert.Equal(t, []string{"nope"}, res.FloorsNotFound)
+	assert.False(t, res.Partial)
+	assert.Empty(t, res.RepliesPartial, "其它楼不列（不算缺口）")
+	assert.Equal(t, 0, res.RepliesMissing)
+	assert.Equal(t, 2, res.FloorsExpanded)
+	assert.Equal(t, 30, res.FloorsLoaded)
+	assert.Equal(t, 5, fc.floors[3].loaded)
+	assert.Equal(t, 5, fc.floors[25].loaded, "楼层上限外的目标楼也展开")
+	assert.Equal(t, 1, fc.floors[0].loaded, "非目标楼不点")
+	assert.Len(t, fc.clicks, 2)
+}
+
+// 要的楼都找到就收工（不看楼层上限、不滚到底）。
+func TestLoadFloorsExpandFloorsStopsWhenAllFound(t *testing.T) {
+	fc := newFake(10, floors(50, func(i int) *fakeFloor { return &fakeFloor{id: id(i), shown: 5, loaded: 1, perClick: 10} })...)
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.ExpandFloors = []string{id(15)}
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(1000))
+	assert.Equal(t, CommentStopFloorLimit, res.Reason)
+	assert.Equal(t, 1, fc.scrolls)
+	assert.Nil(t, res.FloorsNotFound)
+	assert.False(t, res.Partial)
+	assert.Equal(t, 1, res.FloorsExpanded)
+	assert.Equal(t, 5, fc.floors[15].loaded)
+}
+
+// 超长楼续读预算用完：只报要的楼（not_reached，缺多少如实），其它有缺口的楼不进 replies_partial / replies_missing。
+func TestLoadFloorsExpandFloorsBudgetPartial(t *testing.T) {
+	fc := newFake(3, &fakeFloor{id: "a", shown: 50, loaded: 1, perClick: 10},
+		&fakeFloor{id: "big", shown: 1153, loaded: 30, perClick: 1}, &fakeFloor{id: "c", shown: 40, loaded: 1, perClick: 10})
+	cfg := fastFloorCfg(10, 60*time.Millisecond)
+	cfg.ExpandFloors = []string{"big"}
+	res, _ := loadFloors(context.Background(), cfg, fc.ops(10))
+	assert.Equal(t, CommentStopBudget, res.Reason)
+	assert.True(t, res.Partial)
+	require.Len(t, res.RepliesPartial, 1)
+	g := res.RepliesPartial[0]
