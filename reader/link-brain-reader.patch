+}
+
+// favRefusedFixture 假收藏页：滚到底附近去打收藏接口加载下一页；接口前 okPages 次正常、之后回 461（页面状态仍说 hasMore=true）。
+func favRefusedFixture() string {
+	return fmt.Sprintf(`<div id="feeds" class="feeds-container"></div>
+<script>
+const fav = [];
+const st = {user: {notes: {value: [[{id: "own"}], fav]}, activeTab: {value: {index: 1, query: "fav"}},
+  noteQueries: {value: [{hasMore: false}, {hasMore: true}]}}};
+window.__INITIAL_STATE__ = st;
+window.__wheels = 0;
+window.addEventListener("wheel", () => { window.__wheels++; }, {passive: true});
+let loading = false;
+function addPage() {
+  const box = document.getElementById("feeds");
+  for (let i = 0; i < 30; i++) {
+    fav.push({id: "n" + fav.length});
+    const s = document.createElement("section");
+    s.className = "note-item";
+    s.style.cssText = "height:120px;margin:4px;background:#eee";
+    s.textContent = "card " + fav.length;
+    box.appendChild(s);
+  }
+}
+function maybeLoad() {
+  if (loading) return;
+  if (window.innerHeight + window.scrollY < document.body.scrollHeight - 400) return;
+  loading = true;
+  fetch("%s?num=30&cursor=" + fav.length).then(r => r.json()).then(j => { if (j.success) addPage(); }).finally(() => { loading = false; });
+}
+addPage();
+window.addEventListener("scroll", maybeLoad, {passive: true});
+</script>`, collectAPIPath)
+}
+
+// TestLocalBrowserFavoritesAPIRefusedStops 审查：滚收藏时收藏接口开始回 461——立即停（api_refused，partial），当场落证据，
+// 不再走换滚法那几轮（一次真实滚轮都没有），接口不再被多打。
+func TestLocalBrowserFavoritesAPIRefusedStops(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("LINK_BRAIN_EVIDENCE_DIR", root)
+	var mu sync.Mutex
+	calls := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == collectAPIPath {
+			mu.Lock()
+			calls++
+			n := calls
+			mu.Unlock()
+			w.Header().Set("Content-Type", "application/json")
+			if n > 2 {
+				w.WriteHeader(461)
+				fmt.Fprint(w, `{"code":300011,"success":false,"msg":"当前账号存在异常"}`)
+				return
+			}
+			fmt.Fprint(w, `{"code":0,"success":true,"data":{"has_more":true,"notes":[]}}`)
+			return
+		}
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		fmt.Fprint(w, "<!doctype html><html><head><meta charset=utf-8></head><body>"+favRefusedFixture()+"</body></html>")
+	}))
+	t.Cleanup(srv.Close)
+	page := localPage(t)
+	watch := WatchCollectAPI(page)
+	t.Cleanup(watch.Stop)
+	page.Timeout(20 * time.Second).MustNavigate(srv.URL + "/fav/refused").MustWaitLoad()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+	u := &UserProfileAction{page: page, FavExpect: 200}
+	start := time.Now()
+	res, r := u.scrollLoadAllFavorites(ctx)
+	require.Nil(t, r)
+	assert.Equal(t, FavStopRefused, res.Reason)
+	assert.True(t, res.Partial)
+	assert.Equal(t, 90, res.Count, "前 2 页正常（30 + 30 + 30）")
+	assert.Less(t, time.Since(start), 30*time.Second, "被拒就停，不等卡住再换滚法")
+	assert.Equal(t, 0, page.MustEval(`() => window.__wheels`).Int())
+	mu.Lock()
+	assert.Equal(t, 3, calls, "被拒之后不再打接口")
+	mu.Unlock()
+	require.NotEmpty(t, res.Evidence)
+	m := readMeta(t, res.Evidence)
+	assert.Equal(t, "fav_api_refused", m["trigger"])
+}
