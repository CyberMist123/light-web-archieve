+// humanDwell 在页面上停 lo–hi 秒，中间慢慢滚几下，像人在看。
+func humanDwell(page *rod.Page, lo, hi int) {
+	total := time.Duration(lo+rand.Intn(hi-lo+1)) * time.Second
+	end := time.Now().Add(total)
+	for time.Now().Before(end) {
+		time.Sleep(time.Duration(1200+rand.Intn(2500)) * time.Millisecond)
+		_ = page.Mouse.Scroll(0, float64(120+rand.Intn(380)), 3+rand.Intn(5))
+	}
+}
