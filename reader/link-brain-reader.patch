+package main
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// expand_floors 从 MCP（JSON 数组 / 逗号串）进来都能解析成列表。
+func TestParseStringListExpandFloors(t *testing.T) {
+	var args map[string]any
+	require.NoError(t, json.Unmarshal([]byte(`{"expand_floors":["a","b"]}`), &args))
+	assert.Equal(t, []string{"a", "b"}, parseStringList(args["expand_floors"]))
+	assert.Equal(t, []string{"a", " b"}, parseStringList("a, b"))
+	assert.Equal(t, []string{"x"}, parseStringList([]string{"x"}))
+	assert.Nil(t, parseStringList(3.0))
+}
+
+// REST：comment_config.expand_floors 和顶层 expand_floors 都认。
+func TestFeedDetailRequestExpandFloorsJSON(t *testing.T) {
+	var req FeedDetailRequest
+	require.NoError(t, json.Unmarshal([]byte(`{"feed_id":"f","xsec_token":"t","expand_floors":["top"],"comment_config":{"expand_floors":["nested"]}}`), &req))
+	assert.Equal(t, []string{"top"}, req.ExpandFloors)
+	require.NotNil(t, req.CommentConfig)
+	assert.Equal(t, []string{"nested"}, req.CommentConfig.ExpandFloors)
+}
