+// parseStringList 把 MCP 参数解析成字符串列表：[]any / []string / 逗号分隔的字符串；其它类型给 nil。
+func parseStringList(raw any) []string {
+	var out []string
+	switch v := raw.(type) {
+	case []string:
+		out = append(out, v...)
+	case []any:
+		for _, x := range v {
+			if s, ok := x.(string); ok {
+				out = append(out, s)
+			} else if x != nil {
+				out = append(out, fmt.Sprint(x))
+			}
+		}
+	case string:
+		out = strings.Split(v, ",")
+	}
+	return out
+}
