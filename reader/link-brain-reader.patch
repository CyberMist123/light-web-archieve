index 0000000..a6afb28
--- /dev/null
+++ b/browser/killtree_other.go
@@ -0,0 +1,19 @@
+//go:build !windows
+
+package browser
+
+import (
+	"os"
+	"syscall"
+)
+
+// KillTree 杀掉浏览器整个进程组（rod 在非 Windows 上以 Setpgid 启动浏览器）。
+func KillTree(pid int) {
+	if pid <= 0 || pid == os.Getpid() {
+		return
+	}
+	_ = syscall.Kill(-pid, syscall.SIGKILL)
+	if p, err := os.FindProcess(pid); err == nil {
+		_ = p.Kill()
+	}
+}
