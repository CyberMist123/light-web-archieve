+// TestReadFavoritesNoRetry 1008（B4）：读收藏一次请求只读 1 次——页签没点中 / 没停住不再换新页重试（也就没有第二次登录检查）；
+// 失败后只查一次风控（只读页面），页面已是风控页就按风控报。
+func TestReadFavoritesNoRetry(t *testing.T) {
+	tabErr := fmt.Errorf("%w（收藏）", xiaohongshu.ErrTabStuck)
+	ok := &xiaohongshu.UserProfileResponse{}
+
+	type run struct{ reads, risks int }
+	exec := func(result error, riskAfter int) (run, *xiaohongshu.UserProfileResponse, error) {
+		var r run
+		p, err := readFavorites(
+			func() (*xiaohongshu.UserProfileResponse, error) {
+				r.reads++
+				if result == nil {
+					return ok, nil
+				}
+				return nil, result
+			},
+			func() *xiaohongshu.RiskError {
+				r.risks++
+				if riskAfter > 0 && r.risks >= riskAfter {
+					return &xiaohongshu.RiskError{Code: xiaohongshu.RiskAccount, Detail: "x"}
+				}
+				return nil
+			})
+		return r, p, err
+	}
+
+	r, p, err := exec(nil, 0)
+	require.NoError(t, err)
+	assert.Same(t, ok, p)
+	assert.Equal(t, run{reads: 1}, r)
+
+	// 页签点不动 → 不重试，原样交给 handler 报 FAV_TAB_STUCK
+	r, _, err = exec(tabErr, 0)
+	assert.ErrorIs(t, err, xiaohongshu.ErrTabStuck)
+	assert.ErrorIs(t, err, xiaohongshu.ErrTabNotActive)
+	assert.Equal(t, run{reads: 1, risks: 1}, r)
+	assert.Equal(t, "页签点不动，疑似小红书在限流，今晚先不读收藏", favTabStuckText(err))
+	assert.Contains(t, favTabStuckText(fmt.Errorf("%w: 滚收藏途中页签跳到了 %q", xiaohongshu.ErrTabNotActive, "note")), "没停住")
+
+	// 其他失败（没加载出来）→ 不重试
+	r, _, err = exec(errors.New("favorites did not load"), 0)
+	assert.Error(t, err)
+	assert.Equal(t, 1, r.reads)
+
+	// 读的时候就撞风控 → 原样返回，不再查
+	r, _, err = exec(&xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}, 0)
+	assert.Equal(t, xiaohongshu.RiskCaptcha, xiaohongshu.AsRisk(err).Code)
+	assert.Equal(t, run{reads: 1}, r)
+
+	// 页签没点中但页面已是风控页 → 按风控报
+	r, _, err = exec(tabErr, 1)
+	assert.Equal(t, xiaohongshu.RiskAccount, xiaohongshu.AsRisk(err).Code)
+	assert.Equal(t, 1, r.reads)
+
+	// F1：已经滚完一遍才发现页签不对 → 不可重试的错（不带 ErrTabNotActive），handler 报 FAVORITES_FAILED
+	scrolledThenTabWrong := fmt.Errorf("收藏已滚完一遍但提取时页签不对，本次不再重读：%v", tabErr)
+	_, _, err = exec(scrolledThenTabWrong, 0)
+	assert.NotErrorIs(t, err, xiaohongshu.ErrTabNotActive)
+
+	// 1008 第二轮：失败后复查只看到看不见的验证组件——不盖掉原来的错（页签点不动更说明问题）
+	_, err = readFavorites(func() (*xiaohongshu.UserProfileResponse, error) { return nil, tabErr },
+		func() *xiaohongshu.RiskError {
+			return &xiaohongshu.RiskError{Code: xiaohongshu.RiskHiddenWidget, Detail: "x"}
+		})
+	assert.ErrorIs(t, err, xiaohongshu.ErrTabStuck)
+	assert.Nil(t, xiaohongshu.AsRisk(err))
+}
