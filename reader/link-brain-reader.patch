+func TestLoadFloorsFairRounds(t *testing.T) {
+	fc := newFake(3, &fakeFloor{id: "a", shown: 100, loaded: 1, perClick: 10},
+		&fakeFloor{id: "b", shown: 100, loaded: 1, perClick: 10}, &fakeFloor{id: "c", shown: 100, loaded: 1, perClick: 10})
+	res, _ := loadFloors(context.Background(), fastFloorCfg(10, time.Minute), fc.ops(10))
+	require.GreaterOrEqual(t, len(fc.order), 18)
+	assert.Equal(t, []string{"a", "a", "a", "b", "b", "b", "c", "c", "c"}, fc.order[:9], "第一档：每楼先到 30 条")
+	assert.Equal(t, []string{"a", "a", "a", "b", "b", "b", "c", "c", "c"}, fc.order[9:18], "第二档：再各到 60 条")
