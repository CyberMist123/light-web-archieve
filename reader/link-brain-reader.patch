+			t.Cleanup(func() { runLoginWindowFn = old })
+			app.xiaohongshuService.tripRisk(c.hold, "test")
+			app.xiaohongshuService.state.set(func(l *loginState) { l.lastFav = time.Now() })
+			router := setupRoutes(app)
+			code, _ := doJSON(t, router, "POST", "/api/v1/login/window", "")
+			require.Equal(t, http.StatusOK, code)
