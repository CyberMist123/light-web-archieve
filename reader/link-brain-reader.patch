@@ -0,0 +1,151 @@
+package xiaohongshu
+
+import (
+	"encoding/json"
+	stderrors "errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/sirupsen/logrus"
+)
+
+// 风控类停车码：命中就停下本次操作、不重试，由服务层写熔断（1001）。
+const (
+	RiskCaptcha     = "CAPTCHA_REQUIRED" // 页面出现「安全验证」拼图/滑块
+	RiskAccount     = "ACCOUNT_RISK"     // 被跳到 /website-login/*（error、captcha…）等安全跳转
+	RiskNotLoggedIn = "NOT_LOGGED_IN"    // 需要登录的操作发现是游客
+)
+
+// RiskError 风控停车信号。Error() 以 "[CODE]" 开头，MCP 报错文本里原样带出，调用方按方括号码识别。
+type RiskError struct {
+	Code   string
+	Detail string
+}
+
+func (e *RiskError) Error() string { return "[" + e.Code + "] " + e.Detail }
+
+// AsRisk 从错误链里取出 RiskError；不是风控类返回 nil。
+func AsRisk(err error) *RiskError {
+	var r *RiskError
+	if stderrors.As(err, &r) {
+		return r
+	}
+	return nil
+}
+
+// ErrTabNotActive 主页子 tab 没点中（纯前端问题），是读收藏唯一允许重试的失败。
+var ErrTabNotActive = stderrors.New("子 tab 没点中")
+
+// riskContentSelector 用户内容容器：笔记标题/正文/评论/收藏卡片。这里面的字是别人写的，
+// 一篇叫「手机号安全验证怎么办」的笔记不能把号判成撞了验证码（1001 审查 must-fix）。
+const riskContentSelector = `.note-container, #noteContainer, .note-detail-mask, .note-content, #detail-title, #detail-desc, ` +
+	`.comments-container, .comments-el, .comment-item, .parent-comment, .feeds-container, .feeds-page, .note-item, .reds-note-card, .user-page .feeds-tab-container`
+
+// riskProbeJS 只读页面，不点、不解。验证浮层按结构认，不扫整页文字：
+//
+//	① 可见的验证组件：class/id 带 captcha 的元素，或 src 带 captcha 的 iframe；
+//	② 固定定位（position: fixed）的可见浮层里有一句短的「安全验证」，且浮层总字数少、带操作提示（拖动/拼图/滑块/点击/验证）。
+//
+// 两条都跳过用户内容容器里的元素。
+const riskProbeJS = `() => {
+ const EXCLUDE = ` + "`" + riskContentSelector + "`" + `;
+ const shown = (e) => {
+  if (!e || !e.getBoundingClientRect) return false;
+  const r = e.getBoundingClientRect();
+  if (r.width < 40 || r.height < 30) return false;
+  const cs = getComputedStyle(e);
+  return cs.display !== "none" && cs.visibility !== "hidden" && parseFloat(cs.opacity || "1") > 0.05;
+ };
+ const fixedBox = (e) => {
+  for (let a = e; a && a !== document.documentElement; a = a.parentElement) {
+   if (getComputedStyle(a).position === "fixed") return a;
+  }
+  return null;
+ };
+ let why = "";
+ for (const e of document.querySelectorAll('[class*="captcha" i], [id*="captcha" i], iframe[src*="captcha" i]')) {
+  if (e.closest(EXCLUDE)) continue;
+  if (shown(e)) { why = "captcha-element"; break; }
+ }
+ if (!why && document.body) {
+  const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+  while (w.nextNode()) {
+   const s = (w.currentNode.nodeValue || "").trim();
+   if (!s.includes("安全验证") || s.length > 40) continue;
+   const el = w.currentNode.parentElement;
+   if (!el || el.closest(EXCLUDE)) continue;
+   const box = fixedBox(el);
+   if (!box || !shown(box)) continue;
+   const t = (box.innerText || "").trim();
+   if (t.length <= 300 && /拖动|拼图|滑块|滑动|点击|验证/.test(t.replace(/安全验证/g, ""))) { why = "overlay"; break; }
+  }
+ }
+ return JSON.stringify({path: location.pathname, captcha: !!why, why});
+}`
+
+// ClassifyRisk 按页面路径和验证浮层判风控（纯函数）。
+func ClassifyRisk(path string, captcha bool) *RiskError {
+	p := strings.ToLower(path)
+	if strings.HasPrefix(p, "/website-login") {
+		return &RiskError{Code: RiskAccount, Detail: "小红书把页面跳到了 " + path + "（登录异常/安全跳转），已停止操作"}
+	}
+	if captcha || strings.Contains(p, "/captcha") {
+		return &RiskError{Code: RiskCaptcha, Detail: "小红书要求安全验证（拼图滑块），已停止操作"}
+	}
+	return nil
+}
+
+// RiskPage 统一风控检查：导航后、关键步骤前调用。页面读不出来（已关、超时）按「看不出风险」处理。
+func RiskPage(page *rod.Page) *RiskError {
+	r, _ := RiskPageRead(page)
+	return r
+}
+
+// RiskPageRead 同 RiskPage，另报这次到底读没读到页面（ok=false：页面已关/超时，结果不作数）。
+// 验证窗口要靠它区分「没风险」和「根本没看到」。
+func RiskPageRead(page *rod.Page) (*RiskError, bool) {
+	if page == nil {
+		return nil, false
+	}
+	var raw string
+	if err := rod.Try(func() { raw = page.Timeout(5 * time.Second).MustEval(riskProbeJS).Str() }); err != nil {
+		return nil, false
+	}
+	var probe struct {
+		Path    string `json:"path"`
+		Captcha bool   `json:"captcha"`
+		Why     string `json:"why"`
+	}
+	if json.Unmarshal([]byte(raw), &probe) != nil {
+		return nil, false
+	}
+	r := ClassifyRisk(probe.Path, probe.Captcha)
+	if r != nil {
+		logrus.Warnf("风控页: %s（path=%s why=%s）", r.Error(), probe.Path, probe.Why)
+	}
+	return r, true
+}
+
+// PageLoginState 读一次页面登录标志（不导航、不等待）：user / guest / guestflag / risk / pending；读不到返回空串。
+func PageLoginState(page *rod.Page) string {
+	if page == nil {
+		return ""
+	}
+	st := ""
+	_ = rod.Try(func() { st = page.Timeout(5 * time.Second).MustEval(loginStateJS).Str() })
+	return st
+}
+
+// accessTextRisk 详情页错误容器里的文字若是安全验证提示，按验证码停车而不是「笔记不可访问」。
+func accessTextRisk(text string) *RiskError {
+	if strings.Contains(text, "安全验证") || strings.Contains(text, "验证码") {
+		t := []rune(strings.TrimSpace(text))
+		if len(t) > 80 {
+			t = t[:80]
+		}
+		return &RiskError{Code: RiskCaptcha, Detail: fmt.Sprintf("笔记页要求安全验证：%s", string(t))}
+	}
+	return nil
+}
