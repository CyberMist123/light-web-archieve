+//go:build localbrowser
+
+package xiaohongshu
+
+// 本地浏览器测试（默认不编译）：用内置浏览器 + 临时 profile 打开本机 httptest 页面，验证风控探针 JS 和
+// 入库主路（GetFeedDetailWithConfig）在真实 DOM 上的行为。不碰小红书、不碰真 profile：
+//   - XHS_PROFILE_DIR / XHS_HOST 都在测试里改成临时目录和本机服务；
+//   - 浏览器挂一个死代理 127.0.0.1:9，Chrome 对回环地址直连，任何误跳到外网的请求都会失败而不是出去。
+// 跑法：go test -tags localbrowser -count=1 -timeout 600s -run LocalBrowser ./xiaohongshu
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/xpzouying/xiaohongshu-mcp/browser"
+)
+
+const deadProxy = "http://127.0.0.1:9"
+
+// localPage 起一个临时 profile 的 headless 内置浏览器。
+func localPage(t *testing.T) *rod.Page {
+	t.Helper()
+	dir := t.TempDir()
+	require.True(t, strings.HasPrefix(filepath.Clean(dir), filepath.Clean(os.TempDir())), "profile 必须在临时目录")
+	t.Setenv("XHS_PROFILE_DIR", dir)
+	// 预置 Local State，免得「首次建 profile」强制有界面
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "Local State"), []byte("{}"), 0o600))
+	b := browser.NewBrowser(true, browser.WithProxy(deadProxy))
+	t.Cleanup(b.Close)
+	page := b.NewPage()
+	t.Cleanup(func() { _ = page.Close() })
+	return page
+}
+
+func fixtureServer(t *testing.T, pages map[string]string) *httptest.Server {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, ok := pages[r.URL.Path]
+		if !ok {
+			http.NotFound(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		fmt.Fprint(w, "<!doctype html><html><head><meta charset=utf-8></head><body>"+body+"</body></html>")
+	}))
+	t.Cleanup(srv.Close)
+	require.True(t, strings.HasPrefix(srv.URL, "http://127.0.0.1:"))
+	return srv
+}
+
+const (
+	favCards = `<div class="feeds-container" style="position:relative;height:600px">
+<section class="note-item" style="position:absolute;top:0;left:0;width:220px;height:280px"><a class="title"><span>手机号安全验证怎么办</span></a><div>拖动滑块验证教程</div></section>
+<section class="note-item" style="position:absolute;top:0;left:240px;width:220px;height:280px"><span>安全验证</span><span>拼图</span></section>
+</div>`
+	detailModal = `<div class="note-detail-mask" style="position:fixed;inset:0;background:#fff">
+<div id="noteContainer" class="note-container"><div id="detail-title">安全验证怎么过</div>
+<div id="detail-desc">教你完成安全验证：拖动滑块拼图</div>
+<div class="comments-container"><div class="parent-comment">安全验证点不动</div><div class="parent-comment">要验证吗</div></div></div></div>`
+	captchaOverlay = `<div style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.4)">
+<div style="width:320px;height:240px;margin:80px auto;background:#fff">安全验证<p>请拖动下方滑块完成拼图</p></div></div>`
+	captchaWidget = `<div class="red-captcha-container" style="width:320px;height:240px;background:#eee"></div>`
+	hiddenWidget  = `<div id="captcha-root" style="display:none;width:320px;height:240px"></div>`
+)
+
+// TestLocalBrowserRiskProbe 审查 must-fix：探针按结构认验证浮层，笔记标题/正文/评论/收藏卡片里的
+// 「安全验证…验证」不算；真的浮层 / 验证组件 / 安全跳转页照样认出来。
+func TestLocalBrowserRiskProbe(t *testing.T) {
+	srv := fixtureServer(t, map[string]string{
+		"/user/profile/me":        favCards,
+		"/explore/abc":            detailModal,
+		"/explore/overlay":        detailModal + captchaOverlay,
+		"/user/profile/overlay":   favCards + captchaOverlay,
+		"/explore/widget":         captchaWidget,
+		"/explore/hidden":         favCards + hiddenWidget,
+		"/website-login/error":    `<div>登录异常</div>`,
+		"/explore/plain":          `<div>普通页面</div>`,
+		"/explore/text-in-header": `<div style="position:fixed;top:0;height:60px;width:100%">安全验证中心 · 帮助</div>`,
+	})
+	page := localPage(t)
+	cases := []struct{ path, want string }{
+		{"/user/profile/me", ""},
+		{"/explore/abc", ""},
+		{"/explore/plain", ""},
+		{"/explore/hidden", ""},
+		{"/explore/text-in-header", ""}, // 固定头部里只有「安全验证」没有操作提示（剔掉「安全验证」后无 拖动/拼图/滑块/点击/验证）
+		{"/explore/overlay", RiskCaptcha},
+		{"/user/profile/overlay", RiskCaptcha},
+		{"/explore/widget", RiskCaptcha},
+		{"/website-login/error", RiskAccount},
+	}
+	for _, c := range cases {
+		page.Timeout(20 * time.Second).MustNavigate(srv.URL + c.path).MustWaitLoad()
+		r, ok := RiskPageRead(page)
+		require.True(t, ok, c.path)
+		if c.want == "" {
+			assert.Nil(t, r, c.path)
+		} else if assert.NotNil(t, r, c.path) {
+			assert.Equal(t, c.want, r.Code, c.path)
+		}
+	}
+}
+
+// detailFixture 一篇有 30 条评论的笔记；armed=true 时，第一次滚动（滚评论区）就弹出固定定位的验证浮层。
+func detailFixture(id string, armed bool) string {
+	var comments strings.Builder
+	for i := 0; i < 30; i++ {
+		fmt.Fprintf(&comments, `<div class="parent-comment" style="height:80px">评论 %d：要验证吗</div>`, i)
+	}
+	return fmt.Sprintf(`<div id="noteContainer" class="note-container">
+<div id="detail-title">安全验证怎么过</div><div id="detail-desc">拖动滑块教程</div>
+<div class="note-scroller" style="height:400px;overflow:auto"><div class="interact-container">赞</div>
+<div class="comments-container">%s</div></div></div>
+<script>
+window.__INITIAL_STATE__ = {note:{noteDetailMap:{%q:{note:{noteId:%q,title:"安全验证怎么过",desc:"拖动滑块教程",
+  interactInfo:{commentCount:"30"}},comments:{list:[{id:"c1",content:"要验证吗"}],hasMore:true}}}}};
+const armed = %v;
+function trip() {
+  if (!armed || document.getElementById("cap")) return;
+  const d = document.createElement("div");
+  d.id = "cap";
+  d.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.4)";
+  d.innerHTML = '<div style="width:320px;height:240px;margin:80px auto;background:#fff">安全验证<p>请拖动下方滑块完成拼图</p></div>';
+  document.body.appendChild(d);
+}
+document.addEventListener("wheel", trip, true);
+window.addEventListener("scroll", trip, true);
+</script>`, comments.String(), id, id, armed)
+}
+
+// TestLocalBrowserFeedDetailStopsOnCaptchaMidLoad 审查 must-fix：滚评论途中弹验证，数据虽然还读得出来，
+// 入库主路也必须返回 CAPTCHA_REQUIRED（旧代码这里返回成功、不写熔断）。对照组：不弹验证照常成功。
+func TestLocalBrowserFeedDetailStopsOnCaptchaMidLoad(t *testing.T) {
+	srv := fixtureServer(t, map[string]string{
+		"/explore/calm01": detailFixture("calm01", false),
+		"/explore/trap01": detailFixture("trap01", true),
+	})
+	t.Setenv("XHS_HOST", srv.URL)
+	page := localPage(t)
+	cfg := CommentLoadConfig{MaxCommentItems: 20}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer cancel()
+	res, err := NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "calm01", "tok", true, cfg)
+	require.NoError(t, err, "对照组：没有验证浮层时照常成功")
+	assert.Equal(t, "calm01", res.Note.NoteID)
+
+	start := time.Now()
+	res, err = NewFeedDetailAction(page).GetFeedDetailWithConfig(ctx, "trap01", "tok", true, cfg)
+	assert.Nil(t, res)
+	r := AsRisk(err)
+	require.NotNil(t, r, "滚评论途中弹了验证必须按风控失败，err=%v", err)
+	assert.Equal(t, RiskCaptcha, r.Code)
+	assert.Less(t, time.Since(start), 2*time.Minute, "命中后立即停，不许滚满 8 分钟")
+}
diff --git a/xiaohongshu/risk_test.go b/xiaohongshu/risk_test.go
