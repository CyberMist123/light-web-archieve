+		logrus.Infof("XHS browser exited normally profile=%s", b.profile)
+	})
+}
+
+func profileSeed(dir string, configured int) int {
+	path := filepath.Join(dir, "fingerprint-seed")
+	if data, err := os.ReadFile(path); err == nil {
+		seed, err := strconv.Atoi(strings.TrimSpace(string(data)))
+		if err != nil {
+			panic(err)
+		}
+		return seed
+	}
+	if configured <= 0 {
+		configured = rand.Intn(900000000) + 100000000
+	}
+	if err := os.WriteFile(path, []byte(strconv.Itoa(configured)), 0600); err != nil {
+		panic(err)
+	}
+	return configured
