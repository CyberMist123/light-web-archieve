+// waitForSearchFeeds 等结果数组出现，等到就走，等不到也在预算内收手。
+// 只读状态、不改状态；拿不到就当 0 条，由调用方照常返回，不把请求拖到超时。
+func waitForSearchFeeds(page *rod.Page, timeout time.Duration) {
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		res, err := page.Eval(`() => {
+			const s = window.__INITIAL_STATE__;
+			const feeds = s && s.search && s.search.feeds;
+			if (!feeds) return 0;
+			const data = feeds.value !== undefined ? feeds.value : feeds._value;
+			return Array.isArray(data) ? data.length : 0;
+		}`)
+		if err == nil && res.Value.Int() > 0 {
+			return
+		}
+		time.Sleep(500 * time.Millisecond)
+	}
+}
