+//   - 条数在当前级的 Settle 内没增长 → 页面没给 hasMore 但已不少于基准就收工（stable）；否则升一级滚法（等待随之放宽）；
+//     最高级也没招了 → 按 hasMore / 基准给结论；
+//   - 预算用完 → budget（partial，除非页面已说没有更多）；ctx 结束 → cancelled（partial）。
+func scrollFavorites(ctx context.Context, cfg favScrollCfg, probe func() favProbe, scroll func(level int),
+	risk func() *RiskError) (FavScrollResult, *RiskError) {
+	start := time.Now()
+	deadline := start.Add(cfg.Budget)
+	levels := len(cfg.Settle)
+	if levels == 0 {
+		levels, cfg.Settle = 1, []time.Duration{12 * time.Second}
+	}
+	if cfg.Tick == nil {
+		cfg.Tick = favTick
+	}
+	res := FavScrollResult{Expect: cfg.Expect}
+	best, hasMore := 0, -1
+	lastGrow := time.Now()
+	below := func() bool { return cfg.Expect > 0 && float64(best) < float64(cfg.Expect)*cfg.ExpectRatio }
+	finish := func(reason string) (FavScrollResult, *RiskError) {
+		res.Count, res.Reason, res.Seconds = best, reason, time.Since(start).Round(100*time.Millisecond).Seconds()
+		if hasMore >= 0 {
+			v := hasMore == 1
+			res.HasMore = &v
+		}
+		switch reason {
+		case FavStopEnd, FavStopStable:
+			res.Partial = false
+		default:
+			res.Partial = true
+		}
+		hm := "读不到"
+		if res.HasMore != nil {
+			hm = fmt.Sprint(*res.HasMore)
+		}
+		if res.Partial {
+			logrus.Warnf("XHS favorites 只读到一截，共 %d 条（判停 %s · hasMore=%s · 基准 %d · 滚 %d 次 · 用到第 %d 级滚法 · %.0f 秒）",
+				best, reason, hm, cfg.Expect, res.Scrolls, res.Level, res.Seconds)
+		} else {
+			logrus.Infof("XHS favorites 全量加载完成，共 %d 条（判停 %s · hasMore=%s · 基准 %d · 滚 %d 次 · 用到第 %d 级滚法 · %.0f 秒）",
+				best, reason, hm, cfg.Expect, res.Scrolls, res.Level, res.Seconds)
+		}
+		return res, nil
+	}
+	for i := 0; ; i++ {
+		if ctx.Err() != nil {
+			return finish(FavStopCancelled)
+		}
+		if !time.Now().Before(deadline) {
+			if hasMore == 0 {
+				return finish(FavStopEnd)
+			}
+			return finish(FavStopBudget)
+		}
+		p := probe()
+		if cfg.WantTab != "" && p.Tab != "" && p.Tab != cfg.WantTab {
+			res.Tab = p.Tab
+			return finish(FavStopTabLost)
+		}
+		if p.HasMore >= 0 {
+			hasMore = p.HasMore
+		}
+		if p.Count > best {
+			best = p.Count
+			lastGrow = time.Now()
+		}
+		still := time.Since(lastGrow)
+		if p.Count >= 0 && best > 0 && hasMore == 0 && still >= cfg.ConfirmEnd && (!below() || res.Level >= 1) {
+			return finish(FavStopEnd)
+		}
+		if still >= cfg.Settle[res.Level] {
+			if hasMore == -1 && cfg.Expect > 0 && best >= cfg.Expect {
+				// 页面不给 hasMore，但已经读到不少于基准、当前滚法下又不再长：按读全收工，不必再升级滚法多打接口
+				return finish(FavStopStable)
+			}
+			if res.Level+1 < levels {
+				res.Level++
+				lastGrow = time.Now() // 新一级滚法重新计时
+				logrus.Infof("XHS favorites 条数停在 %d 条 %s 没动（hasMore=%d，基准 %d）：换第 %d 级滚法再试",
+					best, still.Round(time.Second), hasMore, cfg.Expect, res.Level)
+			} else {
+				switch {
+				case hasMore == 1:
+					return finish(FavStopStuck)
+				case hasMore == 0:
+					return finish(FavStopEnd)
+				case below():
+					return finish(FavStopBelowExpect)
+				default:
+					return finish(FavStopStable)
+				}
+			}
+		}
+		if i%favScrollRiskEvery == 0 {
+			if r := risk(); r != nil {
+				logrus.Warnf("滚收藏途中撞到风控，停止滚动: %s", r.Error())
+				res.Count, res.Reason, res.Partial = best, FavStopRisk, true
+				res.Seconds = time.Since(start).Round(100 * time.Millisecond).Seconds()
+				return res, r
+			}
+		}
+		scroll(res.Level)
+		res.Scrolls++
+		select {
+		case <-ctx.Done():
+			return finish(FavStopCancelled)
+		case <-time.After(cfg.Tick(i)):
+		}
+	}
 }
 
