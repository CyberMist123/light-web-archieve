+package main
+
+// Link Brain 单账号接口（0925）：一个号、一个持久 profile，评论 / 私密收藏 / 附件
+// 都在这个进程里跑，由 browser.profileMu 串行——不再有第二套浏览器去顶号。
+//
+//   GET  /api/v1/login/session         扫码进度与最近一次已知登录态（不开浏览器，随便轮询）
+//   GET  /api/v1/favorites[?expect=N]  当前账号的收藏列表；N = 上次正常读到的条数（期望基准），响应带 partial / stop_reason
+//   POST /api/v1/attachments/download  先看笔记、再点附件页的「下载」按钮，把文件存到 dest_dir
+//   POST /api/v1/notes/related-file    登录态看笔记页读附件元数据（游客被登录墙挡的笔记用）
+//
+// 扫码进行中，其它会开浏览器的接口一律立刻回 409 LOGIN_IN_PROGRESS：
+// 它们本来会排在 profile 锁后面干等最多 4 分钟，调用方超时后还会误判成服务坏了。
+//
+// 1001 护号：所有开页的路径导航后、关键步骤前都过 xiaohongshu.RiskPage；撞到验证码 / 安全跳转 /
+// 需要登录却是游客，立即停、不重试、写熔断（risk_hold.go），之后会开浏览器的请求一律 423 RISK_HOLD。
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/rand"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
