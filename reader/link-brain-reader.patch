diff --git a/note_verify.go b/note_verify.go
new file mode 100644
index 0000000..dd2e9a5
--- /dev/null
+++ b/note_verify.go
@@ -0,0 +1,282 @@
+package main
+
+// 1011：网页版限制的笔记（她的收藏里有，浏览器里打开要「验证一下」；读取服务打开详情页，页面上没有这篇）。
+//
+//   POST /api/v1/notes/search-token  {note_id, keyword}  用标题搜一次，从搜索结果里按笔记 id 认出这篇、拿新的 xsec_token。
+//                                    只开一页（搜索结果页），导航后和读完各查一次风控；搜不到回 found=false。
+//                                    调用方（Python）管节奏：每篇每天最多一次、开页间隔、账号锁。
+//   POST /api/v1/verify/window       body 带 {note_id, xsec_token} 且**没有熔断**时 = 笔记验证窗口：开有界面的浏览器到这篇，
+//                                    她在窗口里过完验证、看到笔记就关窗。关窗前最后一次读数：
+//                                      · 页面上还有看得见的验证 / 被跳到安全页 → 按风控写熔断（still_risk），不放宽；
+//                                      · 页面上有登录框（游客）→ NOT_LOGGED_IN 写熔断（not_logged_in）；
+//                                      · 窗口里看到过这篇正常渲染 → note_ok（/login/session 的 verify_note 带 note_id / ok / token）；
+//                                      · 都没有 → note_not_seen（这篇还没打开，熔断不动、没有熔断就不写）。
+//                                    有熔断时一律走原来的熔断验证（号的事先处理），响应 mode=hold。
+//
+// 窗口期间 verifying=true：其它会开浏览器的接口照旧 409（busyGuard），/mcp 排在浏览器锁后面。
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/go-rod/rod"
+	"github.com/sirupsen/logrus"
+	"github.com/xpzouying/xiaohongshu-mcp/xiaohongshu"
+)
+
+// respondNoteRestricted 只是这一篇打不开：422 NOTE_RESTRICTED，不写熔断。证据目录（本机绝对路径）只在本机给。
+func respondNoteRestricted(c *gin.Context, r *xiaohongshu.NoteRestrictedError) {
+	body := gin.H{"error": xiaohongshu.NoteRestrictedText, "code": xiaohongshu.NoteRestrictedCode, "details": r.Error(),
+		"path": r.Path}
+	if r.Evidence != "" {
+		body["evidence"] = r.Evidence
+	}
+	logrus.Warnf("%s %s %d %s（%s）", c.Request.Method, c.Request.URL.Path, http.StatusUnprocessableEntity, xiaohongshu.NoteRestrictedCode, r.NoteID)
+	c.JSON(http.StatusUnprocessableEntity, body)
+}
+
+// noteIDRe 笔记 id：16–32 位十六进制（和 Python NOTE_ID_RE 同口径）。拼进 URL 前必须过它。
+var noteIDRe = regexp.MustCompile(`^[0-9a-fA-F]{16,32}$`)
+
+// ---- 搜标题拿新口令 ----
+
+type searchTokenRequest struct {
+	NoteID  string `json:"note_id"`
+	Keyword string `json:"keyword"`
+}
+
+// searchKeywordMax 搜索词最多这么多字（标题太长截前面一段，搜索页本来也只认前面）。
+const searchKeywordMax = 30
+
+func cleanKeyword(s string) string {
+	s = strings.Join(strings.Fields(s), " ")
+	if r := []rune(s); len(r) > searchKeywordMax {
+		s = string(r[:searchKeywordMax])
+	}
+	return s
+}
+
+// pickToken 搜索结果里按笔记 id 认出这篇（纯函数）：返回它的 xsec_token；认不出返回 ""。
+func pickToken(feeds []xiaohongshu.Feed, noteID string) string {
+	for _, f := range feeds {
+		if strings.EqualFold(f.ID, noteID) && f.XsecToken != "" {
+			return f.XsecToken
+		}
+	}
+	return ""
+}
+
+// searchForToken 开一页搜索（测试里替换）：返回结果列表。风控类错误原样返回（*xiaohongshu.RiskError），由调用方写熔断。
+var searchForToken = func(s *XiaohongshuService, keyword string) ([]xiaohongshu.Feed, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+	defer cancel()
+	b, err := s.openBrowser()
+	if err != nil {
+		return nil, err // *holdError：排队期间别的请求撞了风控
+	}
+	defer b.Close()
+	page := b.NewPage()
+	var feeds []xiaohongshu.Feed
+	var fail error
+	if err := rod.Try(func() {
+		feeds, fail = xiaohongshu.NewSearchAction(page).Search(ctx, keyword)
+	}); err != nil && fail == nil {
+		fail = err
+	}
+	// 搜索页同样要认风控页（原来的搜索不查）：读完 / 出错都查一次
+	if r := xiaohongshu.RiskPage(page); r != nil {
+		return nil, r
+	}
+	return feeds, fail
+}
+
+func (s *AppServer) noteSearchTokenHandler(c *gin.Context) {
+	var req searchTokenRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "请求参数错误", err.Error())
+		return
+	}
+	req.NoteID = strings.TrimSpace(req.NoteID)
+	kw := cleanKeyword(req.Keyword)
+	if !noteIDRe.MatchString(req.NoteID) || kw == "" {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "要给笔记 id 和搜索词", nil)
+		return
+	}
+	logrus.Infof("用标题搜这篇的新口令：%s（%d 字）", req.NoteID, len([]rune(kw)))
+	feeds, err := searchForToken(s.xiaohongshuService, kw)
+	if err != nil {
+		if r := xiaohongshu.AsRisk(err); r != nil {
+			s.respondRisk(c, r) // 写熔断（看不见的验证组件不写）
+			return
+		}
+		if h := asHold(err); h != nil {
+			respondHold(c, h)
+			return
+		}
+		respondError(c, http.StatusBadGateway, "SEARCH_FAILED", "搜索没成功", err.Error())
+		return
+	}
+	token := pickToken(feeds, req.NoteID)
+	respondSuccess(c, map[string]any{"found": token != "", "xsec_token": token, "count": len(feeds)},
+		map[bool]string{true: "搜到了这篇", false: "搜索结果里没有这篇"}[token != ""])
+}
+
+// ---- 笔记验证窗口 ----
+
+type noteVerifyRequest struct {
+	NoteID    string `json:"note_id"`
+	XsecToken string `json:"xsec_token"`
+}
+
+// 笔记验证窗口的结论（/login/session 的 verify_result；其余沿用 verifyStillRisk / verifyNotRead / verifyNotLoggedIn / verifyWindowFailed）。
+const (
+	verifyNoteOK      = "note_ok"       // 窗口里看到过这篇正常渲染
+	verifyNoteNotSeen = "note_not_seen" // 一直没看到这篇（还要验证 / 她没过完就关了）
+)
+
+// noteVerifyURL 窗口打开哪一页：这篇的详情页（带上口令，口令过期也照样开，站点自己会处理）。
+func noteVerifyURL(id, token string) string {
+	u := fmt.Sprintf("%s/explore/%s", xiaohongshu.SiteHost(), id)
+	if token = strings.TrimSpace(token); token != "" {
+		u += "?" + url.Values{"xsec_token": {token}, "xsec_source": {"pc_feed"}}.Encode()
+	}
+	return u
+}
+
+// noteWindowReading 笔记窗口里读一次：风控 + 登录态（verifyProbe）+ 这篇有没有渲染出来、当前地址里的口令。
+type noteWindowReading struct {
+	verifyReading
+	guest    bool   // 页面上有登录框
+	rendered bool   // 这篇在页面状态里
+	token    string // 当前地址里的 xsec_token（她过完验证后站点可能换了新的）
+}
+
+// noteWindowProbe 读一次笔记窗口（测试里替换）。
+var noteWindowProbe = func(page *rod.Page, id string) noteWindowReading {
+	r := noteWindowReading{verifyReading: verifyProbe(page)}
+	if st, ok := xiaohongshu.ReadNoteState(page, id); ok {
+		r.rendered = st.Has
+		r.guest = st.Login == "guest"
+	}
+	_ = rod.Try(func() {
+		href := page.Context(context.Background()).Timeout(3 * time.Second).MustEval(`() => location.href`).Str()
+		if u, err := url.Parse(href); err == nil && strings.Contains(u.Path, id) {
+			r.token = u.Query().Get("xsec_token")
+		}
+	})
+	return r
+}
+
+// noteWindowResult 关窗后的结论（纯函数）：返回 verify_result，以及要不要写熔断（码；"" = 不写）。
+//   - 一次都没读到 → not_read；
+//   - 关窗前最后一次读数页面上还有风控 → still_risk，按那个码写熔断（不放宽）；
+//   - 最后一次读数页面上有登录框 → not_logged_in，写 NOT_LOGGED_IN；
+//   - 窗口里看到过这篇正常渲染（且那次页面干净）→ note_ok；
+//   - 其余 → note_not_seen。
+func noteWindowResult(last noteWindowReading, seen, noteSeen bool) (result, tripCode string) {
+	switch {
+	case !seen:
+		return verifyNotRead, ""
+	case last.risk != nil:
+		return verifyStillRisk, last.risk.Code
+	case last.guest:
+		return verifyNotLoggedIn, xiaohongshu.RiskNotLoggedIn
+	case noteSeen:
+		return verifyNoteOK, ""
+	}
+	return verifyNoteNotSeen, ""
+}
+
+// finishNoteVerify 笔记窗口收尾：写结论（verify_result + verify_note），该写熔断就写。
+func (s *XiaohongshuService) finishNoteVerify(id string, last noteWindowReading, seen, noteSeen bool, token string) string {
+	result, trip := noteWindowResult(last, seen, noteSeen)
+	if trip != "" {
+		detail := "笔记验证窗口关窗时页面仍要验证 / 被跳到安全页"
+		if trip == xiaohongshu.RiskNotLoggedIn {
+			detail = "笔记验证窗口：页面上是游客（有登录框）"
+		}
+		s.tripRisk(trip, detail)
+	}
+	ok := result == verifyNoteOK
+	if !ok {
+		token = ""
+	}
+	s.state.set(func(l *loginState) {
+		l.verifyResult, l.verifyFinished = result, time.Now()
+		l.verifyNoteID, l.verifyNoteOK, l.verifyNoteToken = id, ok, token
+	})
+	logrus.Infof("笔记验证窗口结束（%s）：%s", id, result)
+	return result
+}
+
+// noteVerifyWindow 打开笔记验证窗口（调用方已确认没有熔断、参数合法）。
+func (s *AppServer) noteVerifyWindow(c *gin.Context, req noteVerifyRequest) {
+	st := &s.xiaohongshuService.state
+	id := strings.TrimSpace(req.NoteID)
+	if !noteIDRe.MatchString(id) {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "笔记 id 不对", nil)
+		return
+	}
+	started := false
+	st.set(func(l *loginState) {
+		if !l.verifying && l.state != "waiting" {
+			l.verifying, started = true, true
+			l.resetVerify()
+			l.verifyNoteID, l.verifyNoteOK, l.verifyNoteToken = id, false, ""
+		}
+	})
+	if !started {
+		respondError(c, http.StatusConflict, "BUSY", "已有登录或验证窗口在进行", nil)
+		return
+	}
+	target := noteVerifyURL(id, req.XsecToken)
+	go func() {
+		defer st.set(func(l *loginState) { l.verifying = false })
+		defer recoverLog("笔记验证窗口")
+		b, err := openWindowBrowser()
+		if err != nil {
+			logrus.Warnf("笔记验证窗口没打开：%v（%s 内没等到浏览器空出来）", err, windowLockWait)
+			s.xiaohongshuService.finishNoteVerifyFailed(id)
+			return
+		}
+		defer b.Close()
+		page := b.NewPage()
+		logrus.Infof("笔记验证窗口打开这篇：%s", id)
+		_ = rod.Try(func() { page.Timeout(30 * time.Second).MustNavigate(target) })
+		var last noteWindowReading
+		var seen, noteSeen bool
+		token := ""
+		_, _, _ = watchVerifyWindow(time.Now().Add(verifyWindowMax), verifyHintTick,
+			func() bool { _, err := page.Timeout(3 * time.Second).Eval(`() => 1`); return err == nil },
+			func() verifyReading {
+				r := noteWindowProbe(page, id)
+				if r.ok {
+					last, seen = r, true
+				}
+				if r.rendered && r.risk == nil {
+					noteSeen = true
+					if r.token != "" {
+						token = r.token
+					}
+				}
+				return r.verifyReading
+			})
+		s.xiaohongshuService.finishNoteVerify(id, last, seen, noteSeen, token)
+	}()
+	respondSuccess(c, map[string]any{"opened": true, "mode": "note", "timeout": verifyWindowMax.String()},
+		"笔记验证窗口已打开：过完验证、看到笔记后关掉窗口")
+}
+
+// finishNoteVerifyFailed 窗口没打开（浏览器被别的操作占着）。
+func (s *XiaohongshuService) finishNoteVerifyFailed(id string) {
+	s.state.set(func(l *loginState) {
+		l.verifyResult, l.verifyFinished = verifyWindowFailed, time.Now()
+		l.verifyNoteID, l.verifyNoteOK, l.verifyNoteToken = id, false, ""
+	})
+}
