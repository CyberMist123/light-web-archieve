+	require.NotNil(t, r, "滚收藏的风控检查不能空转：stop_reason=%s", res.Reason)
+	assert.Equal(t, RiskCaptcha, r.Code)
+	assert.Equal(t, FavStopRisk, res.Reason)
+
+	// selectTab：第 1 轮没点中，歇着的时候弹了验证浮层 → 歇完那次检查要判出来，返回 RiskError，不再点
+	page.Timeout(20 * time.Second).MustNavigate(srv.URL + "/p/dead").MustWaitLoad()
+	u = NewUserProfileAction(page)
+	pauses := 0
+	oldPause := FavTabRetryPause
+	FavTabRetryPause = func() time.Duration {
+		pauses++
+		page.MustEval(`() => { const d = document.createElement("div"); d.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.4)";
+  d.innerHTML = '<div style="width:320px;height:240px;margin:80px auto;background:#fff">安全验证<p>请拖动下方滑块完成拼图</p></div>'; document.body.appendChild(d); }`)
