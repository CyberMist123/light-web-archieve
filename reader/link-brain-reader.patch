+// TestLoadFloorsPerFloorCap 一楼几千条回复：点到每楼上限就放下，后面的楼照样展开；如实报缺多少。
+func TestLoadFloorsPerFloorCap(t *testing.T) {
+	fc := newFake(3, &fakeFloor{id: "a", shown: 2000, loaded: 1, perClick: 10},
+		&fakeFloor{id: "b", shown: 30, loaded: 1, perClick: 10}, &fakeFloor{id: "c", shown: 0})
+	cfg := fastFloorCfg(10, time.Minute)
+	cfg.MaxClicksPerFloor = 5
+	res, r := loadFloors(context.Background(), cfg, fc.ops(10))
+	require.Nil(t, r)
+	assert.Equal(t, CommentStopEnd, res.Reason)
+	assert.True(t, res.Partial)
+	require.Len(t, res.RepliesPartial, 1)
+	g := res.RepliesPartial[0]
+	assert.Equal(t, 1, g.Floor)
+	assert.Equal(t, ReplyGapCap, g.Reason)
+	assert.Equal(t, 51, g.Loaded)
+	assert.Equal(t, 2000-51, g.Missing)
+	assert.Equal(t, 5, g.Clicks)
+	assert.True(t, g.HasMore)
+	assert.Equal(t, 2000-51, res.RepliesMissing)
+	assert.Equal(t, 30, fc.floors[1].loaded, "放下第 1 楼后第 2 楼照样展开")
+	assert.Equal(t, 0, res.FloorsExpanded, "第 1 楼没展开完，连续展开到底的楼数是 0")
+}
