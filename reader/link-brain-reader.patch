new file mode 100644
index 0000000..509012f
--- /dev/null
+++ b/xiaohongshu/page_ready.go
@@ -0,0 +1,28 @@
+package xiaohongshu
+
+import (
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/sirupsen/logrus"
+)
+
+// feedReadyTimeout 等待详情页关键容器的上限，超时不算失败。
+const feedReadyTimeout = 8 * time.Second
+
+// feedReadySelectors 详情页已出结果的判据：正常笔记容器，或 checkPageAccessible 认的错误容器。
+const feedReadySelectors = ".interact-container, .note-scroller, " +
+	".access-wrapper, .error-wrapper, .not-found-wrapper, .blocked-wrapper"
+
+// waitFeedPageReady 等待 feed 详情页可用：load 事件 + 关键容器出现，不要求整页 DOM 静止。
+// 返回关键容器有没有出现（1011：没出现时调用方再看一眼这篇在不在页面状态里，见 restrictedCheck）。
+func waitFeedPageReady(page *rod.Page) bool {
+	page.MustWaitLoad()
+
+	if _, err := page.Timeout(feedReadyTimeout).Element(feedReadySelectors); err != nil {
+		// 没等到也继续，后续 Element 各自带轮询
+		logrus.Warnf("详情页关键容器未在 %s 内出现，继续尝试: %v", feedReadyTimeout, err)
+		return false
+	}
+	return true
+}
diff --git a/xiaohongshu/risk.go b/xiaohongshu/risk.go
new file mode 100644
index 0000000..3889b4a
--- /dev/null
+++ b/xiaohongshu/risk.go
@@ -0,0 +1,388 @@
+package xiaohongshu
+
+import (
+	"context"
+	"encoding/json"
+	stderrors "errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/sirupsen/logrus"
+)
+
+// 风控类停车码：命中就停下本次操作、不重试，由服务层写熔断（1001）。
+const (
+	RiskCaptcha     = "CAPTCHA_REQUIRED" // 页面出现「安全验证」拼图/滑块
+	RiskAccount     = "ACCOUNT_RISK"     // 被跳到 /website-login/*（error、captcha…）等安全跳转
+	RiskNotLoggedIn = "NOT_LOGGED_IN"    // 需要登录的操作发现是游客
+	// RiskHiddenWidget（1008 第二轮）页面里有验证组件，但没画出来（不在视口 / 祖先透明 / 被盖住 / display:none…，
+	// 可能是 SDK 预载或后台静默校验），或者出现了一下 1.5 秒内又没了。停下**本次**操作（不再滚、不再点），
+	// 但**不写熔断**——服务层回 TRANSIENT，下次照常。码名和 Detail 故意不带「captcha / 滑块 / 安全验证 / 风控」
+	// 这些字：Python 的 looks_blocked 按这些字把报错当成「号出事」（要人处理）。
+	RiskHiddenWidget = "HIDDEN_WIDGET"
+)
+
+// HiddenWidgetText 给她看的话（HTTP 响应的 error 字段）。
+const HiddenWidgetText = "页面里有验证组件但没显示滑块，这次先停，下次照常读"
+
+// HiddenWidgetDetail RiskError.Detail（会进 MCP 报错文本）：不带 looks_blocked 认的那些字。
+const HiddenWidgetDetail = "页面里有验证组件但没显示出来（可能是后台静默校验），这次先停，下次照常读，不暂停账号"
+
+// RiskError 风控停车信号。Error() 以 "[CODE]" 开头，MCP 报错文本里原样带出，调用方按方括号码识别。
+type RiskError struct {
+	Code   string
+	Detail string
+	// Why 探针的判据（iframe / widget / overlay / hidden-widget:<原因> / path），只进日志和证据。
+	Why string
+	// Evidence 这次命中时落的证据目录（RiskPage 落的；没落成为空）。
+	Evidence string
+}
+
+func (e *RiskError) Error() string { return "[" + e.Code + "] " + e.Detail }
+
+// Hidden 是不是「看不见的验证组件」（停本次、不写熔断）。
+func (e *RiskError) Hidden() bool { return e != nil && e.Code == RiskHiddenWidget }
+
+// AsRisk 从错误链里取出 RiskError；不是风控类返回 nil。
+func AsRisk(err error) *RiskError {
+	var r *RiskError
+	if stderrors.As(err, &r) {
+		return r
+	}
+	return nil
+}
+
+// ErrTabNotActive 主页子 tab 没点中 / 没停住。1008（B4）起读收藏不再为它换新页重试：
+// 「点不动」多半是收藏接口被拒的早期表现，服务层报 TRANSIENT（FAV_TAB_STUCK）、当晚不读收藏、不写熔断。
+var ErrTabNotActive = stderrors.New("子 tab 没点中")
+
+// ErrTabStuck 拟人点了两次页签都没切过去（第 1 轮没生效 → 落证据、查风控、原页面歇 20–40 秒 → 第 2 轮仍没生效）。
+// errors.Is(err, ErrTabNotActive) 同样为真。
+var ErrTabStuck = fmt.Errorf("%w：拟人点了两次页签都没切过去", ErrTabNotActive)
+
+// riskContentSelector 用户内容容器：笔记标题/正文/评论/收藏卡片。这里面的字是别人写的，
+// 一篇叫「手机号安全验证怎么办」的笔记不能把号判成撞了验证码（1001 审查 must-fix）。
+const riskContentSelector = `.note-container, #noteContainer, .note-detail-mask, .note-content, #detail-title, #detail-desc, ` +
+	`.comments-container, .comments-el, .comment-item, .parent-comment, .feeds-container, .feeds-page, .note-item, .reds-note-card, .user-page .feeds-tab-container`
+
+// riskFindJS 探针的判据本体（只读页面，不点、不解），返回 {why, el, kind, hidden_why}。
+// 验证浮层按结构认，不扫整页文字。候选：
+//
+//	① class/id 带 captcha 的元素，或 src 带 captcha 的 iframe；
+//	② 固定定位（position: fixed）的浮层里有一句短的「安全验证」，且浮层总字数少、带操作提示（拖动/拼图/滑块/点击/验证）。
+//
+// 两条都跳过用户内容容器里的元素。riskProbeJS（判风控）和 evidenceJS（出事落证据）共用这一份，判据不会两处走样。
+//
+// 1008 第二轮（她：打开报错时既没有验证窗口也没掉登录，怀疑误检测）——「看得见」收紧成：
+//   - 与视口有交集；祖先链（含自己）没有 display:none、visibility:hidden，透明度连乘 > 0.05，clip / clip-path 没把它裁没；
+//   - 可见部分的中心点 elementFromPoint 命中它自己或子孙（没被别的东西盖住）；
+//   - 面积 > 90% 视口的大容器（html / body / #app 一类）里得有验证内容（iframe / canvas / img 或「验证 / 拖动 / 滑块」字样，
+//     且总字数 ≤ 300：整页包装层不算）才当候选，否则整个不算。
+//
+// kind：visible（真看得见：why = iframe / widget / overlay）· hidden（why = hidden-widget，hidden_why 写原因）· ""（没有）。
+// hidden 只认两种：旧判据（只看自身样式和尺寸）会命中、新判据看不见的（不在视口 / 祖先透明 / 被盖住 / 被裁）；
+// 以及自身被藏起来（display:none / visibility:hidden / 透明 / 被裁）但里面有验证内容的。空的、藏起来的占位容器
+// （旧判据也从来不认）仍然不算，免得 SDK 常驻的空壳让每次读都停。
+// 看得见的优先：页面上只要有一个看得见的就报 visible。是不是「隔 1.5 秒仍成立」由 RiskPage 复读判，这里只读一次。
+const riskFindJS = `() => {
+ const EXCLUDE = ` + "`" + riskContentSelector + "`" + `;
+ const vw = window.innerWidth || document.documentElement.clientWidth || 0;
+ const vh = window.innerHeight || document.documentElement.clientHeight || 0;
+ const WORDS = /验证|拖动|滑块|拼图|滑动/;
+ const lenient = (e) => {
+  const r = e.getBoundingClientRect();
+  if (r.width < 40 || r.height < 30) return false;
+  const cs = getComputedStyle(e);
+  return cs.display !== "none" && cs.visibility !== "hidden" && parseFloat(cs.opacity || "1") > 0.05;
+ };
+ const clippedAway = (cs) => {
+  const cp = String(cs.clipPath || "none").trim();
+  if (cp !== "none" && /^(inset\(\s*(5\d|[6-9]\d|100)%|circle\(\s*0(px|%)?\s*(at|\))|ellipse\(\s*0(px|%)?\s)/.test(cp)) return true;
+  const m = String(cs.clip || "auto").match(/^rect\(\s*(-?[\d.]+)px,?\s*(-?[\d.]+)px,?\s*(-?[\d.]+)px,?\s*(-?[\d.]+)px\s*\)$/);
+  if (m && (cs.position === "absolute" || cs.position === "fixed")) {
+   const t = +m[1], r = +m[2], b = +m[3], l = +m[4];
+   if (r - l <= 1 || b - t <= 1) return true;
+  }
+  return false;
+ };
+ // 藏起来的原因（自身或祖先样式）；"" = 样式上没藏
+ const styleHidden = (e) => {
+  let op = 1;
+  for (let a = e; a && a.nodeType === 1; a = a.parentElement) {
+   const cs = getComputedStyle(a);
+   if (cs.display === "none") return a === e ? "display-none" : "ancestor-display-none";
+   if (a === e && cs.visibility === "hidden") return "visibility-hidden";
+   op *= parseFloat(cs.opacity || "1");
+   if (op <= 0.05) return a === e ? "opacity-0" : "ancestor-opacity-0";
+   if (clippedAway(cs)) return a === e ? "clipped" : "ancestor-clipped";
+  }
+  return "";
+ };
+ // 看不见的原因；"" = 真看得见
+ const hiddenWhy = (e) => {
+  const s = styleHidden(e);
+  if (s) return s;
+  const r = e.getBoundingClientRect();
+  if (r.width < 40 || r.height < 30) return "too-small";
+  const x0 = Math.max(0, r.left), y0 = Math.max(0, r.top), x1 = Math.min(vw, r.right), y1 = Math.min(vh, r.bottom);
+  if (x1 - x0 < 1 || y1 - y0 < 1) return "offscreen";
+  const p = document.elementFromPoint((x0 + x1) / 2, (y0 + y1) / 2);
+  if (!p || (p !== e && !e.contains(p))) return "occluded";
+  return "";
+ };
+ const verifyContent = (e) => e.tagName === "IFRAME" || !!e.querySelector("iframe, canvas, img") ||
+  WORDS.test(String(e.textContent || "").slice(0, 2000));
+ const big = (e) => {
+  if (e === document.body || e === document.documentElement) return true;
+  const r = e.getBoundingClientRect();
+  return vw > 0 && vh > 0 && r.width * r.height > 0.9 * vw * vh;
+ };
+ const bigCounts = (e) => String(e.innerText || e.textContent || "").trim().length <= 300 && verifyContent(e);
+ let hidden = null;
+ for (const e of document.querySelectorAll('[class*="captcha" i], [id*="captcha" i], iframe[src*="captcha" i]')) {
+  if (e.closest(EXCLUDE)) continue;
+  if (big(e) && !bigCounts(e)) continue;
+  const why = hiddenWhy(e);
+  if (!why) return {why: e.tagName === "IFRAME" ? "iframe" : "widget", el: e, kind: "visible", hidden_why: ""};
+  if (hidden) continue;
+  if (lenient(e) || (why !== "too-small" && why !== "offscreen" && why !== "occluded" && verifyContent(e))) {
+   hidden = {why: "hidden-widget", el: e, kind: "hidden", hidden_why: why};
+  }
+ }
+ const fixedBox = (e) => {
+  for (let a = e; a && a !== document.documentElement; a = a.parentElement) {
+   if (getComputedStyle(a).position === "fixed") return a;
+  }
+  return null;
+ };
+ if (document.body) {
+  const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+  while (w.nextNode()) {
+   const s = (w.currentNode.nodeValue || "").trim();
+   if (!s.includes("安全验证") || s.length > 40) continue;
+   const el = w.currentNode.parentElement;
+   if (!el || el.closest(EXCLUDE)) continue;
+   const box = fixedBox(el);
+   if (!box || !lenient(box)) continue;
+   const t = (box.innerText || "").trim();
+   if (t.length > 300 || !/拖动|拼图|滑块|滑动|点击|验证/.test(t.replace(/安全验证/g, ""))) continue;
+   const why = hiddenWhy(box);
+   if (!why) return {why: "overlay", el: box, kind: "visible", hidden_why: ""};
+   if (!hidden) hidden = {why: "hidden-widget", el: box, kind: "hidden", hidden_why: "overlay-" + why};
+  }
+ }
+ return hidden || {why: "", el: null, kind: "", hidden_why: ""};
+}`
+
+// riskProbeJS 读一次页面的风控读数：{path, captcha（看得见的验证）, hidden（看不见的验证组件）, why, hidden_why}。
+const riskProbeJS = `() => {
+ const hit = (` + riskFindJS + `)();
+ return JSON.stringify({path: location.pathname, captcha: hit.kind === "visible", hidden: hit.kind === "hidden",
+  why: hit.why, hidden_why: hit.hidden_why || ""});
+}`
+
+// ClassifyRisk 按页面路径和验证浮层判风控（纯函数）。
+func ClassifyRisk(path string, captcha bool) *RiskError {
+	p := strings.ToLower(path)
+	if strings.HasPrefix(p, "/website-login") {
+		return &RiskError{Code: RiskAccount, Detail: "小红书把页面跳到了 " + path + "（登录异常/安全跳转），已停止操作"}
+	}
+	if captcha || strings.Contains(p, "/captcha") {
+		return &RiskError{Code: RiskCaptcha, Detail: "小红书要求安全验证（拼图滑块），已停止操作"}
+	}
+	return nil
+}
+
+// riskProbe 一次读数。
+type riskProbe struct {
+	Path      string `json:"path"`
+	Captcha   bool   `json:"captcha"` // 看得见的验证（iframe / widget / overlay）
+	Hidden    bool   `json:"hidden"`  // 看不见的验证组件（hidden-widget）
+	Why       string `json:"why"`
+	HiddenWhy string `json:"hidden_why"`
+}
+
+func (p riskProbe) seen() bool { return p.Captcha || p.Hidden }
+
+func (p riskProbe) label() string {
+	switch {
+	case p.Captcha:
+		return p.Why
+	case p.Hidden:
+		return p.Why + ":" + p.HiddenWhy
+	}
+	return "none"
+}
+
+// RiskConfirmDelay 探针第一次看到验证组件后，隔多久再读一次确认（1008 第二轮：隔 1.5 秒仍成立才算；测试里改小）。
+var RiskConfirmDelay = 1500 * time.Millisecond
+
+// readRiskProbe 读一次页面。
+//
+// 1008 审查 blocker：调用方的 page 常带着已经过期的 deadline（NewUserProfileAction 的 page.Timeout(60s) 从构造那一刻起算，
+// 滚收藏 6 分钟后它早就过期了），从它派生 Timeout(5s) 会立刻失败、被当成「没风险」——卡住期间每轮查风控、歇完再查
+// 全成了空转。现在一律换一份干净的 context、只给 5 秒（只读页面，不导航、不点）。读不到照旧按「看不出风险」处理，
+// 但写一行日志，并记下来进下一份证据（probe_error）。
+func readRiskProbe(page *rod.Page) (riskProbe, error) {
+	var p riskProbe
+	var raw string
+	err := rod.Try(func() { raw = page.Context(context.Background()).Timeout(5 * time.Second).MustEval(riskProbeJS).Str() })
+	if err == nil {
+		if e := json.Unmarshal([]byte(raw), &p); e != nil {
+			err = fmt.Errorf("读数解不开：%w", e)
+		}
+	}
+	if err != nil {
+		noteProbeError(page, err)
+		logrus.Warnf("风控探针读不到页面（按看不出风险处理）：%v", err)
+		return riskProbe{}, err
+	}
+	return p, nil
+}
+
+// RiskPage 统一风控检查：导航后、关键步骤前调用。页面读不出来（已关、超时）按「看不出风险」处理（记日志）。
+//
+// 1008 第二轮：看到验证组件后隔 RiskConfirmDelay（1.5 秒）再读一次——
+//   - 两次都看得见 → CAPTCHA_REQUIRED（照旧立即停 + 熔断，安全第一，不放宽）；
+//   - 只看见过看不见的组件、或出现了一下又没了 → HIDDEN_WIDGET（停本次、不写熔断，见 RiskHiddenWidget）；
+//   - 第一次没看见、第二次才看得见 → 再隔一次读第三次，看得见才算 CAPTCHA_REQUIRED；
+//   - 复读读不到页面（两次）→ 按第一次的读数（宁可停）。
+//
+// 被跳到 /website-login/*（路径就是证据）不复读，直接 ACCOUNT_RISK。
+// 1008（B1）：命中时当场落一份出事证据（截图 + 命中元素 + 收藏接口回包，见 evidence.go），目录记进 RiskError.Evidence；
+// 服务层写熔断时把它挂进 risk-hold.json（url / tab / evidence）。
+func RiskPage(page *rod.Page) *RiskError {
+	if page == nil {
+		return nil
+	}
+	r := confirmRisk(page)
+	if r != nil {
+		// 收藏接口刚回了拒绝（461 / 300011 之类）：这是「不是误报」最硬的证据，写进 Detail（熔断的 detail、MCP 报错文本都看得到）
+		if w := collectWatchFor(page); w != nil && !r.Hidden() {
+			w.waitBodies(time.Second) // 刚回来的回包还在取（读浏览器内存），等一小会儿好带上 code
+			if why := w.Refused(); why != "" {
+				r.Detail += "；" + why
+			}
+		}
+		noteRiskEvidence(page, r)
+	}
+	return r
+}
+
+func confirmRisk(page *rod.Page) *RiskError {
+	p1, err := readRiskProbe(page)
+	if err != nil {
+		return nil
+	}
+	if r := ClassifyRisk(p1.Path, false); r != nil {
+		r.Why = "path"
+		logrus.Warnf("风控页: %s（path=%s why=path）", r.Error(), p1.Path)
+		return r
+	}
+	if !p1.seen() {
+		return nil
+	}
+	reads := []riskProbe{p1}
+	again := func() (riskProbe, bool) {
+		for i := 0; i < 2; i++ {
+			time.Sleep(RiskConfirmDelay)
+			if p, err := readRiskProbe(page); err == nil {
+				reads = append(reads, p)
+				return p, true
+			}
+		}
+		return riskProbe{}, false
+	}
+	labels := func() string {
+		s := make([]string, len(reads))
+		for i, p := range reads {
+			s[i] = p.label()
+		}
+		return strings.Join(s, " → ")
+	}
+	captcha := func(p riskProbe) *RiskError {
+		if r := ClassifyRisk(p.Path, false); r != nil {
+			r.Why = "path"
+			logrus.Warnf("风控页: %s（path=%s why=path，复读时被跳走）", r.Error(), p.Path)
+			return r
+		}
+		r := ClassifyRisk(p.Path, true)
+		r.Why = p.Why
+		logrus.Warnf("风控页: %s（path=%s why=%s，读数 %s）", r.Error(), p.Path, p.Why, labels())
+		return r
+	}
+	hidden := func(p riskProbe) *RiskError {
+		why := "hidden-widget:" + p1.HiddenWhy
+		if p1.Captcha {
+			why = "appeared-then-gone:" + p1.Why
+		}
+		logrus.Warnf("看不见的验证组件（%s，path=%s，读数 %s）：本次停下、不写熔断", why, p.Path, labels())
+		return &RiskError{Code: RiskHiddenWidget, Detail: HiddenWidgetDetail, Why: why}
+	}
+	p2, ok := again()
+	switch {
+	case !ok: // 复读读不到页面：按第一次的读数，宁可停
+		if p1.Captcha {
+			return captcha(p1)
+		}
+		return hidden(p1)
+	case ClassifyRisk(p2.Path, false) != nil:
+		return captcha(p2)
+	case p1.Captcha && p2.Captcha:
+		return captcha(p2)
+	case p2.Captcha: // 第一次没看见、第二次才看得见：再确认一次
+		p3, ok := again()
+		if !ok || p3.Captcha || ClassifyRisk(p3.Path, false) != nil {
+			if ok {
+				return captcha(p3)
+			}
+			return captcha(p2)
+		}
+		return hidden(p3)
+	}
+	return hidden(p2)
+}
+
+// RiskPageRead 读一次页面（不复读、不落证据），另报这次到底读没读到页面（ok=false：页面已关/超时，结果不作数）。
+// 验证窗口要靠它区分「没风险」和「根本没看到」：验证窗口每 2 秒读一次，滑块挂着时不能每 2 秒截一张图。
+// 只报看得见的验证和安全跳转；看不见的验证组件（hidden-widget）不算——她在窗口里看不见、也拖不了它。
+func RiskPageRead(page *rod.Page) (*RiskError, bool) {
+	if page == nil {
+		return nil, false
+	}
+	p, err := readRiskProbe(page)
+	if err != nil {
+		return nil, false
+	}
+	r := ClassifyRisk(p.Path, p.Captcha)
+	if r != nil {
+		r.Why = p.Why
+		logrus.Warnf("风控页: %s（path=%s why=%s）", r.Error(), p.Path, p.Why)
+	}
+	return r, true
+}
+
+// PageLoginState 读一次页面登录标志（不导航、不等待）：user / guest / guestflag / risk / pending；读不到返回空串。
+// 同 readRiskProbe，换一份干净的 context（调用方的 page 可能带着过期的 deadline）。
+func PageLoginState(page *rod.Page) string {
+	if page == nil {
+		return ""
+	}
+	st := ""
+	_ = rod.Try(func() { st = page.Context(context.Background()).Timeout(5 * time.Second).MustEval(loginStateJS).Str() })
+	return st
+}
+
+// accessTextRisk 详情页错误容器里的文字若是安全验证提示，按验证码停车而不是「笔记不可访问」。
+func accessTextRisk(text string) *RiskError {
+	if strings.Contains(text, "安全验证") || strings.Contains(text, "验证码") {
+		t := []rune(strings.TrimSpace(text))
+		if len(t) > 80 {
+			t = t[:80]
+		}
+		return &RiskError{Code: RiskCaptcha, Detail: fmt.Sprintf("笔记页要求安全验证：%s", string(t))}
+	}
+	return nil
+}
