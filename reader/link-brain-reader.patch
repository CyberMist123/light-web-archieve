+func TestLocalBrowserRiskAfterActionDeadline(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("LINK_BRAIN_EVIDENCE_DIR", root)
+	oldBudget := profileActionBudget
+	profileActionBudget = 300 * time.Millisecond
+	t.Cleanup(func() { profileActionBudget = oldBudget })
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
