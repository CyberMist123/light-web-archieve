+// fastFavCfg 单测用：毫秒级的等待，四级滚法。
+func fastFavCfg(expect int) favScrollCfg {
+	return favScrollCfg{
+		Budget: 3 * time.Second, Settle: []time.Duration{30 * time.Millisecond, 40 * time.Millisecond, 50 * time.Millisecond, 60 * time.Millisecond},
+		ConfirmEnd: 15 * time.Millisecond, Expect: expect, ExpectRatio: favExpectRatio, WantTab: "fav",
+		Tick: func(int) time.Duration { return 2 * time.Millisecond },
+	}
+}
