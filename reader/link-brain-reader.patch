+	favCards = `<div class="feeds-container" style="position:relative;height:600px">
+<section class="note-item" style="position:absolute;top:0;left:0;width:220px;height:280px"><a class="title"><span>手机号安全验证怎么办</span></a><div>拖动滑块验证教程</div></section>
+<section class="note-item" style="position:absolute;top:0;left:240px;width:220px;height:280px"><span>安全验证</span><span>拼图</span></section>
+</div>`
+	detailModal = `<div class="note-detail-mask" style="position:fixed;inset:0;background:#fff">
+<div id="noteContainer" class="note-container"><div id="detail-title">安全验证怎么过</div>
