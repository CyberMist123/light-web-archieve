+// persistSessionCookies：站点把 web_session 等发成会话 cookie（无过期时间），
+// Chromium 正常退出就丢——这是「扫完码、下次调用又是游客」的真因（0925 实测）。
+// 关浏览器前给小红书/rednote 域的会话 cookie 补 30 天有效期，值不变、仍在同一 profile。
+// 只记名字和域名，不碰值的日志。
+func (b *Browser) persistSessionCookies() {
+	if b.page == nil {
+		return
+	}
+	err := rod.Try(func() {
+		res, err := proto.StorageGetCookies{}.Call(b.page.Browser())
+		if err != nil {
+			logrus.Warnf("persist cookies: get failed: %v", err)
+			return
+		}
+		exp := proto.TimeSinceEpoch(time.Now().Add(30 * 24 * time.Hour).Unix())
+		var fix []*proto.NetworkCookieParam
+		var names []string
+		for _, c := range res.Cookies {
+			d := strings.ToLower(c.Domain)
+			if !strings.Contains(d, "xiaohongshu.com") && !strings.Contains(d, "rednote.com") {
+				continue
+			}
+			if c.Name == "web_session" {
+				names = append(names, fmt.Sprintf("web_session@%s(session=%v,empty=%v)", c.Domain, c.Session, c.Value == ""))
+			}
+			if !c.Session || c.Value == "" {
+				continue
+			}
+			fix = append(fix, &proto.NetworkCookieParam{Name: c.Name, Value: c.Value, Domain: c.Domain, Path: c.Path,
+				Secure: c.Secure, HTTPOnly: c.HTTPOnly, SameSite: c.SameSite, Expires: exp})
+		}
+		if len(fix) > 0 {
+			if err := (proto.StorageSetCookies{Cookies: fix}).Call(b.page.Browser()); err != nil {
+				logrus.Warnf("persist cookies: set failed: %v", err)
+				return
+			}
+		}
+		logrus.Infof("persist cookies: made %d session cookies persistent; %v", len(fix), names)
+	})
