+// TestVerifyWindowNoHoldDoesNotOpen 1008（B3）：没有熔断时 /verify/window 直接回 no_hold，不开窗、不拿浏览器锁。
+func TestVerifyWindowNoHoldDoesNotOpen(t *testing.T) {
+	app, _ := testApp(t)
+	var opened atomic.Int32
+	old := openWindowBrowser
+	openWindowBrowser = func() (*browser.Browser, error) { opened.Add(1); return nil, browser.ErrProfileBusy }
+	t.Cleanup(func() { openWindowBrowser = old })
+	router := setupRoutes(app)
+
+	code, out := doJSON(t, router, "POST", "/api/v1/verify/window", "")
+	require.Equal(t, http.StatusOK, code)
+	data := out["data"].(map[string]any)
+	assert.Equal(t, false, data["opened"])
+	assert.Equal(t, "no_hold", data["result"])
+	time.Sleep(100 * time.Millisecond)
+	assert.Equal(t, int32(0), opened.Load(), "没有熔断不许开窗")
+	assert.Equal(t, false, app.xiaohongshuService.state.snapshot()["verifying"])
+
+	// 对照：有熔断才开（桩回「忙」→ 窗口没打开，结论 window_failed，熔断保留）
+	app.xiaohongshuService.tripRisk(xiaohongshu.RiskCaptcha, "test")
+	code, out = doJSON(t, router, "POST", "/api/v1/verify/window", "")
+	require.Equal(t, http.StatusOK, code)
+	assert.Equal(t, true, out["data"].(map[string]any)["opened"])
+	for i := 0; i < 100 && app.xiaohongshuService.state.snapshot()["verifying"] == true; i++ {
+		time.Sleep(10 * time.Millisecond)
+	}
+	assert.Equal(t, int32(1), opened.Load())
+	assert.Equal(t, "window_failed", app.xiaohongshuService.state.snapshot()["verify_result"])
+	assert.NotNil(t, app.xiaohongshuService.hold.get())
+}
