new file mode 100644
index 0000000..2bb74d8
--- /dev/null
+++ b/browser/killtree_windows.go
@@ -0,0 +1,36 @@
+//go:build windows
+
+package browser
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"syscall"
+	"time"
+
+	"github.com/sirupsen/logrus"
+)
+
+// KillTree 杀掉 pid 及其全部子进程（taskkill /T /F），最多等 10 秒；失败再退回只杀主进程。
+func KillTree(pid int) {
+	if pid <= 0 || pid == os.Getpid() {
+		return
+	}
+	exe := filepath.Join(os.Getenv("SystemRoot"), "System32", "taskkill.exe")
+	if os.Getenv("SystemRoot") == "" {
+		exe = "taskkill.exe"
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, exe, "/T", "/F", "/PID", strconv.Itoa(pid))
+	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true, CreationFlags: 0x08000000} // CREATE_NO_WINDOW
+	if out, err := cmd.CombinedOutput(); err != nil {
+		logrus.Warnf("taskkill /T pid=%d: %v %s", pid, err, out)
+		if p, e := os.FindProcess(pid); e == nil {
+			_ = p.Kill()
+		}
+	}
+}
diff --git a/browser/lock.go b/browser/lock.go
new file mode 100644
index 0000000..29e18e3
--- /dev/null
+++ b/browser/lock.go
@@ -0,0 +1,160 @@
+package browser
+
+import (
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sirupsen/logrus"
+)
+
+// 1001：profile 锁记下被谁占、从几点开始、浏览器进程号——/login/session 报出来，看门狗靠它判卡死。
+
+// LockInfo profile 锁的占用信息。
+type LockInfo struct {
+	Owner string
+	Since time.Time
+	PID   int
+}
+
+var (
+	lockMu  sync.Mutex
+	lockCur *LockInfo
+
+	// 关闭上限：落盘会话 cookie、关浏览器（变量便于测试缩短）。
+	persistMax = 10 * time.Second
+	closeMax   = 20 * time.Second
+
+	// 测试替身入口。
+	killTreeFn  = KillTree
+	exitProcess = os.Exit
+
+	watchdogOnce sync.Once
+)
+
+// defaultLockMax 锁占用上限；XHS_LOCK_MAX_S 可覆盖。
+const defaultLockMax = 900 * time.Second
+
+// LockMax 锁占用上限（XHS_LOCK_MAX_S，默认 900 秒）。
+func LockMax() time.Duration {
+	if v, err := strconv.Atoi(strings.TrimSpace(os.Getenv("XHS_LOCK_MAX_S"))); err == nil && v > 0 {
+		return time.Duration(v) * time.Second
+	}
+	return defaultLockMax
+}
+
+// lockProfile 拿 profile 锁。wait<0 一直等；否则最多等 wait，拿不到返回 false。
+func lockProfile(owner string, wait time.Duration) bool {
+	if wait < 0 {
+		profileMu.Lock()
+	} else {
+		deadline := time.Now().Add(wait)
+		for !profileMu.TryLock() {
+			if time.Now().After(deadline) {
+				return false
+			}
+			time.Sleep(200 * time.Millisecond)
+		}
+	}
+	lockMu.Lock()
+	lockCur = &LockInfo{Owner: owner, Since: time.Now()}
+	lockMu.Unlock()
+	startLockWatchdog()
+	return true
+}
+
+// Occupy 拿住 profile 锁但不开浏览器（测试里用它确保任何误触的开页都只会排队、不会真拉起浏览器）。
+// 返回释放函数；wait 内拿不到返回 ok=false。
+func Occupy(owner string, wait time.Duration) (release func(), ok bool) {
+	if !lockProfile(owner, wait) {
+		return nil, false
+	}
+	var once sync.Once
+	return func() { once.Do(unlockProfile) }, true
+}
+
+func unlockProfile() {
+	lockMu.Lock()
+	lockCur = nil
+	lockMu.Unlock()
+	profileMu.Unlock()
+}
+
+func setLockPID(pid int) {
+	lockMu.Lock()
+	defer lockMu.Unlock()
+	if lockCur != nil {
+		lockCur.PID = pid
+	}
+}
+
+// CurrentLock 当前锁的快照；没人占时返回 nil。只读内存，不碰锁本身。
+func CurrentLock() *LockInfo {
+	lockMu.Lock()
+	defer lockMu.Unlock()
+	if lockCur == nil {
+		return nil
+	}
+	c := *lockCur
+	return &c
+}
+
+// lockOverdue 占锁超过 max 时返回占用信息，否则 nil。
+func lockOverdue(now time.Time, max time.Duration) *LockInfo {
+	l := CurrentLock()
+	if l == nil || now.Sub(l.Since) <= max {
+		return nil
+	}
+	return l
+}
+
+// checkLockWatchdog 占锁超时就杀掉浏览器进程树并以 75 退出，交给调用方（ensure_reader）重新拉起。
+func checkLockWatchdog(now time.Time) bool {
+	max := LockMax()
+	l := lockOverdue(now, max)
+	if l == nil {
+		return false
+	}
+	logrus.Errorf("XHS profile lock held by %s for %s (> %s); killing browser pid=%d and exiting 75 so the caller restarts a clean reader",
+		l.Owner, now.Sub(l.Since).Round(time.Second), max, l.PID)
+	if l.PID > 0 {
+		killTreeFn(l.PID)
+	}
+	exitProcess(75)
+	return true
+}
+
+func startLockWatchdog() {
+	watchdogOnce.Do(func() {
+		go func() {
+			for {
+				time.Sleep(10 * time.Second)
+				checkLockWatchdog(time.Now())
+			}
+		}()
+	})
+}
+
+// callerName 取第一个不属于浏览器工厂的调用者函数名，当锁的 owner。
+func callerName() string {
+	pcs := make([]uintptr, 16)
+	n := runtime.Callers(2, pcs)
+	frames := runtime.CallersFrames(pcs[:n])
+	for {
+		f, more := frames.Next()
+		fn := f.Function
+		if fn != "" && !strings.HasPrefix(fn, "github.com/xpzouying/xiaohongshu-mcp/browser.") && fn != "main.newBrowser" &&
+			!strings.HasSuffix(fn, ".openBrowser") && !strings.HasSuffix(fn, ".openHeadedBrowser") {
+			if i := strings.LastIndex(fn, "/"); i >= 0 {
+				fn = fn[i+1:]
+			}
+			return fn
+		}
+		if !more {
+			return "unknown"
+		}
+	}
+}
