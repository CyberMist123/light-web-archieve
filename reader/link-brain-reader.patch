+// ---- 附件下载：每次（重）点「下载」之前都查风控（审查 should-fix） ----
+
+func TestWaitDownloadChecksRiskBeforeEveryClick(t *testing.T) {
+	old := downloadClickAt
+	downloadClickAt = map[int]bool{0: true, 2: true, 4: true}
+	t.Cleanup(func() { downloadClickAt = old })
+
+	var clicks, checks int
+	path, stopped := waitDownload(context.Background(), time.Millisecond,
+		func() bool { checks++; return checks == 2 }, // 第二次点之前页面弹了验证
+		func() { clicks++ },
+		func() string { return "" })
+	assert.True(t, stopped)
+	assert.Equal(t, "", path)
+	assert.Equal(t, 1, clicks, "撞到风控后不能再点")
+
+	clicks, checks = 0, 0
+	n := 0
+	path, stopped = waitDownload(context.Background(), time.Millisecond,
+		func() bool { checks++; return false },
+		func() { clicks++ },
+		func() string {
+			n++
+			if n == 3 {
+				return "f.pdf"
+			}
+			return ""
+		})
+	assert.False(t, stopped)
+	assert.Equal(t, "f.pdf", path)
+	assert.Equal(t, 2, clicks)
+	assert.Equal(t, 2, checks)
+}
