+// favBudget 预算 = min(favScrollBudget, ctx 截止 − favExtractReserve)，不为负。
+func favBudget(ctx context.Context, now time.Time) time.Duration {
+	b := favScrollBudget
+	if dl, ok := ctx.Deadline(); ok {
+		if left := dl.Sub(now) - favExtractReserve; left < b {
+			b = left
+		}
+	}
+	if b < 0 {
+		b = 0
+	}
+	return b
+}
