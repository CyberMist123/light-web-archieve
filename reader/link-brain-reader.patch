+	c.Request = httptest.NewRequest("POST", "/api/v1/feeds/detail", nil)
+	app.respondServiceError(c, &xiaohongshu.NoteRestrictedError{NoteID: testNote, Path: "/explore", Evidence: "E"},
+		http.StatusInternalServerError, "GET_FEED_DETAIL_FAILED", "获取Feed详情失败")
