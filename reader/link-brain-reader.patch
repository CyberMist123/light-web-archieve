+
+// relatedFileJS：登录态下 __INITIAL_STATE__ 里的对象是 Vue ref，要拆 value/_value 才看得到内容
+// （0917 以为『登录会藏掉附件』，多半就是没拆 ref）。state 读不到时再看页面上有没有附件卡片。
+const relatedFileJS = `(nid) => {
+  const un = (x) => { for (let i = 0; i < 4 && x && typeof x === "object" && ("_value" in x || "value" in x) && !("noteId" in x); i++) x = x._value ?? x.value; return x; };
+  const st = window.__INITIAL_STATE__ || {};
+  const map = un(un(st.note)?.noteDetailMap) || {};
+  const note = un(un(map[nid])?.note) || {};
+  const u = un(un(st.user)?.userInfo);
+  const rf = un(note.relatedFile) || null;
+  const card = Array.from(document.querySelectorAll("[class*=file], [class*=attach], [class*=doc]"))
+    .map(e => (e.innerText || "").trim()).find(t => /\.(pdf|docx?|xlsx?|pptx?|zip)\b/i.test(t)) || "";
+  const wall = location.pathname.startsWith("/login") || location.pathname.startsWith("/404");
+  return JSON.stringify({ hasNote: !!note.noteId, guest: !!(u && u.guest), wall, path: location.pathname,
+    relatedFile: rf ? { docId: String(rf.docId ?? ""), name: rf.name || "", bizExtra: rf.bizExtra || "" } : null,
+    cardText: card.slice(0, 200),
+    loginBtn: !!Array.from(document.querySelectorAll("button, div")).find(e => (e.innerText || "").trim() === "登录") });
+}`
+
+// noteRelatedFileHandler 用登录的号打开笔记页（像人一样看一会儿），读附件元数据。
+// 给游客被登录墙挡住的笔记用；一次只看一篇，由调用方控制节奏。
+func (s *AppServer) noteRelatedFileHandler(c *gin.Context) {
+	var req noteFileRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		respondError(c, http.StatusBadRequest, "INVALID_REQUEST", "请求参数错误", err.Error())
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	b, berr := s.xiaohongshuService.openHeadedBrowser()
+	if berr != nil {
+		s.respondServiceError(c, berr, http.StatusBadGateway, "NOTE_OPEN_FAILED", "笔记页打不开")
+		return
+	}
+	defer b.Close()
+	page := b.NewPage()
+	var out string
+	var risk *xiaohongshu.RiskError
+	err := rod.Try(func() {
+		u := fmt.Sprintf("%s/explore/%s?xsec_token=%s&xsec_source=pc_feed", xiaohongshu.SiteHost(),
+			url.PathEscape(req.NoteID), url.QueryEscape(req.XsecToken))
+		page.Context(ctx).Timeout(40 * time.Second).MustNavigate(u).MustWaitLoad()
+		if risk = xiaohongshu.RiskPage(page); risk != nil {
+			return
+		}
+		humanDwell(page, 5, 12)
+		if risk = xiaohongshu.RiskPage(page); risk != nil {
+			return
+		}
+		out = page.Context(ctx).MustEval(relatedFileJS, req.NoteID).Str()
+	})
+	if err != nil && risk == nil {
+		risk = xiaohongshu.RiskPage(page)
+	}
+	if risk != nil {
+		s.respondRisk(c, risk)
+		return
+	}
+	if err != nil {
+		respondError(c, http.StatusBadGateway, "NOTE_OPEN_FAILED", "笔记页打不开", err.Error())
+		return
+	}
+	// 登录号看笔记却是游客：调用方（attachments.py）照旧按 data.guest 停车，这里同时写熔断，后面的开页一律拦下
+	var probe struct {
+		Guest    bool `json:"guest"`
+		LoginBtn bool `json:"loginBtn"`
+	}
+	if json.Unmarshal([]byte(out), &probe) == nil && (probe.Guest || probe.LoginBtn) {
+		s.xiaohongshuService.tripRisk(xiaohongshu.RiskNotLoggedIn, "登录号补看：打开笔记是游客")
+	}
+	c.Data(http.StatusOK, "application/json; charset=utf-8", []byte(`{"success":true,"data":`+out+`}`))
+}
+
+// downloadAttachment 必须 headed：headless 下站点那个下载 POST 会挂住。
+// 实测要点（0925）：只认 xiaohongshu.com 的 /file 页；按钮刚渲染出来就点没反应，要等预览挂好。
+// 1001：每次导航后、点下载前都查风控；撞到就返回 *xiaohongshu.RiskError（code 为风控码），不再往下点。
+func downloadAttachment(parent context.Context, req attachmentRequest, dest string,
+	open func() (*browser.Browser, error)) (string, string, error) {
+	ctx, cancel := context.WithTimeout(parent, 3*time.Minute)
+	defer cancel()
+	before := map[string]bool{}
+	if es, err := os.ReadDir(dest); err == nil {
+		for _, e := range es {
+			before[e.Name()] = true
+		}
+	}
+	b, berr := open() // 拿到锁后再查一次熔断（*holdError）
+	if berr != nil {
+		return "", codeRiskHold, berr
+	}
+	defer b.Close()
+	page := b.NewPage()
+	var path, code string
+	var fail error
+	stopIfRisk := func() bool {
+		if r := xiaohongshu.RiskPage(page); r != nil {
+			code, fail = r.Code, r
+			return true
+		}
+		return false
+	}
+	err := rod.Try(func() {
+		_ = proto.BrowserSetDownloadBehavior{Behavior: proto.BrowserSetDownloadBehaviorBehaviorAllow,
+			DownloadPath: dest, EventsEnabled: true}.Call(page.Browser())
+		// 0927 像人：先打开笔记看一会儿、往下翻一翻，再去附件页（人是从笔记里点进附件的）
+		if req.NoteID != "" {
+			nu := fmt.Sprintf("%s/explore/%s?xsec_token=%s&xsec_source=pc_feed", xiaohongshu.SiteHost(),
+				url.PathEscape(req.NoteID), url.QueryEscape(req.XsecToken))
+			if page.Context(ctx).Timeout(30*time.Second).Navigate(nu) == nil {
+				if stopIfRisk() {
+					return
+				}
+				humanDwell(page, 6, 14)
+				if stopIfRisk() {
+					return
+				}
+				// 1011：笔记页上没有这篇（网页版限制了，要人工验证才给看）：不再往附件页去，回 NOTE_RESTRICTED（不写熔断）；
+				// 页面说是游客 → NOT_LOGGED_IN（号的事）。读不到页面 / 判不了照旧往下走
+				if st, ok := xiaohongshu.ReadNoteState(page, req.NoteID); ok {
+					switch e := xiaohongshu.ClassifyMissingNote(req.NoteID, st).(type) {
+					case *xiaohongshu.RiskError:
+						code, fail = e.Code, e
+						return
+					case *xiaohongshu.NoteRestrictedError:
+						if ev := xiaohongshu.CaptureEvidence(page, xiaohongshu.EvidenceRestricted, nil, ""); ev != nil {
+							e.Evidence = ev.Dir
+						}
+						code, fail = xiaohongshu.NoteRestrictedCode, e
+						return
+					}
+				}
+			}
+		}
+		u := fmt.Sprintf("%s/file/%s?noteId=%s&fileName=%s&xsec_token=%s&xsec_source=note_detail_file",
+			xiaohongshu.SiteHost(), url.PathEscape(req.DocID), url.QueryEscape(req.NoteID),
+			url.QueryEscape(req.FileName), url.QueryEscape(req.XsecToken))
+		_ = page.Context(ctx).Timeout(30 * time.Second).Navigate(u)
+		if stopIfRisk() {
+			return
+		}
+		btn, err := page.Context(ctx).Timeout(45*time.Second).ElementR("button", `下载`)
+		if err != nil {
+			if stopIfRisk() {
+				return
+			}
+			st, _ := page.Eval(`() => { const u=window.__INITIAL_STATE__?.user?.userInfo; const x=u?.value??u?._value??u?._rawValue??u; return x?.guest===true ? "guest" : "" }`)
+			if st != nil && st.Value.String() == "guest" {
+				code, fail = xiaohongshu.RiskNotLoggedIn, &xiaohongshu.RiskError{Code: xiaohongshu.RiskNotLoggedIn, Detail: "附件页：读取服务的号是游客"}
+				return
+			}
+			code, fail = "NO_DOWNLOAD_BUTTON", fmt.Errorf("附件页没有出现下载按钮（文件可能已删除或无下载权限）")
+			return
+		}
+		time.Sleep(8 * time.Second)
+		var stopped bool
+		path, stopped = waitDownload(ctx, time.Second, stopIfRisk,
+			func() {
+				if b2, err := page.Timeout(10*time.Second).ElementR("button", `下载`); err == nil {
+					btn = b2
+				}
+				_ = btn.Timeout(10*time.Second).Click(proto.InputMouseButtonLeft, 1)
+			},
+			func() string {
+				es, _ := os.ReadDir(dest)
+				for _, e := range es {
+					n := e.Name()
+					if !before[n] && !e.IsDir() && !strings.HasSuffix(n, ".crdownload") && !strings.HasSuffix(n, ".tmp") {
+						if info, err := e.Info(); err == nil && info.Size() > 0 {
+							return filepath.Join(dest, n)
+						}
+					}
+				}
+				return ""
+			})
+		if stopped || path != "" {
+			return
+		}
+		if stopIfRisk() {
+			return
+		}
+		code, fail = "DOWNLOAD_TIMEOUT", fmt.Errorf("点了下载但 90 秒内没有文件落地")
+	})
+	if err != nil && fail == nil {
+		fail = err
+		stopIfRisk()
+	}
+	return path, code, fail
+}
+
+// downloadClickAt 第几个 tick 点（重点）一次「下载」：刚渲染出来的按钮常点了没反应（0925）。
+var downloadClickAt = map[int]bool{0: true, 20: true, 45: true}
+
+// waitDownload 点「下载」并等文件落地，最多 90 个 tick。1001：每次（重）点之前都先查风控，
+// 撞上就不点、返回 stopped=true。landed 返回落地文件路径（没有返回空串）。
+func waitDownload(ctx context.Context, tick time.Duration, risk func() bool, click func(), landed func() string) (path string, stopped bool) {
+	for i := 0; i < 90 && ctx.Err() == nil; i++ {
+		if downloadClickAt[i] {
+			if risk() {
+				return "", true
+			}
+			click()
+		}
+		if sleepCtx(ctx, tick) != nil {
+			break
+		}
+		if p := landed(); p != "" {
+			return p, false
+		}
+	}
+	return "", false
+}
+
+// loginWindowHandler 打开小红书官方登录窗口（有界面），由人在官方页面扫码——二维码、「扫码成功，
+// 请在手机上确认」等进度都是官方自己的。程序只在同一页面上等登录态出现（不导航），成功后
+// 在读取用的域名上复核一次，然后关窗落盘。用户手动关窗 = 取消。
+//
+// 1001：拿浏览器锁最多等 windowLockWait，拿不到就 finish 为 failed；窗口里出错（panic）也 finish，
+// 状态不会永远停在 waiting。5 分钟扫码时限从拿到锁之后才开始算。扫码成功 = 解除风控熔断；
+// 1008（审查）：一打开就是登录态（没扫码）只解登录类熔断，验证码 / 安全跳转类保留。
+func (s *AppServer) loginWindowHandler(c *gin.Context) {
+	st := &s.xiaohongshuService.state
+	if code := st.busy(); code != "" {
+		respondError(c, http.StatusConflict, code, "已有登录或验证窗口在进行", nil)
+		return
+	}
+	timeout := 5 * time.Minute
+	parent, cancel := context.WithCancel(context.Background())
+	seq := s.xiaohongshuService.logins.start(cancel)
+	st.begin(seq, windowLockWait+timeout)
+	go func() {
+		defer cancel()
+		defer s.xiaohongshuService.logins.finish(seq)
+		result, user, errText := runLoginWindowFn(s, parent, seq, timeout)
+		if errText != "" {
+			logrus.Warnf("登录窗口 #%d: %s", seq, errText)
+		}
+		switch result {
+		case "success": // 真扫了码：已验证的登录，什么熔断都解
+			s.xiaohongshuService.clearRisk(fmt.Sprintf("登录窗口 #%d 登录成功", seq))
+		case loginAlready:
+			// 1008（审查）：一打开就是登录态、没扫码——只证明登录还在，只解掉登录类熔断（和扫码入口的捷径一致）。
+			// 验证码 / 安全跳转类保留：那类验证只在读收藏那一下出，/explore 页面干净不说明没事
+			s.xiaohongshuService.clearRiskIf(xiaohongshu.RiskNotLoggedIn, fmt.Sprintf("登录窗口 #%d：已是登录态", seq))
+		}
+		st.finish(seq, result, user, errText)
+		logrus.Infof("登录窗口 #%d 结束：%s", seq, result)
+	}()
+	respondSuccess(c, map[string]any{"opened": true, "timeout": timeout.String()}, "登录窗口已打开")
+}
+
+// runLoginWindowFn 测试里替换成桩（真窗口要人扫码）。
+var runLoginWindowFn = (*AppServer).runLoginWindow
+
+// loginAlready 登录窗口一打开就是登录态（没扫码）。对外（/login/session 的 state）照旧报 success。
+const loginAlready = "already_logged_in"
+
+func (s *AppServer) runLoginWindow(parent context.Context, seq uint64, timeout time.Duration) (result string, user *xiaohongshu.CurrentUser, errText string) {
+	result = "timeout"
+	defer func() {
+		if r := recover(); r != nil {
+			result, user, errText = "failed", nil, fmt.Sprintf("登录窗口出错：%v", r)
+		}
+	}()
+	b, err := openWindowBrowser()
+	if err != nil {
+		return "failed", nil, fmt.Sprintf("读取服务正忙（别的操作占着浏览器超过 %s），稍后再点登录", windowLockWait)
+	}
+	defer b.Close()
+	// 扫码时限从拿到锁这一刻起算：expires_at 同步改成真实的截止时间，调用方按它等（别按固定秒数）
+	s.xiaohongshuService.state.restartClock(seq, timeout)
+	ctx, cancelT := context.WithTimeout(parent, timeout)
+	defer cancelT()
+	page := b.NewPage()
+	host := xiaohongshu.LoginHost()
+	err = rod.Try(func() {
+		_ = page.Timeout(30 * time.Second).Navigate(host + "/explore")
+		login := xiaohongshu.NewLogin(page)
+		// 已经登录：直接结束（loginAlready：对外照旧是 success，但只解登录类熔断，见 loginWindowHandler）
+		if _, e := page.Timeout(8 * time.Second).Element(".login-container"); e != nil {
+			if ok, _ := login.CheckLoginStatus(ctx); ok {
+				result = loginAlready
+				user, _ = login.CurrentUser(ctx)
+				return
+			}
+			_ = rod.Try(func() {
+				page.Timeout(10*time.Second).MustElementR("button, div, span", `^\s*登录\s*$`).MustClick()
+			})
+		}
+		done := make(chan bool, 1)
+		go func() { done <- login.WaitForLogin(ctx) }()
+		for {
+			select {
+			case ok := <-done:
+				if !ok {
+					return
+				}
+				user, _ = login.CurrentUser(ctx)
+				// 会话落在哪个域名因号而异：逐个复核并记住（之后读取都用它）
+				if login.RememberSiteHost(ctx) == "" {
+					result, errText = "failed", "扫码成功但两个域名都没有确认到登录，请重试一次"
+					return
+				}
+				result = "success"
+				return
+			case <-time.After(2 * time.Second):
+				if _, e := page.Timeout(3 * time.Second).Eval(`() => 1`); e != nil {
+					result = "cancelled"
+					cancelT()
+					return
+				}
+			}
+		}
+	})
+	if err != nil && result == "timeout" && ctx.Err() == nil {
+		result, errText = "failed", err.Error()
+	}
+	b.Close() // 先落盘再报成功
+	return result, user, errText
+}
+
+// logoutHandler 清掉本地浏览器目录里的小红书登录（只动这个 profile，不影响手机 App 和别的浏览器）。
+func (s *AppServer) logoutHandler(c *gin.Context) {
+	b := newBrowser()
+	defer b.Close()
+	page := b.NewPage()
+	err := rod.Try(func() {
+		res, err := proto.StorageGetCookies{}.Call(page.Browser())
+		if err != nil {
+			panic(err)
+		}
+		for _, ck := range res.Cookies {
+			d := strings.ToLower(ck.Domain)
+			if strings.Contains(d, "xiaohongshu.com") || strings.Contains(d, "rednote.com") {
+				_ = proto.NetworkDeleteCookies{Name: ck.Name, Domain: ck.Domain, Path: ck.Path}.Call(page)
+			}
+		}
+	})
+	if err != nil {
+		respondError(c, http.StatusInternalServerError, "LOGOUT_FAILED", "退出登录失败", err.Error())
+		return
+	}
+	s.xiaohongshuService.state.observe(false)
+	s.xiaohongshuService.state.set(func(l *loginState) { l.user = nil; l.state = "idle" })
+	respondSuccess(c, map[string]any{"logged_out": true}, "已退出登录")
+}
