+// collectFixtureServer 假主页 + 假收藏接口：点「收藏」后页面去打收藏接口。
+//
+//	mode "slow"：接口 delay 后才回（限流时就这样），回来后页签才切到收藏；
+//	mode "refused"：接口立刻回 461 / code 300011，页签不动。
+func collectFixtureServer(t *testing.T, mode string, delay time.Duration) (*httptest.Server, *atomic.Int32) {
+	t.Helper()
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == collectAPIPath {
+			calls.Add(1)
+			w.Header().Set("Content-Type", "application/json")
+			if mode == "refused" {
+				w.WriteHeader(461)
+				fmt.Fprint(w, `{"code":300011,"success":false,"msg":"当前账号存在异常"}`)
+				return
+			}
+			time.Sleep(delay)
+			fmt.Fprint(w, `{"code":0,"success":true,"data":{"has_more":true,"notes":[{"note_id":"n1"}]}}`)
+			return
+		}
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		fmt.Fprintf(w, `<!doctype html><html><head><meta charset=utf-8></head><body>%s
+<script>
+window.__INITIAL_STATE__ = {user: {activeTab: {value: {index: 0, query: "note"}}, notes: {value: [[{id: "own"}], []]}}};
+window.__clicks = [];
+document.addEventListener("click", e => {
+  window.__clicks.push({trusted: e.isTrusted, text: (e.target.innerText || "").trim(), cls: String(e.target.className || "")});
+}, true);
+document.getElementById("fav-tab").addEventListener("click", () => {
+  fetch("%s?num=30&cursor=").then(r => r.json()).then(j => {
+    if (j.success) window.__INITIAL_STATE__.user.activeTab.value = {index: 1, query: "fav"};
+  });
+});
+</script></body></html>`, profileTabs, collectAPIPath)
+	}))
+	t.Cleanup(srv.Close)
+	require.True(t, strings.HasPrefix(srv.URL, "http://127.0.0.1:"))
+	return srv, &calls
+}
+
+// TestLocalBrowserSelectTabLateActivationNoSecondClick 审查：限流时收藏接口慢，第 1 次点击在歇着的时候才迟到生效——
+// 点第 2 次之前先只读看一眼 activeTab，已经是收藏就不再点（再点一次已激活的页签会再打一次收藏接口）。
+func TestLocalBrowserSelectTabLateActivationNoSecondClick(t *testing.T) {
+	t.Setenv("LINK_BRAIN_EVIDENCE_DIR", t.TempDir())
+	srv, calls := collectFixtureServer(t, "slow", 8*time.Second)
+	oldPause := FavTabRetryPause
+	FavTabRetryPause = func() time.Duration { return 6 * time.Second }
+	t.Cleanup(func() { FavTabRetryPause = oldPause })
+	page := localPage(t)
+	page.Timeout(20 * time.Second).MustNavigate(srv.URL + "/p/slow").MustWaitLoad()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	u := NewUserProfileAction(page)
+	require.NoError(t, u.selectTab(ctx, nil, TabFavorites))
+	cl := clicksOn(t, page)
+	require.Len(t, cl, 1, "迟到生效：只有第 1 次点击")
+	assert.True(t, cl[0].Trusted)
+	assert.Equal(t, int32(1), calls.Load(), "收藏接口只被请求 1 次")
+	assert.NotEmpty(t, u.Evidence, "第 1 轮没生效那一刻照样落了证据")
+}
+
+// TestLocalBrowserSelectTabRefusedNoSecondClick 审查：第 1 次点击换来的收藏接口回包已经是拒绝（461 / 300011）——
+// 不再点第 2 次，返回 ErrTabStuck（服务层报 TRANSIENT、不写熔断）。
+func TestLocalBrowserSelectTabRefusedNoSecondClick(t *testing.T) {
+	t.Setenv("LINK_BRAIN_EVIDENCE_DIR", t.TempDir())
+	srv, calls := collectFixtureServer(t, "refused", 0)
