+func TestVerifyWindowDecision(t *testing.T) {
+	captcha := &xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}
+	redirect := &xiaohongshu.RiskError{Code: xiaohongshu.RiskAccount, Detail: "x"}
+	clean := verifyReading{ok: true, loggedIn: true}
+	stillCaptcha := verifyReading{ok: true, risk: captcha, loggedIn: true}
+	stillRedirect := verifyReading{ok: true, risk: redirect}
+	guest := verifyReading{ok: true}
+	unread := verifyReading{ok: false}
+
+	cases := []struct {
+		name     string
+		hold     string
+		alive    []bool
+		readings []verifyReading
+		wantHeld bool
+		result   string
+	}{
+		{"关窗时验证码还在", xiaohongshu.RiskCaptcha, []bool{true, true}, []verifyReading{clean, stillCaptcha}, true, verifyStillRisk},
+		{"一打开就关（一次都没读到）", xiaohongshu.RiskCaptcha, nil, nil, true, verifyNotRead},
+		{"验证过了再关：出现过 → 消失", xiaohongshu.RiskCaptcha, []bool{true, true}, []verifyReading{stillCaptcha, clean}, false, verifyCleared},
+		{"出现过、最后一次没读到不作数，按上一次有效读数", xiaohongshu.RiskCaptcha, []bool{true, true, true},
+			[]verifyReading{stillCaptcha, clean, unread}, false, verifyCleared},
+		// 1008 B3：10-08 04:02 那种——窗口里一次验证都没出现，关窗不再自动解除
+		{"窗口里从头到尾干净：不自动解除", xiaohongshu.RiskCaptcha, []bool{true, true, true}, []verifyReading{clean, clean, clean}, true, verifyNoCaptcha},
+		{"干净、最后一次没读到：仍不解除", xiaohongshu.RiskCaptcha, []bool{true, true}, []verifyReading{clean, unread}, true, verifyNoCaptcha},
+		{"掉登录的熔断：开关验证窗口但没登录", xiaohongshu.RiskNotLoggedIn, []bool{true}, []verifyReading{guest}, true, verifyNotLoggedIn},
+		{"掉登录的熔断：看到已登录且干净 → 解除", xiaohongshu.RiskNotLoggedIn, []bool{true}, []verifyReading{clean}, false, verifyCleared},
+		{"安全跳转的熔断：页面干净但不是登录用户", xiaohongshu.RiskAccount, []bool{true, true}, []verifyReading{stillRedirect, guest}, true, verifyNotLoggedIn},
+		{"安全跳转的熔断：跳过 → 已登录且干净", xiaohongshu.RiskAccount, []bool{true, true}, []verifyReading{stillRedirect, clean}, false, verifyCleared},
+		{"安全跳转的熔断：从没跳过：不自动解除", xiaohongshu.RiskAccount, []bool{true}, []verifyReading{clean}, true, verifyNoCaptcha},
+		// 审查：验证码类也要看到已登录——被踢到登录页、回到首页是游客、关窗，不算验证过了
+		{"验证码的熔断：出现过 → 消失，但最后是游客", xiaohongshu.RiskCaptcha, []bool{true, true}, []verifyReading{stillCaptcha, guest}, true, verifyNotLoggedIn},
+		{"验证码的熔断：被跳去登录页 → 回来是游客", xiaohongshu.RiskCaptcha, []bool{true, true}, []verifyReading{stillRedirect, guest}, true, verifyNotLoggedIn},
+		// 审查：一闪而过的滑块——那次登录态没读到（ok=false），风控照样算「出现过」
+		{"验证码的熔断：滑块那次登录态没读到，照样算出现过", xiaohongshu.RiskCaptcha, []bool{true, true},
+			[]verifyReading{{riskRead: true, risk: captcha}, clean}, false, verifyCleared},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
