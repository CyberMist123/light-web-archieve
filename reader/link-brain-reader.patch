+// ---- 验证窗口：只按关窗前最后一次有效读数解熔断（审查 should-fix）；1008 B3：验证码类要窗口里出现过风控 ----
+
+func verifyRun(alive []bool, readings []verifyReading) (verifyReading, bool, bool) {
+	i, j := 0, 0
+	return watchVerifyWindow(time.Now().Add(time.Minute), time.Millisecond,
+		func() bool {
+			if i >= len(alive) {
+				return false
+			}
+			i++
+			return alive[i-1]
+		},
+		func() verifyReading {
+			if j >= len(readings) {
+				return verifyReading{}
+			}
+			j++
+			return readings[j-1]
+		})
+}
