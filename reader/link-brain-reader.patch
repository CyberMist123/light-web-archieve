@@ -0,0 +1,982 @@
+package xiaohongshu
+
+// 评论楼层加载（1004d）：一次请求、一个预算里「滚评论区加载楼层 + 把楼层上限内每楼的回复展开到底」。
+//
+// 旧加载器（1004 之前）的三个毛病，导致前 10 楼的「展开 N 条回复」没点开：
+//   - 一级评论数 ≥ 上限（默认 10，首屏就有 10 楼）立即返回：第 0 轮只跑了两遍「点按钮」，每遍最多 3–5 个；
+//   - 每遍按页面上 .show-more 的出现顺序点、不认楼，点完不等回复加载出来、也不回头核对，多页回复要连点的楼只点了一次；
+//   - 「展开 N 条回复」的 N 超过 MaxRepliesThreshold（Python 传 100）的楼直接跳过。
+//
+// 新做法：按楼来。每轮读一次页面状态（__INITIAL_STATE__ 里每楼的 subCommentCount / subComments / subCommentHasMore，
+// 加 DOM 里这楼的「展开」按钮），在上限内挑一个楼点它的按钮 → 等回复数变化 → 再读；上限内的楼都处理完才往下滚。
+//
+// 第二版（10-04 19:54 真号试跑：每点一次多 5 条，10 楼全以 click_failed 收场）：
+//   - 根因：按钮元素是从 page.Timeout(2s) 查出来的，句柄带着那个 2 秒超时；点之前还有一段拟人停顿，
+//     停顿 + 滚动一超过 2 秒，点击就因 context deadline 失败。楼越大 DOM 越慢，越往后能点中的越少。
+//     现在找到后把元素重新绑到加载的 ctx，并且每次点都按 comment_id 重新查按钮。
+//   - 点之前把按钮滚到评论滚动容器的中间；拟人点击限时 8 秒，失败退回 DOM click（同 selectTab）。
+//   - 点不动 / 点了不涨：按 2s / 5s / 10s 退避再点这楼（期间先去点别的楼），退避用完还不行才放弃这楼。
+//   - 连续多楼都失败 = 疑似限频：歇 20–40 秒再继续；连着歇两次都没好转判停 throttled。
+//   - 公平分配：按「已加载回复数 / RoundStep」分档，先给每楼都展开到 30 条，再轮到 60 条……；可设每楼回复上限。
+//   - 每次失败记诊断（点击报错、按钮文本 / 位置 / 是否在视口 / 被谁遮挡 / disabled / loading、DOM 与状态里的回复数、
+//     离上次成功多久），写日志并放进 replies_partial[].detail。
+//
+// r03：
+//   - 误判缺口：没有按钮、状态 subCommentHasMore 陈旧为 true，但已加载 ≥ 显示数 → 这楼算展开到底；
+//     缺口为 0 的楼不进 replies_partial。
+//   - 续读 expand_floors：只展开指定 comment_id 的楼，一级评论滚到这些楼都出来（或到底 / 预算尽）；
+//     partial / replies_partial / replies_missing / floors_expanded 只按这些楼算，找不到的进 floors_not_found。
+//
+// 判停核心 loadFloors 是纯逻辑（读数 / 点击 / 诊断 / 滚动 / 风控全部注入），单测用桩驱动；真实页面接线在 floorOpsFor。
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"math/rand"
+	"strings"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/sirupsen/logrus"
+	"github.com/xpzouying/xiaohongshu-mcp/humanize"
+)
+
+// 判停原因（响应 comment_load.stop_reason，日志同样写这几个词）。
+const (
+	CommentStopFloorLimit  = "floor_limit"  // 楼层上限内的楼都读到了（expand_floors：要的楼都找到了），回复都处理完
+	CommentStopEnd         = "end"          // 评论区到底（总楼数不到上限），回复都处理完
+	CommentStopNoComments  = "no_comments"  // 没有评论
+	CommentStopStuck       = "stuck"        // 页面说还有楼，但换了几种滚法都滚不出来：partial
+	CommentStopBudget      = "budget"       // 预算用完：partial
+	CommentStopCancelled   = "cancelled"    // 请求被取消 / 超时：partial
+	CommentStopProbeFailed = "probe_failed" // 连续读不出页面状态：partial
+	CommentStopThrottled   = "throttled"    // 连续多楼点不动，歇过两次仍不行（疑似限频）：partial
+	CommentStopRisk        = "risk"         // 撞风控：立即停（整篇按风控失败）
+)
+
+// 某楼回复没展开完的原因（comment_load.replies_partial[].reason）。
+const (
+	ReplyGapCap           = "cap"            // 点到每楼点击上限还有
+	ReplyGapReplyCap      = "reply_cap"      // 到了调用方给的每楼回复上限（不算 partial）
+	ReplyGapNoGrowth      = "no_growth"      // 点了回复数不涨，退避重试用完
+	ReplyGapNoButton      = "no_button"      // 页面说还有回复，但楼里找不到「展开」按钮
+	ReplyGapClickFailed   = "click_failed"   // 按钮在，但点不动，退避重试用完
+	ReplyGapNotReached    = "not_reached"    // 预算 / 风控 / 取消 / 限频停下时这楼还没展开完
+	ReplyGapNotExpanded   = "not_expanded"   // 调用方没要求展开回复（click_more_replies=false；expand_floors 外的楼不列出）
+	ReplyGapCountMismatch = "count_mismatch" // 按钮没了、页面也不说还有，但条数比楼上显示的少（多半是删除 / 折叠的回复）
+)
+
+// ReplyGap 楼层上限内某一楼的回复没拿全。
+type ReplyGap struct {
+	Floor     int    `json:"floor"` // 第几楼，从 1 起
+	CommentID string `json:"comment_id"`
+	Shown     int    `json:"shown"`   // 楼上显示的回复数（subCommentCount）；读不到为 -1
+	Loaded    int    `json:"loaded"`  // 实际加载到的回复数
+	Missing   int    `json:"missing"` // max(shown − loaded, 0)
+	HasMore   bool   `json:"has_more"`
+	Clicks    int    `json:"clicks"`
+	Reason    string `json:"reason"`
+	Detail    string `json:"detail"` // 最后一次失败的诊断（点击报错 / 按钮状态 / 条数），没有为空
+}
+
+// CommentLoadResult 一次评论加载的结论（响应 data.comment_load）。
+type CommentLoadResult struct {
+	FloorLimit     int        `json:"floor_limit"`                // 楼层上限（请求参数 limit，默认 10）
+	ReplyCap       int        `json:"replies_per_floor_cap"`      // 每楼回复上限（0 = 不限）
+	FloorsLoaded   int        `json:"floors_loaded"`              // 页面里已加载的一级评论（楼）数，可能超过上限（站点一页给 10 楼）
+	FloorsExpanded int        `json:"floors_expanded"`            // 从第 1 楼起连续「回复已展开到底」的楼数（≤ 上限）；expand_floors 时 = 要的楼里展开到底的楼数
+	TotalShown     *int       `json:"comments_total_shown"`       // 页面显示的总评论数（含楼中楼）；读不到为 null
+	HasMore        *bool      `json:"comments_has_more"`          // 页面状态里一级评论还有没有更多；读不到为 null
+	RepliesPartial []ReplyGap `json:"replies_partial"`            // 上限内（expand_floors 时：要的楼里）回复没拿全的楼；空数组 = 全齐
+	RepliesMissing int        `json:"replies_missing"`            // 上面各楼 missing 之和
+	Partial        bool       `json:"partial"`                    // 楼没读到上限 / 有楼没展开完（count_mismatch、reply_cap 不算）
+	FloorsNotFound []string   `json:"floors_not_found,omitempty"` // expand_floors 里页面上没找到的 comment_id（只在传了 expand_floors 且有没找到的时出现）
+	Reason         string     `json:"stop_reason"`
+	Clicks         int        `json:"clicks"`          // 点下去的次数（含没涨的）
+	ClickFails     int        `json:"click_fails"`     // 点不动的次数
+	DOMClicks      int        `json:"dom_clicks"`      // 拟人点击失败、退回 DOM click 的次数
+	ThrottlePauses int        `json:"throttle_pauses"` // 疑似限频歇了几次
+	Scrolls        int        `json:"scrolls"`
+	Seconds        float64    `json:"seconds"`
+	BudgetSeconds  float64    `json:"budget_seconds"`
+}
+
+// floorInfo 一楼的读数。HasMore 1/0/-1 = 还有 / 没有 / 读不到；Shown -1 = 读不到。
+type floorInfo struct {
+	Index   int
+	ID      string
+	Shown   int
+	Loaded  int
+	HasMore int
+	Button  bool   // 楼里有可见的「展开 … 回复」按钮
+	BtnText string // 按钮文本（点完文本变了也算有反应）
+}
+
+// floorSnapshot 一次页面读数。OK=false 表示这次没读出来。Floors 只含上限内的楼。
+type floorSnapshot struct {
+	OK         bool
+	Floors     []floorInfo
+	Loaded     int  // 已加载楼数
+	Total      int  // 页面显示的总评论数，-1 = 读不到
+	HasMore    int  // 一级评论还有没有更多：1/0/-1
+	End        bool // 评论区底部「THE END」出现
+	NoComments bool
+}
+
+// clickResult 点一次的结果。DOM=true 表示拟人点击失败、退回了 DOM click；Detail 是失败诊断。
+type clickResult struct {
+	OK     bool
+	DOM    bool
+	Detail string
+}
+
+type floorLoadCfg struct {
+	FloorLimit        int
+	Expand            bool
+	ExpandFloors      []string // 非空 = 只展开这些 comment_id 的楼，滚到它们都出来为止（续读）
+	Budget            time.Duration
+	ReplyCap          int             // 每楼回复上限，0 = 不限
+	RoundStep         int             // 公平分档：每档每楼多展开这么多条；≤0 = 按楼序一楼点完再下一楼
+	MaxClicksPerFloor int             // 每楼最多点几次（安全阀）
+	Backoff           []time.Duration // 这楼连续失败第 n 次后，再点它之前等 Backoff[n-1]；用完还失败就放弃这楼
+	NoButtonLimit     int             // 页面说还有回复、却连续几次找不到按钮就放弃
+	GrowWait          time.Duration   // 点完最多等多久看回复数 / 按钮文本变化
+	Poll              time.Duration   // 等变化 / 读数失败时的轮询间隔
+	ThrottleStreak    int             // 自上次成功以来累计这么多次失败、且涉及 ≥2 楼 = 疑似限频
+	ThrottlePause     func() time.Duration
+	MaxThrottlePauses int             // 连着歇这么多次都没好转（期间没有一次成功）就判停 throttled
+	ScrollSettle      []time.Duration // 每级滚法「楼数不涨多久」算没招；级数 = len
+	ProbeFailLimit    int             // 连续读不出页面状态几次就停
+	RiskEvery         int             // 滚动时每隔几轮查一次风控（点击前另外必查）
+	Tick              func(i int) time.Duration
+}
+
+type floorOps struct {
+	probe    func() floorSnapshot
+	expand   func(f floorInfo) clickResult // 点这楼的「展开」按钮
+	diagnose func(f floorInfo) string      // 点了没反应时读一次按钮 / 楼的状态（可为 nil）
+	scroll   func(level int)               // 往下滚加载更多楼，level 越高滚得越狠
+	risk     func() *RiskError
+}
+
+const (
+	// maxReplyClicksPerFloor 每楼最多点 300 次（真号一次约给 5 条，约 1500 条）：只是防死循环的安全阀，平时由预算收口。
+	maxReplyClicksPerFloor = 300
+	// defaultRoundStep 公平分档：先让每楼都到 30 条，再 60、90……
+	defaultRoundStep = 30
+	commentRiskEvery = 3
+)
+
+// commentFloorSettle 滚楼层的三级：普通滚 15s 不涨 → 大幅滚 20s → 连推冲刺 25s，仍不涨就判 stuck。
+var commentFloorSettle = []time.Duration{15 * time.Second, 20 * time.Second, 25 * time.Second}
+
+// clickBackoff 一楼连续失败后的退避。
+var clickBackoff = []time.Duration{2 * time.Second, 5 * time.Second, 10 * time.Second}
+
+// commentTick 滚动之间的停顿：0.8–2.0 秒抖动，偶尔多停 2–4 秒（像人在看）。
+func commentTick(int) time.Duration {
+	d := 800*time.Millisecond + time.Duration(rand.Int63n(int64(1200*time.Millisecond)))
+	if rand.Intn(8) == 0 {
+		d += 2*time.Second + time.Duration(rand.Int63n(int64(2*time.Second)))
+	}
+	return d
+}
+
+// throttlePause 疑似限频时歇 20–40 秒（均匀抖动）。
+func throttlePause() time.Duration {
+	return 20*time.Second + time.Duration(rand.Int63n(int64(20*time.Second)))
+}
+
+func defaultFloorLoadCfg(limit int, expand bool, budget time.Duration, replyCap int) floorLoadCfg {
+	return floorLoadCfg{
+		FloorLimit: limit, Expand: expand, Budget: budget, ReplyCap: replyCap, RoundStep: defaultRoundStep,
+		MaxClicksPerFloor: maxReplyClicksPerFloor, Backoff: clickBackoff, NoButtonLimit: 3,
+		GrowWait: 6 * time.Second, Poll: 500 * time.Millisecond,
+		ThrottleStreak: 4, ThrottlePause: throttlePause, MaxThrottlePauses: 2,
+		ScrollSettle: commentFloorSettle, ProbeFailLimit: 10, RiskEvery: commentRiskEvery, Tick: commentTick,
+	}
+}
+
+func floorKey(f floorInfo) string {
+	if f.ID != "" {
+		return f.ID
+	}
+	return fmt.Sprintf("#%d", f.Index)
+}
+
+// floorDone 这楼不用再点：没有按钮，且页面没说还有、或已加载 ≥ 显示数（状态里的 hasMore 会陈旧地停在 true）。
+func floorDone(f floorInfo) bool {
+	return !f.Button && (f.HasMore != 1 || (f.Shown > 0 && f.Loaded >= f.Shown))
+}
+
+// floorComplete 收尾判这楼是否展开到底：floorDone，或显示数已知且已加载 ≥ 显示数（缺口为 0 的楼不算缺口）。
+func floorComplete(f floorInfo) bool { return floorDone(f) || (f.Shown >= 0 && f.Loaded >= f.Shown) }
+
+// wantFloor 这楼在不在要展开的范围：没给 ExpandFloors 时都在（楼层上限由读数控制）。
+func wantFloor(cfg floorLoadCfg, f floorInfo) bool {
+	if len(cfg.ExpandFloors) == 0 {
+		return true
+	}
+	for _, id := range cfg.ExpandFloors {
+		if id == f.ID {
+			return true
+		}
+	}
+	return false
+}
+
+// floorsNotFound ExpandFloors 里这次读数没出现的 id（保持请求里的顺序）。
+func floorsNotFound(cfg floorLoadCfg, s floorSnapshot) []string {
+	seen := map[string]bool{}
+	for _, f := range s.Floors {
+		seen[f.ID] = true
+	}
+	var out []string
+	for _, id := range cfg.ExpandFloors {
+		if !seen[id] {
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+// floorCapped 到了每楼回复上限。
+func floorCapped(f floorInfo, replyCap int) bool { return replyCap > 0 && f.Loaded >= replyCap }
+
+// floorState 判停核心里每楼的计数。
+type floorState struct {
+	clicks    int
+	fails     int // 连续失败（点不动 / 点了不涨）
+	noBtn     int
+	notBefore time.Time
+	gaveUp    string
+	detail    string
+}
+
+// loadFloors 判停核心（纯逻辑）。每轮：读数 → 查预算 → 上限内挑一楼点（分档最低、楼序最前、不在退避中）并等变化 →
+// 都展开完了：楼数够上限 / 到底就收工，否则查风控（每 RiskEvery 轮）、滚一下、歇 Tick。
+// 楼数在当前级的 ScrollSettle 内没涨就升一级滚法，最高级也没招 → stuck。每次点击前必查风控。
+func loadFloors(ctx context.Context, cfg floorLoadCfg, ops floorOps) (CommentLoadResult, *RiskError) {
+	start := time.Now()
+	deadline := start.Add(cfg.Budget)
+	if len(cfg.ScrollSettle) == 0 {
+		cfg.ScrollSettle = []time.Duration{15 * time.Second}
+	}
+	if cfg.Tick == nil {
+		cfg.Tick = commentTick
+	}
+	if cfg.Poll <= 0 {
+		cfg.Poll = 500 * time.Millisecond
+	}
+	if cfg.ThrottlePause == nil {
+		cfg.ThrottlePause = throttlePause
+	}
+	res := CommentLoadResult{FloorLimit: cfg.FloorLimit, ReplyCap: cfg.ReplyCap, BudgetSeconds: cfg.Budget.Round(time.Second).Seconds()}
+	var last floorSnapshot
+	st := map[string]*floorState{}
+	get := func(k string) *floorState {
+		if st[k] == nil {
+			st[k] = &floorState{}
+		}
+		return st[k]
+	}
+	level, best, probeFails := 0, -1, 0
+	lastGrow := time.Now()
+	lastSuccess := start
+	var streak []string // 自上次成功以来的失败楼（可重复）
+	pausesNoGain := 0
+
+	sleep := func(d time.Duration) bool {
+		if left := time.Until(deadline); d > left {
+			d = left
+		}
+		if d <= 0 {
+			return ctx.Err() == nil
+		}
+		select {
+		case <-ctx.Done():
+			return false
+		case <-time.After(d):
+			return true
+		}
+	}
+	finish := func(reason string) (CommentLoadResult, *RiskError) {
+		res.Reason = reason
+		res.Seconds = time.Since(start).Round(100 * time.Millisecond).Seconds()
+		summarizeFloors(&res, last, cfg, st)
+		logFloorResult(res)
+		return res, nil
+	}
+	// waitChange 点完之后等这楼的回复数涨、按钮文本变、或者按钮消失且页面不再说还有。
+	waitChange := func(before floorInfo) bool {
+		until := time.Now().Add(cfg.GrowWait)
+		for time.Now().Before(until) && time.Now().Before(deadline) {
+			if !sleep(cfg.Poll) {
+				return false
+			}
+			s := ops.probe()
+			if !s.OK {
+				continue
+			}
+			last = s
+			for _, f := range s.Floors {
+				if floorKey(f) != floorKey(before) {
+					continue
+				}
+				if f.Loaded > before.Loaded || floorDone(f) || (f.Button && f.BtnText != before.BtnText) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	// onFail 记一次失败：退避或放弃这楼；跨楼连续失败够多就按疑似限频歇一下。返回 true = 该判停 throttled。
+	onFail := func(f floorInfo, reason, detail string) bool {
+		k := floorKey(f)
+		fs := get(k)
+		fs.fails++
+		if reason == ReplyGapClickFailed {
+			res.ClickFails++
+		}
+		since := time.Since(lastSuccess).Round(100 * time.Millisecond)
+		fs.detail = truncRunes(fmt.Sprintf("%s；距上次成功 %s", detail, since), 300)
+		if fs.fails > len(cfg.Backoff) {
+			fs.gaveUp = reason
+			logrus.Warnf("评论第 %d 楼：连续 %d 次失败（%s），放弃这楼（%d/%d）：%s", f.Index+1, fs.fails, reason, f.Loaded, f.Shown, fs.detail)
+		} else {
+			wait := cfg.Backoff[fs.fails-1]
+			fs.notBefore = time.Now().Add(wait)
+			logrus.Warnf("评论第 %d 楼：第 %d 次失败（%s），%s 后再点（%d/%d）：%s", f.Index+1, fs.fails, reason, wait, f.Loaded, f.Shown, fs.detail)
+		}
+		streak = append(streak, k)
+		if cfg.ThrottleStreak <= 0 || len(streak) < cfg.ThrottleStreak || distinct(streak) < 2 {
+			return false
+		}
+		if pausesNoGain >= cfg.MaxThrottlePauses {
+			logrus.Warnf("评论：连续 %d 次失败涉及 %d 楼，已歇 %d 次仍不行，按疑似限频停下", len(streak), distinct(streak), pausesNoGain)
+			return true
+		}
+		d := cfg.ThrottlePause()
+		pausesNoGain++
+		res.ThrottlePauses++
+		logrus.Warnf("评论：自上次成功（%s 前）连续 %d 次失败、涉及 %d 楼，疑似限频，歇 %s 再试", since, len(streak), distinct(streak), d.Round(time.Second))
+		streak = nil
+		sleep(d)
+		for _, s := range st { // 歇完给放弃的楼一次重来的机会
+			if s.gaveUp == ReplyGapClickFailed || s.gaveUp == ReplyGapNoGrowth {
+				s.gaveUp, s.fails = "", 0
+			}
+			s.notBefore = time.Time{}
+		}
+		return false
+	}
+
+	for i := 0; ; i++ {
+		if ctx.Err() != nil {
+			return finish(CommentStopCancelled)
+		}
+		s := ops.probe()
+		if !s.OK {
+			probeFails++
+			if probeFails >= max(1, cfg.ProbeFailLimit) {
+				return finish(CommentStopProbeFailed)
+			}
+			if !time.Now().Before(deadline) {
+				return finish(CommentStopBudget)
+			}
+			sleep(cfg.Poll)
+			continue
+		}
+		probeFails = 0
+		last = s
+		if s.NoComments || (s.Loaded == 0 && s.Total == 0) {
+			return finish(CommentStopNoComments)
+		}
+		if s.Loaded > best {
+			best, lastGrow = s.Loaded, time.Now()
+		}
+		if !time.Now().Before(deadline) {
+			return finish(CommentStopBudget)
+		}
+
+		// 1. 上限内挑一楼展开
+		if cfg.Expand {
+			f, ok, wait := pickFloor(s, cfg, st, time.Now())
+			if ok {
+				fs := get(floorKey(f))
+				switch {
+				case !f.Button:
+					// 页面说还有回复，却找不到按钮：可能还在渲染，等一下再看；几次都没有就放弃这楼
+					fs.noBtn++
+					if fs.noBtn >= max(1, cfg.NoButtonLimit) {
+						fs.gaveUp = ReplyGapNoButton
+						if ops.diagnose != nil {
+							fs.detail = truncRunes(ops.diagnose(f), 300)
+						}
+						logrus.Warnf("评论第 %d 楼：页面说还有回复（%d/%d），但找不到「展开」按钮，放弃这楼：%s", f.Index+1, f.Loaded, f.Shown, fs.detail)
+					} else {
+						sleep(cfg.Poll)
+					}
+				case fs.clicks >= cfg.MaxClicksPerFloor:
+					fs.gaveUp = ReplyGapCap
+					logrus.Warnf("评论第 %d 楼：点了 %d 次（上限）还没展开完（%d/%d），先放下", f.Index+1, fs.clicks, f.Loaded, f.Shown)
+				default:
+					if r := ops.risk(); r != nil { // 点「展开回复」之前必查
+						return riskStop(&res, start, last, cfg, st, r)
+					}
+					out := ops.expand(f)
+					if out.DOM {
+						res.DOMClicks++
+					}
+					if !out.OK {
+						if onFail(f, ReplyGapClickFailed, "点不动："+out.Detail) {
+							return finish(CommentStopThrottled)
+						}
+						continue
+					}
+					fs.clicks++
+					res.Clicks++
+					if waitChange(f) {
+						fs.fails, fs.notBefore, fs.detail = 0, time.Time{}, ""
+						lastSuccess, streak, pausesNoGain = time.Now(), nil, 0
+					} else if ctx.Err() == nil && time.Now().Before(deadline) {
+						d := fmt.Sprintf("点了（%s）%s 内回复数没变", map[bool]string{true: "DOM click", false: "拟人点击"}[out.DOM], cfg.GrowWait)
+						if ops.diagnose != nil {
+							d += "；" + ops.diagnose(f)
+						}
+						if onFail(f, ReplyGapNoGrowth, d) {
+							return finish(CommentStopThrottled)
+						}
+					}
+				}
+				continue
+			}
+			if !wait.IsZero() {
+				// 还有楼没展开完，但都在退避中：等到最早那个
+				sleep(min(time.Until(wait), 2*time.Second))
+				continue
+			}
+		}
+
+		// 2. 上限内的楼都处理完了：够上限 / 到底就收工（expand_floors：要的楼都找到了就收工，不看楼层上限）
+		if len(cfg.ExpandFloors) > 0 {
+			if len(floorsNotFound(cfg, s)) == 0 {
+				return finish(CommentStopFloorLimit)
+			}
+		} else if s.Loaded >= cfg.FloorLimit {
+			return finish(CommentStopFloorLimit)
+		}
+		if s.End || s.HasMore == 0 {
+			return finish(CommentStopEnd)
+		}
+
+		// 3. 往下滚加载更多楼
+		if still := time.Since(lastGrow); still >= cfg.ScrollSettle[level] {
+			if level+1 >= len(cfg.ScrollSettle) {
+				return finish(CommentStopStuck)
+			}
+			level++
+			lastGrow = time.Now()
+			logrus.Infof("评论楼数停在 %d 楼 %s 没涨（页面 hasMore=%d）：换第 %d 级滚法", s.Loaded, still.Round(time.Second), s.HasMore, level)
+		}
+		if cfg.RiskEvery > 0 && i%cfg.RiskEvery == 0 {
+			if r := ops.risk(); r != nil {
+				return riskStop(&res, start, last, cfg, st, r)
+			}
+		}
+		ops.scroll(level)
+		res.Scrolls++
+		if !sleep(cfg.Tick(i)) {
+			return finish(CommentStopCancelled)
+		}
+	}
+}
+
+// pickFloor 上限内挑下一楼：没展开完、没放弃、没到回复上限的楼里，分档（已加载 / RoundStep）最低、楼序最前、且不在退避中的那个。
+// 有候选但都在退避中时 ok=false、wait=最早可点的时刻；没有候选时两者都为零值。
+func pickFloor(s floorSnapshot, cfg floorLoadCfg, st map[string]*floorState, now time.Time) (floorInfo, bool, time.Time) {
+	var pick floorInfo
+	found := false
+	bestTier := 0
+	var wait time.Time
+	for _, f := range s.Floors {
+		fs := st[floorKey(f)]
+		if !wantFloor(cfg, f) || floorDone(f) || floorCapped(f, cfg.ReplyCap) || (fs != nil && fs.gaveUp != "") {
+			continue
+		}
+		if fs != nil && now.Before(fs.notBefore) {
+			if wait.IsZero() || fs.notBefore.Before(wait) {
+				wait = fs.notBefore
+			}
+			continue
+		}
+		tier := 0
+		if cfg.RoundStep > 0 {
+			tier = f.Loaded / cfg.RoundStep
+		}
+		if !found || tier < bestTier {
+			pick, bestTier, found = f, tier, true
+		}
+	}
+	if found {
+		return pick, true, time.Time{}
+	}
+	return floorInfo{}, false, wait
+}
+
+func distinct(keys []string) int {
+	m := map[string]bool{}
+	for _, k := range keys {
+		m[k] = true
+	}
+	return len(m)
+}
+
+func truncRunes(s string, n int) string {
+	r := []rune(s)
+	if len(r) <= n {
+		return s
+	}
+	return string(r[:n]) + "…"
+}
+
+// riskStop 撞风控：记下当时的读数后立即返回 RiskError。
+func riskStop(res *CommentLoadResult, start time.Time, last floorSnapshot, cfg floorLoadCfg,
+	st map[string]*floorState, r *RiskError) (CommentLoadResult, *RiskError) {
+	logrus.Warnf("加载评论途中撞到风控，停止: %s", r.Error())
+	res.Reason = CommentStopRisk
+	res.Seconds = time.Since(start).Round(100 * time.Millisecond).Seconds()
+	summarizeFloors(res, last, cfg, st)
+	res.Partial = true
+	return *res, r
+}
+
+// summarizeFloors 按最后一次读数填楼数、每楼缺口和 partial。
+func summarizeFloors(res *CommentLoadResult, last floorSnapshot, cfg floorLoadCfg, st map[string]*floorState) {
+	res.FloorsLoaded = last.Loaded
+	if last.Total >= 0 && last.OK {
+		v := last.Total
+		res.TotalShown = &v
+	}
+	if last.HasMore >= 0 {
+		v := last.HasMore == 1
+		res.HasMore = &v
+	}
+	res.RepliesPartial, res.RepliesMissing, res.FloorsExpanded = []ReplyGap{}, 0, 0
+	targeted := len(cfg.ExpandFloors) > 0
+	if targeted {
+		res.FloorsNotFound = floorsNotFound(cfg, last)
+	}
+	leading, incomplete := true, false
+	for _, f := range last.Floors {
+		if !wantFloor(cfg, f) { // expand_floors 外的楼：不点、不列、不计
+			continue
+		}
+		fs := st[floorKey(f)]
+		if fs == nil {
+			fs = &floorState{}
+		}
+		reason := fs.gaveUp
+		switch {
+		case floorComplete(f):
+			reason = ""
+			if f.Shown >= 0 && f.Loaded < f.Shown {
+				reason = ReplyGapCountMismatch
+			}
+		case reason != "":
+		case floorCapped(f, cfg.ReplyCap):
+			reason = ReplyGapReplyCap
+		case !cfg.Expand:
+			reason = ReplyGapNotExpanded
+		default:
+			reason = ReplyGapNotReached
+		}
+		switch {
+		case targeted && floorComplete(f):
+			res.FloorsExpanded++
+		case !targeted && leading && floorComplete(f):
+			res.FloorsExpanded++
+		default:
+			leading = false
+		}
+		if reason == "" {
+			continue
+		}
+		missing := 0
+		if f.Shown > f.Loaded {
+			missing = f.Shown - f.Loaded
+		}
+		detail := fs.detail
+		if reason == ReplyGapCountMismatch || reason == ReplyGapReplyCap {
+			detail = ""
+		}
+		res.RepliesPartial = append(res.RepliesPartial, ReplyGap{Floor: f.Index + 1, CommentID: f.ID, Shown: f.Shown,
+			Loaded: f.Loaded, Missing: missing, HasMore: f.HasMore == 1, Clicks: fs.clicks, Reason: reason, Detail: detail})
+		res.RepliesMissing += missing
+		if reason != ReplyGapCountMismatch && reason != ReplyGapReplyCap {
+			incomplete = true
+		}
+	}
+	switch res.Reason {
+	case CommentStopFloorLimit, CommentStopEnd, CommentStopNoComments:
+		res.Partial = incomplete
+	default:
+		res.Partial = true
+	}
+}
+
+func logFloorResult(res CommentLoadResult) {
+	total := "读不到"
+	if res.TotalShown != nil {
+		total = fmt.Sprint(*res.TotalShown)
+	}
+	msg := fmt.Sprintf("评论加载：读到 %d 楼（上限 %d，前 %d 楼回复已展开到底），页面显示共 %s 条评论；回复没拿全 %d 楼、缺 %d 条；判停 %s · 点展开 %d 次（点不动 %d、DOM click %d）· 疑似限频歇 %d 次 · 滚 %d 次 · %.0f/%.0f 秒",
+		res.FloorsLoaded, res.FloorLimit, res.FloorsExpanded, total, len(res.RepliesPartial), res.RepliesMissing,
+		res.Reason, res.Clicks, res.ClickFails, res.DOMClicks, res.ThrottlePauses, res.Scrolls, res.Seconds, res.BudgetSeconds)
+	if res.Partial {
+		logrus.Warn(msg + "（partial）")
+		for _, g := range res.RepliesPartial {
+			logrus.Warnf("  第 %d 楼回复 %d/%d，缺 %d（%s，点了 %d 次）%s", g.Floor, g.Loaded, g.Shown, g.Missing, g.Reason, g.Clicks, g.Detail)
+		}
+		return
+	}
+	logrus.Info(msg)
+}
+
+// ========== 真实页面接线 ==========
+
+// expandButtonSelector 楼里「展开回复」按钮的候选（多候选防改版；文案再用 isExpandRepliesButton 过滤）。
+const expandButtonSelector = `.show-more, [class*="show-more"], .reply-container [class*="more"]`
+
+// floorProbeJS 读楼层状态，全部防御式：读不到的项给「不知道」，不抛错。
+// 楼层数据优先取 __INITIAL_STATE__（抽取也读它）；状态里没有列表时退回 DOM 数楼（Shown 不知道）。
+// ids 非空（expand_floors）时只回这些 comment_id 的楼（不限楼序），否则回前 limit 楼；idx 是楼序（从 0 起）。
+const floorProbeJS = `(feedID, limit, pattern, sels, ids) => {
+  const w = x => x?.value ?? x?._value ?? x?._rawValue ?? x;
+  const out = {ok: false, floors: [], loaded: 0, total: -1, hasMore: -1, end: false, none: false};
+  try {
+    const re = new RegExp(pattern);
+    const want = Array.isArray(ids) && ids.length ? new Set(ids.map(String)) : null;
+    const btnIn = root => {
+      if (!root) return null;
+      return Array.from(root.querySelectorAll(sels)).find(b =>
+        re.test((b.innerText || b.textContent || "").trim()) && b.offsetParent !== null) || null;
+    };
+    const m = w(window.__INITIAL_STATE__?.note?.noteDetailMap) || {};
+    const d = w(m[feedID]) || w(Object.values(m)[0]) || {};
+    const cm = w(d.comments) || {};
+    const list = w(cm.list) || [];
+    if (typeof cm.hasMore === "boolean") out.hasMore = cm.hasMore ? 1 : 0;
+    const tc = parseInt(String(w(d.note)?.interactInfo?.commentCount ?? ""), 10);
+    if (!isNaN(tc)) out.total = tc;
+    if (out.total < 0) {
+      const t = document.querySelector(".comments-container .total, .comments-el .total");
+      const mm = t && (t.innerText || "").match(/(\d+)/);
+      if (mm) out.total = parseInt(mm[1], 10);
+    }
+    const parents = Array.from(document.querySelectorAll(".parent-comment"));
+    const rootOf = (id, i) => {
+      if (id) {
+        const el = document.getElementById("comment-" + id);
+        if (el) return el.closest(".parent-comment") || el.parentElement;
+      }
+      return parents[i] || null;
+    };
+    const push = (idx, id, shown, loaded, hasMore, root) => {
+      const b = btnIn(root);
+      out.floors.push({idx, id, shown, loaded, hasMore, button: !!b, btnText: b ? (b.innerText || "").trim().slice(0, 40) : ""});
+    };
+    if (list.length) {
+      out.loaded = list.length;
+      for (let i = 0; i < (want ? list.length : Math.min(list.length, limit)); i++) {
+        const c = w(list[i]) || {};
+        if (want && !want.has(String(c.id || ""))) continue;
+        const subs = w(c.subComments) || [];
+        const sc = parseInt(String(c.subCommentCount ?? ""), 10);
+        push(i, String(c.id || ""), isNaN(sc) ? -1 : sc, subs.length || 0,
+          typeof c.subCommentHasMore === "boolean" ? (c.subCommentHasMore ? 1 : 0) : -1, rootOf(String(c.id || ""), i));
+      }
+    } else {
+      out.loaded = parents.length;
+      for (let i = 0; i < (want ? parents.length : Math.min(parents.length, limit)); i++) {
+        const p = parents[i];
+        const item = p.querySelector(".comment-item");
+        const id = item && item.id && item.id.startsWith("comment-") ? item.id.slice(8) : "";
+        if (want && !want.has(id)) continue;
+        push(i, id, -1, p.querySelectorAll(".comment-item-sub, .reply-container .comment-item").length, -1, p);
+      }
+    }
+    const end = document.querySelector(".end-container");
+    out.end = !!end && /THE\s*END/i.test((end.innerText || "").replace(/\s+/g, " "));
+    const nc = document.querySelector(".no-comments-text");
+    out.none = !!nc && (nc.innerText || "").includes("这是一片荒地");
+    out.ok = true;
+  } catch (e) {}
+  return out;
+}`
+
+// floorDiagJS 点不动 / 点了没反应时读一次这楼的状态（只读）：按钮文本、位置、是否在视口、中心点被谁遮挡、
+// disabled / loading、DOM 里的回复条数、状态里的回复条数。
+const floorDiagJS = `(feedID, id, idx, pattern, sels) => {
+  const w = x => x?.value ?? x?._value ?? x?._rawValue ?? x;
+  const o = {};
+  try {
+    const re = new RegExp(pattern);
+    const parents = document.querySelectorAll(".parent-comment");
+    let root = null;
+    if (id) { const el = document.getElementById("comment-" + id); if (el) root = el.closest(".parent-comment") || el.parentElement; }
+    if (!root) root = parents[idx] || null;
+    o.root = !!root;
+    if (root) o.domSubs = root.querySelectorAll(".comment-item-sub, .reply-container .comment-item").length;
+    const m = w(window.__INITIAL_STATE__?.note?.noteDetailMap) || {};
+    const d = w(m[feedID]) || w(Object.values(m)[0]) || {};
+    const list = w(w(d.comments)?.list) || [];
+    const c = list.map(w).find(x => String(x?.id || "") === id) || w(list[idx]);
+    if (c) { o.stateSubs = (w(c.subComments) || []).length; o.hasMore = c.subCommentHasMore; o.shown = c.subCommentCount; }
+    const cands = root ? Array.from(root.querySelectorAll(sels)) : [];
+    o.cands = cands.length;
+    const b = cands.find(x => re.test((x.innerText || x.textContent || "").trim())) || null;
+    if (b) {
+      const r = b.getBoundingClientRect();
+      o.text = (b.innerText || b.textContent || "").trim().slice(0, 30);
+      o.rect = [Math.round(r.x), Math.round(r.y), Math.round(r.width), Math.round(r.height)];
+      o.vh = window.innerHeight;
+      o.inView = r.bottom > 0 && r.top < window.innerHeight && r.width > 0 && r.height > 0;
+      const t = o.inView ? document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2) : null;
+      o.covered = t && !b.contains(t) && !t.contains(b) ? ((t.className && String(t.className)) || t.tagName).slice(0, 40) : "";
+      o.disabled = !!(b.disabled || b.getAttribute("aria-disabled") === "true" || b.getAttribute("aria-busy") === "true");
+      o.loading = /loading|spin/i.test(String(b.className) + " " + (b.innerHTML || "").slice(0, 300));
+      o.visible = b.offsetParent !== null;
+    }
+  } catch (e) { o.err = String(e).slice(0, 80); }
+  return JSON.stringify(o);
+}`
+
+// formatFloorDiag 把 floorDiagJS 的结果压成一句中文（进日志和 replies_partial[].detail）。
+func formatFloorDiag(raw string) string {
+	var o struct {
+		Root      bool   `json:"root"`
+		DomSubs   *int   `json:"domSubs"`
+		StateSubs *int   `json:"stateSubs"`
+		HasMore   any    `json:"hasMore"`
+		Shown     any    `json:"shown"`
+		Cands     int    `json:"cands"`
+		Text      string `json:"text"`
+		Rect      []int  `json:"rect"`
+		VH        int    `json:"vh"`
+		InView    bool   `json:"inView"`
+		Covered   string `json:"covered"`
+		Disabled  bool   `json:"disabled"`
+		Loading   bool   `json:"loading"`
+		Visible   bool   `json:"visible"`
+		Err       string `json:"err"`
+	}
+	if err := json.Unmarshal([]byte(raw), &o); err != nil {
+		return "诊断读不出：" + truncRunes(raw, 80)
+	}
+	yn := func(b bool) string { return map[bool]string{true: "是", false: "否"}[b] }
+	num := func(p *int) string {
+		if p == nil {
+			return "?"
+		}
+		return fmt.Sprint(*p)
+	}
+	parts := []string{}
+	if !o.Root {
+		parts = append(parts, "找不到这楼的 DOM")
+	} else if o.Text == "" {
+		parts = append(parts, fmt.Sprintf("楼里没有展开按钮（候选 %d 个）", o.Cands))
+	} else {
+		r := "?"
+		if len(o.Rect) == 4 {
+			r = fmt.Sprintf("(%d,%d %d×%d)/视口高%d", o.Rect[0], o.Rect[1], o.Rect[2], o.Rect[3], o.VH)
+		}
+		cov := "无"
+		if o.Covered != "" {
+			cov = o.Covered
+		}
+		parts = append(parts, fmt.Sprintf("按钮「%s」位置%s 视口内=%s 可见=%s 遮挡=%s disabled=%s loading=%s",
+			o.Text, r, yn(o.InView), yn(o.Visible), cov, yn(o.Disabled), yn(o.Loading)))
+	}
+	parts = append(parts, fmt.Sprintf("回复 DOM %s 条 / 状态 %s 条 / 显示 %v，hasMore=%v", num(o.DomSubs), num(o.StateSubs), o.Shown, o.HasMore))
+	if o.Err != "" {
+		parts = append(parts, "JS 错误 "+o.Err)
+	}
+	return strings.Join(parts, "；")
+}
+
+// loadCommentFloors 真实页面接线入口。
+func (f *FeedDetailAction) loadCommentFloors(ctx context.Context, feedID string, config CommentLoadConfig, budget time.Duration) (CommentLoadResult, *RiskError) {
+	// expand_floors 非空即要求展开（续读），不必另传 click_more_replies
+	cfg := defaultFloorLoadCfg(config.MaxCommentItems, config.ClickMoreReplies || len(config.ExpandFloors) > 0, budget, config.MaxRepliesPerFloor)
+	cfg.ExpandFloors = config.ExpandFloors
+	logrus.Infof("评论加载开始：楼层上限 %d，展开回复=%v，只展开 %d 楼（0=按上限），每楼回复上限 %d（0=不限），预算 %s，分档 %d 条",
+		cfg.FloorLimit, cfg.Expand, len(cfg.ExpandFloors), cfg.ReplyCap, budget.Round(time.Second), cfg.RoundStep)
+
+	ops := f.floorOpsFor(ctx, feedID, cfg, config.ScrollSpeed)
+	if budget > 0 {
+		if r := ops.risk(); r != nil {
+			res := CommentLoadResult{FloorLimit: cfg.FloorLimit, Reason: CommentStopRisk, Partial: true, RepliesPartial: []ReplyGap{}}
+			return res, r
+		}
+		_ = rod.Try(func() { scrollToCommentsArea(f.page.Context(ctx)) })
+		humanize.Delay(ctx, humanize.BetweenScroll)
+	}
+	return loadFloors(ctx, cfg, ops)
+}
+
+// floorOpsFor 真实页面的五个动作。读数 / 诊断用不带 ctx 的原页面（预算用完时照样读得了），点击 / 滚动绑 ctx。
+func (f *FeedDetailAction) floorOpsFor(ctx context.Context, feedID string, cfg floorLoadCfg, speed string) floorOps {
+	page := f.page.Context(ctx)
+	preClick := f.preClick
+	if preClick == nil {
+		preClick = func(ctx context.Context) { humanize.Delay(ctx, humanize.Reading) }
+	}
+	return floorOps{
+		probe: func() floorSnapshot {
+			s := floorSnapshot{Total: -1, HasMore: -1}
+			_ = rod.Try(func() {
+				ids := cfg.ExpandFloors
+				if ids == nil {
+					ids = []string{}
+				}
+				v := f.page.Timeout(10*time.Second).MustEval(floorProbeJS, feedID, cfg.FloorLimit, expandRepliesPattern, expandButtonSelector, ids)
+				if !v.Get("ok").Bool() {
+					return
+				}
+				s.OK = true
+				s.Loaded, s.Total, s.HasMore = v.Get("loaded").Int(), v.Get("total").Int(), v.Get("hasMore").Int()
+				s.End, s.NoComments = v.Get("end").Bool(), v.Get("none").Bool()
+				for _, it := range v.Get("floors").Arr() {
+					s.Floors = append(s.Floors, floorInfo{Index: it.Get("idx").Int(), ID: it.Get("id").Str(), Shown: it.Get("shown").Int(),
+						Loaded: it.Get("loaded").Int(), HasMore: it.Get("hasMore").Int(), Button: it.Get("button").Bool(),
+						BtnText: it.Get("btnText").Str()})
+				}
+			})
+			return s
+		},
+		expand: func(fl floorInfo) clickResult {
+			return clickFloorButton(ctx, page, fl, preClick)
+		},
+		diagnose: func(fl floorInfo) string {
+			raw := ""
+			err := rod.Try(func() {
+				raw = f.page.Timeout(5*time.Second).MustEval(floorDiagJS, feedID, fl.ID, fl.Index, expandRepliesPattern, expandButtonSelector).Str()
+			})
+			if err != nil {
+				return "诊断失败：" + truncRunes(err.Error(), 80)
+			}
+			return formatFloorDiag(raw)
+		},
+		scroll: func(level int) {
+			_ = rod.Try(func() {
+				if getCommentCount(page) > 0 {
+					scrollToLastComment(page)
+					time.Sleep(400 * time.Millisecond) // 技术 settle：等 scrollIntoView 落位
+				}
+				switch {
+				case level <= 0:
+					humanScroll(ctx, page, speed, false, 1)
+				case level == 1:
+					humanScroll(ctx, page, speed, true, 3+rand.Intn(3))
+				default:
+					humanScroll(ctx, page, speed, true, 8+rand.Intn(5))
+				}
+			})
+		},
+		risk: func() *RiskError { return RiskPage(f.page) },
+	}
+}
+
+// clickFloorButton 点这楼的「展开」：每次都按 comment_id 重新查按钮（点完会被重渲染换掉）→ 滚到评论容器中间 →
+// 拟人停顿 → 拟人点击（限时 8 秒）→ 不行退回 DOM click。失败时 Detail 带上点击报错和这楼的诊断。
+func clickFloorButton(ctx context.Context, page *rod.Page, fl floorInfo, preClick func(context.Context)) clickResult {
+	el, text, why := floorExpandButton(ctx, page, fl)
+	if el == nil {
+		return clickResult{Detail: why}
+	}
+	// 滚到评论滚动容器（不只是 window）的中间：贴边时常被底部输入栏 / 浮层盖住，WaitInteractable 一直等
+	_ = rod.Try(func() {
+		el.Timeout(3 * time.Second).MustEval(`function () { this.scrollIntoView({block: "center", inline: "nearest"}) }`)
+	})
+	time.Sleep(time.Duration(300+rand.Intn(300)) * time.Millisecond) // 技术 settle：等滚动落位
+	preClick(ctx)
+	if ctx.Err() != nil {
+		return clickResult{Detail: "预算到点：" + ctx.Err().Error()}
+	}
+	logrus.Debugf("评论第 %d 楼：点「%s」（已加载 %d/%d）", fl.Index+1, text, fl.Loaded, fl.Shown)
+	herr := rod.Try(func() {
+		if err := humanize.Click(el.Timeout(8 * time.Second)); err != nil {
+			panic(err)
+		}
+	})
+	if herr == nil {
+		return clickResult{OK: true}
+	}
+	// 拟人点击失败：退回 DOM click（同 selectTab 的做法）；有没有生效由上层看回复数
+	_, derr := el.Timeout(5 * time.Second).Eval(`function () { this.click() }`)
+	if derr == nil {
+		logrus.Infof("评论第 %d 楼：拟人点击失败（%s），已退回 DOM click", fl.Index+1, truncRunes(herr.Error(), 120))
+		return clickResult{OK: true, DOM: true}
+	}
+	return clickResult{DOM: true, Detail: truncRunes(fmt.Sprintf("拟人点击：%v；DOM click：%v", herr, derr), 200)}
+}
+
+// floorExpandButton 找这楼里可点的「展开 … 回复」按钮：先按评论 id 定位楼，找不到再按楼序取 .parent-comment。
+// 查找一律用不等待的 page.Elements（page 绑着加载的 ctx），**不用 page.Timeout(2s).Element**：rod 的元素句柄
+// 连同它的 page 一起继承查询时的 ctx，带着 2 秒超时的句柄过了拟人停顿再去点，必然 context deadline exceeded
+// （19:54 真号 10 楼全部 click_failed 的根因；对 el.Context(ctx) 改绑也不够，鼠标走的是 el.Page() 的旧 ctx）。
+// 找不到时返回原因。
+func floorExpandButton(ctx context.Context, page *rod.Page, fl floorInfo) (*rod.Element, string, string) {
+	_ = ctx // page 已绑 ctx；参数留给调用方对齐
+	var root *rod.Element
+	_ = rod.Try(func() {
+		if id := strings.Trim(fl.ID, `"\ `); id != "" {
+			if els, err := page.Elements(fmt.Sprintf(`[id="comment-%s"]`, id)); err == nil && len(els) > 0 {
+				if ps, err := els.First().Parents(".parent-comment"); err == nil && len(ps) > 0 {
+					root = ps.First()
+				} else if p, err := els.First().Parent(); err == nil {
+					root = p
+				}
+			}
+		}
+		if root == nil {
+			if els, err := page.Elements(".parent-comment"); err == nil && fl.Index < len(els) {
+				root = els[fl.Index]
+			}
+		}
+	})
+	if root == nil {
+		return nil, "", "找不到这楼的 DOM"
+	}
+	var btn *rod.Element
+	var text string
+	seen := 0
+	err := rod.Try(func() {
+		els, err := root.Elements(expandButtonSelector)
+		if err != nil {
+			panic(err)
+		}
+		for _, el := range els {
+			seen++
+			t, err := el.Text()
+			if err != nil || !isExpandRepliesButton(t) {
+				continue
+			}
+			if !isElementClickable(el) {
+				continue
+			}
+			btn, text = el, strings.TrimSpace(t)
+			return
+		}
+	})
+	if btn == nil {
+		why := fmt.Sprintf("楼里没找到可见的展开按钮（候选 %d 个）", seen)
+		if err != nil {
+			why += "：" + truncRunes(err.Error(), 80)
+		}
+		return nil, "", why
+	}
+	return btn, text, ""
+}
diff --git a/xiaohongshu/comment_floors_localbrowser_test.go b/xiaohongshu/comment_floors_localbrowser_test.go
