+// TestCollectWatchParsesBody 收藏接口回包只留状态 / code / msg / has_more / 条数，不留数据本身；窗口只留最近 20 次。
+func TestCollectWatchParsesBody(t *testing.T) {
+	w := &CollectWatch{pending: map[proto.NetworkRequestID]int{}}
+	w.add("r1", CollectCall{Status: 200})
+	w.fill("r1", `{"code":0,"success":true,"msg":"成功","data":{"has_more":true,"notes":[{"note_id":"secret"},{}]}}`, nil)
+	w.add("r2", CollectCall{Status: 461})
+	w.fill("r2", `{"code":300011,"success":false,"msg":"账号异常"}`, nil)
+	w.add("r3", CollectCall{Status: 200})
+	w.fail("r3", "net::ERR_FAILED")
+	w.add("r4", CollectCall{Status: 200})
+	w.fill("r4", "<html>", nil)
+
+	calls := w.Calls()
+	require.Len(t, calls, 4)
+	assert.Equal(t, float64(0), calls[0].Code)
+	require.NotNil(t, calls[0].HasMore)
+	assert.True(t, *calls[0].HasMore)
+	assert.Equal(t, 2, *calls[0].Notes)
+	assert.Equal(t, 461, calls[1].Status)
+	assert.Equal(t, float64(300011), calls[1].Code)
+	assert.Equal(t, "账号异常", calls[1].Msg)
+	assert.Equal(t, "net::ERR_FAILED", calls[2].Failed)
+	assert.Contains(t, calls[3].Body, "不是 JSON")
+	b, _ := json.Marshal(w.Summary())
+	assert.NotContains(t, string(b), "secret", "不留收藏数据本身")
+	assert.Contains(t, string(b), `"total":4`)
+
+	for i := 0; i < 30; i++ {
+		w.add(proto.NetworkRequestID("x"+string(rune('a'+i))), CollectCall{Status: 200})
+	}
+	assert.Len(t, w.Calls(), collectKeep)
+	assert.Len(t, w.Summary()["recent"], 10)
+	var nilWatch *CollectWatch
+	assert.Nil(t, nilWatch.Summary())
+	nilWatch.Stop()
+}
