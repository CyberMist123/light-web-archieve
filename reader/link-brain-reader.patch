+	eval := func(js string) { _ = rod.Try(func() { pg.MustEval(js) }) }
+	pause := func(lo, span time.Duration) {
+		select {
+		case <-ctx.Done():
+		case <-time.After(lo + time.Duration(rand.Int63n(int64(span)))):
+		}
+	}
+	wheel := func(screens float64) {
+		_ = rod.Try(func() {
+			v := pg.MustEval(`() => ({w: window.innerWidth || 1200, h: window.innerHeight || 800})`)
+			w, h := v.Get("w").Num(), v.Get("h").Num()
+			x := w*0.45 + float64(rand.Intn(int(w*0.1)+1))
+			y := h*0.5 + float64(rand.Intn(int(h*0.1)+1))
+			_ = pg.Mouse.MoveTo(proto.Point{X: x, Y: y})
+			_ = pg.Mouse.Scroll(0, h*screens, 6+rand.Intn(5))
+		})
+	}
+	switch {
+	case level <= 0:
+		eval(favScrollJS)
+	case level == 1:
+		eval(favScrollBackJS)
+		pause(600*time.Millisecond, 600*time.Millisecond)
+		eval(favScrollJS)
+	case level == 2:
+		wheel(1.6 + rand.Float64())
+	default:
+		wheel(-0.8)
+		pause(500*time.Millisecond, 500*time.Millisecond)
+		wheel(2.5 + rand.Float64())
+		eval(favLastCardJS)
+	}
+}
