+// TestVerifyNoCaptchaSeenKeepsHold 1008（B3）：seenRisk 两种分支走真实 /login/session；alive() 只失败 1 次不算关窗。
+func TestVerifyNoCaptchaSeenKeepsHold(t *testing.T) {
+	captcha := &xiaohongshu.RiskError{Code: xiaohongshu.RiskCaptcha, Detail: "x"}
+	clean := verifyReading{ok: true, loggedIn: true}
+	stillCaptcha := verifyReading{ok: true, risk: captcha, loggedIn: true}
+
+	// 读数一直干净 → 熔断保留，session 给 verify_result=no_captcha_seen
+	app, _ := testApp(t)
+	app.xiaohongshuService.tripRisk(xiaohongshu.RiskCaptcha, "读收藏撞验证")
+	since := app.xiaohongshuService.hold.get().Since
+	app.xiaohongshuService.state.set(func(l *loginState) { l.verifyHoldSince = since })
+	last, seen, seenRisk := verifyRun([]bool{true, true}, []verifyReading{clean, clean})
+	assert.False(t, seenRisk)
+	app.xiaohongshuService.finishVerify(last, seen, seenRisk)
+	_, out := doJSON(t, setupRoutes(app), "GET", "/api/v1/login/session", "")
+	data := out["data"].(map[string]any)
+	assert.Equal(t, "no_captcha_seen", data["verify_result"])
+	assert.Equal(t, since, data["verify_hold_since"])
+	require.NotNil(t, data["risk_hold"], "从没出现过验证：熔断保留")
+
+	// 一次新的熔断（清掉后又撞上）：上一轮的结论作废
+	app.xiaohongshuService.clearRisk("test")
+	app.xiaohongshuService.tripRisk(xiaohongshu.RiskCaptcha, "又撞了")
+	assert.Nil(t, app.xiaohongshuService.state.snapshot()["verify_result"])
+
+	// 读数「有风控 → 干净」→ 解除
+	last, seen, seenRisk = verifyRun([]bool{true, true}, []verifyReading{stillCaptcha, clean})
+	assert.True(t, seenRisk)
+	assert.Equal(t, verifyCleared, app.xiaohongshuService.finishVerify(last, seen, seenRisk))
+	assert.Nil(t, app.xiaohongshuService.hold.get())
+
+	// alive() 只失败 1 次（页面跳转）不算关窗：后面那次「干净」读数照样采到，所以「出现过 → 消失」照样解除
+	app.xiaohongshuService.tripRisk(xiaohongshu.RiskCaptcha, "再撞")
+	last, seen, seenRisk = verifyRun([]bool{true, false, true}, []verifyReading{stillCaptcha, clean})
+	require.True(t, seenRisk)
+	assert.Nil(t, last.risk, "单次 alive 失败后继续采样")
+	assert.Equal(t, verifyCleared, app.xiaohongshuService.finishVerify(last, seen, seenRisk))
+	// 连续 2 次失败才算关窗：之后的读数不会再采
+	n := 0
+	_, _, _ = watchVerifyWindow(time.Now().Add(time.Minute), time.Millisecond,
+		func() bool { return false }, func() verifyReading { n++; return clean })
+	assert.Equal(t, 0, n)
+}
