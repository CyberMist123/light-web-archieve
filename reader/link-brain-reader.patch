new file mode 100644
index 0000000..e0fb1e8
--- /dev/null
+++ b/xiaohongshu/note_restricted_test.go
@@ -0,0 +1,62 @@
+package xiaohongshu
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// 1011：网页版限制的笔记——页面上没有这篇时怎么判（纯函数，不开浏览器）。
+
+func TestClassifyMissingNote(t *testing.T) {
+	// 这篇在页面状态里：不判
+	assert.Nil(t, ClassifyMissingNote("n1", NoteState{Has: true, Path: "/explore/n1"}))
+
+	// 页面上没有这篇、不是游客、不在登录页 → 只是这一篇（不写熔断）
+	err := ClassifyMissingNote("n1", NoteState{Path: "/explore/n1", Login: "user"})
+	r := AsNoteRestricted(err)
+	require.NotNil(t, r)
+	assert.Equal(t, "n1", r.NoteID)
+	assert.Nil(t, AsRisk(err), "限制的笔记不是风控，不写熔断")
+	// SSR 首帧的 guest:true（guestflag）不能当成掉登录
+	assert.NotNil(t, AsNoteRestricted(ClassifyMissingNote("n1", NoteState{Path: "/explore", Login: "guestflag"})))
+	assert.NotNil(t, AsNoteRestricted(ClassifyMissingNote("n1", NoteState{Path: "/404", Login: "pending"})))
+
+	// 页面上有登录框 → 号的事（NOT_LOGGED_IN，服务层写熔断）
+	g := AsRisk(ClassifyMissingNote("n1", NoteState{Path: "/explore/n1", Login: "guest"}))
+	require.NotNil(t, g)
+	assert.Equal(t, RiskNotLoggedIn, g.Code)
+
+	// 落在登录类页面 / 风控页：不在这里判（宁可报原来的错）
+	assert.Nil(t, ClassifyMissingNote("n1", NoteState{Path: "/login", Login: "pending"}))
+	assert.Nil(t, ClassifyMissingNote("n1", NoteState{Path: "/website-login/captcha", Login: "risk"}))
+}
+
+// TestNoteRestrictedTextAvoidsBlockedHints 报错文本会进 MCP 报错（Python 按方括号码认），
+// 不能带 looks_blocked 认的那些字，否则会被当成「号出事」整批停车。
+func TestNoteRestrictedTextAvoidsBlockedHints(t *testing.T) {
+	text := (&NoteRestrictedError{NoteID: "abc", Path: "/explore/abc"}).Error()
+	assert.True(t, strings.HasPrefix(text, "[NOTE_RESTRICTED]"))
+	for _, w := range []string{"未登录", "请登录", "登录后", "登录态", "重新登录", "验证码", "captcha", "滑块", "安全验证",
+		"行为异常", "账号异常", "风控", "访问频繁", "操作频繁", "429", "login", "launcher", "内部错误"} {
+		assert.NotContains(t, strings.ToLower(text), strings.ToLower(w), w)
+	}
+	for _, w := range []string{"验证码", "安全验证", "滑块", "登录"} {
+		assert.NotContains(t, NoteRestrictedText, w)
+	}
+}
+
+func TestNoteRestrictedErrorChain(t *testing.T) {
+	inner := &NoteRestrictedError{NoteID: "x", Path: "/explore"}
+	wrapped := fmt.Errorf("外层：%w", inner)
+	assert.Equal(t, inner, AsNoteRestricted(wrapped))
+	assert.Nil(t, AsNoteRestricted(errors.New("别的错")))
+	// 抽取时找不到这篇：原来的报错文本不变，另包着 ErrNoteNotInState（调用方据此再看一眼）
+	e := fmt.Errorf("feed %s not found in noteDetailMap: %w", "x", ErrNoteNotInState)
+	assert.True(t, errors.Is(e, ErrNoteNotInState))
+	assert.Contains(t, e.Error(), "not found in noteDetailMap")
+}
